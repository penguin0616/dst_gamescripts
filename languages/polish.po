msgstr "Zmywajmy się stąd!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ATRIUM_DESTABILIZING.2"
