msgstr "Nasza łódka wygląda, jakby miała zaraz odlecieć!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "This will look great on our boat!"
msgstr "Będzie świetnie wyglądać na naszej łódce!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD"
msgid "We could look at those shimmery scales all day!"
msgstr "Możemy patrzeć na te błyszczące łuski przez cały dzień!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAST_YOTD_ITEM"
msgid "That's for building a mast."
msgstr "Z tego będzie maszt."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELL"
msgid "That jerk tricked us."
msgstr "Ten drań nas wykiwał."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLHEAD"
msgid "Imagine the trouble he has buying hats!"
msgstr "Wyobraź sobie, jak ciężko mu kupić czapkę!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLIGHT"
msgid "Well, these would've been handy before."
msgstr "Cóż, kiedyś mogłyby się przydać."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLLOCK"
msgid "It's missing something."
msgstr "Czegoś brakuje."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "We could listen to that forever!"
msgstr "Moglibyśmy go słuchać bez przerwy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MAXWELLTHRONE"
msgid "That throne makes our skin crawl."
msgstr "Ten tron przyprawia nas o dreszcze."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT"
msgid "Some fire would spice this up."
msgstr "Trochę ognia mogłoby pomóc."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATBALLS"
msgid "I used to make these with grandpa!"
msgstr "Robiliśmy takie z dziadkiem!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.BURNT"
msgid "Fire takes all."
msgstr "Ogień wszystko psuje."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE"
msgid "Food time!"
msgstr "Czas na jedzonko!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Food time!"
msgstr "Czas na jedzonko!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING"
msgid "Is it done yet? I'm hungry."
msgstr "Już gotowe? Jestem głodny."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "It's hard to dry when it's raining."
msgstr "Ciężko suszyć, jak pada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "It's hard to dry when it's raining."
msgstr "Ciężko suszyć, jak pada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Is it done yet? I'm hungry."
msgstr "Już gotowe? Jestem głodny."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK.GENERIC"
msgid "It's not doing us much good empty!"
msgstr "Pusta na niewiele się przyda."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It burned away."
msgstr "Spaliło się."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Ma'am! It's food time!"
msgstr "Pszepani! Jedzonko!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Ma'am! It's food time!"
msgstr "Pszepani! Jedzonko!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Is it done yet?"
msgstr "Już urosło?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "It's hard to dry when it's raining."
msgstr "Ciężko suszyć, jak pada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "It's hard to dry when it's raining."
msgstr "Ciężko suszyć, jak pada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Is it done yet? I'm hungry."
msgstr "Już gotowe? Jestem głodny."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Maybe we could share some meat?"
msgstr "Może moglibyśmy podzielić się mięskiem?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEATYSALAD"
msgid "Is it meat or salad?"
msgstr "To mięso czy sałatka?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEAT_DRIED"
msgid "That worked better than expected."
msgstr "Wyszło lepiej, niż się spodziewałem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MEGAFLARE"
msgid "Ms. Wickerbottom says we shouldn't pick fights..."
msgstr "Pani Wiklińska mówi, że nie powinniśmy wszczynać bójek..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM"
msgid "I would've thought they would bathe more often!"
msgstr "Spodziewałbym się, że częściej się myją!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORHAT"
msgid "Merms only? No fair."
msgstr "Tylko dla mermów? To nie fair."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Merms only? No fair."
msgstr "Tylko dla mermów? To nie fair."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD"
msgid "They look pretty scary!"
msgstr "Wyglądają trochę strasznie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_LUNAR"
msgid "Um, Wurt? Are the merms sick?"
msgstr "Ee, Wurt? Czy te mermy są chore?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMGUARD_SHADOW"
msgid "We've been starting to get a little worried about Wurt..."
msgstr "Zaczynamy się trochę martwić o Wurt…"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHAT"
msgid "Hopefully they don't notice the extra legs."
msgstr "Mam nadzieję, że nie zauważą nadmiarowych nóg."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.BURNT"
msgid "I wonder who that was."
msgstr "Ciekawe, kto to był."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHEAD.GENERIC"
msgid "A waste of food."
msgstr "Szkoda jedzenia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE.BURNT"
msgid "It's in worse shape than before!"
msgstr "Jest w jeszcze gorszym stanie niż wcześniej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Smells fishy."
msgstr "Śmierdzi rybą."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Oh no!"
msgstr "Och, nie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "What a funny little house."
msgstr "Ale śmieszny, mały domek."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMKING"
msgid "He looks pretty important."
msgstr "Wygląda na ważniaka."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE.BURNT"
msgid "Yikes! What happened?"
msgstr "Aj, aj! Co się stało?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Hey, can we be the king? We can take turns!"
msgstr "Czy my tez możemy królować? Będziemy się zmieniać!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "It's burnt up!"
msgstr "Spaliło się!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "Can we help?"
msgstr "Możemy pomóc?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "We better not get too close..."
msgstr "Lepiej się nie zbliżać..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Cool fort!"
msgstr "Super fort!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_ARMORY"
msgid "They don't seem to like sharing their toys."
msgstr "Chyba nie lubią dzielić się zabawkami."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "They don't seem to like sharing their toys."
msgstr "Chyba nie lubią dzielić się zabawkami."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_LUNAR"
msgid "Um, Wurt? Are the merms sick?"
msgstr "Ee, Wurt? Czy te mermy są chore?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_PRINCE"
msgid "Wow, becoming a king looks easy!"
msgstr "Łał, chyba łatwo zostać królem!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_SHADOW"
msgid "We've been starting to get a little worried about Wurt..."
msgstr "Zaczynamy się trochę martwić o Wurt…"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOL"
msgid "Wow, it does everything! Sort of."
msgstr "O rany, to robi wszystko! Tak jakby."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOLSHED"
msgid "Aww, how come we're not allowed inside?"
msgstr "Ojej, dlaczego nie możemy tam wejść?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "Aww, how come we're not allowed inside?"
msgstr "Ojej, dlaczego nie możemy tam wejść?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "Wow, it does everything! Sort of."
msgstr "O rany, to robi wszystko! Tak jakby."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MESSAGEBOTTLE"
msgid "There's something inside!"
msgstr "W środku coś jest!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "It's like the jars grandma used for her preserves."
msgstr "Przypomina mi słoiki, w jakich babcia robiła przetwory."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "Uh oh... Mr. Wolfgang won't be very happy..."
msgstr "Ojej... Pan Wolfgang nie będzie zadowolony..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "Can we try, Mr. Wolfgang? We've got extra arms to lift with!"
msgstr "Możemy poćwiczyć, panie Wolfgangu? Mamy więcej rąk do podnoszenia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MILKYWHITES"
msgid "Poor friend. Looks yummy, though."
msgstr "Biedaczek. Ale wygląda pysznie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINERHAT"
msgid "A handy light for our head."
msgstr "Fajne światełko na głowę."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIBOATLANTERN"
msgid "We like to watch it paddle around."
msgstr "Lubimy patrzeć, jak sobie pływa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIFAN"
msgid "It cools us when we run, how nice."
msgstr "Chłodzi, jak biegniemy. Fajne."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINIFLARE"
msgid "Just in case someone's lost and lonely."
msgstr "Na wypadek, gdyby ktoś poczuł się samotny lub zagubiony."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN.GENERIC"
msgid "That looks nice!"
msgstr "Wygląda super!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Can someone lend us a pencil?"
msgstr "Pożyczy ktoś ołówek?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINISIGN_ITEM"
msgid "Let's build it!"
msgstr "Zbudujmy go!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAUR"
msgid "Wear that frown upside down."
msgstr "Co się patrzysz?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAURCHEST"
msgid "What a big treasure box!"
msgstr "Ale duży skarb!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MINOTAURHORN"
msgid "It's quite tender."
msgstr "Całkiem kruchy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Hello little guy!"
msgstr "Cześć, mały!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.HELD"
msgid "Are you comfy?"
msgstr "Wygodnie ci?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLE.UNDERGROUND"
msgid "Come out and play!"
msgstr "Wyjdź się pobawić!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEBAT"
msgid "Don't look! It's not wearing any clothes!"
msgstr "Nie patrz! Nie założył żadnych ubrań!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEBATHILL"
msgid "Yuck, did that all come from its nose?"
msgstr "Fuj, to wszystko wyszło z jego nosa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEHAT"
msgid "It sees for miles and miles."
msgstr "Zapewnia widoczność!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOLEHILL"
msgid "Hidey-hole."
msgstr "Uciekaj, krecie, do dziury, bo pająk cię złapie u góry."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY"
msgid "He just wants to learn!"
msgstr "Chce się czegoś nauczyć!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYBARREL"
msgid "Did you hear something?"
msgstr "Słyszałeś coś?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYHUT.BURNT"
msgid "That's what happens when you don't play nice!"
msgstr "Tak się właśnie dzieje, jak ktoś jest niemiły!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYHUT.GENERIC"
msgid "We don't want to play in those jerks' tree house! Even if it does look like fun..."
msgstr "Nie chcemy się bawić w domku na drzewie tych głupków! Nawet jeśli wygląda fajnie..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "It doesn't look like it can take us home."
msgstr "Nie wygląda, jakby był w stanie zabrać nas do domu."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "What's that metal stuff?"
msgstr "Co to za metalowe ustrojstwa?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYPILLAR"
msgid "How far up does it go?"
msgstr "Jak wysoko sięga?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYQUEEN"
msgid "She looks pretty important."
msgstr "Wygląda na ważną."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEYTAIL"
msgid "Fuzzy!"
msgstr "Jest kudłaty!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Wearing a fancy hat definitely makes you better at sailing."
msgstr "Z pewnością noszenie wymyślnego kapelusza sprawia, że lepiej znasz się na żeglowaniu."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONKEY_SMALLHAT"
msgid "It's a bit itchy."
msgstr "Trochę drapie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERLASAGNA"
msgid "Mmm!"
msgstr "Mmmm!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERMEAT"
msgid "Smells foul."
msgstr "Śmierdzi paskudnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERMEAT_DRIED"
msgid "It's really chewy."
msgstr "Można je żuć godzinami."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MONSTERTARTARE"
msgid "Looks amazing!"
msgstr "Wygląda świetnie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.BROKEN"
msgid "It's broke."
msgstr "Zepsuta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.GENERIC"
msgid "I wonder what it wants?"
msgstr "Ciekawe, czego chce..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Bright sticky stick!"
msgstr "Jasny kijek!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.STAFFED"
msgid "Something else needs to happen, right?"
msgstr "Coś musi się jeszcze wydarzyć, tak?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "I don't think it wanted that."
msgstr "Ten jej chyba nie odpowiada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "What a pretty moth!"
msgstr "Ale ładna ćma!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Don't worry, we won't eat you."
msgstr "Nie bój się, nie zjemy cię."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Poor moth."
msgstr "Biedna ćma."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It'll be a big tree one day."
msgstr "Kiedyś będzie dużym drzewkiem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.CAVE"
msgid "The moon can't fit in a cave! I think."
msgstr "Księżyc nie zmieści się do jaskini! Chyba..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.GENERIC"
msgid "Hey, Ms. Wicker! How come we can still see the moon?"
msgstr "Pani Wicker! Jak to jest, że wciąż widzimy Księżyc?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.GLASSED"
msgid "It looks like ice, but we think it's actually glass!"
msgstr "Wygląda na lód, ale to chyba szkło!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Wow! Full moon!"
msgstr "Wow! Pełnia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "New moon! Neat!"
msgstr "Jest nów! Super!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is shrinking!"
msgstr "Księżyc się kurczy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon is growing!"
msgstr "Księżyc rośnie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS"
msgid "It came from the moon. Wow!"
msgstr "Łał! Pochodzi z księżyca."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASSAXE"
msgid "We think it cuts better than a regular axe."
msgstr "Myślimy, że jest lepsza niż zwykła siekiera."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_CHARGED"
msgid "There's still lightning stuck in it!"
msgstr "Wciąż tli się w nim światło!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_ROCK"
msgid "Is the moon green, too?"
msgstr "Czy księżyc też jest zielony?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "We hear something tip-tapping in there."
msgstr "Słyszeliśmy jakiś hałas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKCRATER"
msgid "Haha. It's heavy!"
msgstr "Ha, ha! Ciężki!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKIDOL"
msgid "It looks kinda like an alien."
msgstr "Wygląda jak jakiś kosmita."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKNUGGET"
msgid "Neat!"
msgstr "Fajny!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCKSEED"
msgid "Neat, it's a ball that floats by itself!"
msgstr "Super! Ta kulka sama się rusza!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONROCK_PIECES"
msgid "Oh... We don't like this!"
msgstr "Och... To nie jest fajne!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSPIDERDEN"
msgid "They're not so bad once you get to know them."
msgstr "Jak się je pozna, to nie są takie złe."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "Aw, it's not glowy anymore."
msgstr "Oj, już nie świeci."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "Oh! It's so pretty!"
msgstr "Rany! Ale ładne!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "Will these goggles be able to protect all of our eyes from the storm?"
msgstr "Te gogle ochronią przed burzą wszystkie nasze oczy?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_SPARK"
msgid "It makes all our spider hairs stand on end!"
msgstr "Aż nam się wszystkie pajęcze włosy jeżą!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_STATIC"
msgid "That looks kinda dangerous..."
msgstr "Wygląda niebezpiecznie..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "It's like a big lightning bug stuck in a jar."
msgstr "Jakby w słoiku zamknęli wielkiego świetlika."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Hm? Do you need something from me?"
msgstr "Hę? Potrzebujesz czegoś?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Don't worry, you'll be together again soon."
msgstr "Nie martw się, wkrótce znowu będziecie razem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "All together again!"
msgstr "Wszystko znów jest razem!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "We think it says we're getting closer."
msgstr "Chyba mówi, że się zbliżamy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_CROWN"
msgid "It wants to go back home."
msgstr "Chce wrócić do domu."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_GLASS"
msgid "It can't talk like we do, but it's a friend."
msgstr "Nie potrafi mówić jak my, ale to przyjaciel."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ICON"
msgid "It wants to be back with the others."
msgstr "Chce wrócić do pozostałych."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_IDOL"
msgid "It doesn't want to be here. We don't either."
msgstr "Nie chce być tutaj. My też nie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_LINK"
msgid "What could be in there?"
msgstr "Co tam może być?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Oh no, someone's trapped inside that rock!"
msgstr "Och, nie, ktoś jest uwięziony w tej skale!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Oh no, someone's trapped inside that rock!"
msgstr "Och, nie, ktoś jest uwięziony w tej skale!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Oh no, someone's trapped inside that rock!"
msgstr "Och, nie, ktoś jest uwięziony w tej skale!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_SEED"
msgid "It wants to go to one of those cracks in the ground."
msgstr "Chce się dostać do jednego z tych pęknięć w ziemi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_ALTAR_WARD"
msgid "It's lonely, it wants its friends."
msgstr "Chce wracać do przyjaciół."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_CAP"
msgid "It looks weird."
msgstr "Wygląda dziwnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_CAP_COOKED"
msgid "We're not sure about this..."
msgstr "Jakoś nie jesteśmy co do tego przekonani..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "There's so much building to do, can't we go play instead?"
msgstr "Tyle pracy! Nie możemy zamiast tego pójść się pobawić?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "It's coming along!"
msgstr "Jest coraz lepiej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "It looks pretty impressive... whatever it is!"
msgstr "Wygląda imponująco... cokolwiek by to nie było!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "It's trying to talk, we think!"
msgstr "Chyba próbuje coś powiedzieć!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Don't step on a crack!"
msgstr "Muszę uważać, żeby nie wejść na pęknięcie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Woah! Why didn't we think of that?"
msgstr "Ojej! Czemu o tym nie pomyśleliśmy?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.BURNING"
msgid "I hope trees don't feel pain."
msgstr "Mam nadzieję, że drzewa nie czują bólu."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.BURNT"
msgid "It's dead now."
msgstr "Jest martwe."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Sorry, tree."
msgstr "Sorki, drzewko."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE.GENERIC"
msgid "What a pretty tree!"
msgstr "Ale ładne drzewko!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "We like this flower!"
msgstr "Ten kwiatek nam się podoba."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSE"
msgid "She doesn't look at all pleased to see us."
msgstr "Nie wydaje się zachwycona naszym widokiem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSEEGG"
msgid "That would make a huge breakfast!"
msgstr "Ale by było śniadanie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "For its babies' sleepytime."
msgstr "Łóżeczko dla ptasich dzieci."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOQUECA"
msgid "We love when Warly cooks for us."
msgstr "Uwielbiamy, jak Warly nam gotuje."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITO.GENERIC"
msgid "Shoo!"
msgstr "Spadówa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITO.HELD"
msgid "We should just squish you."
msgstr "Powinniśmy cię zmiażdżyć."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOBOMB"
msgid "It looks gross and yummy at the same time."
msgstr "Równocześnie wygląda obrzydliwie i pysznie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOFERTILIZER"
msgid "It will make the little plants grow big and strong!"
msgstr "Sprawi, że roślinki urosną duże i silne!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOMERMSALVE"
msgid "We're just glad it's not for us."
msgstr "Cieszymy się, że to nie dla nas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOMUSK"
msgid "Can we keep it?"
msgstr "Możemy to zatrzymać?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSQUITOSACK"
msgid "Maybe we can put the blood back in?"
msgstr "Może dałoby się jakoś przywrócić tę krew na miejsce?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOSSLING"
msgid "Hungry little guys."
msgstr "Mały, głodny ptaszek."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOUND.DUG"
msgid "Maybe that was too mean."
msgstr "To chyba nie było miłe."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MOUND.GENERIC"
msgid "Our loot sense is tingling."
msgstr "Uwielbiam poszukiwanie skarbów."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULLEDDRINK"
msgid "Warms us right up!"
msgstr "Od razu rozgrzewa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "It's pretty... pretty scary!"
msgstr "Całkiem... Całkiem straszny!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Gosh. It's so sparkly!"
msgstr "Ojej, ale się mieni!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Double duty."
msgstr "Dwa razy więcej obowiązków."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHGNOME"
msgid "What a funny guy."
msgstr "Co za zabawny koleżka."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMBOMB"
msgid "Explodey fungus!"
msgstr "Wybuchowy grzybek!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMHAT"
msgid "It's a cap cap!"
msgstr "Kapelusz z kapelusza!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "We should have chopped it!"
msgstr "Trzeba było użyć siekiery!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "I think it's doing something bad!"
msgstr "Na pewno robi coś niecnego!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "Fire's dangerous, I guess."
msgstr "Ogień jest chyba niebezpieczny."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "There aren't any mushrooms."
msgstr "Nie ma grzybków."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "They look happy."
msgstr "Wyglądają na szczęśliwe."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "It's all yucky."
msgstr "Wyglądają ohydnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "You look chilly."
msgstr "Nie zimno ci?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "Aw, they're so little."
msgstr "Ale są malutkie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Wow! So many mushrooms!"
msgstr "Wow! Ale grzybów!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Well that's no fun-gus."
msgstr "Koniec grzybobrania."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "It still needs to be turned on."
msgstr "Trzeba go jeszcze włączyć."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "It's giving off a nice light."
msgstr "Daje bardzo przyjemne światło."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Aw. It was kinda growing on us."
msgstr "Ajć. Grzyb czy nie grzyb, ze światłem było przyjemniej."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Maybe the night won't be as scary now."
msgstr "Może noc nie będzie teraz taka straszna."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "We love all the colors!"
msgstr "Lubimy wszystkie kolory!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "Smells funny."
msgstr "Dziwnie pachnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "Hahah! Wow, it smells so bad!"
msgstr "Ha, ha, ha! Wow, ale śmierdzi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "It's upsettingly large."
msgstr "Niepokojąco wielki."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_MOON"
msgid "It's big and weird!"
msgstr "Duże i dziwne!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "Smells funny."
msgstr "Dziwnie pachnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "It's all round and squishy now!"
msgstr "Jest teraz okrągły i mięciutki!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Bigger than a normal mushroom."
msgstr "Większy od normalnego grzyba."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "Smells funny."
msgstr "Dziwnie pachnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "It sounds so funny!"
msgstr "Ale śmiesznie brzmi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "How did it get so big?"
msgstr "Jakim cudem urósł taki wielki?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "Smells funny."
msgstr "Dziwnie pachnie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "This one looks friendly!"
msgstr "Wygląda całkiem sympatycznie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDBEARGER"
msgid "It got scarier!"
msgstr "Stał się straszniejszy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDDEERCLOPS"
msgid "Aah! We're sorry!"
msgstr "Aa! Przepraszamy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "It's dead!"
msgstr "Nie żyje!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "Woah! How'd you get rid of your outside skin?"
msgstr "Ojej! Jak się pozbyłeś swojej skóry?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Night night, gross puppy."
msgstr "Dobranoc, brzydki piesku."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATEDWARG"
msgid "That's not a nice puppy!"
msgstr "To nie jest fajny szczeniaczek!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "It's dead!"
msgstr "Nie żyje!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "It's even more monstrous than us!"
msgstr "Bardziej potworny niż my!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "We don't want to get closer."
msgstr "Nie chcemy się zbliżać."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_DROPPER"
msgid "Who wants a cookie?"
msgstr "Kto chce ciastko?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_HEALER"
msgid "Doesn't it look tasty?"
msgstr "No czy nie wygląda apetycznie?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_HIDER"
msgid "We came up with the recipe all by ourselves!"
msgstr "Sami wymyśliliśmy ten przepis!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_MOON"
msgid "We made this cookie special!"
msgstr "To ciasteczko jest wyjątkowe!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_SPITTER"
msgid "We made it look just like our friend!"
msgstr "Wygląda jak nasz kolega!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_WARRIOR"
msgid "We just know they're going to love it!"
msgstr "Po prostu wiemy, że je pokochają!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MUTATOR_WATER"
msgid "This one turned out really good!"
msgstr "To wyszło naprawdę dobrze!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NATURE_BLUEPRINT"
msgid "Flowers are always nice."
msgstr "Kwiaty są zawsze fajne."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTCAPHAT"
msgid "Father used to wear a nightcap just like that."
msgstr "Tata zakładał taką szlafmycę na noc."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTLIGHT"
msgid "It makes our skin crawl."
msgstr "Aż nam ciarki przechodzą po plecach."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREFUEL"
msgid "It's cold and slippery."
msgstr "Jest zimne i ulotne."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREGROWTH"
msgid "Um... we don't think the ground was like that before."
msgstr "Ee... Wcześniej ziemia tak chyba nie wyglądała."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARELIGHT"
msgid "Not exactly my kind of nightlight."
msgstr "Nie mój typ latarni."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMAREPIE"
msgid "It's scary, but tasty."
msgstr "Straszne, ale smaczne."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Everything's dandy."
msgstr "Wszystko super."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Return to us, day!"
msgstr "Wróć do nas, kochany dniu!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "Not much magic here."
msgstr "Nie za wiele tu magii."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "Stable, for now."
msgstr "Na razie sytuacja jest stabilna."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Magic go down the hole."
msgstr "Magia odpuszcza."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "Something's brewing."
msgstr "Coś nadchodzi..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "It's getting magickier!"
msgstr "Robi się magiczniej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTSTICK"
msgid "Night light, night bright!"
msgstr "W nocy świeci, budzi dzieci."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NIGHTSWORD"
msgid "Are you seeing this too?"
msgstr "Też to widzisz?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NITRE"
msgid "What are we supposed to do with this?"
msgstr "I co mamy z tym niby zrobić?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NITRE_FORMATION"
msgid "It's a big stack of rock stuff!"
msgstr "To duży stos kamieni!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "It shows us how good the dirt is, and lots of other stuff too!"
msgstr "Dzięki temu zobaczymy, czy ziemia jest dobra. Dowiemy się też mnóstwa innych rzeczy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR"
msgid "More legs means faster rowing!"
msgstr "Im więcej masz kończyn, tym szybciej wiosłujesz!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR_DRIFTWOOD"
msgid "Rowing is kinda fun!"
msgstr "Wiosłowanie to fajna zabawa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OAR_MONKEY"
msgid "Please don't squash us!"
msgstr "Tylko nas nie zmiażdż!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OASISLAKE.EMPTY"
msgid "We can make mud pies!"
msgstr "Możemy zrobić błotne placki!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OASISLAKE.GENERIC"
msgid "That's a pretty lake!"
msgstr "Ale śliczne jezioro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Yuck, it's just a big chunk of mud!"
msgstr "Ble, gruda błota!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "It's a bobbin' bobber!"
msgstr "Pływający spławik!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "We turned a feather into a float!"
msgstr "Zrobiliśmy spławik z piórka!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "We turned a feather into a float!"
msgstr "Zrobiliśmy spławik z piórka!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "We made this float extra fancy."
msgstr "Zrobiliśmy superładny spławik."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "We made this float extra fancy."
msgstr "Zrobiliśmy superładny spławik."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "It's missing a bobber."
msgstr "Brakuje spławika."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "It's a bobbin' bobber!"
msgstr "Pływający spławik!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "We turned a feather into a float!"
msgstr "Zrobiliśmy spławik z piórka!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "We turned a feather into a float!"
msgstr "Zrobiliśmy spławik z piórka!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "It makes our head feel fuzzy... fuzzier than normal."
msgstr "Mąci nam się od tego w głowie... Bardziej niż zwykle."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "We're gonna catch the biggest fish with this!"
msgstr "Złapiemy na to największe rybki!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "Do fish know when it's raining?"
msgstr "Czy rybki wiedzą, że pada?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "Fishing in the snow might be fun!"
msgstr "Łowienie rybek w śniegu to będzie świetna zabawa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "Ouch! It's sharp!"
msgstr "Auć! Ostre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISHINGROD"
msgid "Wonder what kind of fish we'll catch!"
msgstr "Ciekawe, co się na to złapie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Eww, it'd covered in mud!"
msgstr "Fuj, jest umazana błotem!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "You'd be pretty tasty with some chips."
msgstr "Będziesz dobrze smakować z frytkami."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "Yikes, this one's all prickly!"
msgstr "Ajć, ta jest kolczasta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "This one was really tough to catch."
msgstr "Trudno ją było złapać."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Does this count as eating our vegetables?"
msgstr "To się liczy za warzywo?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "It looks like it has whiskers!"
msgstr "Wygląda, jakby miała wąsy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "It looks like it has whiskers!"
msgstr "Wygląda, jakby miała wąsy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It's a fishsicle!"
msgstr "Rybolód!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "Look, it has a little mustache!"
msgstr "Patrz, ma taki mały wąsik!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_1"
msgid "It's so little!"
msgstr "Ale maleństwo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_2"
msgid "Aww, just a little guy."
msgstr "Ojej, ale maluszek."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_3"
msgid "It's kind of cute. Too bad we're gonna eat it."
msgstr "Jest na swój sposób urocza. Szkoda, że ją zjemy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_4"
msgid "We know we can catch a bigger fish!"
msgstr "Wiemy, że możemy złapać coś większego!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Woah, this fish is weird!"
msgstr "Łał, ale dziwaczna!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_6"
msgid "What if we got a pile of these and jumped in it?"
msgstr "Co będzie, jak uzbieramy ich kupę i wskoczymy w nie?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Wendy got mad when we said it reminded us of her..."
msgstr "Wendy się zezłościła, jak powiedzieliśmy, że wygląda podobnie..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_8"
msgid "Ow! Owie! Hot!!"
msgstr "Auć! Aj! Gorące!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANFISH_SMALL_9"
msgid "Haha, it spits!"
msgstr "Ha, ha! Pluje!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREE"
msgid "The water made it all pruney!"
msgstr "Przez wodę jest całe pomarszczone!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREENUT"
msgid "It's almost as big as we are!"
msgstr "Jest prawie tak duży, jak my!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANTREE_PILLAR"
msgid "Now we have our own big tree!"
msgstr "Teraz mamy własne duże drzewo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE"
msgid "Maybe we could use that for a swing!"
msgstr "Może uda nam się pohuśtać!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON"
msgid "Oooh, can we come play in your tree house?"
msgstr "Ooo, możemy się pobawić w tym domku na drzewie?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "Oh no! Your tree house!"
msgstr "O, nie! Domek na drzewie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANWHIRLPORTAL"
msgid "We love spinny boat rides!"
msgstr "Uwielbiamy wirujące atrakcje!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Look at all those fish!"
msgstr "Ile ryb!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Awww, they got away..."
msgstr "Ooooch, uciekły..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "All fixed!"
msgstr "Wszystko naprawione!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "It's like a web for catching fish!"
msgstr "To jakby sieć do łapania ryb!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "We hope it catches lots of fish."
msgstr "Mamy nadzieję, że złapie dużo ryb."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "We can build it all by ourselves."
msgstr "Możemy zbudować go całkiem sami."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.GENERIC"
msgid "They need kelp!"
msgstr "Potrzebują wodorostów!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "That's a lot of kelp!"
msgstr "Ile wodorostów!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "We can get more!"
msgstr "Przyniesiemy więcej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "They need kelp!"
msgstr "Potrzebują wodorostów!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "That's a lot of kelp!"
msgstr "Ile wodorostów!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "We can get more!"
msgstr "Przyniesiemy więcej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONEMANBAND"
msgid "We need to practice more."
msgstr "Musimy jeszcze poćwiczyć."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION"
msgid "It makes all our eyes water!"
msgstr "Oczy nam się pocą!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_COOKED"
msgid "Our eyes don't water any more."
msgstr "Oczy już się nam nie pocą."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_OVERSIZED"
msgid "It's making all of our eyes tear up!"
msgstr "Aż nam się łza kręci we wszystkich oczach!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ONION_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "Najlepiej będzie, jak je posadzimy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OPALPRECIOUSGEM"
msgid "We see eight million eyes reflecting back at us. Neat!"
msgstr "Odbija się w nim osiem milionów oczu. Super!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OPALSTAFF"
msgid "Whew. Gotta be careful where you point it!"
msgstr "Uff. Trzeba uważać, gdzie się celuje!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ORANGEAMULET"
msgid "Many legs make light work, and so does this."
msgstr "Dużo kończyn uławia sprawę, podobnie jak to."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ORANGEGEM
