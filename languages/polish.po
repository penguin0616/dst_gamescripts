msgctxt "STRINGS.SKIN_DESCRIPTIONS.spicepack_survivor"
msgid "The preferred carryall of the vagabond chef."
msgstr "Wybór wędrownego kucharza."

#. STRINGS.SKIN_DESCRIPTIONS.stagehand_carpet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stagehand_carpet"
msgid "A \"table\" that would be a truly elegant addition to any unkempt wilderness base."
msgstr "Stolik, który ozdobi każdą zapuszczoną bazę."

#. STRINGS.SKIN_DESCRIPTIONS.stagehand_cawnival
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stagehand_cawnival"
msgid "A small, festive \"table\" that reminds you of feathered friends."
msgstr "Mały, odświętny stolik, który przypomina o pierzastych przyjaciołach."

#. STRINGS.SKIN_DESCRIPTIONS.stagehand_cawnival_alt
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stagehand_cawnival_alt"
msgid "A small, festive \"table\" that reminds you of feathered friends."
msgstr "Mały, odświętny stolik, który przypomina o pierzastych przyjaciołach."

#. STRINGS.SKIN_DESCRIPTIONS.stagehand_dragonfly
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stagehand_dragonfly"
msgid "An \"endtable\" inspired by the most opulent of bloodthirsty monsters."
msgstr "Niski stolik inspirowany najbardziej dostojną z krwiożerczych bestii."

#. STRINGS.SKIN_DESCRIPTIONS.stagehand_vintage
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stagehand_vintage"
msgid "A quaint decorative \"table\" that would make your grandmother proud."
msgstr "Szykowny stolik. Twój dziadek byłby z ciebie dumny."

#. STRINGS.SKIN_DESCRIPTIONS.starstaff_crystal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.starstaff_crystal"
msgid "A blindingly beautiful staff, filled with the magic of stars."
msgstr "Zniewalająco piękne berło przepełnione mocą gwiazd."

#. STRINGS.SKIN_DESCRIPTIONS.starstaff_portal
msgctxt "STRINGS.SKIN_DESCRIPTIONS.starstaff_portal"
msgid "Call on the power of otherworldly stars."
msgstr "Użyj mocy gwiazd nie z tego świata."

#. STRINGS.SKIN_DESCRIPTIONS.starstaff_relic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.starstaff_relic"
msgid "Wrap yourself in the warm glow of the stars."
msgstr "Daj się otulić ciepłemu blaskowi gwiazd."

#. STRINGS.SKIN_DESCRIPTIONS.steeringwheel_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.steeringwheel_nautical"
msgid "It never hurts to keep an extra eye out on the ocean."
msgstr "Pilna obserwacja oceanu jeszcze nikomu nie zaszkodziła."

