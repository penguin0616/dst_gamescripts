msgstr "Trwa regeneracja."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
