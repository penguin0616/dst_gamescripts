msgid "What fun is a battle without hand to hand combat?"
msgstr "Cóż za radość jest w walce na dystans?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT"
msgid "The young scout doth come into his own."
msgstr "Coś będzie z naszego młodego zwiadowcy."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT_BAND_MIMIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT_BAND_MIMIC"
msgid "The young scout doth come into his own."
msgstr "Coś będzie z naszego młodego zwiadowcy."

