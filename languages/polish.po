msgstr "To mi wygląda na wskazówki do zrobienia kostiumu dla wołka! Problem w tym, że to tylko część pierwsza..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_POST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_POST"
msgid "It's pretty hard to teach a beefalo \"sit\" and \"stay\"."
msgstr "Trudno nauczyć wołka komend „siad” i „zostań”."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_POST_ITEM"
msgid "This looks easy enough to put together."
msgstr "Zbudowanie tego chyba nie będzie trudne."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "My mom has one of those! It looks a bit different, though."
msgstr "Mama ma taką! Chociaż ta wygląda trochę inaczej."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
msgid "Now to put it together!"
msgstr "Czas to złożyć!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_STAGE"
msgid "Let's win some prizes, Woby!"
msgstr "Woba, chodźmy coś wygrać!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTB_STAGE_ITEM"
msgid "It can't be that much harder than pitching a tent."
msgstr "To nie może być trudniejsze od rozłożenia namiotu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "What a waste of supplies..."
msgstr "Co za marnotrawstwo..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "I think I need to offer it something for it to work."
msgstr "Chyba muszę coś złożyć w ofierze."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "What should we get, Woby?"
msgstr "Co robimy, Woba?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "Hey! I was going to use that!"
msgstr "Ej! Chciałem tego użyć!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "A good sense of direction is important for survival!"
msgstr "Zmysł orientacji jest niezbędny, by przeżyć w dziczy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "You'll never be a Pinetree Pioneer if you can't follow directions!"
msgstr "Orientuj się albo nie zostaniesz Sosnowym Pionierem!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I'd better start training my carrat."
msgstr "Lepiej zacznę treningi z moją myszomarchwią."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "I... reacted too slow... to put the fire out..."
msgstr "Za wolno... zareagowałem... żeby zgasić pożar..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "By the time we're done, my carrat will be ready for anything!"
msgstr "Jak skończymy, moja myszomarchew będzie gotowa na wszystko!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "These reflexes could save your life in the wilderness!"
msgstr "Refleks potrafi ocalić życie w dziczy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "Maybe I'll put it over here... no, over there!"
msgstr "Może tutaj to postawię... nie, jednak tam!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Does that look like a fire pit?!"
msgstr "Czy to wygląda na palenisko?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "I've never been a coach before!"
msgstr "Nigdy nie byłem niczyim trenerem!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Hustle, hustle! Coaches say that, right?"
msgstr "Tempo, tempo! Tak mówi trener, prawda?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "Do you think we should put it over there, Woby?"
msgstr "Woba, jak myślisz, postawimy to tam?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Oh no!!"
msgstr "O nie!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "This is very serious training equipment."
msgstr "To zaawansowany sprzęt treningowy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Aww look at him jump!"
msgstr "Och, popatrz tylko, jak skacze!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "I'm great at putting things together!"
msgstr "Świetnie radzę sobie ze składaniem rzeczy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "A good race needs some planning."
msgstr "Dobry wyścig wymaga trochę planowania."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "Should it go there... no, no, maybe over there..."
msgstr "Tam...? Nie, może jednak raczej tam..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "Someone sabotaged the race!"
msgstr "Ktoś sabotował ten wyścig!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "First one here wins!"
msgstr "Kto dotrze tu pierwszy, ten wygrywa!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "Yes!! Good job little guy!"
msgstr "Tak! Dobra robota, maluchu!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "We'll be back for a rematch, {winner}!"
msgstr "{winner}, wrócimy na dogrywkę!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "What if the race just went on forever?"
msgstr "A gdyby tak wyścig nie miał końca?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "Let's start this race!"
msgstr "Od czegoś trzeba zacząć ten wyścig!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Woby, help me look for a good place to set this up!"
msgstr "Woba, pomóż mi znaleźć na to dobre miejsce!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Why won't everyone just use the fire pit?!"
msgstr "Dlaczego nie możecie robić ogniska w jednym miejscu?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "He just needs some more training. We'll get there!"
msgstr "Po prostu potrzebuje więcej treningów. Jeszcze do tego dojdziemy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Woah, all our training paid off!"
msgstr "Juhuu, treningi się opłaciły!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "Do I get a badge for having the best carrat?"
msgstr "Dostanę odznakę za najlepszą myszomarchew?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "I never knew skills could be measured by weight."
msgstr "Nie miałem pojęcia, że zdolności można mierzyć wagą."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_SEEDPACKET"
msgid "Mystery seeds!"
msgstr "Tajemnicze nasiona!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Not knowing what they are is half the fun!"
msgstr "Niewiedza, co to jest, to połowa zabawy!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_ANCHOR"
msgid "That's gotta be the fanciest anchor I've ever seen."
msgstr "Nigdy nie widziałem takiej fikuśnej kotwicy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "I've got all the supplies ready to build an anchor."
msgstr "Mam wszystko, żeby zrobić kotwicę."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "I guess that's it then."
msgstr "To by było na tyle."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "I think it wants something burnt."
msgstr "Chyba chce czegoś spalonego."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "What should we make, Woby?"
msgstr "Co robimy, Woba?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_OAR"
msgid "A dragon boat needs a dragon paddle."
msgstr "Smocza łódź potrzebuje smoczego wiosła."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "I'll steer us straight to the finish line!"
msgstr "Skieruje nas wprost do mety!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "It's probably a good idea to add a steering wheel."
msgstr "To może być dobry pomysł, żeby dodać ster."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTP_FOOD1"
msgid "We'll have his head on a platter!"
msgstr "Mamy jego głowę na talerzu!"

