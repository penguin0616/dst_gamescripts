msgstr "Strasznie śliski typ."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHAT"
msgid "Oh how safe I do feel!"
msgstr "Och, czuję się taki bezpieczny!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHOLE"
