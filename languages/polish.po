msgstr "No dobra, uwaga... Co gdybym spróbowała to podpalić?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SALTSTACK.MINED_OUT"
