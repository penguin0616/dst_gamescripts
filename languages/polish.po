msgstr "Nuda!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GREEN_CAP_COOKED"
