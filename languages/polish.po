msgstr "Zdecydowanie za dużo kukurydzy dla kogokolwiek z odrobiną rozsądku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY"
