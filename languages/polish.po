msgstr "Walter bierze strzelanie z procy na poważnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPER"
msgid "Ah, to be so simple."
msgstr "Ach, żeby wszystko było takie proste."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPERPELT"
msgid "An empty bag of hunger."
msgstr "Pusty worek głodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURPER_PELT"
msgid "An empty bag of hunger."
msgstr "Pusty worek głodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLE"
msgid "It is mindlessly chasing after rocks."
msgstr "Bezmyślnie goni za kamieniami."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLEHAT"
msgid "It certainly didn't help the original owner."
msgstr "Poprzedniemu właścicielowi raczej nie pomogła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLEHOLE"
msgid "The slurtles pop out when they outgrow it."
msgstr "Szlamółw opuszcza go, gdy przestaje się mieścić."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLESLIME"
msgid "It shimmers with slimy anticipation."
msgstr "Aż lśni od ślimaczej niecierpliwości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Pieces of broken dreams."
msgstr "Odłamki rozbitych marzeń."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Hello there, little one."
msgstr "Dzień dobry, maleństwo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Are you empty inside?"
msgstr "Jesteś pusty w środku?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Dream of a better place."
msgstr "Śni o lepszym miejscu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLBIRD.STARVING"
msgid "A black hole from which seeds never return."
msgstr "Czarna dziura, z której żadne ziarno nie powróci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLGHOST"
msgid "Another life cut short."
msgstr "Kolejne przerwane życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLMEAT"
msgid "It smells like tiny fear."
msgstr "Pachnie jak maleńki strach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SMALLMEAT_DRIED"
msgid "Meat, turned dry and delicious."
msgstr "Mięso. Suche i pyszne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SNAPPER"
msgid "Death will be a blessing."
msgstr "Śmierć będzie tu błogosławieństwem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWBALL_ITEM"
msgid "I remember fun."
msgstr "Pamiętam dobrą zabawę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWMAN.GENERIC"
msgid "The cold keeps it."
msgstr "Chłód go konserwuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "It has potential."
msgstr "Ma potencjał."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SNURTLE"
msgid "That one has a larger shell."
msgstr "Ten ma większą skorupkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "We nourish the plants' soil with the decomposed husks of their ocean cousins."
msgstr "Nawozimy glebę, w której rosną rośliny, rozkładającymi się łupinami ich kuzynów z oceanu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "It has the stench of death... and yet it brings life."
msgstr "Cuchnie śmiercią... A jednak przynosi życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER.STALE"
msgid "It's decomposing nicely."
msgstr "Ładnie się rozkłada."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "It's finished now."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPAT"
msgid "I should put it out of its misery."
msgstr "Muszę skończyć jej cierpienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR"
msgid "They who wield it shall become the destroyer of worlds."
msgstr "Ten, kto zdoła wziąć ją w dłoń, zostanie niszczycielem światów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_GUNGNIR"
msgid "To cut and slash..."
msgstr "Do cięcia i kłucia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_LANCE"
msgid "Such a brutal weapon..."
msgstr "Co za brutalny oręż..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_WATHGRITHR"
msgid "It seems a tad dramatic."
msgstr "Strasznie dramatyczna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "Such terrible destructive power..."
msgstr "Niebywała moc destrukcji..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICEPACK"
msgid "To fend off the ravages of decay... for my food at least."
msgstr "Aby powstrzymać zgniliznę żywności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_CHILI"
msgid "Full of more vitality than I'm used to."
msgstr "Ma w sobie tyle życia, że aż mnie zaskakuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_GARLIC"
msgid "It's smell is good for keeping people at a distance."
msgstr "Ten zapach dobrze trzyma ludzi na dystans."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_SALT"
msgid "For rubbing into wounds."
msgstr "Do wcierania w rany."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPICE_SUGAR"
msgid "Not as sweet as Abigail."
msgstr "Nie tak słodki jak Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.DEAD"
msgid "We will meet again some day."
msgstr "Jeszcze się kiedyś spotkamy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.GENERIC"
msgid "A creature of the night!"
msgstr "Stworzenie ze świata mroku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER.SLEEPING"
msgid "Evil is sleeping."
msgstr "Zło śpi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERDEN"
msgid "A nest of filth and villainy."
msgstr "Gniazdo zła i obrzydliwości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "I wonder if I might ask to borrow some colored pencils..."
msgstr "Ciekawe, czy mogę pożyczyć kilka kolorowych kredek."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDEREGGSACK"
msgid "A tiny package full of death and destruction."
msgstr "Mała paczuszka śmierci i zniszczenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERGLAND"
msgid "Even in death, this beast causes pain."
msgstr "Nawet po śmierci potrafi zadać ból."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHAT"
msgid "Time to stare into the abyss."
msgstr "Czas spojrzeć w otchłań."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHOLE"
msgid "It is infested."
msgstr "Zainfekowany pajęczą zarazą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERHOLE_ROCK"
msgid "It is infested."
msgstr "Zainfekowany pajęczą zarazą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDERQUEEN"
msgid "She is regal in her horribleness."
msgstr "Bardzo królewska w swej okropności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_DROPPER"
msgid "The darkness has drained the color from their fur."
msgstr "Ciemność pozbawiła ich sierść koloru."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HEALER"
msgid "It's only prolonging the inevitable. How sad."
msgstr "Tylko opóźnia nieuniknione. Jakie to smutne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "Merely a temporary respite from the pain of the world."
msgstr "To tylko tymczasowa ulga od bólu tego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_HIDER"
msgid "A cowardly spider."
msgstr "Tchórzliwy pająk."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.DEAD"
msgid "It's the way of all things."
msgstr "Wszystko tak kiedyś skończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "Death on legs."
msgstr "Chodząca śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "It slumbers soundly."
msgstr "Drzemie równo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_REPELLENT"
msgid "Nothing I try seems to work well for me."
msgstr "Nic, co robię, się nie sprawdza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_SPITTER"
msgid "It's chewing on something."
msgstr "Coś przeżuwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Alas, brave warrior."
msgstr "Przykro mi, dzielny wojowniku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "A warrior of the night!"
msgstr "Wojownik nocy!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "I must beware."
msgstr "Muszę zachować ostrożność."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WATER"
msgid "Its legs look so thin and delicate, like they could snap at the slightest kick..."
msgstr "Jego nóżki wyglądają na tak cienkie i delikatne, jakby miały się złamać przy najmniejszym kopnięciu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPIDER_WHISTLE"
msgid "I don't think I want to play with that."
msgstr "Chyba nie chcę się tym bawić."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPOILED_FISH"
msgid "Farewell, chum."
msgstr "Żegnaj, kumplu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPOILED_FOOD"
msgid "Everything turns to waste, eventually."
msgstr "Wszystko kiedyś zamienia się w nicość."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Its life is short, but beautiful."
msgstr "Jego życie jest krótkie, ale piękne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "So many have perished. But this one is safe."
msgstr "Tyle zginęło. Ale ten jest bezpieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_MOON"
msgid "Pop goes the weaselly little thing."
msgstr "To małe paskudztwo wybucha."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "It has no concept of time, or loss."
msgstr "Nie rozumie pojęcia czasu. Ani straty."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_SMALL.HELD"
msgid "So many have perished. But this one is safe."
msgstr "Tyle zginęło. Ale ten jest bezpieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_TALL.GENERIC"
msgid "Be free, little one!"
msgstr "Bądź wolny, maleńki!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SPORE_TALL.HELD"
msgid "So many have perished. But this one is safe."
msgstr "Tyle zginęło. Ale ten jest bezpieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SQUID"
msgid "Bright eyes for dark times."
msgstr "Jasne spojrzenie na ciemne czasy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFFCOLDLIGHT"
msgid "Stars die like everything else..."
msgstr "Gwiazdy gasną, tak jak wszystko inne..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFFLIGHT"
msgid "I can almost make out a tiny solar system."
msgstr "Mogłabym stworzyć mały układ słoneczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFF_LUNARPLANT"
msgid "It will help me make sure no one gets too close."
msgstr "Dzięki temu nikt nie odważy się podejść za blisko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAFF_TORNADO"
msgid "Some weather out there."
msgstr "Taka pogoda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEHAND.AWAKE"
msgid "A creature of shadow that seeks the light... how sad..."
msgstr "Istota cienia poszukująca światła... przygnębiające.."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEHAND.HIDING"
msgid "My heart aches with its beauty."
msgstr "Jego piękno wywołuje u mnie ból serca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEUSHER.SITTING"
msgid "My heart aches with its beauty."
msgstr "Jego piękno wywołuje u mnie ból serca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STAGEUSHER.STANDING"
msgid "A creature of shadow that seeks the light... how sad..."
msgstr "Istota cienia poszukująca światła... przygnębiające.."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STALAGMITE"
msgid "The earth gives up its bounty."
msgstr "Ziemia dzieli się swym bogactwem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STALAGMITE_TALL"
msgid "The earth reaches up."
msgstr "Ziemia pnie się w górę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER"
msgid "Not even death is permanent."
msgstr "Nawet śmierć nie jest wieczna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER_ATRIUM"
msgid "Do you mourn, too?"
msgstr "Czy ty także rozpaczasz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STALKER_MINION"
msgid "Death would be a kindness."
msgstr "Śmierć byłaby aktem łaski."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STASH_MAP"
msgid "No map will lead me to what my heart seeks."
msgstr "Żadna mapa nie doprowadzi mnie do tego, czego szuka moje serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "Death has claimed it."
msgstr "Śmierć upomniała się o swoje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "What IS that?!"
msgstr "Co to ma niby być?!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEHARP"
msgid "Maybe these statues will keep me company."
msgstr "Może te posągi dotrzymają mi towarzystwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "Overgrown and abandoned."
msgstr "Zarośnięty i opuszczony."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUEMAXWELL"
msgid "Did it go as you planned?"
msgstr "Czy jest tak, jak planowałeś?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Cold, hard stone..."
msgstr "Zimny, twardy kamień..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Each of us wear many masks..."
msgstr "Każdy z nas nosi wiele masek..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "A chilling thought... what if nothing's beneath the mask?"
msgstr "Straszliwa myśl... A jeśli pod maską nic nie ma?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "It's a lovely vase."
msgstr "Uroczy wazon."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STEELWOOL"
msgid "This offers no hope of warmth."
msgstr "Żadnej nadziei na ciepło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STEERINGWHEEL"
msgid "Yet still I am directionless."
msgstr "A ja wciąż nie mam celu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "It would make a steering wheel..."
msgstr "Będzie z tego ster..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STINGER"
msgid "Sharp and deadly."
msgstr "Ostre i śmiercionośne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "Abigail?"
msgstr "Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "You might be sitting on Abigail."
msgstr "Nie siedzisz na Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_TABLE.GENERIC"
msgid "Abigail's favorite hiding spot."
msgstr "Ulubiona kryjówka Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "Abigail's favorite hiding spot."
msgstr "Ulubiona kryjówka Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "Can a machine truly die?"
msgstr "Czy maszyna może tak naprawdę umrzeć?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "It lacks a soul."
msgstr "Nie ma duszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STRAWHAT"
msgid "When the sun beats mercilessly, life finds a way. Ugh."
msgstr "Gdy słońce świeci bez litości, życie zawsze znajdzie sposób. Ohydne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STUFFEDEGGPLANT"
msgid "A nightshade. Probably not filled with poison."
msgstr "Bakłażan. Myślałam, że to taki nauczyciel..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.STUFFING"
msgid "Perhaps filling my belly will make me feel less empty inside."
msgstr "Może jak napełnię żołądek, będę czuła się mniej pusta w środku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_PICKED"
msgid "Plucked from the safety of its desert home."
msgstr "Wyrwany ze swego pustynnego domu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_PLANT"
msgid "Life is resilient."
msgstr "Życie bywa odporne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUCCULENT_POTTED"
msgid "This gilded cage is ceramic."
msgstr "Ta złota klatka jest w istocie ceramiczna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "No treasure could replace what I've lost."
msgstr "Żaden skarb nie zastąpi tego, co utraciłam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "Of course. It's locked."
msgstr "No tak. Zamknięte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPERTACKLECONTAINER"
msgid "I don't see what's so spectacular about it."
msgstr "Nie rozumiem, co w niej takiego niezwykłego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR"
msgid "The cracks have started to show..."
msgstr "Widać już pęknięcia…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "Nothing good can last..."
msgstr "Nic dobrego nie trwa wiecznie…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "It promises protection, but for how long?"
msgstr "Ma chronić, ale na jak długo?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "The cracks have started to show..."
msgstr "Widać już pęknięcia…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "Eventually, we all fall."
msgstr "Z czasem wszyscy upadniemy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "Dreadful, yet comforting."
msgstr "Czuję podnoszącą na duchu trwogę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "What hides beneath that shroud?"
msgstr "Co kryje się pod tym całunem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "What hides beneath that shroud?"
msgstr "Co kryje się pod tym całunem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SURFNTURF"
msgid "It could be worse."
msgstr "Mogło być znacznie gorzej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEATERVEST"
msgid "Pieces of dead things, made into a vest!"
msgstr "Skrawki martwych rzeczy zszyte w kamizelkę!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEETPOTATO"
msgid "Oh Abigail, remember how mother would make this every year?"
msgstr "O, Abigail, pamiętasz, jak mama robiła takie co roku?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SWEETTEA"
msgid "Would you care for a tea party, Abigail?"
msgstr "Napijesz się herbatki, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SWORD_LUNARPLANT"
msgid "A shining beacon of pain."
msgstr "Lśniąca latarnia bólu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "It seems the time for celebration is over."
msgstr "Zdaje się, że święta się skończyły."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "A table for gatherings."
msgstr "Stół na zjazd rodzinny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "I wish Abigail could enjoy some of that."
msgstr "Szkoda, że Abigail nie może tego spróbować."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "Like me, it doesn't belong here."
msgstr "Nie pasuje tutaj. Zupełnie jak ja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLECONTAINER"
msgid "At least I won't have to carry bait in my pockets anymore."
msgstr "Przynajmniej nie muszę już nosić przynęt w kieszeniach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLESKETCH"
msgid "New methods for ripping fish from their peaceful lives."
msgstr "Nowy sposób wyrywania ryb z ich spokojnej egzystencji."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TACKLESTATION"
msgid "All fish beware."
msgstr "Drżyjcie rybki małe ze wszystkich mórz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TAFFY"
msgid "Who knew such sweet things could exist here?"
msgstr "Któż spodziewałby się, że istnieją takie słodkości?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRD"
msgid "Free from the shackles of the sky."
msgstr "Uwolniony z oków nieba."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG"
msgid "So full of potential."
msgstr "Skrywa w sobie wielki potencjał."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "All that promise, snatched away. Not bad with bacon."
msgstr "Wszystkie nadzieje stłumione w zarodku. Nieźle smakowałoby z boczkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Chilled by the darkness."
msgstr "Schłodzone przez ciemność."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "A tiny, fragile being, struggling for the light."
msgstr "Małe, kruche życie zmierzające ku światłu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "It cannot bear the heat."
msgstr "Nie zniesie tego gorąca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "A life sooner begun is a life sooner ended."
msgstr "Życie wcześniej rozpoczęte wcześniej się skończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Soon now."
msgstr "Już wkrótce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "That egg represents a new life. Ugh."
msgstr "To jajo jest kolebką nowego życia. Ugh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "The nest is empty. Vacant. Barren. A void."
msgstr "Gniazdo jest puste. Opuszczone. Samotne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TALLEGGS"
msgid "A life snatched away... and wrapped in fried sausage."
msgstr "Skradzione życie... owinięte smażoną kiełbasą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TAMALES"
msgid "Little pockets of warmth in this cold world."
msgstr "Małe pakieciki ciepła w tym zimnym świecie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.GENERIC"
msgid "Will you leave too?"
msgstr "Czy ty też odejdziesz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.HUNGRY"
msgid "We all try to fill the void."
msgstr "Wszyscy staramy się zapełnić pustkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.SLEEPING"
msgid "Rest now."
msgstr "Spocznij teraz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TEENBIRD.STARVING"
msgid "Your true nature is revealed!"
msgstr "Wyszła na jaw twoja prawdziwa natura!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEBASE.GEMS"
msgid "The focus is so lifeless."
msgstr "Potrzeba skupienia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEBASE.VALID"
msgid "Energy flows through it."
msgstr "Przepływa przez niego strumień energii."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "I'm sure the next realm will be even more horrible!"
msgstr "Kolejna kraina będzie pewnie jeszcze straszniejsza!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "No good can come of this."
msgstr "Nic dobrego z tego nie wyjdzie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "It's still locked shut."
msgstr "Wciąż jest zamknięte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "Is it half built, or half destroyed?"
msgstr "Jest w połowie gotowe, czy w połowie zepsute?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_BOX"
msgid "It contains a vital spark."
msgstr "Skrywa w sobie iskrę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_CRANK"
msgid "It looks complicated."
msgstr "Wygląda bardzo skomplikowanie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_POTATO"
msgid "What a hideous creation!"
msgstr "Co za okropny twór!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELEPORTATO_RING"
msgid "It has no sharp edges."
msgstr "Nie ma żadnych ostrych krawędzi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TELESTAFF"
msgid "We could escape if it were more powerful."
msgstr "Gdyby mieć więcej mocy, można by stąd uciec."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENT.BURNT"
msgid "A preview of the fires of Hell."
msgstr "Zapowiedź ognia piekielnego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENT.GENERIC"
msgid "Sleep is but a preview of death."
msgstr "Sen jest zaledwie zapowiedzią śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE"
msgid "Long, thin and dangerous!"
msgstr "Długa, cienka i niebezpieczna!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLESPIKE"
msgid "Sharp, slimy and dangerous."
msgstr "Ostry, oślizgły i niebezpieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLESPOTS"
msgid "These are better left unmentioned."
msgstr "Lepiej o nich nawet nie wspominać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_GARDEN"
msgid "This one is different."
msgstr "Ta jest jakaś inna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR"
msgid "So this is what goes on down below."
msgstr "A więc takie rzeczy dzieją się pod ziemią."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Babies!"
msgstr "Dzieci!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "It shall return, some day."
msgstr "Jeszcze powróci. Kiedyś."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "All beauty fades with time."
msgstr "Z czasem wszelkie piękno przemija."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.CRIMSON"
msgid "The darkness of this world has corrupted it."
msgstr "Spaczył je mrok tego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.ENABLED"
msgid "Ah... so it has escaped."
msgstr "Ach... Więc uciekło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.GENERIC"
msgid "So much beauty contained inside, will it ever escape?"
msgstr "W środku jest tyle piękna. Czy kiedykolwiek ucieknie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "Let it be sealed away forever."
msgstr "Niech pozostanie zamknięte już na wieki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "Abigail, are you doing that?"
msgstr "Abigail, to ty?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "It didn't belong in this world."
msgstr "Nie pochodziła z tego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "What terrible things hide within?"
msgstr "Cóż za okropieństwa kryją się w środku?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "I feel its strange light drawing me in, like a moth to the flame."
msgstr "Czuję, że to dziwne światło mnie przyciąga jak ćmę do ognia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITE"
msgid "Its presence marks the edge of the unknown."
msgstr "Jego obecność wyznacza początek tego, co nieznane."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITEBUGNET"
msgid "The net comes for us all."
msgstr "Sieć czeka nas wszystkich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.THULECITE_PIECES"
msgid "Fragments of a powerful material."
msgstr "Odłamki potężnego surowca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.THURIBLE"
msgid "An ember that burns with the stuff of nightmares."
msgstr "Węgielek żarzący się ogniem koszmarów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.ABANDONED"
msgid "That's how it always ends. I'm alone."
msgstr "Zawsze tak się kończy. Zostaję sama."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.GENERIC"
msgid "He is the light I must follow."
msgstr "To światło, za którym muszę podążać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.LOST_TRACK"
msgid "We have lost our way."
msgstr "Zgubiliśmy się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.NEARBY"
msgid "So close, and yet, so far."
msgstr "Tak blisko, a jednak tak daleko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "Nothing left to find but dust."
msgstr "Nie ma już czego szukać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.SUCCESS"
msgid "No one can hide from their fate forever."
msgstr "Nikt nie może bez końca kryć się przed przeznaczeniem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "What we're looking for is well beyond our reach."
msgstr "To, czego szukamy, jest zdecydowanie poza naszym zasięgiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TRACKING"
msgid "May you find what you are looking for."
msgstr "Obyś znalazł to, czego szukasz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "He leads me to a treasure I cannot obtain."
msgstr "Prowadzi mnie do skarbu, którego nie mogę zdobyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TILLWEED"
msgid "A most stubborn weed."
msgstr "Niebywale uparty chwast."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TILLWEEDSALVE"
msgid "A balm to ease my suffering."
msgstr "Balsam na moją cierpiącą duszę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Just swallow us whole and end our misery."
msgstr "Po prostu połknij nas w całości i zakończ to cierpienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL.RAGE"
msgid "I think I'll be reunited with Abigail soon."
msgstr "Wkrótce znów spotkam Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Just like the one in my heart."
msgstr "Pusto, jak w moim sercu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Look how whimsical it is... We must kill it."
msgstr "Ale dziwny stwór... Trzeba go zabić."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Something has filled the void. In the ground, I mean."
msgstr "Coś wypełniło pustkę. Tę w ziemi, rzecz jasna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO"
msgid "Red as heart's blood."
msgstr "Czerwony niczym krew wprost z serca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_COOKED"
msgid "Its flesh is far more bloody now."
msgstr "Jego ciało jest teraz nawet bardziej krwawe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_OVERSIZED"
msgid "It looks like a giant heart. Shall I cut it open?"
msgstr "Wygląda jak gigantyczne serce. Czy mam wbić w nie nóż?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOMATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOPHAT"
msgid "A piece of finery to help forget the inescapable wild."
msgstr "Odrobina wyrafinowania, by zapomnieć o nieuniknionej dziczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOPHAT_MAGICIAN"
msgid "The darkness has changed it."
msgstr "Mrok go odmienił."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TORCH"
msgid "A tiny bulwark against the night."
msgstr "Niewielka tarcza przed siłami ciemności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOURTIERE"
msgid "I cannot be comforted by comfort food... but I will have some more..."
msgstr "Jedzenie mnie nie pocieszy... ale zjem jeszcze trochę..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "The way is clear."
msgstr "Droga wolna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "For when I don't want to be alone..."
msgstr "Czasem nie lubię być sama…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "Take me far from here."
msgstr "Zabierz mnie daleko stąd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "It came from the belly of the sphinx."
msgstr "Pochodzi z brzucha sfinksa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAILMIX"
msgid "A handful of sustenance."
msgstr "Garść wartości odżywczych."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAILS"
msgid "You shall fall."
msgstr "Zginiesz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRANSISTOR"
msgid "Electrical doo-what?"
msgstr "Bulbu co?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP"
msgid "Simple grass has become deadly."
msgstr "Zwykła trawa zamieniła się w narzędzie śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_BRAMBLE"
msgid "To prick and ensnare."
msgstr "Kłuje i zniewala."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "If only it had swallowed me whole."
msgstr "Szkoda, że nie połknął mnie w całości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "It's a starfish."
msgstr "To tylko rozgwiazda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_TEETH"
msgid "A devious surprise from underground."
msgstr "Nikczemna niespodzianka z podziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "Death when I least expect it."
msgstr "Śmierć. Tam gdzie najmniej się jej spodziewałam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.BURNT"
msgid "It couldn't even hold ashes."
msgstr "Nie utrzyma nawet popiołów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.GENERIC"
msgid "For which to contain my lucre."
msgstr "Tutaj schowam to, co dla mnie cenne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "It's still not big enough to hold all my regrets."
msgstr "Wciąż nie zmieszczę tu wszystkiego, czego żałuję."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST_TRAP"
msgid "Every once in awhile, things go my way."
msgstr "Od czasu do czasu pewne rzeczy dzieją się jednak po mojej myśli"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREECLUMP"
msgid "Was this placed intentionally?"
msgstr "Ktoś to tu postawił specjalnie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREEGROWTHSOLUTION"
msgid "I suppose even trees get hungry."
msgstr "Najwyraźniej nawet drzewa potrafią zgłodnieć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRIDENT"
msgid "It was stolen from the sea, but it still holds power over the waves."
msgstr "Wykradziony morzu, ale wciąż ma w sobie moc fal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_1"
msgid "Perfectly misshapen."
msgstr "Cudownie nieregularne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_10"
msgid "Another mouth to feed."
msgstr "Kolejna gęba do wykarmienia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_11"
msgid "I warned you, WX, never ingest bottles labeled \"Drink me.\""
msgstr "Ostrzegałam cię, WX. Nigdy nie sięgaj po butelki z napisem „Wypij mnie”."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_12"
msgid "Not so slimy any more, are we?"
msgstr "Już nie taka oślizgła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_13"
msgid "I'd carry this to the end of the world."
msgstr "Wezmę ją ze sobą na koniec świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_14"
msgid "I wish my life force would drain away like the tea."
msgstr "Gdyby moje życie przeciekło jak ta herbata..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_15"
msgid "Winning with only one piece is hopeless."
msgstr "Niezasadne jest wierzyć, iż można wygrać jednym tylko pionkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_16"
msgid "Winning with only one piece is hopeless."
msgstr "Niezasadne jest wierzyć, iż można wygrać jednym tylko pionkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_17"
msgid "Two utensils that are one. It reminds me of myself and Abigail."
msgstr "Dwa przybory w jednym. Trochę jak Abigail i ja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_18"
msgid "It conceals tragedy."
msgstr "Skrywa tragedię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_19"
msgid "The spinning inevitably ends, just like life."
msgstr "Nie może kręcić się wiecznie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_2"
msgid "Just a temptation, like death."
msgstr "To ledwie pokusa. Niczym śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_20"
msgid "My back doesn't need scratching."
msgstr "Moich pleców nie trzeba drapać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_21"
msgid "This tool has come to the end of its life."
msgstr "Życie tego narzędzia dobiegło końca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_22"
msgid "I'm not a-frayed."
msgstr "Nie ma co się plątać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_23"
msgid "I don't have a use for it."
msgstr "Nie przyda mi się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_24"
msgid "I've never been lucky."
msgstr "Dziewięć żyć to straszna klątwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_25"
msgid "It smells of decay and death."
msgstr "Cuchnie śmiercią i zgnilizną."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_26"
msgid "That potato is as hollow as I am."
msgstr "Ten ziemniak jest równie pusty jak ja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_27"
msgid "Now at least the wardrobe can be organized."
msgstr "Teraz przynajmniej można uporządkować nieco szafę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_28"
msgid "A horse! A horse! My castle for a horse!"
msgstr "Konia! Konia! Dam zamek za konia!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_29"
msgid "A horse! A horse! My castle for a horse!"
msgstr "Konia! Konia! Dam zamek za konia!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_3"
msgid "If only knives solved more of my problems..."
msgstr "Gdyby tylko nóż mógł rozwiązać więcej moich problemów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_30"
msgid "I'd rather have the castle..."
msgstr "Wolałabym jednak zamek..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_31"
msgid "I'd rather have the castle..."
msgstr "Wolałabym jednak zamek..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_32"
msgid "When I gaze into the ball I see... nothing. Apropos."
msgstr "Gdy patrzę w kulę, widzę... pustkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_33"
msgid "It's very fetching."
msgstr "Bardzo oryginalny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_34"
msgid "Perhaps a curse could end our suffering."
msgstr "Może klątwa skończyłaby nasze cierpienie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_35"
msgid "Neither half empty, nor half full."
msgstr "Ani w połowie pusta, ani w połowie pełna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_36"
msgid "Now Webber and I can match."
msgstr "Mogę poczuć się jak Webber."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_37"
msgid "Drive it through my heart and be done."
msgstr "Wbij mi go w serce i miejmy to z głowy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_38"
msgid "It makes the world look as insignificant as I feel."
msgstr "Sprawia, że świat zaczyna wyglądać na tak mały, jak ja się czuję."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_39"
msgid "One lonely half of a pair."
msgstr "Samotna połowa pary."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_4"
msgid "I'd carry this to the end of the world."
msgstr "Wezmę go ze sobą na koniec świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_40"
msgid "The weight of the world rests upon me."
msgstr "Na mych barkach spoczywa ciężar świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_41"
msgid "It looks like ectoplasm in there."
msgstr "Wygląda mi to na ektoplazmę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_42"
msgid "To frolic, to play, no more."
msgstr "Do zabawy, owszem, ale nic ponadto."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_43"
msgid "I have put childish things behind me."
msgstr "Muszę porzucić dziecinne błahostki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_44"
msgid "Some breaks cannot be mended."
msgstr "Pewnych uszkodzeń nie da się naprawić."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_45"
msgid "It is so colorful..."
msgstr "Jakież kolory..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_46"
msgid "I simply do not know what it is."
msgstr "Po prostu nie mam pojęcia, na co patrzę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_5"
msgid "I'll hold onto it... but only for a friend."
msgstr "Popilnuję tego. Ale tylko dla przyjaciela."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_6"
msgid "Once alive with electricity, they've met their end."
msgstr "Kiedyś żyło w nich napięcie, teraz spotkały swój koniec."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_7"
msgid "Just a simple game."
msgstr "Prosta gra."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_8"
msgid "I wish I could take a bath."
msgstr "Chciałabym się wykąpać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRINKET_9"
msgid "Mismatched buttons for a mismatched life."
msgstr "Badziewne guziki na badziewne życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "Nothing is safe."
msgstr "Nikt nie jest bezpieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "How sad."
msgstr "Jakie to smutne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "If my fish was as heavy as my heart, I'd surely win."
msgstr "Gdyby ta ryba była równie ciężka, co mój żal, z pewnością bym wygrała."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Waga: {weight}\nImię wędkarza: {owner}"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nNot even the strongest are guaranteed survival."
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nNawet najsilniejsi mogą nie przeżyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nOh... I... I did it..."
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nOch... Udało mi się..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nDo you miss your family, fishy?"
msgstr "Waga: {weight}\nImię wędkarza: {owner}\nTęsknisz za rodziną, rybko?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Nothing can ever last."
msgstr "Nic nie może wiecznie trwać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "Ashes to ashes."
msgstr "Wiedza poszła z dymem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "A fleeting distraction from our pitiable lives."
msgstr "Krótka odmiana w naszym godnym pożałowania życiu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nI suppose that's good."
msgstr "Waga: {weight}\nZebrano dnia: {day}\nTo chyba całkiem dobry wynik."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nI'd certainly be crushed under its weight."
msgstr "Waga: {weight}\nZebrano dnia: {day}\nTaka masa z pewnością by mnie zmiażdżyła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "I could weigh it against a feather."
msgstr "Można by to przeciwważyć piórem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNKVEST_SUMMER"
msgid "Skin to wear over your skin."
msgstr "Skóra do zarzucenia na skórę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNKVEST_WINTER"
msgid "It may warm the body, but what of the spirit?"
msgstr "Ogrzeje ciało, ale co z duszą?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_COOKED"
msgid "It looks even worse now."
msgstr "Teraz wygląda jeszcze gorzej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_SUMMER"
msgid "I would have preferred the ears."
msgstr "Wolałabym uszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TRUNK_WINTER"
msgid "Separated from its only friend."
msgstr "Oddzielona od swego jedynego przyjaciela."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TUMBLEWEED"
msgid "Alone, and rolling through life."
msgstr "Samotnie toczy się przez życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURFCRAFTINGSTATION"
msgid "We can change the very earth beneath our feet, but not the past."
msgstr "Możemy odmienić ziemię pod naszymi stopami, ale nie możemy zmienić przeszłości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_ARCHIVE"
msgid "Some ground."
msgstr "Kawałek ziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_BADLANDS"
msgid "Some ground."
msgstr "Kawałek ziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_BEARD_RUG"
msgid "How silly."
msgstr "Ale głupota."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_CARPETFLOOR
