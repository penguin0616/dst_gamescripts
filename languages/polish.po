msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.DEER"
msgid "Let's throw down!"
msgstr "Stawaj do boju!"

#. STRINGS.CHARACTERS.WINONA.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.GENERIC"
msgid "I'll demolish you!"
msgstr "Urządzę ci wyburzeniówkę!"

#. STRINGS.CHARACTERS.WINONA.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.PIG"
msgid "We're makin' bacon!"
msgstr "Robimy bekon!"

#. STRINGS.CHARACTERS.WINONA.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.PREY"
msgid "I'll demolish you!"
msgstr "Urządzę ci wyburzeniówkę!"

#. STRINGS.CHARACTERS.WINONA.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.SPIDER"
msgid "I hate spiders!"
msgstr "Nienawidzę pająków!"

#. STRINGS.CHARACTERS.WINONA.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.BATTLECRY.SPIDER_WARRIOR"
msgid "Let's dance!"
msgstr "Zatańczmy!"

#. STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.GENERIC"
msgid "I quit!"
msgstr "Poddaję się!"

#. STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.PIG"
msgid "I went easy on you!"
msgstr "Dałam ci fory."

#. STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.PREY"
msgid "...Demolition's rescheduled."
msgstr "Przekładamy wyburzenia na później."

#. STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.SPIDER"
msgid "This isn't over!"
msgstr "To jeszcze nie koniec!"

#. STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time!"
msgstr "Następnym razem!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL.LEVEL1.1"
