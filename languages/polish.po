msgstr "Podnosi prędkość poruszania się w formie gęsiołaka."

#. STRINGS.SKILLTREE.WOODIE.WOODIE_CURSE_GOOSE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_CURSE_GOOSE_1_TITLE"
msgid "The Weregoose I"
msgstr "Gęsiołak I"

#. STRINGS.SKILLTREE.WOODIE.WOODIE_CURSE_GOOSE_2_DESC
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_CURSE_GOOSE_2_DESC"
