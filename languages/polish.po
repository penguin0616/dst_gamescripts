msgstr "To grillowania małych posiłków."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_HOE"
msgid "It's a farming instrument."
msgstr "Artefakt rolniczy."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_KEY"
