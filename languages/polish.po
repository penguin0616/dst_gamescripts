msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXHUNGER"
msgid "WX, you gotta stop leavin' this stuff lying around!"
msgstr "WX, musisz przestać rozrzucać tak swoje rzeczy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXHUNGER1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXHUNGER1"
msgid "WX, you gotta stop leavin' this stuff lying around!"
msgstr "WX, musisz przestać rozrzucać tak swoje rzeczy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXSANITY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXSANITY"
msgid "WX, you gotta stop leavin' this stuff lying around!"
msgstr "WX, musisz przestać rozrzucać tak swoje rzeczy!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXSANITY1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_MAXSANITY1"
msgid "WX, you gotta stop leavin' this stuff lying around!"
