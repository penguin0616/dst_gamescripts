msgstr "Zawsze dobrze wiedzieć, co trafia do twojego jedzenia."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "The miracle of life!"
msgstr "Cud życia!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "That is it, just a little more..."
msgstr "Właśnie tak, jeszcze tylko odrobinka..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.READY"
msgid "Fresh-picked produce!"
msgstr "Świeżo zbierane!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Oh dear me, the crop has failed..."
msgstr "Oj! Nie udała się hodowla..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "I wonder who will play the lead?"
msgstr "Ciekawe, kto zagra główną rolę."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Seems a little dark, no?"
msgstr "Dość mrocznie, co?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.ATTACKER"
msgid "Let's all calm down with a nice bowl of soup."
msgstr "Ostudźmy emocje nad miską smacznej zupy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.FIRESTARTER"
msgid "I don't want to nitpick how you light fires, but..."
msgstr "Nie chcę krytykować twojego sposobu rozpalania ognia, ale..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.GENERIC"
msgid "Bonjour, %s!"
msgstr "Bonjour, %s!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.GHOST"
msgid "Oh my. Does that hurt?"
msgstr "Ojej. Boli cię?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.MURDERER"
