msgstr "Nie martw się, Woba i ja znajdziemy do niej jakąś rozpałkę."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I'll have it set up in a jiffy!"
msgstr "Daj mi sekundę, a wszystko poskładam!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "It's nice to have a little extra firelight!"
msgstr "Fajnie jest mieć dodatkowe źródło światła!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "Don't worry, Woby and I will find some kindling for it."
msgstr "Nie martw się, Woba i ja znajdziemy do niej jakąś rozpałkę."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I'll have it set up in a jiffy!"
msgstr "Daj mi sekundę, a wszystko poskładam!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "All fighting should be done with pillows."
msgstr "Wojny powinno toczyć się na poduszki."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "It's okay, everyone is wearing their safety gear!"
msgstr "Wszystko będzie dobrze, każdy zakłada ochraniacze!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "I'll have it set up in a jiffy!"
msgstr "Daj mi sekundę, a wszystko poskładam!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FOOD1"
msgid "Time for a dessert break!"
msgstr "Czas na podwieczorek!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.YOTR_FOOD2"
