msgstr "Chroń się przed potworami i zadziw je artystycznym przepychem murów."

#. STRINGS.SKIN_DESCRIPTIONS.wall_stone_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wall_stone_ancient"
