msgstr "Jest w nim coś zniewalającego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET"
msgid "Not my size, sadly."
msgstr "Niestety jest dla mnie za mała."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN"
msgid "I could have sworn I left you all underground."
msgstr "Mogłabym przysiąc, że zostawiłem was wszystkich pod ziemią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC"
msgid "Say, pal, why don't we try to work this out?"
msgstr "Może uda nam się to jakoś załatwić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT"
msgid "I suppose we can't just leave well enough alone, can we?"
msgstr "Nie możemy tego po prostu zostawić w spokoju?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Watch it where you shoot those things!"
msgstr "Patrzcie, gdzie tym strzelacie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW"
msgid "Best to avoid that."
msgstr "Lepiej tego unikać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL"
msgid "Always something in the way."
msgstr "Zawsze musi być jakaś przeszkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB"
msgid "I'd kill for a crab cake."
msgstr "Zabiłbym za ciastko z krabem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Middle management."
msgstr "Kierownik średniego szczebla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB"
msgid "Am I being watched by that rock?"
msgstr "Czy ten kamień mnie obserwuje?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING"
msgid "Just like old times."
msgstr "Jak za dawnych czasów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Tell me, what is it you see, little one?"
msgstr "Powiedz, co widzisz, maluchu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING"
msgid "You are much too trusting, friend."
msgstr "Jesteś zadecydowanie zbyt ufny, przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN"
msgid "A wholly agreeable animal."
msgstr "Bardzo przyjemny zwierzak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB"
msgid "Quit nibbling my coattails."
msgstr "Przestań obgryzać mi płaszcz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "You had better not chew holes in my suit."
msgstr "Lepiej, żebyś mi nie wygryzła dziur w garniturze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING"
msgid "You're as fowl as I am!"
msgstr "Jesteś całkiem przyjemny jak na drób!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY"
msgid "You're a slobbery little chap, aren't you?"
msgstr "Jesteś małym śliniaczem, prawda?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC"
msgid "I don't know how they got here."
msgstr "Nie wiem, jak się tu dostały."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD"
msgid "Shhhh... My pretty."
msgstr "Cichaj... Mój śliczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS"
msgid "It's falling apart."
msgstr "Rozpada się na kawałki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Disgusting!"
msgstr "Obrzydliwe!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS"
msgid "The mundane stuff of the earth."
msgstr "Przyziemne sprawy przyrody."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS"
msgid "Very funny."
msgstr "Bardzo śmieszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN"
msgid "Dry, crumbly, sustaining."
msgstr "Suchy, łamliwy, ale krzepiący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS"
msgid "I think I could build something useful from this."
msgstr "Chyba mógłbym zrobić z tego coś przydatnego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE"
msgid "The building blocks of civilization."
msgstr "To na nich zbudowano cywilizację."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC"
msgid "Say pal, why don't we talk this out?"
msgstr "Słuchaj, może uda nam się jakoś dogadać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "You went nosing around places you shouldn't have, didn't you?"
msgstr "Węszyłeś w miejscach, w których nie powinieneś, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED"
msgid "He seems fine to me."
msgstr "Jak dla mnie nic mu nie jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Someone needs a bath."
msgstr "Ktoś powinien się umyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "What's his problem?"
msgstr "Z czym on ma problem?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "That stone would be useful, if only it could be broken."
msgstr "Gdyby tylko dało się ten kamień rozbić, mógłby się przydać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "I can just make out something dark within."
msgstr "W środku widać coś mrocznego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST"
msgid "It smells... noxious."
msgstr "Pachnie... niebezpiecznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES"
msgid "Adapt or perish."
msgstr "Przystosuj się lub giń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Bathed in fire."
msgstr "Skąpane w ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "That's not about to grow back."
msgstr "Raczej nie odrośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "An acquaintance of mine describes them as \"leafy\"."
msgstr "Pewien mój znajomy zwykłe nazywać je jako „liściakami”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Shut your maw!"
msgstr "Zamknij paszczę!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECK_OF_CARDS"
msgid "If only I stuck with these."
msgstr "Gdybym tylko nie przestał się tym zajmować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE"
msgid "Bland."
msgstr "Mdłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Puste naczynie czekające na dekorację lub światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Tymczasowy odpoczynek od mroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Purely decorative."
msgstr "Ma walory czysto dekoracyjne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Teraz kolej Wilsona, żeby zdobyć żarówki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Każdy kwiat, nawet najpiękniejszy, kiedyś więdnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP"
msgid "Who's afraid of the dark?"
msgstr "Kto boi się ciemności?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Uninspired."
msgstr "Bez polotu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "If only life were that simple."
msgstr "Gdyby tylko życie było takie proste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "My my, aren't we special."
msgstr "Proszę, proszę. Co za dzieło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER"
msgid "What a staggering sight!"
msgstr "Cóż za imponujący widok!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC"
msgid "Well it's certainly not deer to me."
msgstr "Ale z ciebie jeleń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS"
msgid "Even I'm afraid of that guy."
msgstr "Nawet ja boję się tego typa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It's best to be rid of it."
msgstr "Lepiej się go pozbyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Disgusting."
msgstr "Obrzydliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "The wretch is being puppeteered!"
msgstr "Ktoś pociąga za sznurki tego nędznika!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "Keeps it cold like my heart."
msgstr "Sprawia, że jest tu zimno jak w moim sercu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Don't say I didn't warn you when it all goes up in flames."
msgstr "Ostrzegałem. Nie wiń mnie, jak wszystko stanie w płomieniach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Do I have to do everything around here?"
msgstr "Sam muszę wszystko robić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Deerclops are so myopic."
msgstr "Jeleklopy są strasznie krótkowzroczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER"
msgid "Filthy."
msgstr "Obrzydliwy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED"
msgid "The gem imbues its attacks with a fearsome power."
msgstr "Klejnot przepełnia jego ataki straszliwą siłą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "That's not doing anyone any good."
msgstr "Nic dobrego już z tego nie będzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT"
msgid "Function over form."
msgstr "Funkcjonalność ponad formą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE"
msgid "That looks out-of-place."
msgstr "Tego chyba nie powinno tu być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD"
msgid "Mostly just background noise."
msgstr "Same zakłócenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC"
msgid "I can use this to find my missing parts."
msgstr "Mogę z jej pomocą znaleźć brakujące części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT"
msgid "It must be right under my nose!"
msgstr "Musi być gdzieś blisko!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM"
msgid "This is the right direction."
msgstr "Dobry kierunek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER"
msgid "I should keep my eyes peeled."
msgstr "Muszę mieć oczy szeroko otwarte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It's the starting mechanism."
msgstr "Mechanizm startowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY"
msgid "I need to insert the divining rod."
msgstr "Muszę włożyć tu różdżkę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Progress!"
msgstr "Mamy postęp!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART"
msgid "The portals lead to the next rod."
msgstr "Portale prowadzą do kolejnej różdżki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT"
msgid "So I'm to be a dock builder now, am I?"
msgstr "Czyli teraz mam budować doki, tak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Do I look like a common laborer to you?"
msgstr "Czy ja wyglądam na pospolitego robotnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT"
msgid "I can only imagine how grotesque this will look..."
msgstr "Mogę tylko sobie wyobrazić, jak groteskowo by to wyglądało..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT"
msgid "I'm not the roll-up-your-sleeves type. Ask the handywoman."
msgstr "Nie jestem typem do zakasywania rękawów. Zwróć się do tej kobiety złotej rączki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK"
msgid "Here I am, toiling away for a frivolous diversion."
msgstr "Cały ja – ciężka praca dla frywolnej rozrywki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT"
msgid "I'm no middleman."
msgstr "Nie lubię stać pośrodku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD"
msgid "I'll permit him to stay so long as he keeps cooking."
msgstr "Pozwolę mu zostać, dopóki będzie gotował."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY"
msgid "A fiery fly."
msgstr "Ognista mucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Those scales sure are nifty."
msgstr "Te łuski są naprawdę szykowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Spacious and stylish."
msgstr "Dużo miejsca i świetny styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Such a spiffy design!"
msgstr "Doskonałe wzornictwo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "How undignified."
msgstr "Toż to niegodne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The red gems are producing a sweltering heat."
msgstr "Czerwone klejnoty dają mnóstwo ciepła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "With only one gem it is only moderately scorching."
msgstr "Z jednym klejnotem pali się umiarkowanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT"
msgid "Exotic and delicious."
msgstr "Egzotyczny i przepyszny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Utterly enormous."
msgstr "Ogromny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT"
msgid "Quite formidable looking."
msgstr "Wygląda onieśmielająco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE"
msgid "Simply exquisite."
msgstr "Po prostu wyborne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT"
msgid "The back end of a terrible beast."
msgstr "Tyłek niegdyś straszliwej bestii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES"
msgid "Fiery."
msgstr "Ognista sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE"
msgid "Petrified nightmares."
msgstr "Skamieniałe koszmary."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT"
msgid "Darkness is never far from my mind."
msgstr "Mrok zawsze jest blisko mego umysłu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK"
msgid "It comes from the depths below."
msgstr "Pochodzi z otchłani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oh good. More wood."
msgstr "Znakomicie. Więcej drewna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "It seems to be burning."
msgstr "Zdaje się, że płonie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It's in utter ruin."
msgstr "Zostały po nim tylko resztki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "We've chopped it up already."
msgstr "Już jest porąbane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "It appears to be a piece of drifted wood."
msgstr "Wygląda na kawałek drewna unoszącego się na wodzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK"
msgid "It tastes strangely like berries."
msgstr "Smakuje trochę porzeczkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED"
msgid "Still tastes like berries."
msgstr "Wciąż smakuje porzeczkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "Banany, które nie rosną w jaskiniach? Co za niedorzeczność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I could find a much better place for it."
msgstr "Można by znaleźć mu lepsze miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH"
msgid "Do I look like a gardener?"
msgstr "Wyglądam na ogrodnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL"
msgid "I still don't trust it."
msgstr "Nadal jej nie ufam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING"
msgid "I can't believe I'm reduced to this."
msgstr "Nie wierzę, że to robię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH"
msgid "What would be the most devilish place to put it?"
msgstr "Gdzie najlepiej to umieścić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL"
msgid "I have no interest in such things."
msgstr "Nie interesują mnie takie rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Dokładnie taka dawka subtelności i gracji, jakiej mógłbym spodziewać się po siłaczu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM"
msgid "It's not that impressive."
msgstr "Niezbyt imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's not that impressive."
msgstr "Niezbyt imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT"
msgid "You won't catch me lugging it around."
msgstr "Ja tego taszczył nie będę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE"
msgid "It's not that impressive."
msgstr "Niezbyt imponujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Dokładnie taka dawka subtelności i gracji, jakiej mógłbym spodziewać się po siłaczu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN"
msgid "It's an acquired taste."
msgstr "Do takich rzeczy trzeba przywyknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED"
msgid "Far more than I'd like to have, quite honestly."
msgstr "Szczerze mówiąc, wolałbym go mieć zdecydowanie mniej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE"
msgid "I'll pass."
msgstr "Podziękuję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH"
msgid "Hmph. Just stay away from my suit, pal."
msgstr "Phi, tylko nie pobrudź mi garnituru, kolego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN"
msgid "So this is the source of the Thulecite... I must say, I'm underwhelmed."
msgstr "A więc to jest źródłem tulecytu... Jestem zawiedziony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT"
msgid "They are at least warm."
msgstr "Przynajmniej są ciepłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL"
msgid "It slithers all the way down."
msgstr "Ślisko ślizga się ciałem obślizgłym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED"
msgid "Still rather grotesque."
msgstr "Wciąż zgoła groteskowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT"
msgid "Just another boring plant."
msgstr "Kolejna nudna roślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "An absurdly large eggplant."
msgstr "Co za nieprawdopodobnie wielki bakłażan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER"
msgid "Don't think I'm fooled by its innocent appearance."
msgstr "Ten niewinny wygląd mnie bynajmniej nie zmyli."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT"
msgid "Neat trick."
msgstr "Niezła sztuczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT"
msgid "That was uncalled for."
msgstr "To nie było potrzebne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Puste naczynie czekające na dekorację lub światło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Tymczasowy odpoczynek od mroku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC"
msgid "Purely decorative."
msgstr "Ma walory czysto dekoracyjne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Teraz kolej Wilsona, żeby zdobyć żarówki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Każdy kwiat, nawet najpiękniejszy, kiedyś więdnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT"
msgid "Bathed in fire."
msgstr "Skąpane w ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED"
msgid "That's not about to grow back."
msgstr "Raczej nie odrośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC"
msgid "An acquaintance of mine describes them as \"piney\"."
msgstr "Pewien mój znajomy zwykłe nazywać je jako „iglakami”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Dust to dust."
msgstr "Z prochu powstałeś i w proch się obrócisz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "I put it out of its misery."
msgstr "Skróciłem jego męki na tym świecie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Nie wygląda zdrowo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT"
msgid "Eye to the sky."
msgstr "Zwróć oko ku niebu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT"
msgid "How deliciously macabre."
msgstr "Wspaniale makabryczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR"
msgid "Don't look at me, it's definitely not one of mine."
msgstr "Nie patrz na mnie, to na pewno nie moje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI"
msgid "We're going to be up to our eyeballs in... eyeballs."
msgstr "Będziemy w oczach po same... oczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I should dispose of it before it hatches."
msgstr "Powinienem się tego pozbyć, zanim się wykluje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT"
msgid "The Meat Bulb's pawns."
msgstr "Sługa mięśniaka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET"
msgid "Some of my better work."
msgstr "Jedno z moich lepszych dzieł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM"
msgid "Now it just needs to be set up."
msgstr "Teraz trzeba ją tylko rozstawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT"
msgid "A harvest of ashes."
msgstr "Ognisty plon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC"
msgid "Do I look like a farmer?"
msgstr "Wyglądam na rolnika?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING"
msgid "I have better things to do than watch plants grow."
msgstr "Mam lepsze rzeczy do roboty niż patrzenie, jak rosną rośliny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs to be... refreshed."
msgstr "Trzeba je trochę... odświeżyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE"
msgid "Am I to be reduced to a common farmhand?"
msgstr "Mam się zniżyć do poziomu jakiegoś zwykłego parobka?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING"
msgid "Not the garden!"
msgstr "Tylko nie ogród!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL"
msgid "It's time to reap what I've sown."
msgstr "Czas zebrać to, co zasiałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "At last, my efforts are rewarded."
msgstr "Moje wysiłki nareszcie się opłaciły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Not another blasted weed!"
msgstr "Tylko nie kolejny sakramencki chwast!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Merely a plant."
msgstr "Roślina, nic niezwykłego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING"
msgid "Nearly there."
msgstr "Już prawie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Rotten."
msgstr "Zgniło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "It's no good to anyone now."
msgstr "Nikomu się już nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED"
msgid "I'll have to be patient."
msgstr "Muszę uzbroić się w cierpliwość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW"
msgid "Thankfully it seems capable of doing the work itself."
msgstr "Na szczęście chyba da sobie radę samo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM"
msgid "Some kind of farming implement? I've no interest in such things."
msgstr "To jakiś przyrząd rolniczy? Nie interesują mnie takie rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "The blasted things spring up again just as fast as I can remove them."
msgstr "Ledwo co je usunę, a te cholerstwa znowu się pojawiają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN"
msgid "Is it windy out or is it just this fan?"
msgstr "Tak bardzo wieje, czy to tylko przez ten wiatrak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT"
msgid "I always considered myself the peacock of people."
msgstr "Zawsze widziałem się jako pawia pośród mego ludu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL"
msgid "Not as elegant as a quill and inkwell, but it'll do."
msgstr "Nie tak elegancki jak pióro i atrament, ale może być."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY"
msgid "Yellow is the color of naivety."
msgstr "Żółty to kolor naiwności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW"
msgid "Black is the color of sleep."
msgstr "Czerń to kolor snu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN"
msgid "Red is the color of fire."
msgstr "Czerwony to kolor ognia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Grey is the color of pain."
msgstr "Szary to kolor cierpienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET"
msgid "Better her than me."
msgstr "Lepiej ona niż ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE"
msgid "My life is one obstacle after another."
msgstr "Moje życie jest pełne przeszkód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE"
msgid "When one gate closes..."
msgstr "Gdy jedna brama się zamyka..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM"
msgid "A gate for your pocket."
msgstr "Kieszonkowa furtka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM"
msgid "A fence for your pocket."
msgstr "Kieszonkowy płot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK"
msgid "Hmph. It'll certainly repel anyone with taste."
msgstr "Pff. Z pewnością odstraszy każdego z gustem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR"
msgid "What insidious magic. It draws power from eye rolls and groans."
msgstr "Co za podstępna magia. Czerpie moc z przewracania oczami i wzdychania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER"
msgid "It's not gentlemanly to carry manure in one's hands."
msgstr "Noszenie w rękach łajna nie przystoi dżentelmenom."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH"
msgid "I don't know what's so festive about it."
msgstr "Nie rozumiem, co w niej takiego świątecznego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Positively garish."
msgstr "Bardzo jaskrawe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG"
msgid "A fruit for more refined tastes."
msgstr "Owoc dla mających bardziej wyszukany smak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI"
msgid "Exquisite."
msgstr "Wyborne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB"
msgid "Pleasantly sweet."
msgstr "Przyjemnie słodkie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED"
msgid "Quite decadent."
msgstr "Cóż za dekadencja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF"
msgid "A staff after my own heart!"
msgstr "To to ja rozumiem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS"
msgid "Great for magic tricks."
msgstr "Doskonałe do magicznych sztuczek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC"
msgid "How pretty."
msgstr "Przepiękne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD"
msgid "I could squish them if I wanted to."
msgstr "Mógłbym je rozgnieść, gdybym tylko chciał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND"
msgid "I put fire gems in there as a joke."
msgstr "Dodałem do nich ogniste klejnoty, tak dla żartu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES"
msgid "Blasted nettles!"
msgstr "Sakramenckie pokrzywy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN"
msgid "Words hold power. Pens too, apparently."
msgstr "Słowa mają moc. Pióra najwyraźniej też."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS"
msgid "I should attend to that."
msgstr "Powinienem się nim zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Palenisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH"
msgid "A roaring fire."
msgstr "Szalejący ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Zaczyna przygasać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL"
msgid "It's hot."
msgstr "Gorące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT"
msgid "It's gone cold."
msgstr "Zgasło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF"
msgid "A basic enchantment, but effective."
msgstr "Podstawowe zaklęcie, ale bardzo skuteczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Not much fuel left."
msgstr "Zostało mało paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet before the storm."
msgstr "Cisza przed burzą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Begone, fire!"
msgstr "Przepadnij, ogniu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH"
msgid "Fresh from the murky depths."
msgstr "Prosto z mokrych otchłani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET"
msgid "Not my preferred way to ensnare enemies."
msgstr "Nie jest to mój ulubiony sposób chwytania wrogów w sidła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD"
msgid "I will eat for a lifetime."
msgstr "Najem się po wsze czasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT"
msgid "Ugh, it's still twitching."
msgstr "Uch, wciąż się rusza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED"
msgid "Bland... but acceptable."
msgstr "Mdłe... ale do zaakceptowania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL"
msgid "I'm reduced to scavenging scraps."
msgstr "Zostalem zmuszony do grzebania w resztkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "That was barely an appetizer."
msgstr "To była ledwie przystawka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS"
msgid "These should tide me over."
msgstr "Niewyrafinowane, ale bardzo przyzwoite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS"
msgid "Cooked fish in a crunchy shell."
msgstr "Smaczna rybka w chrupiącym kocyku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX"
msgid "Ugh, the smell... the things I do for a decent meal."
msgstr "Uch, ten smród... Czego się jednak nie robi dla porządnego posiłku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED"
msgid "It still stinks."
msgstr "Wciąż śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT"
msgid "Ow! I cut my finger!"
msgstr "Auć! Zaciąłem się w palec!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOTATIONCUSHION"
msgid "Where does it say, \"women and children first\"?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC"
msgid "I am filled with the irrational urge to stomp upon it."
msgstr "Czuję niewytłumaczalną potrzebę zadeptania go na śmierć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE"
msgid "This is wrong."
msgstr "To nie w porządku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT"
msgid "Definitely not my style."
msgstr "Zdecydowanie nie moje klimaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD"
msgid "Leafy goodness."
msgstr "Liściaste błogosławieństwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE"
msgid "It's so dark down here."
msgstr "Ależ tu ciemno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL"
msgid "I like that flower."
msgstr "Podoba mi się ten kwiat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED"
msgid "It got what it deserved."
msgstr "Zasłużył sobie na to."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE"
msgid "A meal fit for a peasant."
msgstr "Posiłek dla prostaków."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT"
msgid "Ready for the scrimmage."
msgstr "Gotów do szarpaniny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS"
msgid "Nothing but a common weed."
msgstr "Zwykły chwast."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT"
msgid "These garments are absolutely wasted on such base creatures."
msgstr "Co za marnotrawstwo ubierać tak proste stworzenia w takie stroje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE"
msgid "Perhaps it is best left in pieces."
msgstr "Może lepiej zostawić w kawałkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Was it wise to unleash this upon the world?"
msgstr "Rozsądnym było wypuszczenie go na świat?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "It will be the laughingstock of the demon community."
msgstr "Będzie pośmiewiskiem w demoniej społeczności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "The beginnings of some demonic beast."
msgstr "Początek jakiejś demonicznej bestii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES"
msgid "Deserves to be eaten with fine silverware. Sadly, I've just my hands."
msgstr "Zasługują na to, żeby zjeść je sztućcami. Niestety mam tylko ręce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY"
msgid "As long as it tends to the garden I'll leave it be."
msgstr "Póki będzie się zajmować ogrodem, zostawię to stworzenie w spokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Już jej nie do śmiechu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC"
msgid "It jumps and licks things."
msgstr "Skacze i liże wszystko dokoła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING"
msgid "It looks tired."
msgstr "Wygląda na zmęczoną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL"
msgid "At the end of the day, it's still frog."
msgstr "Ostatecznie żaba pozostała żabą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH"
msgid "Has a bit of a kick to it."
msgstr "Potrafi dać niezłego kopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS"
msgid "Muscular."
msgstr "Nieźle umięśnione."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED"
msgid "Stringy."
msgstr "Trochę żylaste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON"
msgid "This recipe has legs."
msgstr "Ten przepis ma nogi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "There are better beverages to make."
msgstr "Są lepsze napoje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They aren't very sociable."
msgstr "Nie są zbyt towarzyskie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I bet it's delicious."
msgstr "Założę się, że jest przepyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Sen to tylko chwilowa ucieczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY"
msgid "Begone, pest!"
msgstr "Precz, szkodniku!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT"
msgid "So this is all it takes to lead."
msgstr "A więc tak mogę nimi kierować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
msgid "This would be great with a simple cheese plate."
msgstr "Świetnie pasowałyby do deski serów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT"
msgid "Not quite enough for a rug."
msgstr "Na chodnik nie starczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING"
msgid "They grow up so fast."
msgstr "Tak szybko dorastają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "That is one persistent tail."
msgstr "Cóż za uparty ogon."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND"
msgid "Try and get me now. Ha!"
msgstr "Spróbuj mnie teraz dorwać. Ha!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Not so tough."
msgstr "Jednak nie taki z ciebie twardziel!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Zakładam, że to dlatego nie ma tu żadnych wampirów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Ciekawe, czy nadal ma moc odpędzania umarłych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED"
msgid "An unreasonably enormous clump of garlic."
msgstr "Ogromny czosnek – to niedorzeczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "Mam to posadzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO"
msgid "It smells much nicer going in than coming back out."
msgstr "Pachnie lepiej, jak wchodzi do układu pokarmowego, niż jak go opuszcza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS"
msgid "My pets! What has become of you?"
msgstr "Moi drodzy! Cóż się z wami stało?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC"
msgid "Blegh."
msgstr "Ble."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "This one is occupied."
msgstr "Tutaj jest zajęte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Don't expect me to reach in there."
msgstr "Nie zamierzam tam sięgać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE"
msgid "Wilson can take it on a picnic."
msgstr "Wilson może sobie to zabrać na piknik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Somebody taste it first!"
msgstr "Najpierw niech skosztuje ktoś inny!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "I don't trust that infernal jelly."
msgstr "Nie ufam tej piekielnej galaretce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Pass. I don't do sticky."
msgstr "Spasuję. Nie jestem fanem lepkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS"
msgid "The fuel needs a focus."
msgstr "Paliwo potrzebuje skupienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.VALID"
msgid "This one's ready."
msgstr "Gotowe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT"
msgid "It communes with us through them."
msgstr "Porozumiewa się z nami przez nie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "Not so tough now, are you?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Ugh. Empty."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD"
msgid "I think it would be best to keep my distance."
msgstr "Lepiej zachowam odpowiednią odległość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "Oh, bygones be bygones and such."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOST"
msgid "It remembers me!"
msgstr "Pamięta mnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWER"
msgid "I hope they found peace."
msgstr "Mam nadzieję, że spoczywa w pokoju."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTFLOWERHAT"
msgid "Talk about a near death experience."
msgstr "To się nazywa bliskie spotkanie ze śmiercią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "It appears someone has been toying with the dark arts and crafts."
msgstr "Ktoś tu się bawił czarną magią."

