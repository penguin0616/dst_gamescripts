msgstr "Czy ten automat spiknął się z jednym z moich narzędzi?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_SCANNER.GENERIC"
msgid "Please buzz around elsewhere, you're distracting me!"
msgstr "Weź bzycz gdzieś indziej, bo mnie rozpraszasz!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WX78_SCANNER.HUNTING"
