#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.GENERIC"
msgid "Can't get a reading."
msgstr "Nie mam żadnych odczytów."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "Północ!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "Północny wschód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "Północny zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "Południe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "Południowy wschód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "Południowy zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPASS.W"
msgid "West..."
msgstr "Zachód!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOST"
msgid "Nah, I'm good."
msgstr "Nie, dziękuję."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "I guess it looks okay? For a pile of rotten dirt?"
msgstr "Chyba dobrze wygląda, nie? Jak na stertę zgniłej ziemi?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Nice."
msgstr "Ekstra."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Is it supposed to be that dry?"
msgstr "Czy to powinno być takie suche?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Ew, why do we have this?"
msgstr "Fuj, po co nam to?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's all wet and gross."
msgstr "Wilgotne i obleśne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COMPOSTWRAP"
msgid "That's disgusting!"
msgstr "Obrzydliwe!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'd rather burn things down than build them up."
msgstr "Wolę palić niż budować."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKBOOK"
msgid "Uuugh, it's no fun cooking with instructions!"
msgstr "Meh, gotowanie według instrukcji to żadna zabawa!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMANDRAKE"
msgid "The fire didn't get rid of its face. Gives me the willies."
msgstr "Ogień nie pozbył się tej twarzy. Trochę to straszne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMEAT"
msgid "Unseasoned meat... great."
msgstr "Niedoprawione mięso... super."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still gross."
msgstr "Wciąż jest ohydne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKEDSMALLMEAT"
msgid "Gonna need a lot of appetizers to survive out here!"
msgstr "Będę potrzebowała dużo przekąsek, aby tutaj przetrwać!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COOKIECUTTER"
