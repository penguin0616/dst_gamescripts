msgstr "Taaak!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
