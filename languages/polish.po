#. STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack"
msgid "Just the thing to bar pesky urchins from your manor."
msgstr "Świetnie odgrodzi twój dwór od tych natrętnych łobuzów."

