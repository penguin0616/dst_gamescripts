msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
