msgstr "Oberżyna!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_COOKED"
msgid "Could use tomato sauce and Parmesan..."
msgstr "Przydałoby się trochę sosu pomidorowego i parmezanu..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EGGPLANT_OVERSIZED"
