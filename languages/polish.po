msgstr "Można swobodnie założyć, że się przyda."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "I'll park it in my pocket until I get to the park."
msgstr "Zachowam go, aż dotrę do parku."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Huh. Reminds me of home."
msgstr "Ha. Przypomina mi o domu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Enlightening."
msgstr "Olśniewająca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_MEALINGSTONE"
