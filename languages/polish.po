msgstr "Smykałka do roli"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_MAX_UPGRADE_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_MAX_UPGRADE_DESC"
