msgstr "Tworzenie krzaków porzeczek"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_FARMRANGE1_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_FARMRANGE1_DESC"
