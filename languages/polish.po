#. STRINGS.SKILLTREE.WOODIE.WOODIE_ALLEGIANCE_LOCK_1_DESC
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_ALLEGIANCE_LOCK_1_DESC"
