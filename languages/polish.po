msgstr "Kawałek ziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_COTL_BRICK"
msgid "Cold stone beneath my feet."
msgstr "Zimny kamień pod stopami."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_COTL_GOLD"
msgid "If I follow the yellow bricks, will they take me home?"
msgstr "Czy dotrę do domu, jeśli pójdę żółtą drogą?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_DECIDUOUS"
