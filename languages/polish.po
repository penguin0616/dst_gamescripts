msgstr "Dziwne!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
