#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "Bonjour, mademoiselle Abigail!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "Bonjour, mademoiselle Abigail!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "Bonjour, mademoiselle Abigail!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "I don't think it's edible."
msgstr "To chyba nie jest jadalne."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "What now, Mademoiselle Wendy?"
msgstr "I co teraz, mademoiselle Wendy?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think it's my place to be holding this."
msgstr "Chyba nie ja powinienem to trzymać."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Something's stirring inside."
msgstr "Coś tam się rusza."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "Bonjour? Anyone there?"
msgstr "Bonjour? Jest tam kto?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Ah, you are looking quite well today little flower!"
msgstr "Ach, wyglądasz dziś bardzo ładnie, kwiatuszku!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "Something's stirring inside."
msgstr "Coś tam się rusza."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "I think it's waking up."
msgstr "Chyba się budzi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "I get the feeling something will happen soon."
msgstr "Mam wrażenie, że wkrótce coś się wydarzy."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I always wished to make a name for myself."
msgstr "Zawsze chciałem zasłynąć czymś w świecie."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN"
msgid "It rattles."
msgstr "Grzechocze."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_COOKED"
msgid "This could use something... Anything."
msgstr "Przydałoby się... cokolwiek."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ACORN_SAPLING"
msgid "Just a petite bébé."
msgstr "To tylko petit bébé."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ADVENTURE_PORTAL"
msgid "What fresh devilment is this?"
msgstr "Cóż to za diabelska sztuczka?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHAT"
msgid "It makes me hear such sweet whispers..."
msgstr "Dzięki temu słyszę cudowny szept..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It's been broken down to its basic ingredients."
msgstr "Rozłożona na podstawowe składniki."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's gobbling up all the energy!"
msgstr "Wysysa całą energię!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Au revoir."
msgstr "Au revoir."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "It looks rather irritated..."
msgstr "Chyba się zdenerwował..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "New and improved! C'est terrible!"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "It is the most brilliant one I have ever seen!"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "At last, it's finished. Or is it..."
msgstr "Nareszcie koniec. A może..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Mon dieu, a second course!"
msgstr "Mon dieu, drugie danie!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "I will not be skewered by the likes of you!"
msgstr "Nie dam się pokroić takim jak ty!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "I'd rather not be fried by that fiery gaze!"
msgstr "Wolałbym, żeby ten ognisty wzrok mnie nie usmażył!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Finalement, it's over."
msgstr "Finalement, już po wszystkim."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Is there more yet in store for us?"
msgstr "Czeka nas coś jeszcze?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Best to keep far away from those, non?"
msgstr "Lepiej trzymać się od nich z daleka, non?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "C'est horrible!"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.AMULET"
msgid "I wear safety."
msgstr "Bezpieczeństwo przede wszystkim."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR"
msgid "Now you stay put!"
msgstr "Zostań na miejscu!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCHOR_ITEM"
msgid "Looks like a recipe for an anchor."
msgstr "Wygląda jak przepis na kotwicę."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I wonder if it's possible to cook such a stony fruit?"
msgstr "Ciekawe, czy taki kamienny owoc da się ugotować."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "I think... I may have lost my appetite."
msgstr "Chyba… straciłem apetyt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "Better, but now it's missing that certain je ne sais quoi."
msgstr "Wygląda lepiej, ale stracił swoje je ne sais quoi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
