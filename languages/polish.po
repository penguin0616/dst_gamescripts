msgstr "Przebieraniec"

#. STRINGS.SKIN_NAMES.abigail_flower_nature
msgctxt "STRINGS.SKIN_NAMES.abigail_flower_nature"
msgid "The Verdant"
msgstr "Zielony"

#. STRINGS.SKIN_NAMES.abigail_flower_rose
msgctxt "STRINGS.SKIN_NAMES.abigail_flower_rose"
msgid "The Roseate"
msgstr "Różana"

#. STRINGS.SKIN_NAMES.abigail_flower_shadow
msgctxt "STRINGS.SKIN_NAMES.abigail_flower_shadow"
