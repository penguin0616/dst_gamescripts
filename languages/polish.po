msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COLD"
msgid "My heart grows cold."
msgstr "Zimno przeszywa me serce."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COMPASS_OUT"
msgid "The compass has fallen to pieces."
msgstr "Kompas rozpadł się na kawałki."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_COZY_SLEEP"
msgid "That was a marginally more restful sleep than usual."
msgstr "Jestem tylko odrobinę bardziej wyspany niż zazwyczaj."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_CRAFTING_FAIL"
msgid "Er... I can't do that."
msgstr "Eee... Nie mogę tego zrobić."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DAMP"
msgid "Damp is not dapper."
msgstr "Wilgoć nie jest elegancka."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DEERCLOPS"
msgid "I hear one of them coming."
msgstr "Nadchodzi jeden z nich."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DESPAWN"
msgid "Say, pal, I don't look so good..."
msgstr "Hej, kolego, coś słabo wyglądasz..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength has left me."
msgstr "Siły mnie opuściły."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Shame. I was starting to enjoy that."
msgstr "Szkoda. Zaczynało mi się podobać."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "I'm exposed to the elements!"
msgstr "Jestem narażony na działanie sił natury!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I've been left vulnerable!"
msgstr "Stałem się bezbronny!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm growing tired."
msgstr "Zaczynam odczuwać znużenie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "My enthusiasm for this has run dry."
msgstr "Zapał mnie opuścił."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "That takes care of that."
msgstr "Oj, niedobrze."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_DUSK"
msgid "It'll be dark soon. Charlie will be waking up."
msgstr "Zaraz się ściemni i Charlie się obudzi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.GENERIC"
msgid "(Gulp!)"
msgstr "**przełyka**"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.INVALID"
msgid "I won't let that anywhere near my mouth."
msgstr "Nie zbliżę tego do ust."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.PAINFUL"
msgid "Ow! That hurt my mouth!"
msgstr "Auć! To bolało!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.SPOILED"
msgid "That was putrid."
msgstr "To było paskudne."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.STALE"
msgid "That was past its expiration date."
msgstr "Data przydatności minęła już dawno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EAT.YUCKY"
msgid "A civilized man does not eat such things."
msgstr "Cywilizowani ludzie nie jedzą takich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I suppose it's only right to share this with the others."
msgstr "Chyba wypada podzielić się tym z innymi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_BOOSTED"
msgid "That hit the spot."
msgstr "I to rozumiem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "I'd rather sleep like the dead."
msgstr "Wolę spać jak zabity."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "Respect my brawn!"
msgstr "Ależ mam krzepę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "That's too stiff a drink."
msgstr "Za mocny trunek."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.1"
msgid "Reduced... to this..."
msgstr "Tak... nisko... upadłem?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.2"
msgid "Huff... huff..."
msgstr "Uff... uff..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.3"
msgid "This is... peasant... work..."
msgstr "Robota... dla... tragarza..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.4"
msgid "Oh... my back..."
msgstr "Au... Moje plecy..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.5"
msgid "I wasn't... built for this..."
msgstr "Nie zostałem... stworzony... do takich rzeczy..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.6"
msgid "All my joints... are cracking!"
msgstr "Moje stawy... zaraz pękną..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7"
msgid "I... was a king, you know..!"
msgstr "Byłem kiedyś.... królem...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8"
msgid "Oof... huff..."
msgstr "Uff... puff..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9"
msgid "This... better not ruin... my suit."
msgstr "Oby... nie zniszczył mi się... garnitur od tego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK"
msgid "That smell... both nostalgic and terrifying!"
msgstr "Ten zapach... Nostalgiczny i upiorny zarazem!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT"
msgid "Thank goodness for the light."
msgstr "Dzięki niebiosom za światło."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1"
msgid "What's this? My shadow puppets feel just a bit stronger..."
msgstr "Co to ma być? Moje cieniste marionetki czują się nieco silniejsze..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2"
msgid "I can feel the strength of my shadow puppets growing."
msgstr "Czuję, że siła moich cienistych marionetek rośnie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3"
msgid "Go, my shadow puppets! With this power, nothing will stand in our way."
msgstr "Śmiało, cieniste marionetki! Dzięki tej mocy nic nie stanie wam na drodze."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4"
msgid "The shadow puppets I summon will be unstoppable!"
msgstr "Cieniste marionetki, które wzywam, będą nie do zatrzymania!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB"
msgid "Gaah! The horror!"
msgstr "Aaach! O zgrozo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Oh, what a magnificent horror."
msgstr "Cóż za wspaniały potwór."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It'll be back."
msgstr "Wróci."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "I've been awaiting your return. Let's end this."
msgstr "Czekałem na twój powrót. Zakończmy to."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT"
msgid "There goes my respite."
msgstr "Nie będzie mi dane odetchnąć."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I'm growing more knowledgeable than I'd care to be about this stuff."
msgstr "Zaczynam o tym wiedzieć więcej, niż bym chciał."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Ack, those infernal nettles!"
msgstr "Aj, co za diabelska pokrzywa!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "The nettle's poison is burning in my veins!"
msgstr "Trucizna tej pokrzywy pali moje żyły!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "The worst has passed."
msgstr "Najgorsze za mną."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN"
msgid "Am I supposed to come running every time I spot a flare?"
msgstr "Czy mam przybiegać za każdym razem, jak zobaczę flarę?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_HELD"
msgid "There are unspeakable horrors below."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLOATER_LETGO"
msgid "Why did I do that?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "Wolność! Nareszcie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "Ich szepty wbiają się w samo serce mego umysłu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I'd better not take a stroll in the acid rain anytime soon."
msgstr "W najbliższym czasie spacer w kwaśnym deszczu może nie być najlepszym pomysłem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "Mój mózg aż puchnie od mocy!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "Moje serce nie zniesie tego gorąca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Ogary robią się niespokojne."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "W brzuchu mi gra."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I'll stick to hunting less dangerous game."
msgstr "Zadowolę się mniej niebezpieczną zwierzyną."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Czuję łajno i pot bestii."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "A niech to! Uciekł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "Nie mogę tropić w tych warunkach!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK"
msgid "Those vicious claw marks do not bode well..."
msgstr "Te ślady po pazurach nie rokują najlepiej…"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature is unaware it's being pursued. Now, to strike."
msgstr "Zwierzyna nie wie, że ją tropię. Czas na atak."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I fear I might have underestimated my prey..."
msgstr "Obawiam się, że mogłem nie docenić swojej ofiary…"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Odrobinkę się ruszyło."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Mam już pełne kieszenie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING"
msgid "At last, a decent meal."
msgstr "Nareszcie jakiś porządny posiłek."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "So you're the source of that pathetic mewling. I'll have to apologize to the strongman."
msgstr "Więc to ty jesteś źródłem tego żałosnego kwilenia. Muszę przeprosić siłacza."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A-ha! Not sneaky enough!"
msgstr "Aha! Aż tak dobrze się nie chowasz!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "Mam cię!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were not clever enough to best the great Maxwell!!"
msgstr "Brakowało ci sprytu, by pokonać wielkiego Maxwella!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Your attempt to escape me has been thwarted, child!"
msgstr "Udaremniłem twą próbę ucieczki, maluchu!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "A-ha! That was the last one! I win!!!"
msgstr "Aha! To już ostatni! Wygrałem!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I had seen it already, but {name} got to it first, I suppose."
msgstr "Widziałem go, ale nie byłem tak szybki jak {name}."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Only one remains."
msgstr "Został tylko jeden."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Blast it!"
msgstr "Niech to szlag!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Where are those blasted kittens!"
msgstr "Gdzie te przeklęte kotki?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I doubt those tiny, pathetic legs would carry them this far."
msgstr "Wątpię, by doszły tak daleko na tych malutkich, żałosnych nóżkach."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "This seems much more likely an area to find the kitcoons."
msgstr "Tutaj z pewnością mam większą szansę, by znaleźć kicioszopy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Of course you need my help."
msgstr "Potrzebujecie mojej pomocy, bez dwóch zdań."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "I suppose we shall begin this ridiculous game."
msgstr "Chyba czas zacząć tę niedorzeczną zabawę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "The coward has summoned its minions."
msgstr "Tchórz przywołał swoich sługusów..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to beat a hasty retreat!"
msgstr "Czas wykonać taktyczny odwrót!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its true power has been unlocked!"
msgstr "Oto ujrzymy jego prawdziwą siłę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh. My head hurts."
msgstr "Ugh. Głowa mi wysiada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Can't touch this!"
msgstr "Nic z tego!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Niewiele się z tego dowiedziałem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Again? What now?"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Something has changed..."
msgstr "Coś się zmieniło…"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That flare's going to send some poor fool into a world of trouble."
msgstr "Ta flara przysporzy wielu kłopotów jakiemuś biednemu głupcowi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1"
msgid "I've just had the most unpleasant feeling..."
msgstr "Właśnie poczułem coś bardzo nieprzyjemnego..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "A monkey? Have I not suffered enough humiliation already?!"
msgstr "Małpa? Czy nie dość już mnie poniżono?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Nobody. Bring this up. Again."
msgstr "Niech. Nikt. O tym. Nie wspomina. Nigdy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "I must have your knowledge."
msgstr "Muszę posiąść twoją wiedzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I hear you in there."
msgstr "Słyszę cię."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "A-ha!"
msgstr "Aha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED"
msgid "How disappointing."
msgstr "Rozczarowałem się."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS"
msgid "What annoying little bugs."
msgstr "Co za małe wredne robale."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Say, pal, you don't look so good."
msgstr "Coś kapkę słabo wyglądasz."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT"
msgid "That's a terrible idea right now."
msgstr "To absolutnie fatalny pomysł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA"
msgid "They're hot on my heels!"
msgstr "Depczą mi po piętach!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP"
msgid "Not while there's danger afoot!"
msgstr "Nie teraz! Niebezpieczeństwo czyha!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep during daylight hours."
msgstr "Nie mogę spać w dzień."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Sleeping now would mess up my sleep schedule!"
msgstr "Jak się teraz prześpię, rozreguluje mi się cały zegar biologiczny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA"
msgid "Traditionally, a siesta comes after eating, not before."
msgstr "Z reguły sjestę się robi po jedzeniu, nie przed."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry. I can't sleep."
msgstr "Nie mogę spać. Jestem zbyt głodny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'm not opening that on top of this thing."
msgstr "Tutaj tego nie otworzę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA"
msgid "It's sleep time, not siesta time."
msgstr "Czas na sen, nie na drzemkę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "It's a bit creepy out for that."
msgstr "Trochę tu zbyt straszno na takie rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "That's what I get for engaging in foolery."
msgstr "Tak się dzieje, jak się bierze udział w błazenadzie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Oh for... would you turn that blasted light off?!"
msgstr "A niech to… Czy możesz z łaski swojej wyłączyć to przeklęte światło?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE"
msgid "That might not be the best idea."
msgstr "To chyba nie jest najlepszy pomysł."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE"
msgid "You're kidding right?"
msgstr "To jest żart, tak?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP"
msgid "Odd. They forgot to set it."
msgstr "Dziwne. Zapomnieli ją zastawić."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "That was, of course, just a warm up..."
msgstr "To oczywiście była tylko rozgrzewka..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "We will meet again, mark my words..."
msgstr "Jeszcze kiedyś się spotkamy, wspomnisz moje słowa..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I must exercise patience."
msgstr "Muszę ćwiczyć cierpliwość."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I daresay, this is almost relaxing."
msgstr "Prawie czuję się zrelaksowany."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Why won't they take the bait? Perhaps I should offer secret knowledge..."
msgstr "Dlaczego nie chcą połknąć tej przynęty? Może powinienem im zaoferować tajemną wiedzę..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I am beginning to tire of all this waiting."
msgstr "Zaczyna nużyć mnie to czekanie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Blast! That cad-fish got away with my tackle!"
msgstr "Szlag! Ta ryba uciekła z moim osprzętem!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line needs more tension."
msgstr "Żyłka musi być bardziej napięta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "We're in for some trouble."
msgstr "Nadciągają kłopoty."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT"
msgid "She won't like that."
msgstr "Nie spodoba jej się to."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Those accursed creatures! The den was all that held this platform together!"
msgstr "Przeklęte stwory! Tylko ta nora spajała platformę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Ah. So it's not seaworthy after all."
msgstr "Ach. Jednak wcale nie nadaje się do zwodowania."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED"
msgid "Have patience!"
msgstr "Uspokój się!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES"
msgid "Oh, this should be good."
msgstr "Ciekawie się zapowiada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "How putrid!"
msgstr "Co za paskudztwo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE"
msgid "I don't like the sound of that..."
msgstr "Nie podoba mi się ten dźwięk..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED"
msgid "It had better grow into something worthwhile."
msgstr "Oby z tego wyrosło coś pożytecznego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "This plant's secrets are revealing themselves to me."
msgstr "Odkrywam tajemnice tej rośliny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Oh ha-ha, laugh it up. I wouldn't have landed on my rump if the witch knew how to navigate!"
msgstr "Bardzo śmieszne. Nie wylądowałbym na zadku, gdyby ta wiedźma wiedziała, co robi!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID"
msgid "That's not good."
msgstr "Niedobrze."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE"
msgid "That rumbling can't be good."
msgstr "Ten hałas nie wróży niczego dobrego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Typical rabbit. Never there when you need them."
msgstr "Typowy królik. Zawsze znika, gdy jest potrzebny."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "A frenzy of activity underfoot."
msgstr "Pod ziemią dzieje się jakieś szaleństwo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY"
msgid "Simon, you rapscallion!"
msgstr "Szymon, ty łotrze!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "I've got you now, Simon!"
msgstr "Mam cię, Szymonie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Some crawling creature beneath us, no doubt."
msgstr "Pod nami pełza jakieś stworzenie, to pewne."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "Cóż to za sztuczki?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH"
msgid "Knowledge is power. And power is... well, power."
msgstr "Wiedza to potęga. A potęga to... cóż, potęga."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "That was simply undignified."
msgstr "Doświadczenie, bez którego byłbym kontent."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "No need to thank me."
msgstr "Ależ nie ma potrzeby mi dziękować."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE"
msgid "Allow me to assist."
msgstr "Pozwól, że pomogę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.1"
msgid "Someone thinks highly of themselves."
msgstr "Ktoś zadziera nosa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.2"
msgid "Your \"Majesty\"."
msgstr "Wasza „Wysokość”."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY.3"
msgid "Your \"Royal Highness\""
msgstr "Wasza „Królewska Mość”."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.1"
msgid "It's a perfect fit."
msgstr "Pasuje idealnie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your \"Majesty\"."
msgstr "Wasza „Wysokość”."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Your \"Royal Highness\""
msgstr "Wasza „Królewska Mość”."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET"
msgid "The cycle begins again."
msgstr "Cykl rozpoczyna się na nowo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO"
msgid "It's deemed me unworthy."
msgstr "Kufer rzecze, iż nie jestem godzien."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES"
msgid "Was there ever a doubt?"
msgstr "Czy kiedykolwiek były jakieś wątpliwości?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I know all I need to already."
msgstr "Wiem już wszystko, o czym wiedzieć muszę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM"
msgid "\nMy shadow puppets should be able to draw from its power..."
msgstr "\nMoje cieniste marionetki powinny móc czerpać z tej mocy..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Who bit me? Show yourself, coward!"
msgstr "Kto mnie ugryzł? Pokaż się, tchórzliwa małpo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Something's stirring..."
msgstr "Coś się święci…"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER"
msgid "Protect me, cursed tree!"
msgstr "Strzeż mnie, przeklęte drzewo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED"
msgid "How dare you!"
msgstr "Jak śmiesz?!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY"
msgid "Wretched greenery! Release me at once!"
msgstr "Parszywe chwasty! Zostawcie mnie! Natychmiast!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's no snow here."
msgstr "Nie ma tu śniegu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "Useless! It won't get any bigger."
msgstr "Bez sensu! Nie da się tego powiększyć."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED"
msgid "Wetter than water itself."
msgstr "Jestem bardziej mokry niż woda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED"
msgid "Quite an expert illusion."
msgstr "Ekspercka iluzja."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "I feel ridiculous. Is this really supposed to help it grow?"
msgstr "Bez sensu. To naprawdę pomoże tej roślinie rosnąć?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Grow faster, you blasted thing! There, did that help?"
msgstr "Rośnij szybciej, ty cholerny chwaście! I jak? Pomogło?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "You know, I ruled over this entire world once. Now I'm talking to a plant."
msgstr "Kiedyś rządziłem całym światem, a teraz rozmawiam z rośliną."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Say pal, do you like magic tricks? This is the one where I talk and you grow."
msgstr "Słuchaj, lubisz sztuczki? Ta polega na tym, że ja mówię, a ty rośniesz."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Here I am, chatting it up with the vegetation."
msgstr "No i proszę, gadam z warzywami."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS"
msgid "I scratched my arms up doing that."
msgstr "Podrapałem się."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT"
msgid "A shame."
msgstr "Cóż za szkoda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED"
msgid "Fine! Begone! The Great Maxwell doesn't need help for a simple child's game."
msgstr "Dobra! Precz! Wielki Maxwell nie potrzebuje pomocy z prostą dziecięcą zabawą."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD"
msgid "That foolish creature! This may prove to be a setback..."
msgstr "Głupie stworzenie! To może stanowić pewien problem..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Can't you see I'm busy, rodent!? ...My apologies. Where were we?"
msgstr "Nie widzisz, że jestem zajęty, gryzoniu? O przepraszam. Na czym to skończyliśmy?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Drat, someone found this kitcoon before us."
msgstr "Szlag, ktoś znalazł tego kicioszopa przed nami."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "Ah, we must be near a kitcoon..."
msgstr "Jesteśmy w pobliżu kicioszopa..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Nothing??? Useless animal!"
msgstr "Nic??? Bezużyteczne zwierzę!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING"
msgid "Yes, good... lead me to the kitcoons."
msgstr "Tak, dobrze... Zaprowadź mnie do kicioszopów."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Even a creature of your stature knows to wait for its superiors."
msgstr "Nawet takie stworzenie jak ty wie, że trzeba czekać na swego pana."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED"
msgid "It fled back into the earth."
msgstr "Uciekła z powrotem do ziemi."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING"
msgid "Now is the time to strike!"
msgstr "Teraz jest dogodny czas do ataku!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP"
msgid "Drat."
msgstr "Szlag."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK"
msgid "I'll need a more powerful tool."
msgstr "Potrzebuję mocniejszego narzędzia."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT"
msgid "Curses. Another light down."
msgstr "A niech to! Kolejna zgasła."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "It's about time."
msgstr "Już chyba czas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF"
msgid "Ack!"
msgstr "Ajć!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED"
msgid "Hmm, not quite done."
msgstr "Hmm, jeszcze nie skończone."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE"
msgid "My suit is drenched in salt water."
msgstr "Mój garnitur nasiąkł słoną wodą."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT"
msgid "The creature is past its prime."
msgstr "To stworzenie lata świetności ma już za sobą."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Waga: {weight}"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEr... I don't suppose anyone would help me carry this?"
msgstr "Weight: {weight}\nEe... Zakładam, że nikt mi nie pomoże tego nieść?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET"
msgid "Water'll ruin a good suit, you know?"
msgstr "Woda może zniszczyć najlepszy garnitur."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER"
msgid "I don't think I'll ever be dry again."
msgstr "Już chyba nigdy nie wyschnę."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Foiled again!"
msgstr "Kolejne fiasko!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "I don't know what I expected."
msgstr "Sam już nie wiem, na co liczyłem."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "That food seems to have had an odd affect on me..."
msgstr "To jedzenie zdaje się mieć na mnie dziwny wpływ..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Its power was short-lived."
msgstr "Ta potęga była krótkotrwała."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE"
msgid "Yech. It's horrible in there."
msgstr "Ech, ale tam paskudnie."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS"
msgid "Oh dear. I know what's making that sound."
msgstr "Och, nie. Wiem, co jest źródłem tego dźwięku."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS"
msgid "Curses. I know that sound."
msgstr "A niech mnie. Kojarzę ten dźwięk."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Surprise, surprise."
msgstr "Cóż za niespodzianka."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "At last, something new."
msgstr "Nareszcie coś nowego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS"
msgid "Oh, I'm not close enough to the starting point? Well maybe it should come to me!"
msgstr "Och, jestem za daleko od miejsca startu? Może to ono powinno się zbliżyć do mnie!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "I think you're forgetting something, pal."
msgstr "Chyba o czymś zapomniałeś, kolego."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "Perhaps some space should be cleared around the Start Tower."
msgstr "Może w pobliżu wieży początkowej powinno być trochę miejsca."

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER"
msgid "You do not belong in MY world!"
msgstr "Nie należysz do MOJEGO świata!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC"
msgid "To arms!"
msgstr "Do broni!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG"
msgid "Brains over brawn!"
msgstr "Umysł ponad krzepę!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY"
msgid "Sacrifice yourself for my comfort!"
msgstr "Poświęć się dla mojej wygody!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER"
msgid "I'll not be made a fool of!"
msgstr "Nie pozwolę z siebie drwić!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR"
msgid "You've forced my hand!"
msgstr "Zmuszasz mnie do tego!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC"
msgid "And stay away!"
msgstr "I trzymaj się z daleka!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG"
msgid "Next time, pig!"
msgstr "Do następnego razu, prosiaku!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY"
msgid "You're not worth my time!"
msgstr "Szkoda na ciebie mojego czasu!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER"
msgid "I won't be made a fool of... next time!"
msgstr "Nie pozwolę robić z siebie durnia... następnym razem!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time the gloves come off!"
msgstr "Następnym razem ci nie daruję!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Całkiem uroczy z ciebie duszek, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Hm? What a familiar presence."
msgstr "Hmm? Osobliwie znajome uczucie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "It demands a sacrifice."
msgstr "Domaga się ofiary."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I should quit toying with this now."
msgstr "Lepiej, jeśli przestanę z tym igrać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "I can sense strong magic within it."
msgstr "Wyczuwam potężną magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "A powerful bond tethers this spirit to our world."
msgstr "Potężna więź łączy tego ducha z naszym światem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "...I wonder how my brother is doing."
msgstr "Zastanawiam się, jak też radzi sobie mój brat..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I can sense strong magic within it."
msgstr "Wyczuwam potężną magię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "This enchantment is not of my doing."
msgstr "To nie moje dzieło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Whatever it is will be arriving soon."
msgstr "Cokolwiek to jest, wkrótce się przekonamy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Even They couldn't build something so devious."
msgstr "Nawet Oni nie zdołaliby zbudować czegoś tak diabelskiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Ktoś bardziej miłujący przyrodę może byłby w stanie do czegoś ją wykorzystać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED"
msgid "Over an open fire."
msgstr "Na otwartym ogniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Hmm, wygląda na to, że powinna być w ziemi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL"
msgid "So that's where I left that thing!"
msgstr "A więc tu go zostawiłem!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT"
msgid "It makes me uneasy... but I can't deny its power."
msgstr "Sprawia, że jestem dość niespokojny... ale cóż to za moc."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Even shattered, it holds power."
msgstr "Nawet fragmenty emanują mocą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Ah, now I see..."
msgstr "Ach, teraz rozumiem..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Something doesn't feel right..."
msgstr "Coś mi tu nie pasuje..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "It seems our actions have been noticed."
msgstr "Zdaje się, że ktoś zauważył nasze działania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It looks nastier than before."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "This had better be the one he wants."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Come on now. You're not fooling anyone."
msgstr "Ejże, nikogo nie oszukasz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It toys with us."
msgstr "Bawi się z nami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "It's trying to ensnare us."
msgstr "Próbuje nas zniewolić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "At last you reveal your true self."
msgstr "Przynajmniej pokazujesz swoje prawdziwe oblicze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "I don't know what to believe. All this time, I thought that They were..."
msgstr "Nie wiem, w co mam wierzyć. Cały ten czas myślałem, że Oni..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "This power, it feels like... but it couldn't be..."
msgstr "Ta moc wydaje się... Ale to niemożliwe..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "I'd do well to avoid those."
msgstr "Lepiej ich unikać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Such grotesquerie."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET"
msgid "It channels the darkest energies of the universe."
msgstr "Pozwala przetworzyć mroczną energię wszechświata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR"
msgid "I can drop it to keep the boat in place."
msgstr "Mogę ją wyrzucić, żeby utrzymać łódź na miejscu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM"
msgid "Can't someone else assemble it?"
msgstr "Czy ktoś inny nie może tego złożyć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I sense magic at its core. Now, how to get it out..."
msgstr "W rdzeniu wyczuwam magię. Teraz tylko jakoś trzeba ją wydobyć…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Hm. Tangy."
msgstr "Hm. Orzeźwiające."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "I prefer them raw."
msgstr "Wolę je na surowo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "I'm sure it will burn out eventually."
msgstr "Z pewnością z czasem się wypali."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Close enough."
msgstr "No, prawie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It provides a lovely ambiance of dread, don't you think?"
msgstr "Tworzy wspaniałą atmosferę grozy, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "A pity."
msgstr "Szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It's coming along nicely."
msgstr "Dobrze sobie radzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Patience. It's time will come."
msgstr "Cierpliwości. Jego czas nadejdzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Impudent plant. This patch of ground isn't good enough for you?"
msgstr "Bezczelna roślina. Ta ziemia nie jest wystarczająco dobra?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I suppose I have no choice but to get my hands dirty."
msgstr "Chyba nie mam wyboru. Muszę ubrudzić sobie ręce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED"
msgid "How mysterious."
msgstr "Cóż za tajemniczość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR"
msgid "Where are their gods now?"
msgstr "Gdzie są teraz ich bogowie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This can be partially restored."
msgstr "Można go częściowo odbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE"
msgid "A once proud race."
msgstr "Niegdyś była to dumna rasa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK"
msgid "Some dumb beast passed through here."
msgstr "Jakiś głupi zwierz tędy przechodził."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES"
msgid "What a miserable thing."
msgstr "Co za żałosne stworzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC"
msgid "Have you no pride?"
msgstr "Czyżbyś nie miał żadnego poczucia godności?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's going to wreak havoc on my world."
msgstr "Sprowadzi zniszczenie na mój świat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We've placated it for now."
msgstr "Udało mi się go tymczasowo udobruchać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT"
msgid "If the ground displeases me, I'll pull it up by the roots."
msgstr "Jeśli ziemia mnie zawiedzie, powyrywam wszystko z korzeniami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET"
msgid "I'll cross it off my bucket list."
msgstr "Jedna pozycja z listy obowiązków mniej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I get the sensation that we are not welcome here."
msgstr "Mam wrażenie, że nie jesteśmy tutaj mile widziani."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "A pile of worthless parts."
msgstr "Kupa bezużytecznych części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Trochę za długo stał na ogniu, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Trzeba zaczekać..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "Już niedługo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Nareszcie, jakieś porządne jadło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "They didn't always live off of the fuel."
msgstr "Nie zawsze żywili się paliwem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Impossible... I thought I was privy to all of Their secrets."
msgstr "Niemożliwe... Myślałem, że znam wszystkie Ich sekrety."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Ah. I suppose I misinterpreted the original design."
msgstr "Ech, chyba mylnie zinterpretowałem pierwotny projekt."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "I always wondered where those parts came from."
msgstr "Zawsze mnie zastanawiało, skąd pochodzą te części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "How did I not know of this place? Did They know?"
msgstr "Jakim cudem nie wiedziałem o tym miejscu? A czy Oni wiedzieli?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Rather devious."
msgstr "Całkiem przebiegłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Still inactive. Curious."
msgstr "Wciąż nie działa. Ciekawe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It couldn't be..."
msgstr "To niemożliwe..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It's leading us to something..."
msgstr "Do czegoś nas prowadzi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It fulfilled its purpose."
msgstr "Spełnił swoje zadanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "I have many questions."
msgstr "Mam tyle pytań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "These runes are... different."
msgstr "Te runy są... inne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I can only glean a hint of their meaning."
msgstr "Niewiele z tego rozumiem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "This symbol here keeps repeating..."
msgstr "Ten symbol ciągle się powtarza..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "\"To change?\" No. It's a name..."
msgstr "„Zmienić?” Nie. To nazwa..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "\"Alter\"?"
msgstr "„Zmienić”?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Hm. I have a bad feeling..."
msgstr "Hm, mam złe przeczucie..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It's powerless."
msgstr "Brak temu mocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Don't let it escape!"
msgstr "Nie może uciec!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "I suppose I'll need to find a suitable gem."
msgstr "Chyba muszę znaleźć odpowiedni klejnot."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It saps power from the gems."
msgstr "Czerpie moc z klejnotów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY"
msgid "That's some fly mail."
msgstr "Pancerz smoka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE"
msgid "Black never goes out of style."
msgstr "Czarny nigdy nie wychodzi z mody."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS"
msgid "Direct confrontation is quite gauche."
msgstr "Trochę surowy w dotyku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE"
msgid "That really isn't my style."
msgstr "To naprawdę nie mój styl."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS"
msgid "Thulecite meshes so well with nightmare fuel."
msgstr "Tulecyt doskonale komponuje się z koszmarnym paliwem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON"
msgid "Like all things, it craves the fuel."
msgstr "Potrzebuje paliwa. Jak wszystko inne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER"
msgid "Wet, soggy, and oddly filling."
msgstr "Wilgotny i dziwnie sycący."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL"
msgid "That is not dapper at all."
msgstr "Ani krztyny klasy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK"
msgid "What it lacks in style it almost makes up for in pure, stubborn resilience."
msgstr "Brak stylu nadrabia czystą wytrzymałością."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD"
msgid "Ugh. I'm not typically one for vulgar fisticuffs."
msgstr "Ugh. Nie w moim stylu takie barbarzyńskie rozwiązania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who's frail now?"
msgstr "I kto jest teraz delikatny?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE"
msgid "A little obsessed with bunnies, are we?"
msgstr "Ktoś tu ma lekkiego świra na punkcie króliczków, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Does no one else find this armor oddly itchy?"
msgstr "Czy tylko mnie dziwnie drapie ten pancerz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Of course the plant saves the best stuff for himself."
msgstr "Oczywiście. Ta roślina zostawia dla siebie to, co najlepsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY"
msgid "Wrap yourself in the nightmare. Embrace it."
msgstr "Owiń się w koszmar. Otwórz się na niego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "The fabric really breathes."
msgstr "Ten materiał naprawdę oddycha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "„Tamtędy”... Ech!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Somehow, it says even less now."
msgstr "Teraz się nie dowiem, co tu się wydarzyło."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "„Tamtędy”... Ech!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "This requires profundity."
msgstr "Me działanie winno być gruntowne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC"
msgid "A fine powder that smells of destruction."
msgstr "Proszek pachnący zniszczeniem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Don't worry. There will be more Chesters."
msgstr "Nie martw się. Skrzynek na świecie nie zabraknie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "There's always another Glommer."
msgstr "Zawsze znajdzie się inny glomer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "My trip through the portal made it unrecognizable."
msgstr "Podróż przez portal zmieniła jego strukturę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS"
msgid "We must always eat our vegetables."
msgstr "Podobno zawsze trzeba dojadać warzywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP"
msgid "I suppose you can make soup from anything."
msgstr "Przypuszczam, że zupę da się zrobić ze wszystkiego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED"
msgid "Smells terrible."
msgstr "Śmierdzi niemiłosiernie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "What am I supposed to do with all this asparagus?"
msgstr "I co mam niby zrobić z takim szparagiem?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is feeding off the dark energy."
msgstr "Żywi się mroczną energią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Best not to overuse this power."
msgstr "Lepiej jej nie nadwyrężać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Now we've gone and done it."
msgstr "No to się porobiło…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It lacks a key."
msgstr "Brakuje klucza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON"
msgid "This is a most wretched idea."
msgstr "To fatalny pomysł."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY"
msgid "It's strange to see it."
msgstr "Osobliwy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No fuel, no power."
msgstr "Bez paliwa nie ma energii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "It feeds off the nightmare."
msgstr "Żywi się koszmarami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I can't believe I've forgotten how to read this."
msgstr "Nie chce mi się wierzyć, że zapomniałem, jak to odczytywać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of the city, before the fuel."
msgstr "Obraz miasta sprzed czasów paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "We all know what happens next."
msgstr "Wszyscy wiemy, co stanie się teraz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They gained such an enviable power..."
msgstr "Udało im się zdobyć godną pozazdroszczenia potęgę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "I know why you led me back here."
msgstr "Wiem już, czemu mnie tu sprowadziliście."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "But it won't work."
msgstr "Ale to się nie uda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE"
msgid "There's a dreamlike quality to the material."
msgstr "Zdaje się być stworzona z jakiegoś sennego surowca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE"
msgid "Sometimes the direct approach is best."
msgstr "Czasem proste rozwiązania są najlepsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "They're even ugly as infants."
msgstr "Nawet jako niemowlaki są paskudne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Seems we've a few hours of reprieve."
msgstr "Chyba mamy kilka godzin wytchnienia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK"
msgid "I wish there were porters around here."
msgstr "Szkoda, że nie ma w tym świecie bagażowych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS"
msgid "Now that is a proper breakfast."
msgstr "Właśnie tak powinno wyglądać śniadanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALATRO_MACHINE"
msgid "The game is rigged! But I'll play again to be sure."
msgstr "Ta gra jest nieuczciwa! Zagram jeszcze raz, by się upewnić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON"
msgid "This seems out of place here. Too cheery."
msgstr "Zupełnie tu nie pasuje. Za wesoło mu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT"
msgid "Would I really stoop so low as to wear such a thing?"
msgstr "Naprawdę upadłbym tak nisko, by włożyć takie coś?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY"
msgid "Oh no... he's managed to make them even more cheerful."
msgstr "O, nie... Teraz są jeszcze weselsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its power is spent. Now it's just garishly cheery."
msgstr "Nie ma już mocy. Teraz został tylko krzykliwy kolor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The mime's power unsettles me."
msgstr "Moc tego mima mnie niepokoi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY"
msgid "Those look much too jovial for my liking."
msgstr "Zanadto jowialne, jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST"
msgid "I think I'd rather drown."
msgstr "Chyba wolę utonąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "Banany, które nie rosną w jaskiniach? Co za niedorzeczność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE"
msgid "It doesn't do much for my refined palate."
msgstr "Nie robi wrażenia na moich wyrobionych kubkach smakowych."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP"
msgid "Hm... I don't know what I was expecting."
msgstr "Hmm... Nie wiem, na co liczyłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE"
msgid "Sticky and gooey and good for putting on booboos."
msgstr "Klejący i rozciągliwy. Na gagę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Ew."
msgstr "Ohyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE"
msgid "I wish they were oysters."
msgstr "Szkoda, że to nie ostrygi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA"
msgid "I suppose I'll eat it if there's nothing else."
msgstr "Zjem to, jeśli muszę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I suppose anything is \"food\" now."
msgstr "Teraz chyba wszystko ujdzie za jedzenie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI"
msgid "At least it's an attempt at sophistication."
msgstr "Przynajmniej próbuje udawać wyszukanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED"
msgid "It's an acquired taste."
msgstr "Do takich rzeczy trzeba przywyknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE"
msgid "It's surprisingly delicious."
msgstr "Zaskakująco przepyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT"
msgid "I made a rock so heavy that even I can't lift it."
msgstr "Sprawiłem sobie kamień cięższy niż ze spiżu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT"
msgid "Ugh. Ugly beasts."
msgstr "Paskudne. Paskudne bestie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT"
msgid "Violence has never felt better."
msgstr "Przemoc jeszcze nigdy nie dawała tyle frajdy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE"
msgid "Ugh. It stinks."
msgstr "Uff. Śmierdzi tu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB"
msgid "It smells quite nice, if I'm honest."
msgstr "Szczerze mówiąc, zapach ma całkiem znośny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE"
msgid "It smells."
msgstr "Śmierdzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT"
msgid "Do I have no dignity left?"
msgstr "Czy ja mam jeszcze choć trochę godności?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED"
msgid "The things I must do to survive..."
msgstr "Cóż to trzeba robić, żeby przeżyć..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER"
msgid "As good a place as any to stash sheet music away."
msgstr "Miejsce do przechowywania nut dobre jak każde inne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "My acts were always a bit more improvisational."
msgstr "Ja to zawsze bardziej improwizuję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "My acts were always a bit more improvisational."
msgstr "Ja to zawsze bardziej improwizuję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "No. I do NOT sing."
msgstr "Nie. Ja NIE śpiewam."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING"
msgid "I'm not eating that."
msgstr "Nie zamierzam tego jeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED"
msgid "I'm still not eating that."
msgstr "I tak nie zamierzam go zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR"
msgid "Hirsute."
msgstr "Włochata sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER"
msgid "Take whatever you want."
msgstr "Bierz, co tylko chcesz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "That's one problem solved."
msgstr "O jeden problem mniej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Ugh. I can't just leave that lying around."
msgstr "Ech. Nie mogę go tu zostawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "The \"moon's\" influence is growing..."
msgstr "Wpływ „księżyca” staje się silniejszy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK"
msgid "Portable indeed. Wilson can carry it."
msgstr "Przenośny. W sam raz dla Wilsona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST"
msgid "See my vest."
msgstr "Popatrz na tę kamizelę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR"
msgid "This would make a nice rug."
msgstr "Byłby z niego niezły dywanik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'd say luck is in rather short supply around here."
msgstr "Szczęścia to tutaj akurat brakuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY"
msgid "At least they're good for something."
msgstr "Przynajmniej do czegoś się nadają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW"
msgid "I don't like sleeping rough."
msgstr "Nie przepadam za spaniem w takich warunkach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC"
msgid "They work so hard, the fools."
msgstr "Tak ciężko pracują. Głupie owady."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD"
msgid "Now what do I do with it?"
msgstr "I co mam z nią zrobić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT"
msgid "Honey roasted."
msgstr "Pieczony miód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So tempting, but so full of bees."
msgstr "Oj kusi, ale niestety jest pełny pszczół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC"
msgid "It holds the bees."
msgstr "Pojemnik na pszczoły."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Czemu te pszczoły nie są mymi sługami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY"
msgid "So tempting, but so full of bees."
msgstr "Oj kusi, ale niestety jest pełny pszczół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Trzeba jeszcze trochę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Honey roasted."
msgstr "Pieczony miód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Zrobiłem już dość, ta stara kobieta może sobie sama walczyć z pszczołami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "I think she made this herself."
msgstr "Chyba sama to zrobiła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "Czemu te pszczoły nie są mymi sługami?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Zrobiłem już dość, ta stara kobieta może sobie sama walczyć z pszczołami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Trzeba jeszcze trochę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD"
msgid "They smell even worse when they're dead."
msgstr "Martwe wołki śmierdzą jeszcze gorzej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "How dare you die on me!"
msgstr "Jak śmiesz mi tak umierać!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like a creature that knows its place."
msgstr "Lubię, gdy zwierzęta znają swoje miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Aw nuts, it's following me."
msgstr "A niech to. Idzie za mną."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC"
msgid "Just look at that stupid beast."
msgstr "Popatrz tylko na to głupie zwierzę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER"
msgid "I suppose I'm saddled with this creature now."
msgstr "Chyba teraz to stworzenie jest na mojej głowie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED"
msgid "Now it looks dumb AND pathetic."
msgstr "Teraz wygląda nie tylko głupio, ale do tego żałośnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY"
msgid "Yes, you understand how this works."
msgstr "Tak, ty rozumiesz, jak to działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY"
msgid "I suppose some people might find that charming."
msgstr "Zdaje się, że dla niektórych jest to uroczy widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER"
msgid "I'd only ride you if I was desperate."
msgstr "Musiałbym być pod ścianą, by na tobie jeździć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's only marginally less stupid when it's asleep."
msgstr "Jak śpi, jest tylko marginalnie mniej głupi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED"
msgid "I suppose I'd better keep the stupid beast fed."
msgstr "Pewnie muszę nakarmić tę głupią bestię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT"
msgid "How unfashionable."
msgstr "Wyczuciem smaku bym tego nie nazwał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT"
msgid "Best to keep the beast placated for now."
msgstr "Lepiej, żeby na razie bestia była zadowolona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL"
msgid "It smells like a barn."
msgstr "Śmierdzi oborą."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "What a shame."
msgstr "Co za szkoda..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "How ridiculous."
msgstr "Niedorzeczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "I suppose I'll have to try to make this creature less homely."
msgstr "Trzeba sprawić, by ten stwór był mniej brzydki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Do I look like a common construction worker? Oh very well..."
msgstr "Czy ja wyglądam na pospolitego budowlańca? Ech, no dobra..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL"
msgid "It appears to have some kind of hypnotic effect on beefalo."
msgstr "Wygląda na to, że ten dźwięk działa na wołka hipnotyzująco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD"
msgid "Keep your backside to yourself, madam!"
msgstr "Trzymaj swój odwłok z dala ode mnie, madam!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT"
msgid "I'll wear it if I have to."
msgstr "Jak będzie trzeba, to założę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE"
msgid "Not the bees!"
msgstr "Tylko nie pszczoły!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE"
msgid "They wait so patiently."
msgstr "Ależ są cierpliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL"
msgid "Maybe I shouldn't have put that there."
msgstr "Może nie powinienem był jej tu umieszczać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN"
msgid "I didn't make that one! Really!"
msgstr "Ja tego nie stworzyłem, poważnie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I am not getting that on my shoes."
msgstr "Nie zamierzam w to wdepnąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Now what are those bees up to?"
msgstr "Co te pszczoły kombinują?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "I don't see what all the buzz is about."
msgstr "Nie wiem, o co ten szum."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX"
msgid "I miss sealing a good letter."
msgstr "Brakuje mi prawdziwych listów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY"
msgid "I'm picking up notes of terror, with a hint of dread."
msgstr "Wyczuwam nutki terroru i odrobinę lęku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR"
msgid "Back to the dungeons with you!"
msgstr "Wracaj do swego obmierzłego lochu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL"
msgid "More bell."
msgstr "Będzie hałas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE"
msgid "Just what am I looking at here?"
msgstr "Na co ja właściwie patrzę?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG"
msgid "How truly unnerving."
msgstr "Jakże niepokojący widok."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It's seen better days."
msgstr "Nie jest w najlepszej formie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It makes me a little nostalgic."
msgstr "Sprawia, iż ogarnia mnie nostalgia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES"
msgid "Sigh. If I have to."
msgstr "Ech. Jakoś się zmuszę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY"
msgid "Delightfully sweet with a subtle hint of tartness."
msgstr "Wybornie słodkie. Z subtelną nutką cierpkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're quite delicious, actually."
msgstr "Tak naprawdę są całkiem pyszne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs manure."
msgstr "Potrzeba nawozu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING"
msgid "It better not start talking to me."
msgstr "Mam nadzieję, że nie zacznie do mnie rozmawiać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Reduced to eating berries. Sigh."
msgstr "Że też przyszło mi jeść jakieś dzikie owoce..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED"
msgid "And now we wait."
msgstr "No to teraz czekamy..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot for that little bush."
msgstr "Za ciepło dla tego krzaczka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It looks to be in need of assistance. Fertilizer, perhaps?"
msgstr "Potrzebne substancje odżywcze. Może nawóz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It better not start talking to me."
msgstr "Mam nadzieję, że nie zacznie do mnie rozmawiać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "Skądże zaraza w moim świecie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Wygląda mi dość podejrzanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The berries will stay fresh as long as I leave them there."
msgstr "O ile zostawię je tutaj, te jagody powinny zachować świeżość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "I fear I'll have to wait."
msgstr "Obawiam się, że muszę poczekać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I know the feeling."
msgstr "Znam to uczucie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE"
msgid "This seems like a lot of fuss for some mashed berries."
msgstr "Za dużo zachodu jak na rozgniecione porzeczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA"
msgid "It has a unique spongy texture."
msgstr "Ma wyjątkową, gąbczastą konsystencję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT"
msgid "Now that is surely fuel for nightmares."
msgstr "To jest dopiero paliwo dla koszmarów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE"
msgid "A nut with legs! How terrifying!"
msgstr "Orzech z nogami! Straszna rzecz!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD"
msgid "That's a deep sleep."
msgstr "Śpi bardzo, bardzo głęboko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC"
msgid "You'll never get me behind bars again."
msgstr "Nie dam się już więcej zamknąć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about, feathers?"
msgstr "O co tyle krzyku?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "I feel for ya, feathers."
msgstr "Rozumiem twój ból, pierzasty przyjacielu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Maybe he wasn't sleeping."
msgstr "Może wcale nie spał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You'll still be in there when you wake up."
msgstr "I tak tu będziesz, jak się obudzisz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh, come on. I fed you last week."
msgstr "Nie wygłupiaj się, karmiłem cię w zeszłym tygodniu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP"
msgid "They keep falling for it!"
msgstr "Wciąż się nabierają na te same sztuczki!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG"
msgid "I like to think of it as baby bird prison."
msgstr "Zawsze sobie tłumaczę, że to więzienie dla małego ptaszka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side up."
msgstr "Sadzone najlepsze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT"
msgid "That creature has seen better days."
msgstr "To stworzenie nie wygląda najlepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "You dare spit at me?!"
msgstr "Ośmielasz się na mnie pluć?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP"
msgid "I'm especially proud of that piece."
msgstr "Jestem z niego szczególnie dumny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "How DARE you!"
msgstr "Jak ŚMIESZ?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE"
msgid "They degrade without proper upkeep."
msgstr "Bez odpowiedniej opieki zaczynają wariować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG"
msgid "Black never goes out of style."
msgstr "Czarny nigdy nie wychodzi z mody."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE"
msgid "Just make sure to breathe out."
msgstr "Tylko pamiętaj, żeby zrobić wydech."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA"
msgid "That is not my style."
msgstr "To nie w moim stylu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2"
msgid "I'm no blowhard."
msgstr "Jedno dmuchnięcie i po kłopocie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE"
msgid "A glorious tube of pain!"
msgstr "Wspaniała tuba bólu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP"
msgid "Call me \"Mr. Sandman\"."
msgstr "Aaa, kotki dwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr "Nigdy nie uderza dwa razy w to samo miejsce. No chyba że akurat tak się trafi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "Jest cały pokryty szronem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "Niebieski symbolizuje lód."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr "Przypomina się, że muszę poćwiczyć swoje zimne spojrzenie!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "Wiem wszystko na ten temat. Po prostu wyleciało mi z głowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr "Zaiste unikatowy plan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "Czy coś mogłoby pójść nie tak?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
msgid "Umami!"
msgstr "Umami!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "The blue ones are good for, uh, something."
msgstr "Niebieskie nadają się do... hmm... czegoś."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's not ready."
msgstr "Jeszcze nie jest gotowy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Another time, maybe?"
msgstr "Może innym razem?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS"
msgid "Roughly hewn."
msgstr "Grubo ciosane."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON"
msgid "Begone, swine."
msgstr "Odejdźże, knurze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR"
msgid "Well he's certainly no slouch."
msgstr "Kawał chłopa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05"
msgid "Merely smithereens."
msgstr "Same drzazgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH"
msgid "I detest such work."
msgstr "Nie cierpię takiej pracy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP"
msgid "That won't keep the water at bay for long."
msgstr "To nie zablokuje wody na długo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Are we there yet?"
msgstr "Jesteśmy już na miejscu?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Whatever."
msgstr "Kogo to obchodzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Are you supposed to be intimidating?"
msgstr "Mam się ciebie bać?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK"
msgid "Out of my way!"
msgstr "Z drogi!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Hm. Someone's feeling prickly."
msgstr "Hm. Ktoś tu się trochę najeżył."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Punkt orientacyjny lub wykorzystana w odpowiedniej chwili przeszkoda…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Punkt orientacyjny lub wykorzystana w odpowiedniej chwili przeszkoda…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Enjoying the show, pal?"
msgstr "Podoba ci się przedstawienie, kolego?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START"
msgid "Can I just wait here for everyone to be done?"
msgstr "Mogę tu zaczekać, aż wszyscy skończą?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Wherever."
msgstr "Gdziekolwiek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Now those apes won't get their grubby hands on my loot."
msgstr "Teraz małpy nie wyciągną brudnych łapsk po moje łupy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "It's not old, it's \"classic.\""
msgstr "To nie staroć, tylko „klasyk”."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Looks heavy enough to sink us."
msgstr "Wygląda na wystarczająco ciężkie, by nas zatopić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Uch. Te poślednie zadania do mnie nie pasują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP"
msgid "I don't know if the smell is worth the protection it offers."
msgstr "Nie wiem, czy warto męczyć się z tym zapachem w imię ochrony."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Uch. Te poślednie zadania do mnie nie pasują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Seashells. The sturdiest building material known to man."
msgstr "Muszle. Najwytrzymalszy materiał budowlany znany ludzkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Uch. Te poślednie zadania do mnie nie pasują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "I always thought boats could use more teeth."
msgstr "Zawsze myślałem, że łodzie potrzebują więcej zębów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Uch. Te poślednie zadania do mnie nie pasują."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Don't test me."
msgstr "Nie wystawiaj mnie na próbę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It's useless if it isn't loaded."
msgstr "Jest bezużyteczna, jeśli nie jest naładowana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Tragically, I can't just summon cannonballs out of thin air."
msgstr "Niestety nie wyczaruję kul armatnich z niczego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT"
msgid "Fine. I suppose the task of building it is left to me."
msgstr "Niech będzie. Wygląda na to, że to ja muszę ją zbudować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Am I building a boat or weaving a basket?"
msgstr "Buduję łódź czy wyplatam koszyk?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM"
msgid "I've been reduced to a common shipyard laborer."
msgstr "Stałem się zwykłym robolem w stoczni."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK"
msgid "Oh, great. Now we're going to drown."
msgstr "Świetnie. Teraz zatoniemy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Shockingly, it seems to work."
msgstr "Szokujące, ale to chyba działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "If it saves me from having to row myself, I'll give it a chance."
msgstr "Jeżeli oszczędzi mi to wiosłowania, dam temu szansę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Somehow, it's working."
msgstr "Jakimś cudem to działa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This feels ridiculous."
msgstr "Czuję się idiotycznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Blast it Higgsbury, I can barely read these scribbled instructions."
msgstr "Niech cię szlag, Higgsbury, ledwo mogę odczytać te instrukcje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR"
msgid "If I hear one word of complaint, I'm turning this boat around."
msgstr "Jeżeli usłyszę choć słowo skargi, zawracam tę łajbę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Do I look like a common shipwright? Oh, very well..."
msgstr "Czy ja wyglądam na cieślę okrętowego? Ech, no dobra..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "What is the thread count on this?"
msgstr "Ile jest tu nitek?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP"
msgid "Looking at it is making me seasick."
msgstr "Na sam widok dostaję choroby morskiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS"
msgid "Can you rightfully call a sack of potpourri a pillow?"
msgstr "Jak ktoś może nazywać worek uschniętych kwiatów poduszką?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "It will either protect me or cut me to ribbons."
msgstr "Albo mnie ochroni, albo potnie na kawałeczki."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT"
msgid "Someone's about to have a very bad day."
msgstr "Ktoś będzie miał dziś bardzo zły dzień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Its power has been amplified..."
msgstr "Jego moc się wzmogła…"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD"
msgid "Grind them bones."
msgstr "Wielokrotne złamanie otwarte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP"
msgid "It's hearty and filling."
msgstr "Tłuste i pożywne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW"
msgid "Leave no scrap unused."
msgstr "Nic nie może się zmarnować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT"
msgid "History repeats itself."
msgstr "Historia lubi się powtarzać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Rebuilding her library, is she?"
msgstr "Odbudowuje swoją bibliotekę, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES"
msgid "Perhaps now the bees will serve me."
msgstr "Może teraz pszczoły będą mi służyć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS"
msgid "What a wasteful misuse of magic."
msgstr "Cóż za smutne marnotrawstwo magii."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE"
msgid "I've had enough fire and brimstone for one eternity."
msgstr "Starczy mi ognia i siarki, jak na jedną wieczność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL"
msgid "The words within evoke an unknown force."
msgstr "Zawarte weń słowa są kluczem do niezmierzonej potęgi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE"
msgid "Ah. Based on the librarian's own observations, I take it?"
msgstr "Ach. To pewnie z własnych obserwacji bibliotekarza, jak mniemam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH"
msgid "I suppose I'll eat for a lifetime, then? Somehow I doubt it."
msgstr "Niby mam najeść się na całe życie? Jakoś nie wydaje mi się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL"
msgid "I could stop a fiend in its tracks with this."
msgstr "Mógłbym powstrzymać tym niejednego wroga."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "Niemądrze igrać z mocami przekraczającymi twe pojmowanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE"
msgid "Hopefully this version is less wordy."
msgstr "Oby ta wersja była mniej rozwlekła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Hopefully this will mean less time relegated to the garden."
msgstr "Miejmy nadzieję, że to oznacza mniej czasu poświęcanego na ogrodnictwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT"
msgid "Taking some inspiration from the Codex, are we? I'm flattered."
msgstr "Ktoś tu czerpał inspirację z Codexu? Czuję się mile połechtany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Now she's just showing off."
msgstr "Teraz się już popisuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON"
msgid "We've come this far, no point in stopping our meddling now."
msgstr "Zaszliśmy tak daleko, że szkoda byłoby teraz zaniechać wścibstwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN"
msgid "What's a ritual without a little showmanship? Surely a prop or two?"
msgstr "Co to za rytuał bez małej pokazówki? Z pewnością przydadzą się jakieś rekwizyty?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Hmph. It doesn't hold a candle to the secret knowledge I possess."
msgstr "Phi. Nie może nawet równać się z tajemną wiedzą, którą ja posiadłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "Niemądrze igrać z mocami przekraczającymi twe pojmowanie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP"
msgid "I haven't had a real sleep in... ages."
msgstr "Nie spałem porządnie od... lat."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE"
msgid "I'm always cool and collected."
msgstr "Zawsze jestem opanowany i zdystansowany."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES"
msgid "What horrors shall be summoned from the depths?"
msgstr "Cóż za nieopisane koszmary da się przywołać z głębin?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB"
msgid "As if spiders are what you should be worried about here."
msgstr "Tak jakby trzeba było się tu martwić akurat pająkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG"
msgid "Beats getting your hands dirty."
msgstr "Nie brudzi rąk."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG"
msgid "Best not to think about where it's been."
msgstr "Lepiej nie wiedzieć, gdzie ona była."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It's of no use to me like this."
msgstr "W tym stanie na nic mi się nie przyda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH"
msgid "It's like showing affection, without actually touching it."
msgstr "Pozwala okazać zaangażowanie bez konieczności dotyku."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET"
msgid "Good for capturing defenseless insects."
msgstr "Do łapania bezbronnych owadów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Disgusting. I'll have someone else pick it."
msgstr "Obrzydlistwo. Niech ktoś inny to zbierze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "We already took the food parts."
msgstr "Zebraliśmy już to, co da się zjeść."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT"
msgid "For keeping the peasantry in line."
msgstr "To żeby chłopstwo nie wychodziło przed szereg."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE"
msgid "Nice and snug."
msgstr "Przyjemna i foremna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP"
msgid "I guess we could wrap a few things up."
msgstr "Moglibyśmy coś zapakować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN"
msgid "It reminds me of my old act."
msgstr "Przypomina mi się, jak grałem w teatrzyku szkolnym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW"
msgid "Good until the last hop."
msgstr "Kic i do gara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Utterly destroyed."
msgstr "Akt kompletnej destrukcji."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT"
msgid "There's room in there for me."
msgstr "Znajdzie się tam dla mnie miejsce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER"
msgid "Some puns are irresistible."
msgstr "Osełka masełka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It's a flying flower."
msgstr "Latający kwiatek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD"
msgid "It would be a shame if someone ripped the wings off of it."
msgstr "Szkoda by było, jakby mu ktoś urwał skrzydła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN"
msgid "That should stop its incessant flapping."
msgstr "Dość tego trzepotania."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS"
msgid "Ha ha ha. I got him!"
msgstr "Ha, ha, ha! Dorwałem go!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD"
msgid "Carrion connoisseur."
msgstr "Koneser mięsa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS"
msgid "Meat rolled in cabbage. How exciting."
msgstr "Mięso zawinięte w kapustę. Doprawdy ekscytujące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC"
msgid "Puffer plant."
msgstr "Jeżoroślina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED"
msgid "Cactus? More like flat-tus!"
msgstr "Kaktus platfus!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER"
msgid "This part of the cactus is always nice."
msgstr "Ta część kaktusa jest fantastyczna."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT"
msgid "It would be unwise to put that in my mouth."
msgstr "Włożenie tego do ust nie byłoby rozsądne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Cactus comestible."
msgstr "Kaktus w wersji jadalnej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL"
msgid "I don't think I truly appreciated those sunny shores."
msgstr "Chyba nie doceniałem tych słonecznych wybrzeży."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Zaraz będzie po ptokach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC"
msgid "How comforting."
msgstr "Bardzo przyjemne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Charlie przez jakiś czas się nie pokaże."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs fuel."
msgstr "Potrzeba paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Fiery."
msgstr "Ognista sprawa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT"
msgid "That's not coming back."
msgstr "Skończyło się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC"
msgid "How do these things keep getting into my world?"
msgstr "Jak te dziwadła dostają się do mojego świata?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD"
msgid "Bait."
msgstr "Mam cię."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED"
msgid "You look atrocious."
msgstr "Wyglądasz okropnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG"
msgid "That's our sugar-sack."
msgstr "Nasza torba słodkości."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE"
msgid "It has pictures of fast things carved into it."
msgstr "Jest cała pokryta wyobrażeniami szybkich rzeczy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "That looks heavy. Someone should load it into the cannon."
msgstr "To mi wygląda na ciężkie. Ktoś powinien załadować to do armaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "That's more than enough cheer for one day."
msgstr "Dość tej wesołości jak na jeden dzień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "This place is turning into a circus."
msgstr "To miejsce zaczyna przypominać cyrk."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Must I do everything around here?"
msgstr "Czy muszę wszystko tutaj robić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Oh good. Wouldn't want anyone thinking we've got taste around here, would we?"
msgstr "No tak. Przecież nie chcemy, żeby ktoś pomyślał, że jednak mamy dobry gust, czyż nie?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Wygląda na to, że praca tutaj nigdy się nie kończy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Wonderful. It's even tackier than I imagined it would be."
msgstr "Cudownie. Jest bardziej tandetne, niż myślałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Wygląda na to, że praca tutaj nigdy się nie kończy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "One more thing to clutter the ground."
msgstr "Jeszcze jeden śmieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "What exactly is so fantastic about it?"
msgstr "I co w tym niby takiego niesamowitego?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Measly things. In my time I made proper statues..."
msgstr "Nędzne to wszystko. Kiedyś robiłem porządne posągi..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Curiosity always seems to get the better of me."
msgstr "Ciekawość zawsze ze mną wygrywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Curiosity always seems to get the better of me."
msgstr "Ciekawość zawsze ze mną wygrywa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A paltry light source. But it will do."
msgstr "Marne źródło światła. Ale niech będzie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Wygląda na to, że praca tutaj nigdy się nie kończy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "At least it's small and somewhat manageable."
msgstr "Przynajmniej jest małe, więc można nad tym w miarę zapanować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Wygląda na to, że praca tutaj nigdy się nie kończy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Surely you're not serious?"
msgstr "Żartujesz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "These props leave something to be desired."
msgstr "Te rekwizyty pozostawiają trochę do życzenia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "What are they hiding down there..."
msgstr "Co one tam ukrywają..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "I'll play it, but I won't enjoy it."
msgstr "Zagram, ale bez przyjemności."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Get back here, you blasted contraption!"
msgstr "Wracaj tutaj, ty parszywcu!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Such pointless frivolity..."
msgstr "Cóż za bezsens..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "What are they hiding down there..."
msgstr "Co one tam ukrywają..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I'm almost certain it was this one..."
msgstr "Jestem prawie pewien, że to ta..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "A simple matter of memorization. I'll show you just how easy it is."
msgstr "Kwestia zapamiętania. Pokażę, jakie to proste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "I imagine some people might find this amusing."
msgstr "Wyobrażam sobie, że niektórych mogłoby to rozbawić."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Well, I suppose a bit of destruction might be relaxing."
msgstr "Cóż, zakładam, że odrobina zniszczenia może być relaksująca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Another mindless diversion."
msgstr "Kolejna bzdurna rozrywka."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "What are they hiding down there..."
msgstr "Co one tam ukrywają..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I'm certain it's rigged."
msgstr "Jestem pewien, że wszystko jest ustawione."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "I mam to zrobić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It requires payment."
msgstr "Wymaga zapłaty."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "A meaningless victory."
msgstr "Nieistotne zwycięstwo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL"
msgid "How novel."
msgstr "Cóż za oryginalność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID"
msgid "We're being overrun."
msgstr "To już przesada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Fine. I'll play your silly little games."
msgstr "Dobra. Wezmę udział w tych durnych zabawach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST"
msgid "Just look at him, strutting around like he owns the place."
msgstr "Patrzcie no! Pyszni się, jakby był właścicielem tego miejsca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It's about as festive as I like it. Which is not at all."
msgstr "Jest tu tak odświętnie, jak lubię – czyli wcale."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The birds seem to enjoy it. Some creatures just lack any taste."
msgstr "Ptakom chyba się podoba. Niektóre stworzenia nie mają za grosz gustu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "I think that's about as much clutter as one could possibly throw on a tree."
msgstr "Już więcej rupieci nie da się upchać na jedno drzewo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "It's so... ugh... whimsical."
msgstr "Jest takie... ech... dziwaczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "I somehow doubt they'd have anything I want."
msgstr "Wątpię, żeby mieli coś dla mnie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "Must I do everything around here?"
msgstr "Czy muszę wszystko tutaj robić sam?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "A prize ticket. How exciting."
msgstr "Los. Wspaniale."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Oh good. Now I can get some useless trinket from the Prize Booth."
msgstr "No świetnie. Teraz dostanę jakąś bezużyteczną błyskotkę z budki z nagrodami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I don't know why I'm dedicating so much time to this."
msgstr "Nie wiem, dlaczego poświęcam temu tyle czasu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "About as pleasant as you'd expect."
msgstr "Niczego lepszego się nie spodziewałem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A"
msgid "Far too jaunty for my taste."
msgstr "Zbyt wesołe jak na mój gust."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B"
msgid "At least it will give me some respite from this wretched heat."
msgstr "Przynajmniej odpocznę od tego przeklętego upału."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C"
msgid "It affords some protection from the sun's burning rays."
msgstr "W pewnym stopniu chroni przed piekącym słońcem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Fancy... for a laborer's tool."
msgstr "Niezłe... Jak na narzędzie robotnika."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Too bad."
msgstr "Szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I never cared for woodworking. The sawdust gets everywhere."
msgstr "Nie przepadam za stolarką. Trociny wszędzie się dostają."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD"
msgid "Disgusting."
msgstr "Obrzydliwe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC"
msgid "That carrot is revolting!"
msgstr "Ta marchew się buntuje!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD"
msgid "You thought you could fool me?"
msgstr "Myślałaś, że mnie oszukasz?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING"
msgid "I'm sure it is diseased."
msgstr "Na pewno jest chora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Starting to feel left out?"
msgstr "Czujesz się opuszczona?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT"
msgid "I'm not a fan of vegetables."
msgstr "Nie przepadam za warzywami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED"
msgid "A little more refined, at least."
msgstr "Przynajmniej odrobinę bardziej wyszukana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED"
msgid "A ludicrously oversized carrot."
msgstr "Absurdalnie wielka marchew."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED"
msgid "How mundane."
msgstr "Nie dla mnie takie przyziemne sprawy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Nie dla mnie taka robota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Such directionless destruction."
msgstr "Niepotrzebna strata."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Useless."
msgstr "Bezużyteczny śmieć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Mapmaking is a soothing pastime. Methodical."
msgstr "Rysowanie map to bardzo uspokajające zajęcie. Metodyczne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON"
msgid "Catty vermin."
msgstr "Przebiegły szkodnik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Well, I guess that's that."
msgstr "Cóż, to by chyba było na tyle."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Vermin housing."
msgstr "Dom szkodnika."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT"
msgid "Dead head."
msgstr "W sumie to jest trupia głowa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE"
msgid "The classic game of catcoon and mechanical mouse."
msgstr "Klasyczna zabawa w kotoszopa i mechaniczną mysz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Well it's not going to move itself."
msgstr "No cóż. Sam się nie ruszy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must deal with the others first."
msgstr "Wpierw musimy zająć się pozostałymi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA"
msgid "Ashes in one's mouth."
msgstr "Smakuje jak popiół."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I refuse to be held responsible for that."
msgstr "Nie ponoszę za to odpowiedzialności. Protestuję."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Even worse than raw."
msgstr "Pieczony jest jeszcze gorszy.."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE"
msgid "It looks like a banana, but I'm not buying it."
msgstr "Wygląda na banana, ale jakoś mnie nie przekonuje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE"
msgid "I plugged it a long time ago."
msgstr "Zatkałem je wieki temu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "When it's less claustrophobic, perhaps."
msgstr "Może gdy zrobi się trochę mniej klaustrofobicznie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "That was not a good idea!"
msgstr "To nie był dobry pomysł!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Off to plunder the depths."
msgstr "Ku baśniowym bogactwom otchłani!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Probably shouldn't venture any deeper."
msgstr "Chyba lepiej nie zapuszczać się głębiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'd rather stay here than mingle with the crowds above."
msgstr "Wolę chyba poczekać, aż tłum na górze nieco się przerzedzi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Get me out of here!"
msgstr "Zabierzcie mnie stąd!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Onward to the next thing."
msgstr "Ku nowym przygodom."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN"
msgid "I'd like to step on it."
msgstr "Chciałbym ją rozdeptać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE"
msgid "A delightful, cultured dish."
msgstr "Wyborny, kulturalny posiłek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL"
msgid "Nothing will steal my carbon!"
msgstr "Nie pozwolę ukraść mojego węgla!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND"
msgid "I'll... see to it."
msgstr "Tak… dopilnuję tego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER"
msgid "Tough crowd."
msgstr "Trudna publiczność."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN"
msgid "Misdirection, the oldest trick in the book. Well played, Charlie."
msgstr "Odwrócenie uwagi, najstarsza sztuczka magików. Dobrze to rozegrałeś, Charlie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC"
msgid "Charlie..."
msgstr "Charlie..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Just like the old days."
msgstr "Jak za dawnych czasów."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1"
msgid "There's a reason I never finished that."
msgstr "Nie bez powodu nigdy ich nie dokończyłem."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2"
msgid "That one was a jerk."
msgstr "Wredny drań."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3"
msgid "Didn't like that one's face."
msgstr "Ale paskudna morda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "How kitsch."
msgstr "Ale kicz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Is there a sinkhole I can bury this in?"
msgstr "Gdzie jest jakiś ściek, do którego mógłbym to wrzucić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER"
msgid "A brute."
msgstr "Brutal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "It'll scare away anyone with good taste."
msgstr "Odstraszy każdego, kto ma choć odrobinę dobrego gustu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "At least this version doesn't shed all over my poor suit."
msgstr "Przynajmniej w takiej postaci nie zostawia sierści na moim biednym garniturze."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Does she really need a statue?"
msgstr "Naprawdę potrzebny jej pomnik?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Could use a few more mechanical bits in my opinion."
msgstr "Przydałoby mu się trochę więcej mechanicznych części."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Jego elementy zaczęły się poruszać!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Rather elegant, I'd say."
msgstr "Rzekłbym, że nawet eleganckie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I had a mantle to set it on."
msgstr "Gdybym tylko miał gdzie to wyeksponować."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON"
msgid "This animal commands respect through violence."
msgstr "To zwierzę zdobywa szacunek dzięki przemocy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It's quite fetching."
msgstr "Chętnie państwu łapę poda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "What a gruesome maw."
msgstr "Ależ straszliwa paszcza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING"
msgid "I am not that crabby!"
msgstr "Wcale nie jestem taki znowuż uszczypliwy!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Seems like anyone can get a statue these days."
msgstr "Wygląda na to, że teraz każdy może mieć swój pomnik."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "Ah yes, the rummaging hog."
msgstr "No tak, to niespokojny knur."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I don't like winters."
msgstr "Nie lubię zimy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "I take great offense to anyone trying to improve on my designs."
msgstr "Czuję się urażony, gdy ktoś próbuje doskonalić moje dzieła."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "Let's leave this underground."
msgstr "Opuśćmy te podziemia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "It never stood a chance."
msgstr "Nie miał najmniejszych szans."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "An eye could never best a master of illusion such as I."
msgstr "Oko nigdy nie pokona takiego mistrza iluzji jak ja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "What a well-dressed figure!"
msgstr "Doskonale ubrana figura!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "How could I not have seen..."
msgstr "Jak mogłem nie zauważyć..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "This seems cruel."
msgstr "To chyba lekka przesada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON"
msgid "This is a rather precarious design."
msgstr "Dość niebezpieczna konstrukcja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Why bother?"
msgstr "Po co się trudzić?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A dreadful lack of accordions."
msgstr "A gdzie akordeon?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "And I thought chivalry was dead!"
msgstr "A myślałem, że rycerstwo to przeżytek!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Such a fowl-tempered bird."
msgstr "Ależ paskudny charakter ma ten ptak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Who put this ridiculous thing here?"
msgstr "Kto postawił tu to dziwactwo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Always keep things close to the chest, right pal?"
msgstr "Chciałoby się jeszcze kogoś przyskrzynić, co, kolego?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON"
msgid "I'm fairly partial to this one."
msgstr "Mam do tego lekką słabość."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "What an imbecilic expression."
msgstr "Cóż za debilny fizys."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE"
msgid "Must everything be about my shortcomings?"
msgstr "Czy wszystko musi się odnosić do moich niedociągnięć?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN"
msgid "I have no idea what that is."
msgstr "Nie mam pojęcia, co to jest."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE"
msgid "Ceci n'est pas une pipe. Pity."
msgstr "Ceci n'est pas une pipe. A szkoda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's nice, but where's the rust? The exhaust pipes?"
msgstr "Fajnie, ale gdzie rdza? Gdzie wydech?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "Jego elementy zaczęły się poruszać!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Bottom feeding lone shark."
msgstr "Samotny rekin żywiący się resztkami."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER"
msgid "I do like this one."
msgstr "Podoba mi się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least the statue doesn't smell as bad as the original."
msgstr "Przynajmniej nie cuchnie tak jak oryginał."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "The most troublesome pair I've ever seen."
msgstr "W życiu nie widziałem pary tak nieznośnych stworzeń."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "It was a bad dog."
msgstr "To był niedobry piesek."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "I can still smell it's breath."
msgstr "Nadal czuję ten oddech."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD"
msgid "Always nice to be reminded of my victories."
msgstr "Zawsze mi miło, jak coś przypomina mi o moich zwycięstwach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTS"
msgid "Let's leave this underground."
msgstr "Zostawmy to pod ziemią."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER"
msgid "Annoying little monster. Has his uses, though."
msgstr "Mały, denerwujący przybłęda. Jest jednak całkiem użyteczny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Stop looking at me!"
msgstr "Nie gap się tak."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "What is it waiting for?"
msgstr "Na co ona czeka?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Hmph. Dress it up with wires and gears, but I know magic when I see it."
msgstr "Pff. Tyle przewodów i kół zębatych, a od razu widzę, że to magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "It's a trap!"
msgstr "To pułapka!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM"
msgid "Say, that chum doesn't look so good."
msgstr "Nie wygląda najlepiej."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I was wise to be suspicious."
msgstr "Warto było być podejrzliwym."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE"
msgid "I don't trust it."
msgstr "Nie ufam mu."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC"
msgid "This earthen beast's all fired up."
msgstr "Strasznie się zapala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE"
msgid "How delightfully disconcerting."
msgstr "Olśniewająco niepokojące."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Zaraz będzie po ptokach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC"
msgid "How comforting."
msgstr "Bardzo przyjemne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Charlie przez jakiś czas się nie pokaże."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW"
msgid "It needs fuel."
msgstr "Potrzeba paliwa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL"
msgid "Cold and fiery."
msgstr "Płomienny, ale zimny."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT"
msgid "That's not coming back."
msgstr "Skończyło się."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Someone should attend to that."
msgstr "Ktoś powinien się tym zająć."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Palenisko."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A roaring, cold fire."
msgstr "Szalejący, zimny ogień."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Zaczyna przygasać."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's cold."
msgstr "Zimne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT"
msgid "It's gone warm."
msgstr "Zrobiło się ciepłe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST"
msgid "Do you really expect me to dig through that?"
msgstr "Naprawdę sądzisz, że się przez to przekopię?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC"
msgid "I've lost my way."
msgstr "Zgubiłem drogę."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Północ"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Północny wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Północny zachód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Południe"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Południowy wschód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Południowy zachód"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W"
