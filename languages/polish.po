msgstr "Już prawie.."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_COOKPOT.DONE"
