msgstr "Super! Powinnam się przebrać."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Kill that flag!"
msgstr "Zabić tę flagę!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BERNIE"
msgid "You're always there for me, Bernie."
msgstr "Zawsze mogę na ciebie liczyć, Benio."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Pfft, I bet he can't even fight."
msgstr "Pffff, założę się, że nie umie się nawet bić."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Dibs!"
msgstr "Mój!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Woah! I love it!"
msgstr "Woow! Ale super!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, gimme!"
msgstr "Dawaj, dawaj!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
