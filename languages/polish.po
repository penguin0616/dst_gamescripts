msgstr "Szkoda."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "I remember drawing at the table."
msgstr "Pamiętam, jak rysowałem przy stole."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "I remember drawing at the table."
msgstr "Pamiętam, jak rysowałem przy stole."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.DIRT"
msgid "Some dirt, big whoop."
msgstr "Trochę ziemi. Wielkie rzeczy."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.PLANT"
msgid "What could possibly go wrong?"
msgstr "Czy coś mogłoby pójść nie tak?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM.WORM"
msgid "Creepy crawly!"
msgstr "Obrzydliwy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE.GENERIC"
msgid "I think that thing is alive."
msgstr "To chyba żyje."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE.OPEN"
msgid "I've been in worse."
msgstr "Byłem już w gorszych miejscach."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMHOLE_LIMITED"
msgid "Gross, that one looks sick!"
msgstr "Ohyda! Wygląda na chorą!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT"
msgid "It's gushing with light."
msgstr "Wydziela przedziwne światło."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT_LESSER"
msgid "I dare you to eat it!"
msgstr "Dasz radę to zjeść?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMLIGHT_PLANT"
msgid "What could possibly go wrong?"
msgstr "Czy coś mogłoby pójść nie tak?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Hey, %s! Friends don't hit friends!"
msgstr "Ej, %s! Przyjaciele nie biją przyjaciół!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "We don't think it's safe for you to be around fire."
msgstr "Chyba nie powinieneś zbliżać się do ognia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GENERIC"
msgid "Hey, it's our good friend, %s!"
msgstr "O, to nasz dobry przyjaciel, %s!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.GHOST"
msgid "Poor %s! He died of loneliness!"
msgstr "Biedny %s! Samotność go zabiła!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.MURDERER"
msgid "Wickerbottom says we can't be friends anymore!"
msgstr "Wiklińska mówi, że nie możemy się już kolegować!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is really rooting for us!"
msgstr "%s naprawdę nas wspiera!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "Oh no!"
msgstr "Och, nie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Hey, little friend!"
msgstr "Hej, maluszku!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "We'll keep you safe."
msgstr "Będziemy o ciebie dbać."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "Night night."
msgstr "Pora na dobranoc."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "It smells like yummy fruit."
msgstr "Pachnie smakowicie i owocowo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "It looks kinda yummy."
msgstr "Wygląda smakowicie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "Night night!"
msgstr "Dobrej nocy!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "We think it's probably too big to fit in a jar."
msgstr "Chyba jest za duży, żeby wejść do słoika."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORM_BOSS"
msgid "Wow."
msgstr "Łoł."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.ATTACKER"
msgid "Hey, play nice, %s!"
msgstr "Hej! Zachowuj się, %s!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.FIRESTARTER"
msgid "Don't play tricks, Mr. Imp!"
msgstr "Proszę się zachowywać, panie chochliku!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.GENERIC"
msgid "Hey %s! Your horns look nice!"
msgstr "Hej, %s! Masz ładne rogi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.GHOST"
msgid "Oh no, %s! You're hurt!"
msgstr "Och, nie! %s! Jesteś ranny!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.MURDERER"
msgid "Oh no! %s, what did you do!"
msgstr "Och, nie! Co żeś narobił, %s!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX.REVIVER"
msgid "Grandpa always said laughter was the best medicine!"
msgstr "Dziadek zawsze mówił, że najlepszym lekarstwem jest śmiech!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_NABBAG"
msgid "Is it stealing if the thing is just on the ground?"
msgstr "Czy to kradzież, jeśli coś po prostu leży na ziemi?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_REVIVER"
msgid "In case something bad happens."
msgstr "Gdyby stało się coś złego."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORTOX_SOULJAR"
msgid "Are there spider souls in there?"
msgstr "Są w tym dusze pająków?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.ATTACKER"
msgid "Hey, stop it! No hitting!"
msgstr "Ej! Przestań! Nie ma bicia się!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.FIRESTARTER"
msgid "We... don't think that's allowed..."
msgstr "Tego... chyba nie wolno robić..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.GENERIC"
msgid "Hey %s! Whatcha up to?"
msgstr "Hej, %s! Co robisz?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.GHOST"
msgid "Don't worry! We're sure there's a heart around here somewhere!"
msgstr "Nie martw się! Jesteśmy pewni, że znajdziemy w okolicy jakieś serce."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.MURDERER"
msgid "Why would you do that, %s?"
msgstr "Dlaczego, %s...?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT.REVIVER"
msgid "Whew, thanks %s!"
msgstr "Uff, dzięki, %s!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "Wurt won't let us play with her mud wand, even after we shared our snacks!"
msgstr "Wurt nie pozwala nam bawić się błotną różdżką. Nawet po tym, jak podzieliliśmy się z nią przekąskami!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "Wurt won't let us play with her mud wand, even after we shared our snacks!"
msgstr "Wurt nie pozwala nam bawić się błotną różdżką. Nawet po tym, jak podzieliliśmy się z nią przekąskami!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.ATTACKER"
msgid "We thought you were a friendly robot, %s!"
msgstr "Myśleliśmy, że jesteś przyjacielskim robotem, %s!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.FIRESTARTER"
msgid "Maybe they didn't know fire is dangerous to us."
msgstr "Być może nie wie, jak niebezpieczny jest dla nas ogień."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.GENERIC"
msgid "Hi %s! You look very non-organic today!"
msgstr "Witaj, %s! Wyglądasz dziś bardzo nieorganicznie!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.GHOST"
msgid "Bad day destroying humans, %s? Tomorrow will be better!"
msgstr "Kiepski ci idzie niszczenie ludzkości, %s? Jutro będzie lepiej!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.MURDERER"
msgid "Let us introduce you to our world wide web! Sh-sha!"
msgstr "Pozwól, że przedstawimy ci sieć lokalną! Sz-sza!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WX78.REVIVER"
msgid "Aww. We'd beep-boop %s on the nose if they had one!"
msgstr "Oooch, %s. Pstryknęlibyśmy cię w nos, gdybyś go tylko miał."

