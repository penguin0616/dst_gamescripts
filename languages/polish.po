msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMHOLE"
msgid "That was a scary hole!"
msgstr "Straszna ta dziura!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS"
msgid "Ohhh nooo. We're not friends with worms!"
msgstr "Ooooch, nieeee. Nie przyjaźnimy się z robakami!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORMS_BOSS"
msgid "Yikes! Here comes a BIG worm!"
msgstr "Ojej! Ale wielgachny robal!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
