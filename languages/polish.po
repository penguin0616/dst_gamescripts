msgstr "Poświęcaj zdrowie, by tworzyć mięśniaki."

#. STRINGS.SKILLTREE.WORMWOOD.LUREPLANTCRAFTING_TITLE
msgctxt "STRINGS.SKILLTREE.WORMWOOD.LUREPLANTCRAFTING_TITLE"
msgid "Lureplant Crafting"
msgstr "Tworzenie mięśniaków"

#. STRINGS.SKILLTREE.WORMWOOD.MOON_CAP_EATING_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.MOON_CAP_EATING_DESC"
