msgid "I get the feeling... that this meant a great deal to someone."
msgstr "Mam przeczucie... że to wiele znaczyło dla kogoś."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Luck has long since abandoned me..."
msgstr "Szczęście dawno mnie opuściło..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUCY"
msgid "Hello... \"Lucy\"... I'd like you to meet my sister."
msgstr "Witaj... „Lucy”... Poznaj moją siostrę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUMPY_SAPLING"
msgid "This life appeared from nowhere."
msgstr "To życie pojawiło się znikąd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARFROG"
msgid "What horrors have you seen, little frog?"
msgstr "Jakie potworności widziałaś, żabko?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANTHAT"
msgid "It lets me hide my face from the world."
msgstr "Pozwoli mi ukryć twarz przed światem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_HUSK"
msgid "It can't hurt anyone anymore."
msgstr "Już nikogo nie skrzywdzi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARPLANT_KIT"
msgid "You can't always fix what's broken. But sometimes you can."
msgstr "Nie zawsze da się coś naprawić. Ale czasem tak."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "Beautiful and fragile."
msgstr "Piękny i delikatny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARRIFT_PORTAL"
msgid "A gaping wound in the sky."
msgstr "Otwarta rana na niebie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT"
msgid "Others must suffer for it to survive."
msgstr "Aby mogła przeżyć, inni muszą cierpieć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "It's lashing out."
msgstr "Wścieka się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE"
msgid "Will I be able to create anything of use?"
msgstr "Czy dam radę stworzyć cokolwiek przydatnego?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_FORGE_KIT"
msgid "I should try to put these scattered pieces together..."
msgstr "Powinnam spróbować złożyć te rozrzucone elementy…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_GRAZER"
msgid "Will you grant me the eternal slumber I seek?"
msgstr "Czy pozwolisz mi na upragniony wieczny odpoczynek?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUNAR_SEED"
msgid "All that remains is its crown."
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANT"
msgid "It consumes all."
msgstr "Pożera wszystko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUREPLANTBULB"
msgid "Life goes on."
msgstr "Życie toczy się dalej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LUTEFISK"
msgid "Maybe I'll try just a bite."
msgstr "Może tylko gryza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MADSCIENCE_LAB"
msgid "Madness lies within."
msgstr "Nasze wnętrze toczy obłęd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAGICIAN_CHEST"
msgid "You can't use a magic box for hide-and-seek, that's cheating."
msgstr "Nie można używać magicznej skrzyni do zabawy w chowanego, bo to oszustwo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS"
msgid "What a horrid bird!"
msgstr "Cóż za wstrętne ptaszysko!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_BEAK"
msgid "How gruesome."
msgstr "Makabryczne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHER"
msgid "It won't be needing these anymore."
msgstr "Nie będą mi już potrzebne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "My fingers ache from sewing in all those feathers."
msgstr "Palce mnie bolą od przyszywania tych wszystkich piór."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MALE_PUPPET"
msgid "I wonder what he did."
msgstr "Ciekawe, co zrobił."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE"
msgid "Alas, poor mandrake!"
msgstr "Biedna mandragoro!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKESOUP"
msgid "Boiled the life out of him."
msgstr "Wygotowałam z niej ostatnie resztki życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Onward, vegetable minion!"
msgstr "Ku zwycięstwu, warzywny sługo!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_COOKED"
msgid "Now it's just food."
msgstr "Teraz jest zwykłym jedzeniem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANDRAKE_PLANTED"
msgid "The mighty mandrake. It's best picked at night."
msgstr "Potężna mandragora. Najlepiej zbierać ją w nocy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MANRABBIT_TAIL"
msgid "It contains his fuzzy wuzzy essence."
msgstr "Zawiera kwintesencję jego futerkowej miękkości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAPSCROLL"
msgid "Blank as Abigail now."
msgstr "Biała jak Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLE"
msgid "Smooth and lifeless."
msgstr "Gładki i pozbawiony życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN"
msgid "Cold... but not lifeless..."
msgstr "Zimna... ale niepozbawiona życia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "It cares nothing for the laws of this world..."
msgstr "W nosie ma prawa rządzące tym światem..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLEPILLAR"
msgid "Even stone can not withstand the constant pull of decay."
msgstr "Nawet kamień nie oprze się zębom czasu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLESHRUB"
msgid "Against all odds, it has flourished in life..."
msgstr "Żyje wbrew wszelkim przeciwnościom..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARBLETREE"
msgid "Be ye alive or be ye dead?"
msgstr "Żyjesz ty czy jednak nie żyjesz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Even thorns burn."
msgstr "Nawet ciernie płoną."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.BURNT"
msgid "The end."
msgstr "Koniec."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "A bush that always hurts."
msgstr "Krzew, który zadaje ból."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Life is pain. Now it has no life."
msgstr "Życie to ból. Ale nie ma tu już życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_PLANT"
msgid "It's a plant."
msgstr "Zwykła roślina."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNING"
msgid "It's burning."
msgstr "Płonie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.BURNT"
msgid "Black like my heart."
msgstr "Czarne. Jak me serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Its spikes were no protection."
msgstr "Kolce nie zapewniły mu bezpieczeństwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A tree that knows only pain."
msgstr "Drzewo, które zna tylko ból."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASHEDPOTATOES"
msgid "My stomach rumbles just looking at it..."
msgstr "W brzuchu mi burczy od samego patrzenia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_FOOLHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_HALFWITHAT"
msgid "I already mask my emotions."
msgstr "Już i tak maskuję swoje emocje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_KINGHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_MIRRORHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_QUEENHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_SAGEHAT"
msgid "I already mask my emotions."
msgstr "Już i tak maskuję swoje emocje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TOADYHAT"
msgid "I already mask my emotions."
msgstr "Już i tak maskuję swoje emocje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASK_TREEHAT"
msgid "To become someone else, even for a moment..."
msgstr "Stać się kimś innym, chociaż na moment..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST"
msgid "If we sailed forever we would never reach the horizon."
msgstr "Nawet jeśli będziemy wiecznie żeglować, nigdy nie wypłyniemy poza horyzont."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "A meager light to combat the darkness."
msgstr "Mdłe światełko do walki z ciemnością."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "A meager light to combat the darkness."
msgstr "Mdłe światełko do walki z ciemnością."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "How long before that fire in your eyes goes out?"
msgstr "Kiedy ogień w twoich oczach zgaśnie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Alas, being struck down by lightning is one less thing I can look forward too."
msgstr "Niestety, nie mogę już wyczekiwać trafienia piorunem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_ITEM"
msgid "It's for making a mast."
msgstr "Do budowy masztu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS"
msgid "Fly me away from this place."
msgstr "Zabierz mnie stąd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "That's alright, I can manage it."
msgstr "W porządku, poradzę sobie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD"
msgid "Maybe I could sail far away..."
msgstr "Może odpłynę gdzieś daleko…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAST_YOTD_ITEM"
msgid "It's for making a mast."
msgstr "Do budowy masztu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELL"
msgid "I feel a strange kinship with him."
msgstr "Czuję do niego niewytłumaczalną sympatię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLHEAD"
msgid "He sure has a taste for the dramatic."
msgstr "Lubi dramatyzować."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLIGHT"
msgid "What a curious light."
msgstr "Ależ dziwne światło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLLOCK"
msgid "Looks magical."
msgstr "Wygląda magicznie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Shall we have a danse macabre?"
msgstr "Czas na danse macabre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MAXWELLTHRONE"
msgid "Not quite what I expected."
msgstr "Nie tego oczekiwałam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT"
msgid "It is still bloody."
msgstr "Krew jeszcze w nim płynie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATBALLS"
msgid "Balled meat. How exciting."
msgstr "Mięso w kulkach. Niesamowite."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.BURNT"
msgid "It's done drying. Forever."
msgstr "Jest wyschnięte. Na zawsze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE"
msgid "The drying is over."
msgstr "Wysuszone."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Wysuszone."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING"
msgid "It sways in the drying wind."
msgstr "Zachodni wiatr mięsne kąski suszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Deszcz wszystko psuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Deszcz wszystko psuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Zachodni wiatr mięsne kąski suszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK.GENERIC"
msgid "I can hang meat here."
msgstr "Mogę tu powiesić mięso."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It's done drying. Forever."
msgstr "Jest wyschnięte. Na zawsze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The drying is over."
msgstr "Wysuszone."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Wysuszone."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "It sways in the drying wind."
msgstr "Zachodni wiatr mięsne kąski suszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "Deszcz wszystko psuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "The rain is keeping it from drying."
msgstr "Deszcz wszystko psuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Zachodni wiatr mięsne kąski suszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "One can't survive long without food..."
msgstr "Nie można długo przeżyć bez jedzenia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATYSALAD"
msgid "This salad tastes strange..."
msgstr "Ta sałatka dziwnie smakuje..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEAT_DRIED"
msgid "Meat turned dry and delicious."
msgstr "Mięso. Suche i pyszne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEGAFLARE"
msgid "I could just let the monsters come for me..."
msgstr "Mogłabym po prostu pozwolić potworom mnie dorwać..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM"
msgid "Horrid swamp thing!"
msgstr "Paskudny bagienny stwór!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORHAT"
msgid "I'm not a merm."
msgstr "Nie jestem mermką."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "I'm not a merm."
msgstr "Nie jestem mermką."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD"
msgid "Friend or foe?"
msgstr "Przyjaciel czy wróg?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_LUNAR"
msgid "Their eyes... they're so vacant and cold..."
msgstr "Ich oczy… Takie puste i zimne…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMGUARD_SHADOW"
msgid "You shed everything you were. Does it feel... good?"
msgstr "Porzuciliście to, czym wcześniej byliście. Czy to… przyjemne uczucie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHAT"
msgid "We all hide behind our own masks..."
msgstr "Wszyscy nosimy jakieś maski..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.BURNT"
msgid "Somehow, it found a way to sink even lower."
msgstr "Jakimś cudem znalazł sposób, by upaść jeszcze niżej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHEAD.GENERIC"
msgid "No dignity at all."
msgstr "Żadnej godności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.BURNT"
msgid "Fire has broken it down even further."
msgstr "Ogień dopełnił dzieła zniszczenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Time has broken it down."
msgstr "Widać zęby czasu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Nothing but ash."
msgstr "W proch się obrócił."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "It has not yet been touched by the ravages of time."
msgstr "Nie nosi jeszcze śladów upływu czasu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMKING"
msgid "He does look very regal, despite the warts."
msgstr "Wygląda królewsko, nawet pomimo kurzajek."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.BURNT"
msgid "Their kingdom vanishes as swiftly as it appeared."
msgstr "Ich królestwo znika równie szybko, co się pojawiło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE.GENERIC"
msgid "\"The Frogs Who Desired a King\"..."
msgstr "\"Żaby proszące o Króla\"..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "All that work, for nothing."
msgstr "Tyle roboty na nic."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "I don't know why you bother."
msgstr "Nie wiem, po co zawracać sobie tym głowę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "They fight without purpose..."
msgstr "Walczą bez celu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "They seem to not wish us harm, for now."
msgstr "Chyba nie chcą nas skrzywdzić. Póki co."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY"
msgid "\"Mermfolk Ownlee\"... hmph. How childish."
msgstr "„Dylgo dla mermów”. Pff… Dziecinada."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "\"Mermfolk Ownlee\"... hmph. How childish."
msgstr "„Dylgo dla mermów”. Pff… Dziecinada."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_LUNAR"
msgid "Their eyes... they're so vacant and cold..."
msgstr "Ich oczy… Takie puste i zimne…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_PRINCE"
msgid "Are you ready to shoulder the burdens of leadership?"
msgstr "Czy jesteś gotów wziąć na swe barki ciężar władzy?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_SHADOW"
msgid "You shed everything you were. Does it feel... good?"
msgstr "Porzuciliście to, czym wcześniej byliście. Czy to… przyjemne uczucie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL"
msgid "It's only slightly better than useless."
msgstr "O krok od bezużyteczności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED"
msgid "Father had a tool shed, though he hardly used it."
msgstr "Ojciec miał skład na narzędzia, choć rzadko go używał."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "Father had a tool shed, though he hardly used it."
msgstr "Ojciec miał skład na narzędzia, choć rzadko go używał."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "It's only slightly better than useless."
msgstr "O krok od bezużyteczności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLE"
msgid "I wonder what poor forgotten soul sent that."
msgstr "Ciekawe, jakaż to biedna dusza to wysłała."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "It holds nothing but emptiness."
msgstr "W całości pusta."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "It's nothing but ashes and memories."
msgstr "Teraz to tylko popiół i wspomnienia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "It seems strength can only be found through suffering."
msgstr "Wygląda na to, że siłę buduje się tylko przez cierpienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MILKYWHITES"
msgid "Ashes to ashes, dust to... this."
msgstr "Z prochu powstałeś... w to się obrócisz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINERHAT"
msgid "Hands-free lighting!"
msgstr "Oświetlenie bez trzymanki!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIBOATLANTERN"
msgid "Such a happy little glow... I despise it."
msgstr "Małe, wesołe światełko... Jakże nim gardzę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFAN"
msgid "When I am still, it is as lifeless as Abigail."
msgstr "Gdy się nie ruszam, jest zupełnie bez życia. Jak Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINIFLARE"
msgid "Why? No one will come."
msgstr "Po co? I tak nikt nie przyjdzie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.GENERIC"
msgid "Such a striking likeness..."
msgstr "Cóż za uderzające podobieństwo..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN.UNDRAWN"
msgid "It is bare..."
msgstr "Puściutki..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINISIGN_ITEM"
msgid "We must stick it in the cold, hard ground..."
msgstr "Musimy wetknąć go w zimną, twardą ziemię..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAUR"
msgid "He must be lonely, trapped in such a small cage."
msgstr "Na pewno jest samotny. Uwięziony w takiej małej klatce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURCHEST"
msgid "My, what magnificent horns you have!"
msgstr "Wspaniałe rogi!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MINOTAURHORN"
msgid "All that remains of a once great beast."
msgstr "Wszystko, co pozostało po niegdyś potężnej bestii."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.ABOVEGROUND"
msgid "You should go back to where it's dark."
msgstr "Powinieneś wrócić tam, gdzie jest ciemno."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.HELD"
msgid "How do you like being torn away from your family?"
msgstr "I jak ci się podoba być oddzielonym od najbliższych?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLE.UNDERGROUND"
msgid "Stay down there, away from this horrible place."
msgstr "Zostań tam, gdzie jesteś. Z dala od tego straszliwego miejsca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBAT"
msgid "Nature has played a cruel joke on this creature."
msgstr "Przyroda okrutnie zażartowała sobie z tego stworzenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEBATHILL"
msgid "Abigail keeps daring me to touch it..."
msgstr "Abigail ciągle namawia mnie, żebym tego dotknęła..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHAT"
msgid "So this is what those things see."
msgstr "A więc to widzą te stworzenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOLEHILL"
msgid "Down, down, down to the depths."
msgstr "W dół, w dół, w dół ku otchłani."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY"
msgid "Living without the burden of intelligence must be nice."
msgstr "Życie bez brzemienia inteligencji musi być fantastyczne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYBARREL"
msgid "It's filthy."
msgstr "Ohyda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.BURNT"
msgid "Charred remains are all that's left."
msgstr "Zostały tylko zwęglone szczątki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYHUT.GENERIC"
msgid "I never cared for climbing trees, no matter how many times Abby prodded me."
msgstr "Nigdy nie lubiłam łazić po drzewach, nawet gdy Abby mnie na to namawiała."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "For a moment I let myself imagine it might take me home... when will I learn?"
msgstr "A przez chwilę pozwoliłam sobie pomarzyć, że zabierze mnie do domu... kiedy ja się nauczę?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "The scattered remains of some ill-fated machine."
msgstr "Rozrzucone szczątki jakiejś pechowej maszyny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYPILLAR"
msgid "Her kingdom is built on nothing but sand, and one day it will topple."
msgstr "Jej królestwo zbudowano na piasku i pewnego dnia runie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYQUEEN"
msgid "Queens don't usually scratch their backsides in public, do they Abigail?"
msgstr "Królowe zazwyczaj nie drapią się publicznie po zadzie, prawda, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEYTAIL"
msgid "Oh. They're so soft. And fuzzy."
msgstr "Och. Są takie miękkie. I kudłate."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "A captain must go down with her ship."
msgstr "Kapitan musi zatonąć wraz ze swym statkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONKEY_SMALLHAT"
msgid "It makes my hair itch..."
msgstr "Swędzą mnie od niej włosy..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERLASAGNA"
msgid "Cooked evil is still evil. Even in lasagna."
msgstr "Pieczone zło nie przestaje być złem. Nawet jeśli to lazania."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT"
msgid "Evilness pervades it."
msgstr "Zło je przenika."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Meat turned dry and weird-tasting."
msgstr "Wyschło. I dziwnie smakuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MONSTERTARTARE"
msgid "Looks good, tastes horrible."
msgstr "Wygląda świetnie, smakuje paskudnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.BROKEN"
msgid "It's been ravaged by time."
msgstr "Nadgryziona zębem czasu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.GENERIC"
msgid "I felt a terrible chill run down my spine."
msgstr "Poczułam na kręgosłupie straszliwy chłód."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Bathed in pale eternal light..."
msgstr "Skąpany w bladym, przedwiecznym świetle..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.STAFFED"
msgid "Perhaps it thirsts for a sacrifice. Where's Webber..."
msgstr "Pewnie żąda ofiary... Gdzie Webber?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "That doesn't look right..."
msgstr "To nie wygląda dobrze..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Such beauty can never last."
msgstr "Takie piękno szybko przemija."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Give up. You won't escape my grasp."
msgstr "Poddaj się. Nie wyrwiesz się z moich rąk."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "It's the way of all things."
msgstr "Wszystko tak kiedyś skończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It grows, against all odds."
msgstr "Rośnie wbrew wszelkim przeciwnościom."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.CAVE"
msgid "Caves. The moon's one weakness."
msgstr "Jaskinie. Jedyna słabość Księżyca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GENERIC"
msgid "Does it reflect from the other side too, Abigail?"
msgstr "Czy po drugiej stronie też odbija, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.GLASSED"
msgid "It's staring at me."
msgstr "To coś się na mnie gapi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "A full moon looms overhead. Watchful."
msgstr "Księżyc patrzy na nas pełnią swej tarczy. Czuwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A new moon looms above us."
msgstr "Nowy Księżyc zawitał na niebo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "The moon is on the wane."
msgstr "Księżyc się zmniejsza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "The moon waxes before us."
msgstr "Księżyc rośnie na naszych oczach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS"
msgid "Its sharp edge would end this quickly."
msgstr "Ostra krawędź szybko to skończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASSAXE"
msgid "Death is so anticlimactic for trees."
msgstr "Śmierć drzew jest taka rozczarowująca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_CHARGED"
msgid "It feels almost alive, somehow."
msgstr "Jakimś cudem wydaje się niemal żywe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_ROCK"
msgid "What a sickly color."
msgstr "Co za niezdrowy kolor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "What lives within that cold glass mound?"
msgstr "Ciekawe, co żyje w tym zimnym, szklanym kopcu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKCRATER"
msgid "It's useless and missing a piece, much like me."
msgstr "Bezużyteczny i wybrakowany. Jak ja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKIDOL"
msgid "A lifeless sacrifice."
msgstr "Wyzuta z życia ofiara."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKNUGGET"
msgid "It's traveled so far..."
msgstr "Tyle przebył..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCKSEED"
msgid "Its pallor reminds me of Abigail."
msgstr "Ta bladość przywodzi mi na myśli Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONROCK_PIECES"
msgid "Now it will never decay..."
msgstr "Teraz nigdy nie zmarnieje..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSPIDERDEN"
msgid "Terrible creatures lurk within."
msgstr "Wewnątrz czają się przerażające stwory."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "Cold glass."
msgstr "Zimne w dotyku szkło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "There's light trapped inside."
msgstr "W środku uwięzione jest światło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "I shall be able to see with eyes unclouded."
msgstr "Z moich oczu opadnie mgła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_SPARK"
msgid "It doesn't feel of this world."
msgstr "Wydaje się nie z tego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC"
msgid "That looks rather dangerous... I wonder if he'd let me try."
msgstr "Wygląda dość niebezpiecznie... Ciekawe, czy pozwoli mi spróbować."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "I can see a little spark inside."
msgstr "Widzę w środku iskierkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Heehee. Yes, I'd love to hear a secret."
msgstr "Hi, hi. Tak, chciałabym poznać tajemnicę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "It doesn't feel good to be incomplete."
msgstr "Nieprzyjemnie jest czuć się niekompletnym."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "You are whole again."
msgstr "Znowu jesteś w jednym kawałku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "The whispers... are getting louder..."
msgstr "Szepty... robą się coraz głośniejsze..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_CROWN"
msgid "You're safe now."
msgstr "Teraz nic ci nie grozi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_GLASS"
msgid "It wants to find its missing pieces."
msgstr "Pragnie, bym odnalazła brakujące części."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ICON"
msgid "I will take you to your final resting place."
msgstr "Zabiorę cię do twojego ostatecznego miejsca spoczynku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Abby and I will help put you back together."
msgstr "Abby i ja pomożemy ci się zebrać do kupy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_LINK"
msgid "Is something hiding in there?"
msgstr "Czy coś się tam chowa?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "I sense a presence within..."
msgstr "Wyczuwam w tym jakąś obecność..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "I sense a presence within..."
msgstr "Wyczuwam w tym jakąś obecność..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "I sense a presence within..."
msgstr "Wyczuwam w tym jakąś obecność..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_SEED"
msgid "It wants some sort of energy."
msgstr "Chce jakiejś energii."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_ALTAR_WARD"
msgid "So lost and alone... my sister and I will help you."
msgstr "Jesteś taki samotny i zagubiony... Moja siostra i ja ci pomożemy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP"
msgid "It took nourishment from dead things, now its death will nourish me."
msgstr "Karmił się martwą materią, a teraz to ja pożywię się nim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_CAP_COOKED"
msgid "All is malleable."
msgstr "Wszystko da się dostosować do własnych potrzeb."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "There's so much left to be done..."
msgstr "Zostało jeszcze tyle do zrobienia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "It's quite odd looking, isn't it?"
msgstr "Dziwnie wgląda, nie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "How very peculiar."
msgstr "Bardzo dziwaczne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "I see the light."
msgstr "Widzę światło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Even the earth is falling apart under the pressure."
msgstr "Nawet ziemia się rozpada pod wpływem nacisków."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "They're trapped... for now."
msgstr "Są uwięzieni... Póki co."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNING"
msgid "Oh. It's burning."
msgstr "Och. Płonie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.BURNT"
msgid "Your suffering is over now."
msgstr "Twoje cierpienie dobiegło końca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.CHOPPED"
msgid "It's met its end at our hands."
msgstr "Spotkał je smutny koniec z naszych rąk."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE.GENERIC"
msgid "A fleeting beauty."
msgstr "Ulotne piękno."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Delicate and impermanent."
msgstr "Delikatne i nietrwałe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE"
msgid "It's an abomination."
msgstr "Odrażające."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSEEGG"
msgid "Not sure how a thing like that happens."
msgstr "Nie wiem, jak coś takiego w ogóle powstało."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "A cradle of life. I hate it."
msgstr "Kolebka życia. Nienawidzę jej!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOQUECA"
msgid "Thank-you, Warly."
msgstr "Dziękuję, Warly."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.GENERIC"
msgid "It thieves others' life to maintain its own."
msgstr "Kranie życie innych, by zachować własne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITO.HELD"
msgid "I can feel its stolen warmth."
msgstr "Czuję w rękach jego kradzione ciepło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOBOMB"
msgid "The enemies of my enemies are my mosquitoes."
msgstr "Wrogowie moich wrogów to moje komary."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOFERTILIZER"
msgid "The best nourishment is the lifeblood of another."
msgstr "Nic tak nie odżywia jak krew innych istot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMERMSALVE"
msgid "Don't worry, this will only hurt for a moment."
msgstr "Nie martw się. Będzie bolało tylko przez chwilę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOMUSK"
msgid "What an ugly little doll."
msgstr "Co za brzydka laleczka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSQUITOSACK"
msgid "A sack of blood ripped from a mosquito. I love it."
msgstr "Krwawy komarzy pęcherz. Uwielbiam go."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOSSLING"
msgid "A new life. The last thing anyone needs."
msgstr "Nowe życie. Ostatnia rzecz, której potrzebujemy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.DUG"
msgid "The earth has vomited up its secrets."
msgstr "Ziemia zwymiotowała swe tajemnice."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MOUND.GENERIC"
msgid "Some day, I will join you."
msgstr "Pewnego dnia do ciebie dołączę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULLEDDRINK"
msgid "Can it thaw a cold, broken heart?"
msgstr "Czy potrafi ogrzać zimne, złamane serce?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Its beauty is tinged with a heartbreaking sadness."
msgstr "Jego piękno skażone jest potwornym smutkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Cold and beautiful like death."
msgstr "Piękno i zimno godne śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "An item with multiple uses."
msgstr "Narzędzie o wielu zastosowaniach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHGNOME"
msgid "It's so... bouncy."
msgstr "Jest taki... sprężysty."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMBOMB"
msgid "Death in mushroom form."
msgstr "Śmierć w grzybnej formie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMHAT"
msgid "If I'm lucky, it'll be poisonous."
msgstr "Jeśli mam szczęście, jest trujący."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Death has released it."
msgstr "Dziecko śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "A death cap, surely."
msgstr "Śmiertelne nasienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "It is no more."
msgstr "Było i nie ma."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Emptiness. The natural state of all things."
msgstr "Pustka. Naturalny stan każdej rzeczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It thrives... against all odds..."
msgstr "Rosną... wbrew wszelkim przeciwnościom..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Nothing escapes the pull of decay."
msgstr "Nikt nie ucieknie przed długimi palcami zniszczenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "A frigid cold bites at its heart."
msgstr "W jej sercu zapanował mróz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The beginnings of life..."
msgstr "Początek życia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Completely teeming with life..."
msgstr "Aż kipi życiem..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Life goes on."
msgstr "Życie toczy się dalej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Oh look... A mushroom..."
msgstr "Ooo... Grzybek..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Abigail would have thought this was... pretty..."
msgstr "Abigail na pewno by się spodobała..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Nothing good may last."
msgstr "Nic, co dobre, nie trwa wiecznie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Let's turn it red as my heart's blood..."
msgstr "Niech będzie czerwony, jak krew mego serca..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Such a sickly fungal glow..."
msgstr "Przedziwna grzybna poświata..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Dobrze znam zapach śmierci i rozkładu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "All its efforts fall on rocky soil."
msgstr "Wszystkie jego starania napotykają kamienisty grunt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "It looks like a rotting hat."
msgstr "Wygląda jak gnijący kapelusz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_MOON"
msgid "Curiouser and curiouser."
msgstr "No to pa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Dobrze znam zapach śmierci i rozkładu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "It has a glowing presence."
msgstr "Roztacza wokół siebie poświatę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "Do little gnomes live in these?"
msgstr "Ciekawe, czy mieszkają w nich małe gnomy..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Dobrze znam zapach śmierci i rozkładu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "It's trying so hard. Why?"
msgstr "Ta bardzo się stara. Tylko po co?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "These are some strange trees."
msgstr "Bardzo dziwne drzewa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "I know the scent of death and decay."
msgstr "Dobrze znam zapach śmierci i rozkładu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "This one is frail and scorned. Like a friend."
msgstr "Ktoś tu chyba mieszka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDBEARGER"
msgid "Don't worry. Abby and I will put you out of your misery."
msgstr "Nie martw się. Razem z Abby skrócimy twoje męki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDDEERCLOPS"
msgid "Forced to continue its cursed existence... I pity it."
msgstr "Zmuszony do dalszego, przeklętego życia… Współczuję."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "It's better this way."
msgstr "Dobrze się stało."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "For this creature, to live is to suffer."
msgstr "Dla tego stworzenia życie jest cierpieniem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Don't wake up."
msgstr "Nie budź się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATEDWARG"
msgid "It only lives for malice."
msgstr "Żyje tylko, by czynić zło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "It's better this way."
msgstr "Dobrze się stało."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "To let it live would be a cruelty."
msgstr "Pozwolić mu żyć byłoby okrucieństwem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "Don't wake up."
msgstr "Nie budź się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_DROPPER"
msgid "Webber sees the world in a most curious way."
msgstr "Webber postrzega świat w bardzo dziwny sposób."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HEALER"
msgid "It's the only thing smiling around here."
msgstr "To jedyne uśmiechnięte coś w okolicy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_HIDER"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Skoro upiekłeś ciasteczka, możesz przyprowadzić na herbatkę jednego ze swoich pajęczych przyjaciół."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_MOON"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Skoro upiekłeś ciasteczka, możesz przyprowadzić na herbatkę jednego ze swoich pajęczych przyjaciół."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_SPITTER"
msgid "It's the only thing smiling around here."
msgstr "To jedyne uśmiechnięte coś w okolicy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WARRIOR"
msgid "Very well, since you made the cookies you can bring one spider friend to our tea party."
msgstr "Skoro upiekłeś ciasteczka, możesz przyprowadzić na herbatkę jednego ze swoich pajęczych przyjaciół."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MUTATOR_WATER"
msgid "Webber sees the world in a most curious way."
msgstr "Webber postrzega świat w bardzo dziwny sposób."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NATURE_BLUEPRINT"
msgid "Do you like this one, Abigail?"
msgstr "Podoba ci się, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTCAPHAT"
msgid "There are so few comforts to be found in this wretched place."
msgstr "Na tym padole łez tylko kilka rzeczy daje ukojenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTLIGHT"
msgid "Eerie, and yet beautiful."
msgstr "Przedziwna i na swój sposób piękna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREFUEL"
msgid "With the sleep of dreams comes this stuff."
msgstr "Produkt sennych koszmarów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREGROWTH"
msgid "Something wicked this way comes."
msgstr "Droga w nieznane."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARELIGHT"
msgid "It pulls power from beneath."
msgstr "Czerpie moc z podziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMAREPIE"
msgid "It tastes like melancholy. Mmm."
msgstr "Smakuje melancholią. Pycha."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "I know not what lurks in the shadow."
msgstr "Nie mam pojęcia, co czai się w mroku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "It's almost over."
msgstr "To już prawie koniec."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The presence has departed."
msgstr "Obecność rozwiała się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "They're all around!"
msgstr "Są wszędzie!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "I think they're leaving."
msgstr "Chyba odchodzą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I can feel the prying eyes."
msgstr "Czuję spojrzenie ciekawskich oczu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "They approach."
msgstr "Nachodzą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSTICK"
msgid "Danger in the dark."
msgstr "Niebezpieczeństwo w mroku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NIGHTSWORD"
msgid "Dreams come to a point. A sharp one."
msgstr "Sny mają swe granice. Ostre granice."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE"
msgid "Herein lies the folly of man."
msgstr "Oto dzieło szalonego umysłu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NITRE_FORMATION"
msgid "It thrives while the rest of us burn."
msgstr "Rośnie w siłę, kiedy my cierpimy z piekącego bólu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "I used to like reading about plants... I suppose this is similar in a way."
msgstr "Kiedyś lubiłam czytać o roślinach... Przypuszczam, że to daje podobny efekt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR"
msgid "I'd prefer to be stranded at sea."
msgstr "Wolałabym zostać porzucona na morzu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_DRIFTWOOD"
msgid "Just when it thought it had escaped the ocean..."
msgstr "A już myślałam, że uciekłam przed oceanem..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OAR_MONKEY"
msgid "It slices through the waves without mercy."
msgstr "Bezlitośnie tnie fale."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.EMPTY"
msgid "If only my tears could dry up like this lake."
msgstr "Gdyby tylko moje łzy mogły wyschnąć tak, jak to jezioro."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OASISLAKE.GENERIC"
msgid "A place to drown my sorrows."
msgstr "Miejsce, gdzie mogę utopić me smutki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Nothing but grass and muck."
msgstr "Tylko trawa i breja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "The line seems terribly bare... perhaps it needs something..."
msgstr "Żyłka wygląda przeraźliwie pusto... Może czegoś jej trzeba..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "It floats happily until something drags it under."
msgstr "Unosi się radośnie, póki coś nie wciągnie go pod powierzchnię."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Perhaps it's poisoned?"
msgstr "Może jest zatruta?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "I'll never catch a fish as heavy as my heart."
msgstr "Nigdy nie złapię ryby przewyższającej ciężarem moje zmartwienia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "The rain will mask my tears of boredom..."
msgstr "Deszcz ukrywa moje łzy nudy..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "How miserable."
msgstr "Przygnębiające."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "A paltry last meal for the fish."
msgstr "Licha i ostatnia rybia wieczerza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISHINGROD"
msgid "The depths will offer no safety from my hook."
msgstr "Nie skryjecie się w głębinach przed mym haczykiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "What a horrendous looking creature."
msgstr "Cóż za potwornie wyglądające stworzenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "I'm afraid your time is up."
msgstr "Obawiam się, że nadszedł twój czas."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "It fought hard to live. A shame, really."
msgstr "Dzielnie walczyła o życie. Doprawdy szkoda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "My luck couldn't possibly be worse than it already is."
msgstr "Chyba nie mogę mieć większego pecha."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Its existence must be so confusing."
msgstr "Jej żywot musi być bardzo konfundujący."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "It's almost too pretty to eat. Almost."
msgstr "Prawie zbyt piękna, by ją zjeść. Prawie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "It's almost too pretty to eat. Almost."
msgstr "Prawie zbyt piękna, by ją zjeść. Prawie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It has no warmth... like my life without Abigail."
msgstr "Nie ma w sobie ciepła... Tak jak moje życie bez Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "A fish, by any name, should not smell sweet."
msgstr "Żadna ryba nie powinna słodko pachnieć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_1"
msgid "It didn't have enough time to grow."
msgstr "Nie zdążyła urosnąć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_2"
msgid "I'm afraid you've splished your last splash."
msgstr "Obawiam się, że to był twój ostatni plusk."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_3"
msgid "I suppose it will do for now."
msgstr "Na razie musi wystarczyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_4"
msgid "All my efforts reap only the smallest rewards."
msgstr "Nagroda niewspółmierna do wysiłku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_5"
msgid "It looks oddly... crunchy?"
msgstr "Wygląda dziwnie... chrupiąco?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_6"
msgid "It already reeks of decay."
msgstr "Już cuchnie rozkładem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Hmph. I see no resemblance."
msgstr "Hmpf. Nie widzę podobieństwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_8"
msgid "The sun has set on your time in this world."
msgstr "Słońce twego życia już zaszło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANFISH_SMALL_9"
msgid "What a rude little creature."
msgstr "Co za niegrzeczne stworzonko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE"
msgid "Its roots have the appearance of sunbleached bones."
msgstr "Jego korzenie wyglądają jak kości, które wyblakły na słońcu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREENUT"
msgid "How strange that it doesn't drown when dropped to the bottom of the ocean."
msgstr "Dziwne, że nie tonie, gdy ktoś rzuci go na dno oceanu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANTREE_PILLAR"
msgid "It reminds me of happier days, sitting in the dappled shade..."
msgstr "Przypomina mi szczęśliwsze czasy, gdy przesiadywałam w nakrapianym słońcem cieniu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE"
msgid "This would make a good hangman's tree."
msgstr "Świetne drzewo dla wisielca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON"
msgid "Something sinister lurks above us."
msgstr "Nad nami czyha coś złowieszczego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "Nothing but ash remains."
msgstr "W proch się obróciło."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEANWHIRLPORTAL"
msgid "It calls to me."
msgstr "Wzywa mnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "I'm sorry. You are the unlucky ones."
msgstr "Przykro mi. Miałyście pecha."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Ah. Of course."
msgstr "Och. Oczywiście."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "Somehow, I managed to fix it."
msgstr "Jakimś cudem udało mi się go naprawić."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "The fish must die, so that I may prolong my own terrible existence."
msgstr "Ryby muszą umrzeć, abym ja mogła przedłużyć moją nędzną egzystencję."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "I shouldn't get my hopes up..."
msgstr "Nie powinnam robić sobie nadziei..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "Even I should be able to build it simply enough."
msgstr "Nawet mnie powinno się udać to zbudować."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.GENERIC"
msgid "Empty."
msgstr "Pusto."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "So even the merms have their limits."
msgstr "Czyli nawet mermowie mają jakieś ograniczenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "The merms are in an endless cycle of feeding. Give them more."
msgstr "Mermowie tkwią w nieskończonym cyklu jedzenia. Daj im więcej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "Empty."
msgstr "Pusto."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "So, even the merms have their limits."
msgstr "Czyli nawet mermowie mają jakieś granice."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "The merms are in an endless cycle of feeding. Give them more."
msgstr "Mermowie tkwią w nieskończonym cyklu jedzenia. Daj im więcej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONEMANBAND"
msgid "I used to take joy in instruments such as these."
msgstr "Kiedyś cieszyły mnie takie rzeczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION"
msgid "I never cry."
msgstr "Nigdy nie płaczę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_COOKED"
msgid "It will never make anyone cry again."
msgstr "Już nikt przez nią nie zapłacze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_OVERSIZED"
msgid "You won't draw any tears from me."
msgstr "Nie wyciśniesz ze mnie żadnych łez."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ONION_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALPRECIOUSGEM"
msgid "I see a million sad eyes reflecting back at me..."
msgstr "Widzę odbicie miliona smutnych oczu..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OPALSTAFF"
msgid "As cold and lifeless as... well..."
msgstr "Zimne i pozbawione życia, tak jak... no cóż..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEAMULET"
msgid "Temporary release from drudgery."
msgstr "Tymczasowa przerwa od harówki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEGEM"
msgid "Such things used to bring me happiness."
msgstr "Kiedyś takie rzeczy sprawiały mi radość."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGEMOONEYE"
msgid "It sees all, and yet nothing."
msgstr "Widzi wszystko i nic."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ORANGESTAFF"
msgid "With each use the wielder dies and is again reborn."
msgstr "Każde jego użycie sprawia, że jego użytkownik to ginie i rodzi się na nowo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTER"
msgid "Is it true they hold paws while sleeping at sea to not get separated?"
msgstr "To prawda, że podczas snu na morzu trzymają się za łapki, by się nie rozdzielić?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.GENERIC"
msgid "It has nothing."
msgstr "Niczego nie posiada."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "If I take what's there, the creature may starve."
msgstr "Jeśli wszystko stąd zabiorę, to stworzenie może umrzeć z głodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.OTTERDEN_DEAD"
msgid "I had a feeling it would end at sea."
msgstr "Tak czułam, że doczekam końca na morzu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONETREE"
msgid "Your hardened exterior won't protect you from the world."
msgstr "Twoja twarda powłoka nie uchroni cię przed światem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SAPLING"
msgid "It may yet have the chance to grow up."
msgstr "Może będzie mieć jeszcze szanse, żeby urosnąć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SCALE"
msgid "I warned you that your armor wouldn't protect you."
msgstr "Ostrzegałam, że twój pancerz cię nie ochroni."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PALMCONE_SEED"
msgid "A tree that has barely begun to live."
msgstr "Drzewo, które dopiero co zaczęło żyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANDORASCHEST"
msgid "Life is a gamble."
msgstr "Życie to definicja ryzyka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANETTONE"
msgid "It's... delicious."
msgstr "To jest... przepyszne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PANFLUTE"
msgid "Music is the window to my empty soul."
msgstr "Muzyka jest oknem do mej pustej duszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PAPYRUS"
msgid "For documenting my pain."
msgstr "Przeleję nań swój ból."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PAVLOVA"
msgid "It's brittle and delicate, like life itself."
msgstr "Krucha i delikatna, jak życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEGHOOK"
msgid "Abigail will defend me."
msgstr "Abigail mnie osłoni."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PENGUIN"
msgid "All dressed up, but where to go?"
msgstr "Strój wyjściowy, ale gdzież w nim iść?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER"
msgid "It looks so tiny and insignificant."
msgstr "Wygląda na małą i nieważną."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPERPOPPER"
msgid "They're so good I almost forgot my crushing grief."
msgstr "To jest tak dobre, że niemal zapomniałam o swym przejmującym smutku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_COOKED"
msgid "What can this tiny plant possibly do to fill my empty life?"
msgstr "Cóż może ta mała roślinka, aby uczynić me życie pełniejszym?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_OVERSIZED"
msgid "That is a very significant amount of pepper."
msgstr "To bardzo duża papryka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEPPER_SEEDS"
msgid "Will I live to see this grow?"
msgstr "Czy dożyję, aż wyrośnie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERD"
msgid "Dumb bird! Stay away from the berries!"
msgstr "Głupie ptaszysko! Zostaw te porzeczki!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDFAN"
msgid "It's... surprisingly soft."
msgstr "Jest... zaskakująco miękki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.BURNT"
msgid "Black like my heart."
msgstr "Czarna. Jak me serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.EMPTY"
msgid "It's empty..."
msgstr "Pusta..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PERDSHRINE.GENERIC"
msgid "It hungers for a sacrifice."
msgstr "Pragnie ofiar."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PEROGIES"
msgid "A lovely little pouch of nutrients."
msgstr "Małe, urocze, odżywcze sakiewki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS"
msgid "Its joy was so disparaging..."
msgstr "Cóż za uwłaczająca mi radość. Dobrze, że już po niej..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETALS_EVIL"
msgid "They are painted with the colors of my soul."
msgstr "Pomalowane barwami mej duszy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PETRIFIED_TREE"
msgid "Now it will never die..."
msgstr "Teraz już nigdy nie umrze..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PHLEGM"
msgid "The wretched beast must have been sick."
msgstr "Bestia najwyraźniej była chora."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PHONOGRAPH"
msgid "Shall we have a danse macabre?"
msgstr "Czas na danse macabre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE"
msgid "That the earth itself might be penetrated."
msgstr "Narzędzie do penetrowania ziemi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "It makes the endless toil a bit easier."
msgstr "Ułatwia trochę ten wieczny mozół."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PICKLEDHERRING"
msgid "It tastes... good."
msgstr "Smakuje... dobrze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE1"
msgid "A storm rages within him."
msgstr "W jego wnętrzu gotuje się burza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE2"
msgid "Furious."
msgstr "Co za furia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE3"
msgid "His whole career is grounded in violence."
msgstr "Cała jego kariera opiera się na przemocy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITE4"
msgid "Petrifying."
msgstr "Robi wrażenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER1"
msgid "A storm rages within him."
msgstr "W jego wnętrzu gotuje się burza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER2"
msgid "Furious."
msgstr "Co za furia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER3"
msgid "His whole career is grounded in violence."
msgstr "Cała jego kariera opiera się na przemocy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGELITEFIGHTER4"
msgid "Petrifying."
msgstr "Robi wrażenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGUARD"
msgid "This little piggie looks mean."
msgstr "Ten prosiak nie wygląda przyjaźnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGGYBACK"
msgid "They are more useful in death."
msgstr "Po śmierci na więcej się nadają."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.BURNT"
msgid "He's been burnt down."
msgstr "Odszedł w płomieniach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHEAD.GENERIC"
msgid "Kill the pig! Spill his blood!"
msgstr "Zabić świniaka! Przelać jego krew!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.BURNT"
msgid "Nothing lasts forever."
msgstr "Nic nie trwa wiecznie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.FULL"
msgid "I hope they're enjoying themselves."
msgstr "Mam nadzieję, że dobrze się bawią."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.GENERIC"
msgid "At least they are comfortable."
msgstr "Przynajmniej żyją sobie wygodnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Always on the outside, looking in."
msgstr "Zawsze wykluczona, zerkam tylko do wewnątrz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGKING"
msgid "Live it up while you can, Your Majesty."
msgstr "Korzystaj z życia, póki możesz, Wasza Wysokość."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.DEAD"
msgid "He's better off, now."
msgstr "Tak będzie dla niego lepiej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.FOLLOWER"
msgid "I still feel alone."
msgstr "Mimo wszystko czuję się samotna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GENERIC"
msgid "They are so standoffish."
msgstr "Są tacy nieprzystępni."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.GUARD"
msgid "How Orwellian."
msgstr "Miałam kiedyś kolegę Orwella. Miałby parę słów do powiedzenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGMAN.WEREPIG"
msgid "A creature of the night!"
msgstr "Stworzenie ze świata mroku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.BURNT"
msgid "Ashes to ashes."
msgstr "Poszła z dymem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.EMPTY"
msgid "It needs a sacrifice of flesh."
msgstr "Trzeba tu ofiary z ciała."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A tribute to gluttony."
msgstr "Hołd złożony obżarstwu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGSKIN"
msgid "The hide of a pig that once was."
msgstr "Drugie życie świńskiego zadka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTENT"
msgid "The place where they wrap pigs in blankets."
msgstr "Świństwo w czystej postaci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIGTORCH"
msgid "It cuts at the darkness."
msgstr "Przecina ciemność jasnym płomieniem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_COIN"
msgid "It pays for a fleeting friendship."
msgstr "Opłaca się tym przelotne przyjaźnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIG_TOKEN"
msgid "Yet another unnecessary plaything."
msgstr "Kolejna bezużyteczna zabawka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE"
msgid "A tiny life, ensconced in brittle death."
msgstr "Malutkie życie w kruchej otoczce śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PINECONE_SAPLING"
msgid "A tree will grow soon."
msgstr "Wkrótce wyrośnie tu drzewo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_FLAG_POLE"
msgid "Those monkeys have no imagination. I've seen more macabre children's drawings."
msgstr "Te małpy nie mają wyobraźni. Widziałam dziecięce rysunki, które są bardziej makabryczne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PIRATE_STASH"
msgid "Oh... did I... find the treasure?"
msgstr "Och... czy ja... znalazłam skarb?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PITCHFORK"
msgid "What a devilish tool!"
msgstr "Cóż to za diabelskie narzędzie?!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT"
msgid "It has a foul smell."
msgstr "Nie pachnie ładnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTMEAT_COOKED"
msgid "It's only slightly more appealing."
msgstr "Odrobinę bardziej zachęcające. Tylko odrobinę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANTREGISTRYHAT"
msgid "I don't like to play in the dirt..."
msgstr "Nie lubię grzebać w ziemi..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "An edible plant."
msgstr "Jadalna roślina."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Keep growing. I'll wait."
msgstr "Rośnij śmiało. Ja poczekam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.READY"
msgid "It is ready for the harvest."
msgstr "Można zbierać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's had the life sucked out of it."
msgstr "Życie całkowicie z niej uleciało."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "What a strange little story."
msgstr "Co za osobliwa opowiastka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Fun!"
msgstr "Fajne!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.ATTACKER"
msgid "%s... they'll betray us."
msgstr "%s... Twoja zdrada wisi w powietrzu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Do you wish to see the world burn?"
msgstr "Marzy ci się ujrzeć świat w płomieniach?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GENERIC"
msgid "How do you do, %s?"
msgstr "Jak się miewasz, %s?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.GHOST"
msgid "A heart could return %s to this world..."
msgstr "Serce mogłoby pomóc ci wrócić do świata żywych, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! Cutthroat!"
msgstr "Morderstwo! Zabójstwo!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER.REVIVER"
msgid "Abigail likes you, %s."
msgstr "Abigail cię lubi, %s."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "A souless existence."
msgstr "Bezduszne istnienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYER_HOSTED.ME"
msgid "I don't need another dead twin."
msgstr "Nie potrzebuję kolejnej martwej bliźniaczki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PLAYING_CARD"
msgid "A single playing card. Great."
msgstr "Pojedyncza karta do gry. Wspaniale."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "Tools for watch surgery."
msgstr "Narzędzia do grzebania w bebechach zegarków."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Obserwowanie mijających sekund jest kojące."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "Its power is spent."
msgstr "Wyczerpały mu się baterie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PARTS"
msgid "Clock entrails."
msgstr "Wnętrzności zegarka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Obserwowanie mijających sekund jest kojące."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "Its power is spent."
msgstr "Wyczerpały mu się baterie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "What will I find if I take a tumble down the rabbit hole?"
msgstr "Co znajdę, gdy wpadnę do króliczej nory?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "What will I find if I take a tumble down the rabbit hole?"
msgstr "Co znajdę, gdy wpadnę do króliczej nory?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "I'm afraid the past is just as dreadful as the future."
msgstr "Obawiam się, że przeszłość jest równie przerażająca jak przyszłość."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Obserwowanie mijających sekund jest kojące."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "Its power is spent."
msgstr "Wyczerpały mu się baterie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Abigail... do you think...?"
msgstr "Abigail... Naprawdę myślisz...?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "Its power is spent."
msgstr "Wyczerpały mu się baterie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "It's soothing to watch the seconds tick away."
msgstr "Obserwowanie mijających sekund jest kojące."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "Its power is spent."
msgstr "Wyczerpały mu się baterie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "Nothing could be as painful as my own memories."
msgstr "Nie ma nic boleśniejszego od moich własnych wspomnień."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POCKET_SCALE"
msgid "What is the weight of my actions?"
msgstr "Jaki jest ciężar mych czynów?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLISHCOOKIE"
msgid "I suppose... it wouldn't hurt to have one..."
msgstr "Chyba... jedno nie zaszkodzi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERS"
msgid "I would have preferred a raven."
msgstr "Wolałabym kruka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POLLY_ROGERSHAT"
msgid "The hat of a cutthroat pirate."
msgstr "Czapka bezwzględnego pirata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE"
msgid "So many juicy red bits to chomp and squish!"
msgstr "Mnóstwo soczystych czerwonych nasionek do schrupania i rozgniecenia!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_COOKED"
msgid "Warm, but no less messy."
msgstr "Ciepły, ale robi tyle samo bałaganu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "I wonder how long a single seed would keep one trapped in the underworld..."
msgstr "Ciekawe, jak długo jedno nasiono zdołałoby więzić kogoś w podziemnym świecie..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POMEGRANATE_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Roślina, która pragnie zaistnieć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POND"
msgid "Ophelia? Are you down there?"
msgstr "Ofelia? Jesteś tam?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDEEL"
msgid "An eel."
msgstr "Tak wygląda węgorz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PONDFISH"
msgid "It was flopping around desperately for life. The poor fool."
msgstr "Wiła się żałośnie w poszukiwaniu życia. Niemądre stworzenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POND_ALGAE"
msgid "Some algae."
msgstr "Jakieś algi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POOP"
msgid "Life is blood and this."
msgstr "Życie – krew i to."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "Inflicts chaos and turmoil on food."
msgstr "Wywołuje chaos i zamieszanie wśród produktów spożywczych."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "I may starve to death before it's done."
msgstr "Może umrę z głodu, zanim będzie gotowe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "It will all be over soon."
msgstr "Wkrótce będzie po wszystkim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Another menial task has been completed."
msgstr "Kolejne nudne zadanie zostało wykonane."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "A foodless void."
msgstr "Bezdaniowa pustka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "For when the hunger gnaws at my tiny stomach..."
msgstr "Coś do walki z małym głodem..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "I may carry warmth with me, yet I am ever cold."
msgstr "Choć noszę przy sobie ciepło, zawsze jest mi lodowato."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Finished."
msgstr "Skończone."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "If only it could spice up my life."
msgstr "Gdyby tylko mogło dodać pikanterii mojemu życiu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT"
msgid "It makes no difference where I rest my head, my nights are filled with bad dreams."
msgstr "Nie ma różnicy, gdzie złożę głowę wieczorem, i tak noc będzie pełna koszmarów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PORTABLETENT_ITEM"
msgid "Abigail and I set up a tent in our backyard once. It was... fun."
msgstr "Kiedyś z Abigail rozstawiłyśmy namiot w ogródku. Było... fajnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO"
msgid "It has eyes, yet it never cries."
msgstr "Ma oczy, a jednak nigdy nie płacze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSACK"
msgid "Large enough to hold a corpse... or a few dozen potatoes."
msgstr "Wystarczająco duży, żeby zmieścić zwłoki... albo kilka tuzinów ziemniaków."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOSOUFFLE"
msgid "A dish as delicate as life itself."
msgstr "Danie delikatne niczym samo życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATOTORNADO"
msgid "Spiraling, just like my life."
msgstr "W kawałeczkach. Jak moje życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_COOKED"
msgid "Now its eyes will never open."
msgstr "Teraz nigdy już nie otworzy oczu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_OVERSIZED"
msgid "I'm not sure if I could even carry it on my own..."
msgstr "Chyba sama nie dałabym go rady udźwignąć..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POTTEDFERN"
msgid "Its growth is stunted by the limits of the pot."
msgstr "Jej wzrost ograniczony jest pojemnością donicy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POWCAKE"
msgid "I would have to be desperate."
msgstr "Musiałabym być naprawdę zdesperowana."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.POWDER_MONKEY"
msgid "What more can be taken from me?"
msgstr "Co jeszcze można mi odebrać?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "Dry as a bone..."
msgstr "Wyschnięta na wiór..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "What an odd looking watering can."
msgstr "Co za dziwna konewka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PRIME_MATE"
msgid "What it must be like to live unburdened by intelligence?"
msgstr "Ciekawe, jak to jest żyć bez obciążenia, jakim jest inteligencja?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.GENERIC"
msgid "Oh, to be so carefree."
msgstr "Ach, żeby móc być tak beztroską."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.HELD"
msgid "Life is not fair, is it?"
msgstr "Życie nie jest sprawiedliwe, prawda?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUFFIN.SLEEPING"
msgid "It slumbers soundly."
msgstr "Drzemie równo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN"
msgid "It's as big as the hole where my heart once was."
msgstr "Ogromna niczym dziura, w której ongiś biło me serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCARVER"
msgid "I love a pumpkin gutting contest."
msgstr "Uwielbiam konkurs na patroszenie dyni."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINCOOKIE"
msgid "Why indulge in such childish things?"
msgstr "Co za dziecinada."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKINPIE"
msgid "Is it sweet enough to help me forget the bitterness in my heart?"
msgstr "Czy jest dość słodkie, bym mogła zapomnieć o goryczy w mym sercu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_COOKED"
msgid "It shriveled a tiny bit from the heat. I like that."
msgstr "Skurczyła się trochę od ciepła. Podoba mi się."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_LANTERN"
msgid "You're not so scary."
msgstr "Nie boję się ciebie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "If only it could become a carriage and carry me far away from here."
msgstr "Szkoda, że nie może przemienić się w karocę, która zabrałaby mnie daleko stąd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUMPKIN_SEEDS"
msgid "It's a seed. Exciting."
msgstr "Nasiona. Doprawdy niesamowite."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUNCHINGBAG"
msgid "Some are simply made to suffer."
msgstr "Niektórzy po prostu są stworzeni, żeby cierpieć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PUREBRILLIANCE"
msgid "It hurts my eyes."
msgstr "Aż bolą oczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEAMULET"
msgid "It's oozing."
msgstr "Wydziela jakąś maź."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEGEM"
msgid "Purple like a... purple thing."
msgstr "Fioletowy jak... coś fioletowego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.PURPLEMOONEYE"
msgid "Maybe now I'll lose fewer friends..."
msgstr "Może teraz nie będę tracić tylu przyjaciół..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "We have prolonged our horrific demise."
msgstr "Przedłużyliśmy nasze żałosne konanie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "The monster's hunger shall never cease."
msgstr "Głód potwora jest niezaspokojony."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "A post. Not very exciting."
msgstr "Słupek. Niezbyt ekscytujący."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Like death, it creeps everywhere."
msgstr "Wszędzie się wdziera. Niczym śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "I am not impressed by opulence."
msgstr "Przepych nie robi na mnie wrażenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "What horror have those eyes witnessed?"
msgstr "Jakie koszmary widziały te oczy?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Yet another reminder of death."
msgstr "Kolejne memento śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Don't worry. You'll be dead soon."
msgstr "Nie martw się. Twój kres jest bliski."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "It shall never grow another berry."
msgstr "Już nigdy nie wyrosną tu porzeczki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "It is empty, like my heart."
msgstr "Pusta. Tak, jak moja dusza."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "For making food."
msgstr "Do produkcji żywności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making a small amount of food."
msgstr "Do produkcji niewielkich porcji żywności."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN1"
msgid "I shall put them on my eyes when I die."
msgstr "Przykryjcie nimi moje oczy, gdy umrę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN2"
msgid "Money will not bring back Abigail."
msgstr "Pieniądze nie przywrócą życia Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN3"
msgid "Wealth cannot buy immortality."
msgstr "Żadna fortuna nie kupi wiecznego życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_COIN4"
msgid "It came from above."
msgstr "Wzięła się z góry."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Its insides are as horrid as its outsides."
msgstr "Jego wnętrzności są równie ohydne co jego powierzchowność."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's ready now."
msgstr "Wszystko gotowe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Life is a trap."
msgstr "Największą pułapką jest życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FERN"
msgid "Wilson calls them \"greens\"... but they're purple..."
msgstr "Wilson używa określenie „zielenina”... Ale to przecież fiolet..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Flour by any other name would smell as sweet."
msgstr "Mąka, bo trzeba się nad nią namęczyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked purples."
msgstr "Gotowany fiolet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "We should offer it to the beast."
msgstr "Trzeba to złożyć w ofierze bestii."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "The beast will be satisfied with this."
msgstr "Bestia będzie zadowolona."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "This will satisfy the beast, but not for long."
msgstr "To zaspokoi bestię, aczkolwiek nie na długo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "The beast doesn't want that."
msgstr "Bestia tego nie chce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "A waste."
msgstr "Szkoda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC"
msgid "It gives food flavor."
msgstr "Zapewnia świetny smak."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "It smells a bit nice."
msgstr "Całkiem ładnie pachnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATKID"
msgid "What childhood is this for you?"
msgstr "I to ma być twoje dzieciństwo?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "But no honey."
msgstr "A gdzie miód?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Hello, ma'am. Care to trade?"
msgstr "Witam panią. Czy zechciałaby pani pohandlować?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL"
msgid "It can't make life more palatable."
msgstr "Nie może sprawić, że życie stanie się bardziej znośne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I don't want to carry this around."
msgstr "Nie chcę tego ze sobą targać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "It makes a little bit of food."
msgstr "Można tu przyrządzić co nieco jedzenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "It only works if I place it somewhere."
msgstr "Działa jedynie wtedy, gdy gdzieś go umieszczę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_HOE"
msgid "To till the corrupt soil."
msgstr "Do uprawiania tej wstrętnej gleby."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY"
msgid "It is the key to something precious."
msgstr "To klucz do czegoś cennego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "The key to a beautiful place, locked long away."
msgstr "Klucz do pięknego miejsca, zazdrośnie zamkniętego przed światem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "It sheds light on nothing important."
msgstr "Oświetla nic ważnego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "The only light in my life is Abigail."
msgstr "Jedynym blaskiem w mym życiu jest Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I am ground down on the mealing stone of life."
msgstr "W tym kamieniu może kryć się tajemnica życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Seclusion has not been kind to it."
msgstr "Osamotnienie nie wyszło mu na dobre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "I, too, cart around my baggage."
msgstr "Ja także lubię przewozić me rzeczy na wózku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Nothing in there could bring me happiness."
msgstr "Nie ma tam nic, co mogłoby mnie uradować."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Maybe we'll get lucky and they'll be poisonous."
msgstr "Może będziemy mieć szczęście i okażą się trujące."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "They thrive on a stump made by death."
msgstr "Kikut naznaczony śmiercią."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "All things die. Even fungus."
msgstr "Wszystko ginie. Nawet grzyby."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION"
msgid "I never cry."
msgstr "Nigdy nie płaczę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "It will never make anyone cry again."
msgstr "Już nikt przez nią nie zapłacze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN"
msgid "It looks okay."
msgstr "Wygląda całkiem w porządku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Sigh... Why bother?"
msgstr "Ech... Po co się trudzić?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Looks dangerous."
msgstr "Groźnie wygląda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "It's winged, but it's no angel."
msgstr "Owszem, ma skrzydła, ale to nie anioł."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Abigail needs a statue."
msgstr "Abigail potrzebny jest pomnik."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Long dry."
msgstr "Długo schnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Now I may enter the park."
msgstr "Teraz mogę wkroczyć do parku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "I need a key to enter."
msgstr "Do otwarcia niezbędny jest klucz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "A monument. But not to Abigail."
msgstr "To pomnik. Ale nie ku czci Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Dust to dust."
msgstr "Z prochu powstałeś i w proch się obrócisz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Had I such a shell, I would never emerge."
msgstr "Gdybym miała taką skorupę, nigdy bym jej nie opuściła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Cold and dead."
msgstr "Zimny i martwy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "Would you like to be a pie, little bird?"
msgstr "Chcesz, aby cię ugotować, ptaszku?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's practicing for the big sleep."
msgstr "Trenuje przed zapadnięciem w sen wieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "If only life had been handed to me on a silver plate."
msgstr "Gdyby tylko ktoś zechciał ofiarować mi życie na srebrnej tacy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Water, water, everywhere..."
msgstr "Woda... Wszędzie woda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL"
msgid "There's no night here. It is a nice change."
msgstr "Tu nie zapada noc. To miła odmiana."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Perhaps I'll be happier in the next world."
msgstr "Być może będę szczęśliwsza w innym świecie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT"
msgid "We cook to stave off death."
msgstr "Gotujemy, aby odpędzić śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO"
msgid "It has eyes, yet it never cries."
msgstr "Ma oczy, a jednak nigdy nie płacze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Now its eyes will never open."
msgstr "Teraz nigdy już nie otworzy oczu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "The hanger is a noose for a pot."
msgstr "Ten taki stryczek, ale dla garnka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "It's for hanging the pot over the fire."
msgstr "Do zawieszania garnków nad ogniem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "We will cook, or we will die."
msgstr "Będziemy gotować. Albo zemrzemy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Sweetness begets sweetness."
msgstr "Słodycz rodzi słodycz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Time came for it."
msgstr "Nadszedł jego czas."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Nothing escaped this plague."
msgstr "Ta zaraza pochłonęła wszystko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "It's been forgotten."
msgstr "Jakże zapomniana."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Nothing more to pray for."
msgstr "Nie ma co więcej wznosić modłów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "This was once a happy home."
msgstr "Ongiś część szczęśliwego domu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Its hearth no longer has a home."
msgstr "To palenisko jest teraz bezdomne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Time is an illusion."
msgstr "Czas jest zaledwie iluzją."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "Time is death's ally."
msgstr "Czas jest sojusznikiem śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Death has been here."
msgstr "Śmierć tędy przechodziła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "It's a ghost town."
msgstr "To opuszczone miejsce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Some tragedy has struck this house."
msgstr "Wydarzyła się tutaj jakaś tragedia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "A door that leads nowhere."
msgstr "Drzwi prowadzące donikąd."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "The roof cannot protect you when death comes."
msgstr "Żaden dach nie uchroni nas przed nadejściem śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Let's have a peek inside..."
msgstr "Zajrzyjmy do środka..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Locked, like my heart."
msgstr "Niedostępny. Tak, jak moje serce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON"
msgid "It flops as its life slowly leaves its body."
msgstr "Jego ciało szarpie się, więdnąc w szponach śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Not so lively now."
msgstr "Już się tak nie rzuca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT"
msgid "It adds flavor..."
msgstr "Dodaje smaku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "It needs to be ground down before we can use it."
msgstr "Trzeba je najpierw zetrzeć. Inaczej nie będzie z nich pożytku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "There is no salt, yet."
msgstr "Sól się jeszcze nie wytrąciła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "There is salt to be had."
msgstr "Jest sól do zebrania."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "It's for collecting salt from the pond."
msgstr "Służy do gromadzenia soli."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP"
msgid "Tree blood."
msgstr "Krew drzewa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "For collecting tree blood."
msgstr "Do gromadzenia krwi drzew."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAPLING"
msgid "We will perish before this grows back."
msgstr "Przeminiemy, nim odrośnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "As bittersweet as life."
msgstr "Słodko-gorzki smak. Jak życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Planting seeds requires an optimism I don't possess."
msgstr "Ogrodnictwo wymaga optymizmu, którego nie posiadam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Is all of life not a slaughter?"
msgstr "Czyż egzystencja nie jest rzezią?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Just a dash."
msgstr "Ociupinkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "I suppose it could be edible."
msgstr "To się chyba da zjeść."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "We've taken all there was to take."
msgstr "Nie można mu już nic więcej odebrać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "We ripped it from its home on the shrub."
msgstr "Odebrany rodzinie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It has a sickly beauty."
msgstr "Chorobliwie piękne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "All things must end."
msgstr "Wszystko się kończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "All that sacrifice for nothing."
msgstr "Cała praca na nic."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Like a dagger through the heart. A tree heart."
msgstr "Niczym sztylet w serce. Serce drzewa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I can harvest it now."
msgstr "Gotowe do zbiorów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "Its life ebbs."
msgstr "Jego życie odpływa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "They're less standoffish than their brethren."
msgstr "Nico mniej konfliktowa od jego braci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "How do you do, sir?"
msgstr "Jak się pan miewa?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "He is practicing for the big sleep."
msgstr "Trenuje przed zapadnięciem w sen wieczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "I see no joy in this house."
msgstr "Brakuje w tym domu radości."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Neither a house nor a home."
msgstr "Ani to dom, ani domostwo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Not as sweet as Abigail."
msgstr "Nie tak słodki jak Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Red as heart's blood."
msgstr "Czerwony niczym krew wprost z serca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Its flesh is far more bloody now."
msgstr "Jego ciało jest teraz nawet bardziej krwawe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "How do you do?"
msgstr "Jak się miewasz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "How do you do?"
msgstr "Jak się miewasz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's... a turnip."
msgstr "To... rzepa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "The turnip is now cooked."
msgstr "Rzepa jest już ugotowana."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT"
msgid "We can grind it down into flour."
msgstr "Możemy je zetrzeć na mąkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "The life they contain is a mystery."
msgstr "Zazdrośnie skrywają tajemnicę życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.GENERIC"
msgid "He's wandering mindlessly, oblivious to his fate."
msgstr "Wałęsa się bez celu, nieświadomy swego przeznaczenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBIT.HELD"
msgid "He is safely in my embrace."
msgstr "Jest bezpieczny w mych objęciach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHAT"
msgid "Fine. It's adorable."
msgstr "Elegancko. Jest uroczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.GENERIC"
msgid "I'm too big to fall down there."
msgstr "Jestem za duża, żeby tam wpaść."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOLE.SPRING"
msgid "It's closed up. No one is falling down there, now."
msgstr "Zamknięta. Teraz nikt już tam nie wpadnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.BURNT"
msgid "It didn't cook well."
msgstr "Nierówno się upiekła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "It is not as edible as it looks."
msgstr "Nie jest wcale taka jadalna, na jaką wygląda."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN"
msgid "I guess it plays a type of burial song."
msgstr "Pewnie wygrywa jakiś rodzaj pieśni pogrzebowej."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "It's like a grave for my things."
msgstr "To jakby grób dla mojego dobytku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "You're making me angry."
msgstr "Oj, zaczynasz mnie złościć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKINGSPEAR"
msgid "Death by rabbit antler. Cute."
msgstr "Śmierć zadana porożem królika. Słodko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "It's in a foul mood."
msgstr "Chyba nie ma zbyt dobrego humoru."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_LUCKY"
msgid "I should take a closer look."
msgstr "Powinnam się lepiej przyjrzeć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RABBITKING_PASSIVE"
msgid "He seems friendly enough."
msgstr "Wydaje się dosyć przyjazny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINCOAT"
msgid "I liked jumping in puddles with Abigail."
msgstr "Lubiłam skakać po kałużach z Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINHAT"
msgid "What fun is rain if you're not getting wet?"
msgstr "Gdzież jest przyjemność z deszczu, jeśli nie mokniesz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.BURNT"
msgid "Does that mean sunshine is dead, too?"
msgstr "Czy to znaczy, że blask słońca też nie żyje?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAINOMETER.GENERIC"
msgid "It measures cloudiness. I like when it's dreary."
msgstr "Mierzy zachmurzenie. Lubię, jak jest szaro."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RATATOUILLE"
msgid "A whole bunch of cooked vegetables. Riveting."
msgstr "Pełen garnek gotowanych warzyw. Odświeżające."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RAZOR"
msgid "This is just for shaving."
msgstr "Służy do golenia. I tylko do golenia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD"
msgid "I wondered if I'd ever hear that song again."
msgstr "Zastanawiałam się, czy usłyszę jeszcze tę piosenkę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_BALATRO"
msgid "It brightens my mood, if only for a while."
msgstr "Może tylko na chwilę, ale poprawia mi nastrój."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Abigail, czy ta muzyka podnosi cię na duchu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DANGER"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Abigail, czy ta muzyka podnosi cię na duchu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DAWN"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Abigail, czy ta muzyka podnosi cię na duchu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DRSTYLE"
msgid "Does this music lift your spirits, Abigail?"
msgstr "Abigail, czy ta muzyka podnosi cię na duchu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_DUSK"
msgid "I wonder if father still listens to his record collection."
msgstr "Ciekawe, czy ojciec wciąż słucha swojej kolekcji nagrań."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_EFS"
msgid "A song of sweet foreboding."
msgstr "Słodko złowroga piosenka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_END"
msgid "I wonder if father still listens to his record collection."
msgstr "Ciekawe, czy ojciec wciąż słucha swojej kolekcji nagrań."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Love it."
msgstr "Przepięknie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_MAIN"
msgid "I wonder if father still listens to his record collection."
msgstr "Ciekawe, czy ojciec wciąż słucha swojej kolekcji nagrań."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "I wonder if father still listens to his record collection."
msgstr "Ciekawe, czy ojciec wciąż słucha swojej kolekcji nagrań."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDGEM"
msgid "Red like my heart's blood."
msgstr "Czerwony niczym krew płynąca w mym sercu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDLANTERN"
msgid "A light to guide me."
msgstr "Światło mnie poprowadzi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDMOONEYE"
msgid "Now Wolfgang won't get \"lost\" when I invite him to play."
msgstr "Teraz Wolfgang się nie zgubi, jak go zaproszę do zabawy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REDPOUCH"
msgid "What lies within?"
msgstr "Cóż się tam kryje?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP"
msgid "A mushroom after my own heart."
msgstr "Grzyb w kolorze mego serca."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_CAP_COOKED"
msgid "All is malleable."
msgstr "Wszystko da się dostosować do własnych potrzeb."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Damp."
msgstr "Wilgotny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "I would hide too, if I could."
msgstr "Też bym się schowała, gdybym mogła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Harvested."
msgstr "Zebrany."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.BURNING"
msgid "Soon to be ashes."
msgstr "Wkrótce zamieni się w popiół."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.GENERIC"
msgid "It's just a bunch of reeds."
msgstr "To tylko kępka tataraku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REEDS.PICKED"
msgid "They have already been torn away."
msgstr "Wyrwany."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REFINED_DUST"
msgid "Dust to... somewhat denser dust."
msgstr "Pył zmieniony w... nieco gęstszy pył."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REFLECTIVEVEST"
msgid "Everything's a vest."
msgstr "Wszystko może być kamizelką."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RELIC"
msgid "A leftover of an ancient world."
msgstr "Pozostałość ze starożytnego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.BURNT"
msgid "It is unspeakably burnt."
msgstr "Spalona ponad wyobrażenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I will learn unspeakable things."
msgstr "Nauczę się niesamowitych rzeczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "It is unspeakably burnt."
msgstr "Spalony ponad wyobrażenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "I will learn unspeakable things."
msgstr "Nauczę się niesamowitych rzeczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "It is unspeakably burnt."
msgstr "Spalony ponad wyobrażenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "I have learnt unspeakable things."
msgstr "Nauczyłam się niesamowitych rzeczy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Madness brings fire."
msgstr "Szaleństwo sprowadza ogień."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "This is but a step from madness."
msgstr "Jeden krok dzieli mnie od szaleństwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESKIN_TOOL"
msgid "Change is... not always terrible."
msgstr "Zmiana nie zawsze jest czymś złym."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "I'm glad that fail-safe is gone."
msgstr "Cieszę się, że już go nie ma."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "It's just putting off the inevitable."
msgstr "To tylko odwleka to, co nieuniknione."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RESURRECTIONSTONE"
msgid "A futile ward."
msgstr "Niepotrzebny wysiłek."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.REVIVER"
msgid "Choices matter."
msgstr "Twój wybór ma znaczenie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RHINODRILL"
msgid "Brotherly camaraderie will not save you."
msgstr "Braterstwo nie uchroni was przed zagładą."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROASTTURKEY"
msgid "The holiday was cut short for this poor bird."
msgstr "Święta szybko się skończyły dla tego biednego ptaka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.GENERIC"
msgid "Does that mean spring is coming? I hope not."
msgstr "Czy to oznacza, że nadchodzi wiosna? Oby nie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN.HELD"
msgid "He likes being trapped in my pocket."
msgstr "Lubi swoje nowe więzienie w mej kieszeni."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "Life in the barren, frozen wastes."
msgstr "Życie z jałowych, mroźnych pustkowi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBIN_WINTER.HELD"
msgid "It's so soft. It is my enemy."
msgstr "Jest taki miękki. To wróg."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Oh to be encased within a hard and unfeeling exterior..."
msgstr "Och jakby tak dać się zamknąć w twardej i pozbawionej uczuć skorupie..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROBOT_PUPPET"
msgid "I wonder what they did."
msgstr "Ciekawe, czym sobie zasłużyli."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK"
msgid "Even that is not permanent."
msgstr "Nawet one nie są wieczne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKS"
msgid "Some small rocks."
msgstr "Kilka małych kamyków."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCKY"
msgid "What terrible sights they have seen."
msgstr "Jakichż strasznych rzeczy był świadkiem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It will never again bear fruit."
msgstr "Nigdy już nie wyda owoców."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Oh. It's burning."
msgstr "Och. Płonie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It is corrupt. Tainted."
msgstr "Jest skażone. Zbrukane."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Vileness spreads within it."
msgstr "Rozprzestrzenia się po nim jakaś nikczemność."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It's born fruit."
msgstr "Wydało owoc."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It has nothing to offer me."
msgstr "Nie ma mi nic do zaoferowania."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "I feel much the same."
msgstr "Czuję się podobnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "It grew on a tree, but it looks like a rock."
msgstr "Wyrósł na drzewie, ale przypomina kamień."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "I can eat it now."
msgstr "Mogę go teraz zjeść."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "It might actually taste good at this point."
msgstr "Teraz może nawet będzie smaczny."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Why do you persevere?"
msgstr "Po co w ogóle się starasz?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A large piece of cold, unfeeling ice."
msgstr "Duży kawałek zimnego, bezdusznego lodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE.MELTED"
msgid "A large pool of cool, melted ice."
msgstr "Duża kałuża chłodnego, stopionego lodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_ICE_MELTED"
msgid "A large pool of cool, melted ice."
msgstr "Duża kałuża chłodnego, stopionego lodu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "There's a fire in the pit's belly."
msgstr "Widzę ogień w głębi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The shadows encroach."
msgstr "Cień nadciąga."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "The lava's on fire."
msgstr "Lawa płonie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_LIGHT.OUT"
msgid "The lava lost its will to burn..."
msgstr "Lawa straciła wolę walki..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_MOON"
msgid "It's traveled so far..."
msgstr "Tyle przebył..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "Now it will never die..."
msgstr "Teraz już nigdy nie umrze..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "Now it will never die..."
msgstr "Teraz już nigdy nie umrze..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK"
msgid "A Rook? Or is it a Castle?"
msgstr "Wieża? Czy może zamek?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROOK_NIGHTMARE"
msgid "Time erodes everything."
msgstr "Czas niszczy wszystko."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE"
msgid "That would be the easy way out of this place."
msgstr "To byłoby łatwe wyjście."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "A rope over an abyss."
msgstr "Lina nad przepaścią."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "I hope you find her."
msgstr "Mam nadzieję, że ją znajdziesz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROTTENEGG"
msgid "The way of all things."
msgstr "Wszystko tak kiedyś skończy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ROYAL_JELLY"
msgid "We stole it out of the mouths of baby bees."
msgstr "Odebrana z pyszczków małych biednych pszczółek...."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUBBLE"
msgid "Broken bits of stone."
msgstr "Kamienne odłamki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINSHAT"
msgid "Abigail would've loved this crown."
msgstr "Abigail spodobałaby się ta korona."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_BAT"
msgid "It possesses the power of the ancients."
msgstr "Przesycona potęgą ludzi z dawnych czasów."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.RUINS_RUBBLE"
msgid "A pile of broken dreams."
msgstr "Sterta zrujnowanych marzeń."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "It is touched by death."
msgstr "Czuć woń śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It judges my very being."
msgstr "Ocenia me jestestwo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLEHORN"
msgid "I'm only taking back what's mine."
msgstr "Jedynie odbieram to, co moje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_BASIC"
msgid "As if it wasn't already burdened by the yoke of life..."
msgstr "Jakby nie było już dość znękane ciężarem istnienia.."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_RACE"
msgid "Too much whimsy gives me indigestion."
msgstr "Wstrząsy wywołują u mnie niestrawność."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_SHADOW"
msgid "The higher you sit, the farther you fall."
msgstr "Im wyżej siedzisz, tym dłużej spadasz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WAR"
msgid "Oh, how we bend creatures to our ill intent."
msgstr "Ach, jakże naginamy wolę bestii do naszych potrzeb."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SADDLE_WATHGRITHR"
msgid "It has wings, but will never fly."
msgstr "Ma skrzydła, ale nigdy nie poleci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALSA"
msgid "I don't feel much like dancing."
msgstr "Nie mam ochoty tańczyć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTBOX"
msgid "It'll only prolong the inevitable."
msgstr "To tylko odwleka nieuniknione."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK"
msgid "The beasts crave it..."
msgstr "Bestie do tego lgną..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTLICK_IMPROVED"
msgid "Salty like tears."
msgstr "Słone jak łzy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTROCK"
msgid "Almost as salty as my bitter tears."
msgstr "Prawie tak słone jak moje gorzkie łzy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GENERIC"
msgid "Those figures can't be natural."
msgstr "Te formacje nie mogą być naturalne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.GROWING"
msgid "The cycle begins anew."
msgstr "Cykl rozpoczyna się na nowo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "It's been utterly destroyed."
msgstr "Akt kompletnej destrukcji."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDBLOCK"
msgid "Mockery of a spoiled childhood."
msgstr "Drwina ze smutnego dzieciństwa."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANDSPIKE"
msgid "Aim for my heart..."
msgstr "Mierz w me serce…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.ACTIVE"
msgid "It's calling to me."
msgstr "Wzywa mnie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Even this obelisk has left me."
msgstr "Nawet ten obelisk mnie opuścił."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.BURNING"
msgid "Consigned to the flames."
msgstr "Powierzona płomieniom."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASED"
msgid "It's not long for this world..."
msgstr "Nie pozostanie z nami na długo..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.DISEASING"
msgid "It is on the precipice..."
msgstr "Stoi nad przepaścią..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.GENERIC"
msgid "It's trying to grow up."
msgstr "Próbuje urosnąć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.PICKED"
msgid "Maybe next time, sapling."
msgstr "Może następnym razem, maleńka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SAPLING.WITHERED"
msgid "The oppressive heat got to this one."
msgstr "Męczące ciepło dało jej się we znaki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCANDATA"
msgid "If I'm lucky, it might just bore me to death."
msgstr "Jeżeli będę miała szczęście, zanudzi mnie na śmierć."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNING"
msgid "Antagonizing crows is always bad luck."
msgstr "Czy teraz strach mnie opuści?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.BURNT"
msgid "Now the crows will be at peace."
msgstr "Wróble zaznają wreszcie spokoju."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCARECROW.GENERIC"
msgid "Who would want to scare crows away?"
msgstr "Po co straszyć biedne wróbelki?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCORCHED_SKELETON"
msgid "The flame has cleansed this poor wretched soul."
msgstr "Ogień oczyścił jego biedną duszę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPBOOK_PAGE"
msgid "A lost and lonely page."
msgstr "Zaginiona i samotna strona."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAPHAT"
msgid "My head will be safe. My dignity, however..."
msgstr "Moja głowa jest bezpieczna, ale godność…"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "I won't find what I'm looking for, no matter how far I can see."
msgstr "Jak daleko bym nie widziała, nie znajdę tego, czego szukam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Abigail... You be Death, I'll be the Sculptor..."
msgstr "Abigail... Ty będziesz Śmiercią, a ja Rzeźbiarzem..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "...I can't be disappointed... If I expect nothing..."
msgstr "...Nie jestem zawiedziona... bo niczego nie oczekuję..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "That looks... f-fun..."
msgstr "Wygląda nawet... fajne..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Cleft from the stone."
msgstr "Wyryta w kamieniu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "A beautiful corruption gnaws at its base..."
msgstr "Cudowna siła rozpadu dopadła jego podstawy..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Not everyone can be put back together after falling apart."
msgstr "Nie każdy potrafi się pozbierać po zupełnym rozpadzie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "It wants out..."
msgstr "Chce się wydostać..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "The more the marble wastes, the more the statue grows."
msgstr "Im więcej marmuru marnujemy, tym większa jest figura."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "How did this get here?"
msgstr "Skąd to się tu wzięło?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "There's a sickly beauty to it..."
msgstr "Jest w niej coś dziwnie pięknego..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "If only the rest of us could be whole again."
msgstr "Żeby każdego dało się tak poskładać..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "It wants out..."
msgstr "Chce się wydostać..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "We all have monsters within, I suppose."
msgstr "W każdym z nas siedzi potwór."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Off with his head! Heehee."
msgstr "Stracił głowę! Hi, hi."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "I feel... queasy..."
msgstr "Czuję się jakoś... nieswojo..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "It's been made whole again. Lucky."
msgstr "Jest znowu cała. Szczęściara."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "It wants out..."
msgstr "Chce się wydostać..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Perhaps it wanted to hide the shame of its monstrous form?"
msgstr "Może chciała ukryć swoje potworne oblicze?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Strange marble debris..."
msgstr "Dziwny marmurowy odłamek..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Another entry in a long line of unfortunate occurrences."
msgstr "Kolejny punkt na liście niefortunnych zdarzeń."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Thinking on the waves makes me nauseous."
msgstr "Sama myśl o falach wywołuje we mnie chorobę morską."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEAFOODGUMBO"
msgid "A sea once teeming with life. No more."
msgstr "Życie wyrwane ze swego środowiska."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEASTACK"
msgid "I could steer toward it and resign myself to a watery fate."
msgstr "Mogłabym skierować się prosto na to i zdać się na wodny los."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "I feel the same way."
msgstr "Czuję się dokładnie tak samo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It must be nice."
msgstr "Zazdroszczę."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDPOUCH"
msgid "Another burden for me to shoulder."
msgstr "Kolejne brzemię, które muszę dźwigać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS"
msgid "Life, or at least the promise of it."
msgstr "Życie. A przynajmniej jego obietnica."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEEDS_COOKED"
msgid "The fire has toasted their life away."
msgstr "Ogień wypalił z nich wszelkie życie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SENTRYWARD"
msgid "Grant us the power of sight..."
msgstr "Obdarz nas mocą widzenia..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_KIT"
msgid "Another implement for staving off the inevitable decay."
msgstr "Kolejna próba powstrzymania nieuniknionego rozkładu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "This burnt husk is all that remains."
msgstr "Już dogasa... nic po nim nie pozostanie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "A mockery of life."
msgstr "Kpina z życia."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SEWING_TAPE"
msgid "It doesn't mend the hole... merely masks it."
msgstr "Nie służy do łatania dziur. Jedynie do ich przykrywania."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDANCER"
msgid "Father used to do silly dances like that."
msgstr "Ojciec kiedyś odprawiał takie śmieszne tańce."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWDIGGER"
msgid "Was he your brother?"
msgstr "Czy był to twój brat?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWHEART"
msgid "It beats with a sorrow to span the skies and plumb the darkest seas."
msgstr "Jego bicie przepełnione jest bólem, który wznosi się pod niebiosa i sięga największych głębin."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Endless, swirling nothingness... how serene."
msgstr "Nieskończona, wirująca nicość… jaka spokojna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "Another nightmare to torment me."
msgstr "Kolejny koszmar, który mnie prześladuje."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "Will the darkness consume me at last?"
msgstr "Czy ciemność wreszcie mnie pochłonie?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "What are you? The Grin Reaper?"
msgstr "Czym ty jesteś? Radosnym kosiarzem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Parasite."
msgstr "Pasożyt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "There is no face beneath that hood."
msgstr "Pod tym kapturem nie ma twarzy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BATTLEAXE"
msgid "A beautiful death bringer."
msgstr "Piękny orędownik śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_BEEF_BELL"
msgid "A shame it only works for beefalo."
msgstr "Szkoda, że to działa tylko na wołka."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE"
msgid "What terrible things will I create?"
msgstr "Jakie straszliwe rzeczy mogę stworzyć?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHADOW_FORGE_KIT"
msgid "I suppose if I tried I could piece it together."
msgstr "Chyba mogę spróbować złożyć to w całość."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHALLOW_GRAVE"
msgid "What difference does it make?"
msgstr "Co za różnica?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARK"
msgid "Are you here to send me to a watery grave?"
msgstr "Chcesz mnie wysłać do morskiego grobu?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHARKBOI"
msgid "It has a bite no colder than reality."
msgstr "Gryzie gorzej niż sumienie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHELL_CLUSTER"
msgid "They're all clumped together... it seems a shame to separate them..."
msgstr "Wszystkie trzymają się razem... Szkoda je rozdzielać."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHIELDOFTERROR"
msgid "Nothing can truly shield you from the horrors of this cruel world."
msgstr "Nic tak naprawdę nie ochroni nas przed grozą tego okrutnego świata."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL"
msgid "What terrible secrets might be uncovered with this?"
msgstr "Cóż za potworne tajemnice można odkryć za jej pomocą?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "Some things should stay buried... but not today."
msgstr "Niektóre rzeczy powinny pozostać w ziemi… ale nie dzisiaj."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMBAIT"
msgid "Will it give me a dreamless sleep?"
msgstr "Dzięki temu zasnę i nic mi się nie przyśni?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOMCAKE"
msgid "Will it make me grow? Or shrink perhaps? Mushrooms are funny things."
msgstr "Sprawi, że urosnę? A może się skurczę? Grzyby to dziwne organizmy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SHROOM_SKIN"
msgid "A reminder of the death we wrought."
msgstr "Pamiątka śmierci, której byliśmy przyczyną."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.BURNT"
msgid "A preview of the fires of Hell."
msgstr "Zapowiedź ognia piekielnego."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A siesta is but a preview of death."
msgstr "Sjesta jest zaledwie zapowiedzią śmierci."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SILK"
msgid "So slippery and fine."
msgstr "Ależ miękka i delikatna."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "I wish I had a song left in my heart to sing."
msgstr "W moim sercu nie ma już żadnych pieśni do zaśpiewania."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "They are rather pretty..."
msgstr "Są całkiem ładne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Abigail, do you remember collecting shells on the beach?"
msgstr "Abigail, pamiętasz, jak razem zbierałyśmy muszelki na plaży?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.GENERIC"
msgid "It's a memorial to my sister... but it's so bare..."
msgstr "To pomnik ku pamięci mej siostry... ale jest taki pusty..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "I won't let you fade away, Abigail. Never."
msgstr "Nigdy nie pozwolę ci zniknąć, Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "I can almost hear your voice, Abby."
msgstr "Prawie słyszę twój głos, Abby."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "These don't make me feel good, but they help Abigail."
msgstr "Nie czuję się przy nich dobrze, ale pomagają Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Abigail always loved flowers..."
msgstr "Abigail zawsze kochała kwiaty..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON"
msgid "I envy your escape."
msgstr "Zazdroszczę ci ucieczki."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETONHAT"
msgid "A tortured mind dwelled within."
msgstr "Wewnątrz przetrzymywany był znękany umysł."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_NOTPLAYER"
msgid "All living things share the same fate. Thankfully."
msgstr "Wszystkie żywe istoty czeka ten sam los. Całe szczęście."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Zazdroszczę ci, %s. Być może %s i ja moglibyśmy pobawić się razem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Zazdroszczę ci, %s. Być może %s i ja moglibyśmy pobawić się razem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Zazdroszczę ci, %s. Być może %s i ja moglibyśmy pobawić się razem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "I envy you, %s. Maybe I should play with %s?"
msgstr "Zazdroszczę ci, %s. Być może %s i ja moglibyśmy pobawić się razem?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKETCH"
msgid "I think we could make what's drawn here..."
msgstr "Można by to zbudować..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SKULLCHEST"
msgid "It shall contain my memento mori."
msgstr "Ukryję w niej swe memento mori."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLEEPBOMB"
msgid "Sickly spores bring such sweet slumber."
msgstr "Te chorobotwórcze zarodniki są źródłem słodkiego spoczynku."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOT.GENERIC"
msgid "Abigail used to play with one of these."
msgstr "Abigail kiedyś się taką bawiła."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "Grief takes up no space, yet weighs far more."
msgstr "Żałoba nie zajmuje miejsca, ale jest cięższa niż cokolwiek."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Ktoś może się potknąć i skręcić kark. Może to będę ja."

