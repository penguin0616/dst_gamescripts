msgstr "Wygląda pusto."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "I'll preserve my judgement."
msgstr "Zachowam przemyślenia dla siebie."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.GEMS"
msgid "It needs a gem."
msgstr "Potrzebny klejnot."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.VALID"
msgid "Looks ready."
msgstr "Chyba gotowe."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT"
msgid "They're promising me... knowledge."
msgstr "Obiecują mi... wiedzę."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "It's occupied."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Drat, empty."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT_GUARD"
