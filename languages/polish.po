msgstr "Ciepły i soczysty."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERMELON_OVERSIZED"
msgid "A big, juicy watermelon."
msgstr "Wielki soczysty arbuz."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERMELON_SEEDS"
msgid "It's a seed."
msgstr "Normalne nasiona."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT"
msgid "As long as we don't take their barnacles, they'll stay our buds."
msgstr "Jeśli nie będziemy zabierać im pąkli, będziemy kumplami."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_BABY"
msgid "This one's just a sprout."
msgstr "To tylko kiełek."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_BOMB"
msgid "We're under seedge!"
msgstr "Nasionoblężenie!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPLANT_PLANTER"
msgid "They seem to grow best on oceanic rocks."
msgstr "Zdaje się, że najlepiej rosną na morskich skałach."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERPUMP"
msgid "It puts out fires very a-fish-iently."
msgstr "SpoWODuje, że pożar zniknie!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERTREE_PILLAR"
msgid "That tree is massive!"
msgstr "To drzewo jest ogromne!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATERTREE_ROOT"
msgid "It's not a square root."
msgstr "Można nim wykorzenić niewiedzę?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "I'd like to avoid a punch from %s, if possible."
msgstr "Żadnych ciosów od %s, jeśli można prosić."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "%s is really heating things up today."
msgstr "%s ostro rozgrzewa dziś atmosferę."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Good day, %s!"
msgstr "Miłego dnia, %s!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.GHOST"
msgid "Nice try. You're not escaping to Valhalla yet, %s."
msgstr "Nieźle, %s. Ale to jeszcze nie czas na ucieczkę do Walhalli."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WATHGRITHR.MURDERER"
