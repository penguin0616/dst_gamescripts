msgstr "Sprawia, że dużo szybciej zbierasz różne rzeczy."

#. STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_QUICKPICKER_3_TITLE
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_QUICKPICKER_3_TITLE"
msgid "Quick Picker III"
