msgstr "Ciekawe, jaki los zgotuje nam ta machina."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
