msgid "Sumptuous! We're on the right path, wielder!"
msgstr "Syto! Jesteśmy na właściwej ścieżce!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.2"
msgid "We're on the cusp, wielder. I FEEL IT."
msgstr "To przełomowy moment. CZUJĘ TO."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.1"
msgid "OH YES."
msgstr "OCH, TAK."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.10
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.10"
msgid "Thank you, wielder."
msgstr "Dziękuję, ręko, która mnie dzierży."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.11
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.11"
msgid "I'm proud of us."
msgstr "Jestem z nas dumny."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.2"
msgid "So juicy!"
msgstr "Ależ soczyście!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.3"
msgid "A satisfying meal."
msgstr "Zadowalający posiłek."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.4"
msgid "Worthy."
msgstr "To było godziwe."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.5"
msgid "Beautiful!"
msgstr "Pięknie!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.6"
msgid "A delight!"
msgstr "Sama rozkosz!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.7"
msgid "I am satiated."
msgstr "Jestem nasycony."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.8"
msgid "A fine feast of flesh."
msgstr "Wspaniała, mięsna uczta."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.9
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.9"
msgid "Gluttonous!"
msgstr "Rozpusta!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.1"
msgid "Hungry!"
msgstr "Głodny!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.2"
msgid "F-feed me!"
msgstr "N-nakarm mnie..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.3"
msgid "M-must... k-kill."
msgstr "M-muszę... Z-zabijać."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.4"
msgid "Me-meat!"
msgstr "M-mięsko!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.5"
msgid "Fl... fl-flesh!"
msgstr "Ci-ciało!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.1"
msgid "So hungry."
msgstr "Taki głodny."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.2"
msgid "I need to fleshen up."
msgstr "Potrzebuję się odżywić."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.3"
msgid "Find us something to kill."
msgstr "Znajdź nam coś do zabicia."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.4"
msgid "How about some pork chops?"
msgstr "A może schaboszczak?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.5"
msgid "GASH, I'm so hungry!"
msgstr "OCH! Jestem taki głodny!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.6"
msgid "You need to MEAT me halfway."
msgstr "Nie ma mięsa bez kości. I bardzo dobrze."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.7"
msgid "I crave beast flesh!"
msgstr "Pragnę mięsa z jakiejś bestii!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.8"
msgid "When do we eat?"
msgstr "Kiedy będziemy jeść?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.9
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.9"
msgid "I need meat."
msgstr "Potrzebuję mięska."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.1"
msgid "You dare neglect me, {mortal}?"
msgstr "Zaniedbujesz mnie, śmiertelna istoto?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.2"
msgid "Death gives me life."
msgstr "Śmierć daje mi życie."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.3"
msgid "Wielder, you've changed."
msgstr "Ręko, która mnie dzierżysz, widzę w tobie zmianę."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.1"
msgid "F-feel... str-strange..."
msgstr "D-dziwne... Ucz-czucie..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.2"
msgid "Some... thing... ha-happening."
msgstr "Coś... się... d-dzieje."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.3"
msgid "Stro... str-stronger!"
msgstr "Si... Siła! Więcej siły!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.4"
msgid "Aw... awa- awake."
msgstr "B... Budzę się."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.1"
msgid "I'm changing."
msgstr "Zmieniam się."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.2"
msgid "My strength grows!"
msgstr "Moja moc rośnie!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.3"
msgid "I'm evolving!"
msgstr "Przeistaczam się!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.1"
msgid "RAAAAAAAAAAAAAAAAAAAAR!"
msgstr "RAAAAAAAAAAAAAAAAAAAAR!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.2"
msgid "Nothing can stop us now, wielder!"
msgstr "Nic nas już nie powstrzyma, ręko, która mnie dzierży!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.3"
msgid "AXE-IMUM POWER!!!"
msgstr "MOC ZAOSTRZONA!!!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.1"
msgid "Sh-sharp."
msgstr "O-ostro."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.2"
msgid "We k-kill n-now?"
msgstr "A teraz z-zabijamy?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.3"
msgid "Ch-chop."
msgstr "C-ciach."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.4"
msgid "H-hack... ha-ack? HACK!"
msgstr "C-ciach... ciach? CIACH!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.1"
msgid "Let me axe you a question. Why aren't we killing something?"
msgstr "To może toporne pytanie, ale... Czemu nic nie zabijamy?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.2"
msgid "What shall we destroy next, wielder?"
msgstr "Jaka będzie nasza kolejna ofiara, moja istoto?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.3"
msgid "I know I have a rough edge. But I can still cut it."
msgstr "Może bywam trochę ostry, prawda... Ale za to mam cięty humor."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.4"
msgid "Can you hack it?"
msgstr "Ciachniemy coś?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.5"
msgid "What are you waiting for, wielder?"
msgstr "Na co czekasz, istoto dzierżąca?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.6"
msgid "We haven't murdered something in forever."
msgstr "Od wieków nic nie upolowaliśmy."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.7"
msgid "We shall commit unspeakable acts of savagery!"
msgstr "Powinniśmy popełniać dzikie, barbarzyńskie czyny!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.8"
msgid "Do you realize what we are capable of together, {mortal}?"
msgstr "{mortal}, zdajesz sobie sprawę, co wspólnie możemy osiągnąć?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.1"
msgid "It's been a journey, wielder."
msgstr "Cóż to była za przygoda, istoto."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.2"
msgid "I reflect on our path of destruction with fondness."
msgstr "Wspominam naszą drogę zniszczenia z rozczuleniem."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.3"
msgid "Remember how much fun we had killing things?"
msgstr "Pamiętasz, jak wspaniale się bawiliśmy, mordując istoty cięcie za cięciem?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.1"
msgid "Fo-for...get... forget h-her..."
msgstr "Za-zapo... mnij... Zapomnij o n-niej..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.2"
msgid "M-mi... mine."
msgstr "M-mój..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.3"
msgid "He's... m-mine."
msgstr "On jest... m-mój."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.4"
msgid "Wo... Woo... Woodie."
msgstr "Wo... Woo... Woodie."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.1"
msgid "Heard you're an axe man."
msgstr "Słyszałem, że znasz się na siekierkach."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.2"
msgid "Forget your crazy axe."
msgstr "Zapomnij o tej świrniętej siekierce."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.3"
msgid "Sever your ties with that old battle axe."
msgstr "Czas przeciąć stare więzy z tamtą siekierą."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.4"
msgid "Just me and hew."
msgstr "Tylko ja i ty."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.5"
msgid "I fell for you."
msgstr "Dobrze mi z tobą."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.1"
msgid "I just want a simple wielding."
msgstr "Nie potrzebuję zbyt wiele. Wystarczy, żeby mnie dobrze dzierżyć."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.2"
msgid "I'll never cleave you."
msgstr "Jestem jak dla ciebie ciosany."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.3"
msgid "Let's carve our names in a tree."
msgstr "Wyryjmy nasze imiona na drzewie."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.1"
msgid "Starv... starving!"
msgstr "Umrę z głodu...!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.2"
msgid "D-dying!"
msgstr "Umieram!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.3"
msgid "F-find... fl-flesh... now!"
msgstr "M-mięsko... teraz!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.4"
msgid "Must h-have mmm-MEAT!"
msgstr "Muszę... MIĘSA!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.1"
msgid "Feed me, NOW."
msgstr "Nakarm mnie. JUŻ."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.2"
msgid "Why do you starve me, cruel {mortal}?"
msgstr "Czemu mnie głodzisz, okrutna śmiertelna istoto?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.3"
msgid "Are you trying to kill me, wretched {mortal}?"
msgstr "Chcesz doprowadzić do mojej śmierci, nędzny śmiertelny stworze?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.4"
msgid "Feed me before it's too late!"
msgstr "Nakarm mnie! Zanim będzie za późno!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.5"
msgid "We need to murder something, now!"
msgstr "Coś musimy zamordować, i to już!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.6"
msgid "Getting... weaker."
msgstr "Słabnę..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.7"
msgid "If I'm not killing, I'm dying!"
msgstr "Gdy nie zabijam, gasnę!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.8"
msgid "Not to be dramatic, but... I'M STARVING TO DEATH!"
msgstr "Nie chcę zabrzmieć dramatycznie, ale... ZAGŁODZISZ MNIE NA ŚMIERĆ!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.1"
msgid "Cursed {mortal}."
msgstr "Przeklęta śmiertelna istota."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.2"
msgid "Is this the end?"
msgstr "Czy to już koniec?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.3"
msgid "It can't end like this."
msgstr "To nie może się tak skończyć."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.4"
msgid "Come too far... tasted too much..."
msgstr "Dotarłem za daleko... Zasmakowałem zbyt wiele..."

#. STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_DESTINATION_FULL
msgctxt "STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_DESTINATION_FULL"
msgid "[WIP] Destination is full!"
msgstr "[WIP] Kierunek zapełniony!"

#. STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_MIGRATION_CANCELLED
msgctxt "STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_MIGRATION_CANCELLED"
msgid "[WIP] Migration canceled"
msgstr "[WIP] Anulowano migrację"

#. STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_MIGRATION_DESTINATION_NOT_READY
msgctxt "STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_MIGRATION_DESTINATION_NOT_READY"
msgid "[WIP] Destination is not ready!"
msgstr "[WIP] Kierunek nie jest gotowy!"

