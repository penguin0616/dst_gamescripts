msgstr "Twój czas nadszedł zbyt wcześnie..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
