msgstr "Wygląda na to, że pomyślano o kostiumach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It seems the costumes are provided."
msgstr "Wygląda na to, że pomyślano o kostiumach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY"
msgid "I think that one will fit me nicely."
msgstr "Sądzę, że to by mi pasowało."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It seems the costumes are provided."
msgstr "Wygląda na to, że pomyślano o kostiumach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It seems the costumes are provided."
msgstr "Wygląda na to, że pomyślano o kostiumach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY"
msgid "It seems the costumes are provided."
msgstr "Wygląda na to, że pomyślano o kostiumach."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
