msgstr "Możemy udawać kogoś innego!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_SAGEHAT"
msgid "Ooooh, they'll never guess it's us!"
msgstr "Ooooch, nigdy nie zgadną, że to my!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MASK_TOADYHAT"
