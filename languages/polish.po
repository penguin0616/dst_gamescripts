msgstr "No i o to chodzi!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET"
msgid "We could be good friends, you and I."
msgstr "Myślę, że moglibyśmy się zaprzyjaźnić."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM"
msgid "Now that's a proper gem."
msgstr "No. I to jest porządny klejnot!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE"
msgid "You coulda been a useful necklace."
msgstr "Można by tak zrobić z ciebie naszyjnik."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF"
msgid "It's a hard work destroyer."
msgstr "Narzędzie do niszczenia efektów ciężkiej pracy."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP"
msgid "Yep. Green mushroom."
msgstr "Tak jest. Zielony muchomor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED"
msgid "Doesn't look TOO deadly."
msgstr "Nie wygląda ZBYT zabójczo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It's some sorta green mushroom."
msgstr "To taki zielonkawy grzyb."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Leniwy grzyb."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "It's a mushroom hole."
msgstr "Dziura po grzybie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_BIG"
msgid "Fancy a swim? Ha! Didn't think so."
msgstr "Masz ochotę popływać? Ha! Tak myślałam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_SMALL"
msgid "Fancy a swim? Ha! Didn't think so."
msgstr "Masz ochotę popływać? Ha! Tak myślałam."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE"
msgid "This green mush ain't bad!"
msgstr "Ta zielona papka jest całkiem niezła!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO"
msgid "What? We all do it."
msgstr "No co? Przecież wszyscy to robią."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER"
msgid "For when you need a big KABOOM!"
msgstr "Przydaje się, gdy potrzebne jest wielkie BUM!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1"
msgid "A nice change from baked apples."
msgstr "Fajna odmiana od pieczonych jabłek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10"
msgid "Curious flavor."
msgstr "Cudaczny smak."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11"
msgid "Best eaten by the handful."
msgstr "Najlepiej jeść całymi garściami."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12"
msgid "Ha, yuck! Everyone watch me eat'em!"
msgstr "Ha, ale ohyda! Hej, popatrzcie, jak je jem!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13"
msgid "I ain't patient enough to eat these."
msgstr "Nie mam do nich cierpliwości."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14"
msgid "Whew! That's the kick y'need!"
msgstr "Raju! Ale wykręca gębę!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2"
msgid "Is this even food?"
msgstr "To się w ogóle da jeść?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3"
msgid "That's no treat."
msgstr "To wcale nie jest żaden cukierek."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4"
