msgstr "Горячая кашка."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAVE_BANANA_TREE"
