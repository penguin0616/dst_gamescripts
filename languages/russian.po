msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_BEARD_RUG"
msgid "I made it from my beard!"
msgstr "Я выткал его из собственной бороды!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_CARPETFLOOR"
