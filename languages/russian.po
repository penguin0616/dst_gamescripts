#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.APPLYMODULE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.APPLYMODULE.COOLDOWN"
msgid "only_used_by_wx78"
