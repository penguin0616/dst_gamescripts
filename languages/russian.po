msgstr "Все еще мерзкое."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT"
