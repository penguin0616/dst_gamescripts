#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
