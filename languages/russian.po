msgstr "Сдается, этого котенка уже кто-то нашел."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "A kit's nearby!"
msgstr "Где-то здесь сидит котенок!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
