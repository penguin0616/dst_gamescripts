msgstr "Я мог бы серьезно пострадать."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
