msgstr "На что смотришь?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_BEEFALO"
