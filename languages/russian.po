msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "It needs a new magic focus."
msgstr "Ей нужен новый магический источник."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
