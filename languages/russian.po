msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
