msgstr "Руки чешутся задокументировать результаты!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
