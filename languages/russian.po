msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.APPRAISE.NOTNOW"
