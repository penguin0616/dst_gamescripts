msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
