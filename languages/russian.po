msgstr "Не буду мешать."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
