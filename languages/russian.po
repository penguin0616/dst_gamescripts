msgstr "Это будет расточительством."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "No need, it's already en glace."
msgstr "Не стоит, все уже en glace."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "Patience!"
msgstr "Терпение!"

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.HASPET"
msgid "I already have a little companion."
msgstr "У меня уже есть маленький спутник."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.MOUNTED"
msgid "Mon dieu, that's far away."
msgstr "Mon dieu, как далеко."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.BUILD.TICOON"
msgid "Non, that's not the one I'm following."
msgstr "Non, это не тот месье, за которым я шел."

#. STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WARLY.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
