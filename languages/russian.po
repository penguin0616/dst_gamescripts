msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTFUEL"
msgid "Ah, are you the source of this magic?"
msgstr "О, значит, ты — источник магии?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
