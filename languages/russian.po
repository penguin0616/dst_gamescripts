msgstr "Это больше не стол."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "Is table."
msgstr "Это стол."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Is table."
msgstr "Это стол."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM.DIRT"
