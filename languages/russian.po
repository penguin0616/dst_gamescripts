msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_pickettan"
msgid "Why not put down stakes and settle down here?"
msgstr "Почему бы не оградить себе территорию и не остаться на ней?"

#. STRINGS.SKIN_DESCRIPTIONS.fence_pickettan_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_pickettan_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_picketwhite
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_picketwhite"
msgid "Why not put down stakes and settle down here?"
msgstr "Почему бы не оградить себе территорию и не остаться на ней?"

#. STRINGS.SKIN_DESCRIPTIONS.fence_picketwhite_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_picketwhite_item"
msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack"
msgid "Just the thing to bar pesky urchins from your manor."
msgstr "Поможет не пускать в сад усадьбы надоедливых беспризорников."

#. STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_victorianblack_item"
