msgid "We will see who is best Wolfgang! Raaa!"
msgstr "Посмотрим, кто тут лучший Вольфганг! Р-р-ра-а-а!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s is nice man. Like me! Ha ha."
msgstr "%s — славный человек. Как я! Ха-ха."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOLFGANG_WHISTLE"
msgid "Wolfgang is good teacher!"
msgstr "Вольфганг — отличный наставник!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.ATTACKER"
msgid "Is angry monkey!"
msgstr "Злая обезьяна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Is exactly why we stop having monkeys in circus!"
msgstr "Вот поэтому мы в цирке больше обезьян не держим!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GENERIC"
msgid "Why does strange monkey follow Wolfgang?"
msgstr "Почему странная обезьяна ходит за Вольфгангом?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.GHOST"
msgid "Poor monkey."
msgstr "Бедная обезьянка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.MURDERER"
msgid "Wolfgang will stop this monkey business, for good!"
msgstr "Вольфганг положит конец этому обезьянничеству!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WONKEY.REVIVER"
msgid "Ah. Monkey is friend, yes?"
msgstr "О, так обезьяна — друг?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODCARVEDHAT"
msgid "Is thick and sturdy, like Wolfgang's own mighty skull!"
msgstr "Прочная и твердая, как могучая черепушка Вольфганга!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.ATTACKER"
msgid "Does beardman %s want to fight?"
msgstr "Бородач %s хочет побороться?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVER"
msgid "The beard ate %s!"
msgstr "%s съеден бородой!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "Still have good moustache, %s."
msgstr "%s все еще с усами."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Be careful! Do not burn, beard!"
msgstr "Осторожней! Не обожгись, бородач!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC"
msgid "Is beard! Hello!"
msgstr "Борода! Привет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GHOST"
msgid "Wolfgang will get heart for you, beard!"
msgstr "Вольфганг достанет тебе сердце, бородач!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSE"
msgid "Beardman become birdman! Ha ha!"
msgstr "Бородач оброс перьями! Ха!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "No fear birdman, Wolfgang will help!"
msgstr "Не бойся, птицелюд, Вольфганг тебе поможет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSE"
msgid "Something different about beardman today."
msgstr "Бородач сегодня как-то изменился."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Wolfgang will find heart for antlered beard."
msgstr "Вольфганг найдет сердце для рогатого бородача."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.MURDERER"
msgid "Drop axe and fight, beardman!"
msgstr "Брось топор и дерись, бородач!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.REVIVER"
msgid "%s is nice man with magnificent beard."
msgstr "%s — славный парень с потрясающей бородой."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "Chair looks burnt and sad."
msgstr "Стульчик выглядит обгоревшим и грустным."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Is tiny chair strong enough to hold Wolfgang?"
msgstr "Достаточно ли мощный этот стульчик, чтобы выдержать Вольфганга?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Do not worry, friend. Wolfgang will stand."
msgstr "Не волнуйся, друг. Вольфганг постоит."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOOD_TABLE.BURNT"
