#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN"
