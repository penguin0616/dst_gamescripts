msgstr "Мы не начнем, пока я не намечу маршрут!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_YOTD_NOTENOUGHBOATS"
