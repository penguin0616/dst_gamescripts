msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.2"
