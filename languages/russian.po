msgstr "Хм. Сдается, тут ничегошеньки нет."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_START_TRACKING"
msgid "Looks like they're onto somethin'..."
msgstr "Похоже, он что-то учуял..."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
