msgstr "Эй, кто там? Ты в порядке?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SKELETONHAT"
msgid "It's not very comfy."
msgstr "Она не очень уж удобная."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SKELETON_NOTPLAYER"
