msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_NOTEAM.1"
