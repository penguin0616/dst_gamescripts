msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD_ITEM"
msgid "Is for making big sail-stick."
msgstr "Из этого можно сделать столб для плаваний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL"
msgid "A fancy suit is no match for my muscles!"
msgstr "Чудной костюм не подходит для моих мускулов!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD"
msgid "Scary head is twelve feet tall!"
msgstr "Страшная голова, двенадцать футов в высоту!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLIGHT"
msgid "Scary light!"
msgstr "Страшный свет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLOCK"
msgid "Scary lock!"
msgstr "Страшный замок!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Is box that sings!"
msgstr "Это поющая коробка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLTHRONE"
msgid "Scary chair!"
msgstr "Страшный стул!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT"
msgid "Meat makes me strong!"
msgstr "Мясо делает меня сильным!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATBALLS"
msgid "Ball of meats make me strong!"
msgstr "Шарик из мяса делает меня сильным!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.BURNT"
msgid "Cannot dry meat now."
msgstr "Не могу сейчас сушить мясо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE"
msgid "Yum, meaty leather!"
msgstr "Ням! Мясная кожа!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Is very good and dry now!"
msgstr "Хорошо высохло, вкусно получилось!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING"
msgid "Dry meaty things! Dry!"
msgstr "Сухие мясные штуки! Сушись!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Go away, rain! Meat is drying!"
msgstr "Дождик, уходи! Мясо сушится!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Sky tears is re-wetting Wolfgang's dry things!"
msgstr "Небо плачет и мочит сухие запасы Вольфганга!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Wolfgang could punch water out, maybe?"
msgstr "Может, Вольфганг сможет выколотить всю воду?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.GENERIC"
msgid "For drying many meats!"
msgstr "Можно высушить много мяса!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Cannot dry meat now."
msgstr "Не могу сейчас сушить мясо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Will old lady be able to eat such tough meat?"
msgstr "А старушка точно сможет прожевать такое жесткое мясо?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Is very good and dry now!"
msgstr "Хорошо высохло, вкусно получилось!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Dry meaty things! Dry!"
msgstr "Сухие мясные штуки! Сушись!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "Go away, rain! Meat is drying!"
msgstr "Дождик, уходи! Мясо сушится!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "Sky tears is re-wetting the dry things!"
msgstr "Небо плачет и мочит сухие запасы!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Wolfgang could punch water out, maybe?"
msgstr "Может, Вольфганг сможет выколотить всю воду?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Is sad and meat-less."
msgstr "Печально, что тут мяса нет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATYSALAD"
msgid "Need more than weird leaves to fill Wolfgang's mighty belly!"
msgstr "Чтобы могучему Вольфгангу пузо набить, одних странных листиков не хватит!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT_DRIED"
msgid "Look like leather, taste like meat."
msgstr "Выглядит, как кожа, а на вкус — мясо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEGAFLARE"
msgid "Wolfgang will be careful with that one."
msgstr "Вольфгангу нужно быть с этим поосторожнее."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM"
msgid "Is fishy man!"
msgstr "Рыбочеловек!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORHAT"
msgid "Is helmet special for fish man."
msgstr "Это шлем только для рыболюдей."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Is helmet special for fish man."
msgstr "Это шлем только для рыболюдей."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD"
msgid "Not as mighty as Wolfgang!"
msgstr "Не такой могучий, как Вольфганг!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_LUNAR"
msgid "Nice spiky fish man... Wolfgang is friend."
msgstr "Хороший колючий рыбочеловек... Вольфганг — друг."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_SHADOW"
msgid "Fighting fish man dutiful even in death."
msgstr "Рыбочеловек послушно сражается даже после смерти."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHAT"
msgid "Wolfgang will be biggest and strongest fish man!"
msgstr "Вольфганг станет самым большим и сильным рыболюдом!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.BURNT"
msgid "Not so nice looking now."
msgstr "Теперь не так уж и мило выглядит."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.GENERIC"
msgid "What a handsome devil!"
msgstr "Дьявольская красота!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.BURNT"
msgid "The house was really not strong enough."
msgstr "Этот дом серьезно был недостаточно крепким."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.GENERIC"
msgid "The house was not strong enough."
msgstr "Этот дом не был крепким."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Little house was no match for fire."
msgstr "Маленький домик перед огнем не устоял."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "Is house for fish men!"
msgstr "Дом для рыболюдов!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMKING"
msgid "Wolfgang would like to challenge him to arm wrestle!"
msgstr "Вольфганг хочет потягаться с ним в борьбе!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE.BURNT"
msgid "Is burnt up."
msgstr "Он сгорело."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Big sitting mat looks very inviting."
msgstr "Большая сидушка так и манит к себе."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "All gone in puff of smoke."
msgstr "И все исчезло в клубах дыма."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "Tiny fish girl seems very busy."
msgstr "Маленькая рыбья девочка чем-то очень занята."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "Is tree full of fish!"
msgstr "Полное дерево рыбы!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Is tree full of fighting fish!"
msgstr "Полное дерево воинственной рыбы!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY"
msgid "For fish man only."
msgstr "Это только для рыболюдей."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "For fish man only."
msgstr "Это только для рыболюдей."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_LUNAR"
msgid "Er... looking good, fish man. Purple suit you. Really..."
msgstr "Э-э... неплохо выглядишь, рыбочеловек. Тебе идет фиолетовый. Правда..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_PRINCE"
msgid "Looks too scrawny to be king!"
msgstr "Мелковат он для короля!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_SHADOW"
msgid "Wow, fish man working overtime."
msgstr "Ого, рыбочеловек заработался."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOL"
msgid "Fish man tools for fish man work."
msgstr "Инструмент рыболюдей, чтобы им работать."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOLSHED"
msgid "No Wolfgangs allowed. Aw."
msgstr "Вольфгангам нельзя. Эх."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "No Wolfgangs allowed. Aw."
msgstr "Вольфгангам нельзя. Эх."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "Fish man tool not bad."
msgstr "Инструмент рыболюдей неплохой."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MESSAGEBOTTLE"
msgid "Has tiny note inside!"
msgstr "Там внутри записочка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "Nothing inside."
msgstr "Тут ничего нет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "Wolfgang will hold back mighty tears..."
msgstr "Вольфганг сильный и плакать не станет..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "Watch, puny friends! Wolfgang will perform feats of strength!"
msgstr "Смотрите, маленькие друзья! Вольфганг покажет свою мощь!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MILKYWHITES"
msgid "Looks gross, must be good for Wolfgang!"
msgstr "Выглядит мерзко, но для Вольфганга будет полезно!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINERHAT"
msgid "Lamp for put on head."
msgstr "Лампочка для головы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIBOATLANTERN"
msgid "Is floaty water light."
msgstr "Плавучий водяной огонек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIFAN"
msgid "It's so twirly when I run! Haha!"
msgstr "Такой ветер дует, когда я бегаю! Ха-ха!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINIFLARE"
msgid "Is tiny sky boom!"
msgstr "Маленький небесный взрыв!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN.GENERIC"
msgid "Tiny picture is worth many, tinier words."
msgstr "Лучше один раз увидеть, чем сто раз услышать."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Sign needs little scribbles!"
msgstr "Этой табличке не хватает маленьких каракулей!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINISIGN_ITEM"
msgid "Wolfgang will help punch into ground!"
msgstr "Вольфганг поможет вбить это в землю!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAUR"
msgid "Strong! Like me! I like him!"
msgstr "Сильный! Как я! Он мне нравится!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURCHEST"
msgid "Chest have big strong horns."
msgstr "Сундук с большими сильными рогами."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURHORN"
msgid "Is trophy from mighty foe."
msgstr "Трофей от могучего противника."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Now you will know Wolfgang's strength!"
msgstr "Сейчас ты увидишь всю силу Вольфганга!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.HELD"
msgid "Wolfgang have mercy for tiny soft animal."
msgstr "Вольфганг пощадит маленькую мохнатую зверюшку."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLE.UNDERGROUND"
msgid "Stay underground where you are safe from Wolfgang."
msgstr "Держись от Вольфганга подальше под землей, там тебе будет безопасно."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEBAT"
msgid "Sniffer Rat has weak and puny wings! This makes Wolfgang laugh!"
msgstr "У нюхокрысы крылышки маленькие и слабые! Вольфгангу очень смешно!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEBATHILL"
msgid "Is mushy, stinky home."
msgstr "Вонючий мягкий дом."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEHAT"
msgid "Mole skin is stretchy."
msgstr "Кротовая кожа хорошо тянется."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOLEHILL"
msgid "Mole hole."
msgstr "Кротовая нора."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY"
msgid "Ugly monkey man!"
msgstr "Уродливая человеко-обезьяна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYBARREL"
msgid "This... thing. It smells not so good."
msgstr "Эта… штуковина. Она не очень хорошо пахнет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYHUT.BURNT"
msgid "Is burnt monkey house."
msgstr "Обезьяний дом сгорел."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Is monkey house for monkeys."
msgstr "Дом для маленьких обезьянок."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "Is broken?"
msgstr "Не работает?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "Wolfgang almost stubbed his mighty toe on it!"
msgstr "Вольфганг чуть палец на могучей ноге не сломал!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYPILLAR"
msgid "Hmm. Is very strange tree."
msgstr "Хм. Очень странное дерево."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYQUEEN"
msgid "Hello hairy lady!"
msgstr "Привет, волосатая дама!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEYTAIL"
msgid "Soft fuzzy plant."
msgstr "Мягкое пушистое растеньице."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Wolfgang will be best first mate!"
msgstr "Вольфганг будет первым помощником капитана!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONKEY_SMALLHAT"
msgid "Looks better on Wolfgang than it did on monkeys."
msgstr "На Вольфганге выглядит куда лучше, чем на обезьянах."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERLASAGNA"
msgid "Taste like hairs and meats with noodle."
msgstr "На вкус как лапша с мясом и волосами."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT"
msgid "It is not looking like food."
msgstr "Не очень похоже на еду."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Look like leather, taste like leather."
msgstr "Выглядит, как кожа, а на вкус… тоже кожа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MONSTERTARTARE"
msgid "Blech!"
msgstr "Буэ-э-э!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.BROKEN"
msgid "Tiny platform is broken!"
msgstr "Маленькая платформа сломалась!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.GENERIC"
msgid "Little platform is still missing pieces."
msgstr "Маленькой платформе все еще не хватает частей."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Sickly little light is not run out."
msgstr "Слабый маленький свет не кончается."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.STAFFED"
msgid "Is ready for good fight!"
msgstr "Готов к хорошей битве!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Feels wrong to Wolfgang."
msgstr "Вольфгангу кажется, что-то не так."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Flutterby is big and green!"
msgstr "Большая зеленая бабочка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Green flutterby is soft."
msgstr "Зеленая бабочка мягенькая."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Flutterby flappers."
msgstr "Бабочкины хлопалки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "Puny little tree!"
msgstr "Жалкое мелкое деревце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.CAVE"
msgid "Moon is shy in cave!"
msgstr "Луна спряталась в пещере!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GENERIC"
msgid "Wolfgang see moon reflection, but not his mighty self!"
msgstr "Вольфганг видит отражение Луны, но не его могущественное я!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.GLASSED"
msgid "M-maybe is not good night for looking up at sky."
msgstr "Н-наверное, сегодня ночью в небо смотреть не надо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Moon is very mighty!"
msgstr "Луна очень могуча!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Moon is hiding."
msgstr "Луна прячется."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "Moon is get sleepy."
msgstr "Луна хочет спать."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "Tiny moon is get bigger!"
msgstr "Крошечная Луна становится все больше!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS"
msgid "Is clear green sharp-stuff."
msgstr "Прозрачная зеленая острая штука."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASSAXE"
msgid "Is for swing and chop."
msgstr "Чтобы рубить и махать."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_CHARGED"
msgid "Sharp and glowy stuff."
msgstr "Острое и светится."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_ROCK"
msgid "Sharp stuff that fell from sky cheese."
msgstr "Острый материал с небесного сыра нападал."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "Is home of the glassy shellbeasts."
msgstr "Тут живут стеклянные твари в панцирях."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKCRATER"
msgid "Rock from moon has hole. Like a cheese!"
msgstr "У камня с Луны есть дырка. Прямо как сыр!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKIDOL"
msgid "Hehe. Is funny little moon man."
msgstr "Хе-хе. Смешной лунный человечек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKNUGGET"
msgid "But is not cheese?"
msgstr "Это не сыр?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCKSEED"
msgid "Is ball not for throwing."
msgstr "Мячик не для бросания."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONROCK_PIECES"
msgid "Is little pieces from moon!"
msgstr "Маленькие кусочки с Луны!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSPIDERDEN"
msgid "Scary things is inside maybe."
msgstr "Там, внутри, могут скрываться страшные гады."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "Can see reflection of Wolfgang's big muscles in it!"
msgstr "Вольфганг видит отражение своих могучих мышц!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "Is strange and glowy."
msgstr "Странное и светится."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "Is fueled by potato, like Wolfgang!"
msgstr "Работает на картошке, прямо как Вольфганг!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_SPARK"
msgid "Makes Wolfgang's moustache hairs bristle!"
msgstr "У Вольфганга усы дыбом встают!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC"
msgid "Is tiny jumpy spark-thing."
msgstr "Маленькая прыгучая искорка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "Ha! Tiny spark is too weak to break out!"
msgstr "Ха! Маленькая слабая искорка, не вырвется!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "You have secrets for Wolfgang, friend?"
msgstr "Ты Вольфгангу секреты рассказать хочешь, дружище?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Wolfgang like to help new friends."
msgstr "Вольфганг любит помогать новым друзьям."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "Seems happy now, Wolfgang thinks."
msgstr "Вольфганг думает, что теперь ему хорошо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "Such loud whisperings. Make head hurt."
msgstr "Очень громко говорит, даже голова разболелась."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Wolfgang will help you!"
msgstr "Вольфганг тебе поможет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Tell Wolfgang where you go and he will take you."
msgstr "Скажи Вольфгангу, куда тебе нужно, и он тебя отнесет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ICON"
msgid "Wolfgang will carry you most mightily!"
msgstr "Вольфганг сильный, тебя донесет куда угодно!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Wolfgang is here to help, yes."
msgstr "Вольфганг пришел помочь, да."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_LINK"
msgid "Maybe little light ball needs time to get mightier?"
msgstr "Может, надо подождать, пока шарик из света силу наберет?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Special things is trapped inside!"
msgstr "Внутри скрыто что-то хорошее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Special things is trapped inside!"
msgstr "Внутри скрыто что-то хорошее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Special things is trapped inside!"
msgstr "Внутри скрыто что-то хорошее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_SEED"
msgid "Yes, Wolfgang will carry you."
msgstr "Да, Вольфганг тебя донесет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_ALTAR_WARD"
msgid "Is not so heavy, Wolfgang will carry as far as you need!"
msgstr "Совсем не тяжело! Вольфганг донесет, куда надо!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_CAP"
msgid "Wolfgang tired of mushrooms."
msgstr "Вольфгангу грибы очень надоели."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_CAP_COOKED"
msgid "It is changed."
msgstr "Он изменился."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "Is nice floor for light ball."
msgstr "Хороший пол для шарика из света."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "Wolfgang just follow instructions."
msgstr "Вольфганг просто выполняет инструкции."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Wolfgang understand, is giant night light!"
msgstr "Вольфганг понял! Это огромный ночник!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Wolfgang is frighten, but happy."
msgstr "Вольфганг напуган, но счастлив."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Tiny ground is crack apart!"
msgstr "Земля треснула!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Why is ground stuffed with stinky shells?"
msgstr "Почему в землю тут напиханы вонючие панцири?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.BURNING"
msgid "Is burning!"
msgstr "Горит!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.BURNT"
msgid "Is burnt up."
msgstr "Оно сгорело."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Is stumpy stump now."
msgstr "Остался только пенек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE.GENERIC"
msgid "Roly poly weird tree."
msgstr "Маленькое толстенькое деревце."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "It come from weird tree."
msgstr "Это упало с того странного дерева."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE"
msgid "Very strange creature."
msgstr "Очень странное создание."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSEEGG"
msgid "Breakfast for whole family!"
msgstr "Завтрак для целой семьи!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "Is big bird baby bed!"
msgstr "Очень большая кроватка для птиц!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOQUECA"
msgid "Made by Wolfgang's friend. Mmm."
msgstr "Это Вольфгангу друг сделал. М-м-м."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.GENERIC"
msgid "Reminds me of uncle!"
msgstr "Напоминает мне о дядюшке!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITO.HELD"
msgid "No more blood for you!"
msgstr "Не будет тебе больше крови!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOBOMB"
msgid "Buzzing boom bag."
msgstr "Жужжащий мешочек делает бабах."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Blech, little bag smells of month-old borscht!"
msgstr "Фу-у, мешочек воняет как прокисший борщ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOMERMSALVE"
msgid "Wolfgang already hates needles... this make it even worse."
msgstr "Вольфганг и так ненавидит иголки... а тут еще хуже."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOMUSK"
msgid "Is huggable bug friend!"
msgstr "Друга-жука можно обнимать!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSQUITOSACK"
msgid "Uncle did not have gut like this."
msgstr "Даже у дядюшки такого пуза не было."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOSSLING"
msgid "Mmmm. Is still breakfast, I think."
msgstr "М-м-м-м-м. Вроде как, это все еще завтрак."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.DUG"
msgid "Sorry, dead peoples."
msgstr "Простите, мертвецы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOUND.GENERIC"
msgid "Scary! Is probably full of bones!"
msgstr "Страшно! Похоже, тут полно костей!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULLEDDRINK"
msgid "Is good, cozy drink."
msgstr "Хорошее питье, приятное."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "Why door not crumble under mighty Wolfgang punches?!"
msgstr "Почему дверь не крошится от могучих ударов Вольфганга?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Is strong like Wolfgang."
msgstr "Крепкий, прямо как Вольфганг!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "Chop and dig! I can do that all day."
msgstr "Рубить и копать! Могу этим заниматься хоть целый день!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHGNOME"
msgid "Little mushy man."
msgstr "Маленький грибной человечек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMBOMB"
msgid "Is dangerous mushy-boom!"
msgstr "Опасный грибковый бум!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHROOMHAT"
