msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "We're winning!"
msgstr "Мы выигрываем!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_BALL"
msgid "We wanna play with it!"
msgstr "Мы хотим с ним поиграть!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_CROWKID"
msgid "Are you a boy who was eaten by a crow?"
msgstr "Ты мальчик, которого проглотила ворона?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Wow, it's so shiny!"
msgstr "Ого, как блестит!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_HOST"
msgid "That's the biggest crow we've ever seen!"
msgstr "Мы такой большой вороны никогда не видели!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It would look better with more decorations around."
msgstr "Будет выглядеть еще лучше, если его украсить."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "We're pretty sure we can fit even more decorations around it!"
msgstr "Мы наверняка сможем развесить тут еще больше украшений!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "It's perfect!"
msgstr "Великолепно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "We need to find a good planting spot."
msgstr "Нужно найти хорошее место для посадки."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "We're saving up our tickets for that one in the back!"
msgstr "Мы копим билеты на самый главный приз!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "We can't wait to see what kind of prizes they have!"
msgstr "Скорей бы узнать, какие тут дают призы!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "We won a ticket!"
msgstr "Мы выиграли билетик!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "It's a good thing we have extra arms to carry all these tickets!"
msgstr "Как хорошо, что у нас столько рук — все билеты унесем!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Maybe now we can go get a prize!"
msgstr "Наверно, теперь можно пойти забрать приз!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "We should've gotten the popcorn instead..."
msgstr "Лучше бы мы взяли попкорн..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVAL_VEST_A"
