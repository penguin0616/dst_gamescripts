#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "We can fix it, or take its insides!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
