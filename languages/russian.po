#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "What is your problem, rabbit?!"
msgstr "Да чего ты такой злобный?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RABBITKING_LUCKY"
