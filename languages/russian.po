msgstr "Вот тебе, репка!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "Просто горстка семян."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_WHEAT"
