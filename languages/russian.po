msgstr "Что-то как-то не так."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_OTTERBOAT_DENBROKEN"
