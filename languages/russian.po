msgstr "Ха! Вольфганг может камень вдвое больше себя поднять!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Is icy, like... ice!"
msgstr "Такая ледяная, прямо как... лед!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_GEM"
msgid "Make muscles mighty!"
msgstr "Сделает мышцы сильнее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Lift! Lift to get strong!"
msgstr "Поднимаем! Поднимаем и становимся сильнее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_HEAT"
msgid "Wolfgang is getting good warm-up!"
msgstr "Сейчас Вольфганг как следует разогреется!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_MARBLE"
msgid "Wolfgang will be strongest!"
msgstr "Вольфганг будет самым могучим!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUMBBELL_REDGEM"
msgid "Is fiery, like Wolfgang's spirit!"
msgstr "Пылкая, как душа Вольфганга!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN"
msgid "Is spiky smelly fruit."
msgstr "Это колючий вонючий фрукт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_COOKED"
msgid "Now is hot spiky smelly fruit."
msgstr "А теперь это горячий колючий вонючий фрукт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_OVERSIZED"
msgid "Is big and spiky fruit."
msgstr "Большой колючий фрукт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DURIAN_SEEDS"
msgid "Is seeds for growing."
msgstr "Это семена, чтобы растить всякую всячину."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMERINGUE"
msgid "Wolfgang will leave that for someone else to eat."
msgstr "Вольфганг это кому-нибудь другому оставит."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMOTH"
msgid "Bushy beardy bug."
msgstr "Мохнатый бородатый жучок."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DUSTMOTHDEN"
msgid "Is cozy home for moths."
msgstr "Уютный дом для мотыльков."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EARMUFFSHAT"
msgid "Is could make me look like little bunny!"
msgstr "Я теперь буду выглядеть, как крольчонок!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EEL"
msgid "Eel needs cooking!"
msgstr "Угря надо приготовить!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EEL_COOKED"
msgid "Eel has been cooked."
msgstr "Угорь приготовлен."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT"
msgid "Is not egg!"
msgstr "Это не мясо!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_COOKED"
msgid "Has no yolk! Yolk is strongest part!"
msgstr "Нет желтка! В желтке вся сила!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Wolfgang is getting tired of being fooled by non-egg plant..."
msgstr "Вольфганг не доверяет этому странному огурцу..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EGGPLANT_SEEDS"
msgid "Is seeds for growing."
msgstr "Это семена, чтобы растить всякую всячину."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ELIXIR_CONTAINER"
msgid "Little ghost girl have many supplements."
msgstr "Всякие витаминчики для призрачной девочки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EMBERLIGHT"
msgid "Tiny torchlady makes good fires."
msgstr "Огненная малышка в кострах знает толк."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.BURNT"
msgid "Is burny bits."
msgstr "Ожоги."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.EMPTY"
msgid "Puny table will not hold Wolfgang's weight."
msgstr "Хрупкий стол не выдержит веса Вольфганга."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Wolfgang does not like dark."
msgstr "Вольфгангу не нравится темнота."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.GENERIC"
msgid "Little flowers are weak, but look nice."
msgstr "Малютки цветы слабые, но выглядят здорово."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Please do not go out, little light."
msgstr "Пожалуйста, не уходи, малютка свет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ENDTABLE.WILTED"
msgid "Little flowers are weaker than usual."
msgstr "Малютки цветы слабее, чем обычно."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.BURNING"
msgid "Is broke."
msgstr "Сломалось."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.BURNT"
msgid "Is small and broken now."
msgstr "Маленькое и сломанное."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Ha! You stood no chance!"
msgstr "Ха! У тебя не было шансов!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN.GENERIC"
msgid "Hello, tree!"
msgstr "Привет, дерево!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Is broke."
msgstr "Сломалось."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Is small and broken now."
msgstr "Маленькое и сломанное."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Ha! You stood no chance!"
msgstr "Ха! У тебя не было шансов!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Cheer up, tree!"
msgstr "Веселее, дерево!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEBRELLAHAT"
msgid "Is always looking up."
msgstr "Все время смотрит вверх."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEMASKHAT"
msgid "Wolfgang not fan of squishy hat."
msgstr "Вольфгангу мягкая шапка не по нраву."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR"
msgid "Wolfgang not like big scary eye!"
msgstr "Вольфгангу большой страшный глаз не нравится!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR_MINI"
msgid "Feeling of being watched is bad, but feeling of being bitten is much worse!"
msgstr "Неприятно, когда на тебя пялятся, но когда тебя кусают — еще хуже!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Is weird thing trying to hatch?"
msgstr "Эта странная штука пытается вылупиться?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYEPLANT"
msgid "They are not what they seem."
msgstr "Они не те, чем кажутся."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYETURRET"
msgid "Mighty structure will help me fight!"
msgstr "Могучая конструкция поможет мне в сражении!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.EYETURRET_ITEM"
msgid "It needs strong placing."
msgstr "Нужно поставить в правильном месте."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.BURNT"
msgid "No more growing."
msgstr "Больше ничего не вырастет."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.GENERIC"
msgid "Will grow mighty crops here!"
msgstr "Здесь вырастет могучий урожай!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.GROWING"
msgid "Grow my little friends! Grow!"
msgstr "Растите, мои маленькие друзья! Растите!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "Dirt is not dirty enough to make plants."
msgstr "Грязь недостаточно грязная, чтобы в ней росли растения."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_HOE"
msgid "Is to till soil for tiny seeds."
msgstr "Это чтобы землю рыхлить для крошечных семечек."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.BURNING"
msgid "No! Is burning!"
msgstr "О нет! Пожар!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL"
msgid "Good to eat!"
msgstr "Можно есть!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Plant has reached full mightiness!"
msgstr "Растение достигло пика мощи!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Sneaky weed thinks it can muscle in on Wolfgang's garden?!"
msgstr "Хитрая трава думает, что с Вольфгангом бороться сможет?!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Plant."
msgstr "Растение."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.GROWING"
msgid "Is growing up strong."
msgstr "Растет большим и сильным."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Is so sad!"
msgstr "Очень печально!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Wolfgang was going to eat that..."
msgstr "Вольфганг это съесть хотел..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLANT.SEED"
msgid "Is just tiny seed."
msgstr "Крошечное семечко."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLOW"
msgid "It is doing a mighty job!"
msgstr "Делает работу, для которой нужно много сил!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_PLOW_ITEM"
msgid "Will make garden full of fruits and veggies for Wolfgang!"
msgstr "Сделает для Вольфганга сад с фруктами и овощами!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "You are in the way!"
msgstr "Прочь с дороги!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERFAN"
msgid "Ha! Is as big as head!"
msgstr "Ха! Большой, как голова!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERHAT"
msgid "Is silly hat of feather. Could make Wolfgang bird?"
msgstr "Дурацкая шляпа с пером. Вольфганг станет похож на птицу?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHERPENCIL"
msgid "Wolfgang must stick pinky out when holding it."
msgstr "Вольфгангу нужно оттопырить мизинец, когда он возьмет это."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_CANARY"
msgid "Is feather of bird yellow."
msgstr "Перо желтой птицы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_CROW"
msgid "Is feather of bird black."
msgstr "Перо от черной птицы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_ROBIN"
msgid "Is feather of bird red."
msgstr "Перо красной птицы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Is feather of bird white."
msgstr "Перо белой птицы."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FEM_PUPPET"
msgid "Scary chair scares her!"
msgstr "Страшный стул ее пугает!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE"
msgid "I do not like trapping little animals."
msgstr "Мне не нравится загонять маленьких зверушек в ловушки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_GATE"
msgid "Is little flimsy swingboards."
msgstr "Маленькие шаткие трамплины."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_GATE_ITEM"
msgid "Wolfgang will help make swingboards!"
msgstr "Вольфганг поможет сделать доски!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_ITEM"
msgid "Wolfgang will help make fence!"
msgstr "Вольфганг поможет сделать забор!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_JUNK"
msgid "Is ugly little fence, but does its job."
msgstr "Страшный маленький заборчик знает свое дело."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FENCE_ROTATOR"
msgid "Is sword for fences? Very strange."
msgstr "Шпага для заборов? Чудеса."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FERTILIZER"
msgid "Bucket full of smelly."
msgstr "Полное ведро вонючки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FESTIVEFISH"
msgid "Is good fish for holidays."
msgstr "Хорошая праздничная рыба."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Is made from brightest of colors!"
msgstr "Тут столько ярких цветов!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIG"
msgid "Is big sweet fruit."
msgstr "Большой сладкий фрукт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIGATONI"
msgid "Is noodles of sweetness."
msgstr "Лапша, но сладкая."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIGKABAB"
msgid "All food should go on stick!"
msgstr "Любая еда на палочке вкуснее!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIG_COOKED"
msgid "Warm fruit ready for Wolfgang to eat!"
msgstr "Теплый фрукт Вольфгангу на обед!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREBALLSTAFF"
msgid "Puny stick is not for Wolfgang."
msgstr "Хлипкая палочка — не для Вольфганга."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIRECRACKERS"
msgid "Crackle bangs!"
msgstr "Трещащие взрывы!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREFLIES.GENERIC"
msgid "Sparkly!"
msgstr "Сверкает!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREFLIES.HELD"
msgid "My pocket is sparkles!"
msgstr "У меня сверкает карман!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREHOUND"
msgid "Bark!"
msgstr "Гав!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIRENETTLES"
msgid "Bad and stingy."
msgstr "Вредная и жгучая."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREPEN"
msgid "Wolfgang does not want to write with that pen!"
msgstr "Вольфганг этой ручкой писать не хочет!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.FIREPIT.EMBERS"
msgid "The darkness is coming!"
