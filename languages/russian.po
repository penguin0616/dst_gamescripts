msgstr "Фабричный огонь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Excellent work, bees!"
msgstr "Отлично сработано, пчелы!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Huh. Interestin' construction."
msgstr "Хм. Занимательная конструкция."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Where's that stellar work ethic, bees?!"
msgstr "Ну и где эта ваша выдающаяся трудовая этика, пчелы?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Excellent work, bees!"
msgstr "Отлично сработано, пчелы!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "You've been working hard."
msgstr "Вы хорошо поработали."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD"
msgid "That's unfortunate."
msgstr "Досадно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "It wasn't its time."
msgstr "Он был так молод."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "We're friends now."
msgstr "Теперь мы друзья."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Looks like I made a friend."
msgstr "Кажется, у меня появился друг."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.GENERIC"
msgid "Heh. Big lug."
msgstr "Хех. Огромный болванчик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.MYPARTNER"
msgid "We're buddies!"
msgstr "Мы напарники!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.NAKED"
msgid "Ha! That's just vulgar."
msgstr "Ха! Это просто грубо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY"
msgid "Rein in that attitude before I rein in you!"
msgstr "Ну-ка давай держи себя в руках, а то у меня тоже руки чешутся!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY"
msgid "You're getting soft!"
msgstr "Ты становишься мягче!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER"
msgid "Wow! You're in top form!"
msgstr "Ого! Ты в отличной форме!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING"
msgid "Lazy."
msgstr "Ленивый."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOFEED"
msgid "Feedin' time!"
msgstr "Обеденный перерыв!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT"
msgid "Seem secretive."
msgstr "Ne какой-то секрет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOTREAT"
msgid "My beefalo's been pulling her weight, she should get a reward."
msgstr "Моя бифало славно поработала, ей причитается плата."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL"
msgid "Smelly, but warm."
msgstr "Воняет, зато тепло."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Guess I'll have to build another one."
msgstr "Что ж, придется строить заново."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Awfully fancy for a beefalo."
msgstr "Слишком вычурно для простого бифало."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Let's get this beefalo spiffed up."
msgstr "Пригладим этому бифало шерстку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Better get building!"
msgstr "Приступим к строительству!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEF_BELL"
msgid "The beefalo sure do like that bell!"
msgstr "Бифало и правда любят этот колокольчик!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD"
msgid "Monarchy is an outdated ruling system!"
msgstr "Монархическая система правления вышла из моды!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT"
msgid "Respecting bees means respecting stingers."
msgstr "Уважаешь пчелу — уважай и ее жало."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE"
msgid "Hard at work."
msgstr "За тяжкой работой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE"
msgid "Sounds like the hum of an engine."
msgstr "Звучит, как жужжание мотора."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL"
msgid "That guy's got no concern for others. Pfft."
msgstr "Этому парню вообще нет дела до других. Пф-ф."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN"
msgid "It's the queen of bees!"
msgstr "Это пчелиная королева!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Sticky. I'd rather not walk on it."
msgstr "Липко. Не буду тут ходить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "I swear that thing's gotten bigger."
msgstr "Клянусь, эта штука только что увеличилась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Yeesh! I'd take a hammer to that."
msgstr "Ой фу! Мне тут кувалда потребуется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX"
msgid "It smells kinda alright."
msgstr "Пахнет прямо нормально так."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX_SPRAY"
msgid "I never liked perfume. Now I like it even less"
msgstr "Никогда не любила духи, а теперь-то и подавно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR"
msgid "Go back to your cage."
msgstr "Возвращайся в клетку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL"
msgid "There's always a stampede when the quittin' bell rings."
msgstr "Когда звенит звонок — всегда такое тревожное чувство."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE"
msgid "Is he clockwork? Can I peek inside?"
msgstr "А он заводной? Можно внутрь заглянуть?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_BIG"
msgid "That girl knows how to put on a show."
msgstr "А девчонка знает, как привлечь к себе внимание."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He's a bit of a fixer-upper."
msgstr "Ему бы ремонт не помешал."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "This little guy's been well loved."
msgstr "Видно этого парнишку очень любят."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES"
msgid "A handful of loose berries."
msgstr "Пригоршня диких ягод."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED"
msgid "A bit charred in places, but I don't mind."
msgstr "Местами подгорели, но мне норм."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY"
msgid "They're so juicy!"
msgstr "Они такие сочные!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're still pretty darn juicy."
msgstr "В них осталась толика сочности."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN"
msgid "Needs something from a beast's backside."
msgstr "Здесь бы не помешало чего-нибудь из звериного зада."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING"
msgid "Not much I can do now."
msgstr "Тут я мало чем могу помочь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Тебе бы больничный взять…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Yeuch! Is it supposed to smell like that?"
msgstr "Ох! Оно и должно так вонять?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Can I eat those?"
msgstr "А это вообще есть можно?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED"
msgid "Picked it right clean."
msgstr "Сорвала так сорвала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED"
msgid "You've obviously never worked a boiler room."
msgstr "Очевидно, тебе не доводилось работать в бойлерной."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Totally pooped. Or unpooped?"
msgstr "Совсем уделался. Или обделался?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Not much I can do now."
msgstr "Тут я мало чем могу помочь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Тебе бы больничный взять…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Yeuch! Is it supposed to smell like that?"
msgstr "Ох! Оно и должно так вонять?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Looks tasty. Hope they're not poison."
msgstr "Выглядит аппетитно. Надеюсь, они не ядовитые."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Picked it right clean."
msgstr "Сорвала так сорвала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Pssh. This heat's nothing."
msgstr "Пф-ф. Это даже жарой нельзя назвать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE"
msgid "Pass it over here!"
msgstr "Ну-ка, дайте-ка мне его сюда!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA"
msgid "I'll give it a try!"
msgstr "Нужно попробовать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT"
msgid "At least it doesn't have steel-toed workboots!"
msgstr "По крайней мере, на нем нет стальных ботинок."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE"
msgid "Shoo! Get outta here!"
msgstr "Кыш! Проваливай отсюда!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD"
msgid "I think it was my turn to feed her."
msgstr "Наверное, была моя очередь ее кормить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "That's some proper metalwork."
msgstr "Немного изящной работы по металлу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Hey! Is it my turn to feed the bird?"
msgstr "Эй! Снова моя очередь кормить птицу?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "She was just a patsy."
msgstr "Она была такой простофилей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Let's uh... just sweep that under the rug."
msgstr "Давайте это… просто сметем это под коврик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Why are you tired? Your life is so cushy."
msgstr "Ты почему устала? Твоя жизнь не такая и тяжелая."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING"
msgid "This poor bird's a bag of bones."
msgstr "Эта бедняжка похожа на мешок с костями."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP"
msgid "Birds of a feather get trapped together."
msgstr "И птичка в клетке и перья целы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG"
msgid "Breakfast."
msgstr "Завтрак."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED"
msgid "I always get bits of shell in there by accident."
msgstr "У меня всегда скорлупа случайно попадается."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT"
msgid "That bird gives me the creeps."
msgstr "У меня от этой птицы мурашки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "There's something... off about it."
msgstr "Что-то в ней... неправильное."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP"
msgid "How industrial."
msgstr "Как индустриально."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Yeow!"
msgstr "Йоу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "You look awful!"
msgstr "Выглядишь ужасно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG"
msgid "Not the cheeriest, is it?"
msgstr "Как-то мрачновато."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE"
msgid "Simple, but effective."
msgstr "Просто, но эффективно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA"
msgid "Efficient, and painful!"
msgstr "Эффективно и больно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2"
msgid "That's right up my alley!"
msgstr "Это по моей части!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "Тьфу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP"
msgid "Inflicts the very worst thing... laziness."
msgstr "Приводит в самое ужасное состояние… лень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW"
msgid "I'm gonna shoot this at the bot's butt."
msgstr "Какой-нибудь паразит получит от меня этой штуковиной в задницу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET"
msgid "Now I don't have to take breaks to cool off."
msgstr "Теперь можно не ходить на перерывы, чтобы прохладиться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM"
msgid "It's a gem. A gem that's blue."
msgstr "Это самоцвет. Самый синий цвет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE"
msgid "It saw me standing alone."
msgstr "Он видел меня стоящей просто так."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON"
msgid "Blueprint paper just smells right."
msgstr "Обожаю запах чертежной бумаги."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE"
msgid "Progress on paper!"
msgstr "Прогресс, нарисованный на бумаге!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP"
msgid "Yep. Blue mushroom."
msgstr "Ну да, это синий гриб"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED"
msgid "Well, I don't THINK it's poison."
msgstr "Не ДУМАЮ, что он ядовит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's some sorta blue mushroom."
msgstr "Ну это что-то типа синего гриба."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Ленивый гриб."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Got'er done."
msgstr "Взяла и взяла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS"
msgid "Oh, the possibilities."
msgstr "Ох, сколько возможностей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON"
msgid "Who's ready fer some bacon?!"
msgstr "Кто готов отведать бекончика?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR"
msgid "Let's cut him down to size!"
msgstr "Обстругаем его немного!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03"
msgid "Busted right up, hey?"
msgstr "Прямо-таки в клочья разлетелась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04"
msgid "Busted right up, hey?"
msgstr "Прямо-таки в клочья разлетелась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05"
msgid "Busted right up, hey?"
msgstr "Прямо-таки в клочья разлетелась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH"
msgid "Never know when you might need one."
msgstr "Никогда не знаешь, когда такое пригодится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP"
msgid "Just a quick fix until I can do some proper repairs."
msgstr "Пока так, а потом подлатаю как следует."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Checkpoint ahead!"
msgstr "Прямо по курсу контрольная точка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Better roll up my sleeves and get to buildin'."
msgstr "Пора закатать рукава и браться за стройку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Tryin' to throw a monkeywrench in my race, sis?"
msgstr "Не пытайся мне помешать, сестричка — это мартышкин труд."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy ahead!"
msgstr "Буек прямо по курсу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy ahead!"
msgstr "Буек прямо по курсу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "Надо выкинуть подальше. Не хочу продырявить чужую лодку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "Надо выкинуть подальше. Не хочу продырявить чужую лодку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Must be the new supervisor."
msgstr "Это, видать, новый бригадир."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START"
msgid "No sense stallin', let's go!"
msgstr "Чего весла развесили? Вперед!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Better get started!"
msgstr "Пора за дело!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Plenty of space for storage."
msgstr "Сколько места для хранения!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "They sure don't build 'em like they used to."
msgstr "Да уж, добротно раньше строили."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "It sometimes pays to have a tough exterior."
msgstr "Иногда полезно напустить грозный вид."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "На воде меры предосторожности лишними не бывают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Slimy, but it'll do for securin' the boat some more."
msgstr "Склизковато, конечно, но амортизатор для лодки неплохой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "На воде меры предосторожности лишними не бывают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Turns out seashells are good for givin' shellter from the sea. Ha!"
msgstr "А ракушки действительно неплохая защита от стихии, ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "На воде меры предосторожности лишними не бывают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Wouldn't wanna end up on the business end of those fangs."
msgstr "Не хотела бы я угодить в такие зубищи."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Extra protection's always good, 'specially on water."
msgstr "На воде меры предосторожности лишними не бывают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "All you sea critters better think twice about messing with my boat!"
msgstr "Подумайте хорошенько, прежде чем поднимать клешни на мою лодку!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It won't do much good if it's not loaded."
msgstr "Без снарядов от нее никакой пользы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I won't be able to do much without some cannonballs."
msgstr "Если не будет ядер, то и пушка стрелять не будет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_CANNON_KIT"
msgid "I'll get 'er firin' ready in no time."
msgstr "Сейчас я над ней поработаю, и можно будет стрелять."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Don't expect to build somethin' that's gonna last with cheap materials."
msgstr "Из дешевых материалов ничего долговечного смастерить невозможно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ITEM"
msgid "Time to roll up my sleeves!"
msgstr "Закатаем рукава и за работу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_LEAK"
msgid "That needs a fixin'!"
msgstr "Лодку не помешало бы подлатать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Leaves my hands free for other work!"
msgstr "Освобождает руки для другой работы!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Hands-free sailing, pretty nifty."
msgstr "Автоматизация труда в чистом виде."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I'm not sayin' I'm surprised it works, but..."
msgstr "Не то чтобы я удивлена, что это работает, но..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It'll be handy if it works."
msgstr "Если сработает — будет очень удобно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I think I get the gist, just gotta put it together."
msgstr "Кажется, я начинаю соображать, что тут к чему."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR"
msgid "Controllin' the boat rotation is mighty useful."
msgstr "Вертеть лодкой как захочется может быть весьма полезно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Time to put this doo-hickey to the test."
msgstr "Пора испытать эту штуковину."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It's cushy enough for me."
msgstr "Сгодится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_KELP"
msgid "It wouldn't be my first choice of pillow stuffing."
msgstr "Будь у меня выбор, я бы не стала делать из этого подушку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_PETALS"
msgid "Way too flimsy, there's no support at all!"
msgstr "Какой от нее толк, если она слишком хлипкая?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Aww, it kinda makes me nostalgic for the old steel mill."
msgstr "Она мне напоминает про старые добрые рабочие деньки на металлургическом заводе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT"
msgid "Anyone call for a demolition crew?"
msgstr "Бригаду взрывников вызывали?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "I think that little green fella did some tinkering."
msgstr "Похоже, это смастерил зеленый парнишка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESHARD"
msgid "Whew. These got crunched real good."
msgstr "Фух. Они прямо неплохо так похрустели."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESOUP"
msgid "Knocked it out of the park again, bucko."
msgstr "Как всегда выше всяких похвал, кулинар-хвастунишка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BONESTEW"
msgid "Hearty."
msgstr "Здорово."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.BURNT"
msgid "Shoot. Grams is gonna have a fit."
msgstr "Вот зараза. Бабулю точно инфаркт хватит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "I've gotta say, that's some pretty solid construction."
msgstr "Не могу не отметить, что собрано все это дело с умом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BEES"
msgid "I can't read when there's work to do!"
msgstr "Некогда мне читать, работы полно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BIRDS"
msgid "I was never much of a book learner."
msgstr "Никогда не была заядлой любительницей книг."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_BRIMSTONE"
msgid "I prefer hands-on learning."
msgstr "Я предпочитаю практическое обучение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_ELEMENTAL"
msgid "I ain't too well read."
msgstr "С начитанностью у меня не очень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FIRE"
msgid "Not really my kinda thing."
msgstr "Как-то это совсем не мое."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FISH"
msgid "I learn by doing, not reading."
msgstr "Я учусь не на словах, а не деле."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_FOSSIL"
msgid "I ain't much of a bookworm."
msgstr "Книжным червем меня не назовешь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_GARDENING"
msgid "I prefer to learn from experience."
msgstr "Предпочитаю учиться на опыте других."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE"
msgid "I prefer to learn from experience."
msgstr "Предпочитаю учиться на опыте других."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "I don't need a book tellin' me how to stick seeds in the ground."
msgstr "Еще мне какая-то книга не указывала, как семена в землю совать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT"
msgid "I gotta admit, pretty handy to have a book with a built-in reading lamp."
msgstr "Должна признать, книга со встроенной лампой — очень удобная вещь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "It's all Greek to me."
msgstr "Ничего не понятно, но очень интересно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_MOON"
msgid "At this point, I wish I knew less about the moon."
msgstr "Если так подумать, я бы предпочла знать о луне чуточку меньше."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RAIN"
msgid "I'm too busy to sit around and read."
msgstr "Я слишком занята, чтобы просто сидеть и читать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "You'll only really learn by gettin' your hands dirty."
msgstr "Нельзя узнать что-то новое, не замарав рук."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SILVICULTURE"
msgid "I'd rather have building material than reading material."
msgstr "Я предпочитаю строительные материалы печатным."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_SLEEP"
msgid "I already know how to sleep, thanks."
msgstr "Уже в курсе, как спать, спасибо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TEMPERATURE"
msgid "Sorry grams, I'm not much of a reader."
msgstr "Прости, бабуль, я читать не особенно люблю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_TENTACLES"
msgid "I'm not really a \"book smarts\" kind of gal."
msgstr "Я не очень то «горю желанием» изучать всю эту чепуху."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOK_WEB"
msgid "This ain't one of them self-help books, is it?"
msgstr "Это что, книга по саморазвитию?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOMERANG"
msgid "It's great at comebacks. Ha!"
msgstr "Хотя бы он возращается. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOOTLEG"
msgid "Guess I'd better shake a leg. Ha!"
msgstr "Похоже, пора пошевеливать ногами, ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "I bet I could get it back in working order."
msgstr "Да я в два счета все починю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BRUSH"
msgid "Repetitive tasks are soothing."
msgstr "Повторение упражнений успокаивает."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUGNET"
msgid "Wish we had mosquito netting."
msgstr "Хотелось бы и москитную сетку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "We can pick it if we can get close enough."
msgstr "Если подобраться поближе, можно будет сорвать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "The sea's fulla food, hey?"
msgstr "В море всегда найдется пропитание, правда?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BULLKELP_ROOT"
msgid "Preferred tool of the foreman."
msgstr "Любимый инструмент бригадира."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLE"
msgid "That oughta keep everything nice and fresh."
msgstr "Все должно оставаться чистым и свежим."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNDLEWRAP"
msgid "We could wrap stuff up for later."
msgstr "Мы сможем завернуть что-нибудь на будущее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYMAN"
msgid "You really oughta get some sun."
msgstr "Тебе реально бы реально не помешало немного солнца."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUNNYSTEW"
msgid "I'm so hungry I could eat a... bunny?"
msgstr "Я такая голодная, что... кролика целиком слопала бы!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Right to a crisp."
msgstr "Прямо до хрустящей корочки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUSHHAT"
msgid "Just, y'know. Strap a bush on your head."
msgstr "Ну вы поняли. Напяливай куст себе на башку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTER"
msgid "This makes everything better."
msgstr "С ним все становится лучше."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It has no work or responsibilities. Poor thing."
msgstr "Ни работы, ни обязанностей. Бедолага."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLY.HELD"
msgid "How you doin' in there?"
msgstr "Ну как тебе сидится?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Never liked having butterflies in my stomach."
msgstr "Никогда не любила бабочек в животе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUTTERFLYWINGS"
msgid "There's no flight in their future."
msgstr "Нет больше в их будущем полетов."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BUZZARD"
msgid "It lives off the hard work of others."
msgstr "Он живет на основе тяжкого труда других."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CABBAGEROLLS"
msgid "That'll put meat on your bones!"
msgstr "Ну, сейчас-то мы нарастим мяска на косточки!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.GENERIC"
msgid "Prickly."
msgstr "Иголочки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS.PICKED"
msgid "Guess we know who won that one."
msgstr "Кажется, мы все знаем, чей это приз."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_FLOWER"
msgid "Much less prickly."
msgstr "Намного меньше иголочек."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT"
msgid "It's got a sharp taste. Ha!"
msgstr "Какой острый вкус, порезаться можно. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "That seems a lot safer."
msgstr "Кажется, так намного безопасней."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CALIFORNIAROLL"
msgid "Looks a bit fancy, but I'll give it a try!"
msgstr "Выглядит уж больно кучеряво, но надо пробовать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.EMBERS"
msgid "On its last legs."
msgstr "На ладан дышит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.GENERIC"
msgid "It'll last me the night, hopefully."
msgstr "Надеюсь, он доживет вместе со мной до утра."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.HIGH"
msgid "A good healthy blaze."
msgstr "Хорошее, яркое пламя."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.LOW"
msgid "Gonna go out soon."
msgstr "Скоро совсем потухнет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.NORMAL"
msgid "About as cozy as it gets out here."
msgstr "Достаточно уютно, насколько это может сейчас быть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAMPFIRE.OUT"
msgid "My sister was afraid of the dark."
msgstr "Моя сестра боялась темноты."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.GENERIC"
msgid "That brings back memories."
msgstr "Это наводит на воспоминания."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY.HELD"
msgid "I should take it with me if I go spelunking."
msgstr "Надо взять с собой, вдруг увлекусь спелеологией."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANARY_POISONED"
msgid "Everybody out of the mineshaft!!"
msgstr "Все срочно выбираемся из шахты!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANDYBAG"
msgid "It's a goodybag."
msgstr "Мешок полезностей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANE"
msgid "It's no Tin Lizzie."
msgstr "Это точно не винтаж."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Better load this in the cannon."
msgstr "Это дело надо зарядить в пушку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Now that'll cheer you right up!"
msgstr "Даже мертвого развеселит!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Looks like it's on break."
msgstr "Кажется, сейчас перекур."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Well, this thing's not gonna build itself."
msgstr "Сама себя она не построит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "It really fancies the place up, doesn't it?"
msgstr "Дает ощущение праздника, правда?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Shouldn't take long to build."
msgstr "Построю за пару минут."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Not sure what I should do with this now that I built it..."
msgstr "Построила я эту штуку, а что с ней делать — не знаю..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Let's get crackin'! Ha!"
msgstr "Пойдут скорлупки по закоулочкам! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "I'm not really one for knickknacks."
msgstr "Я во всех этих штучках не разбираюсь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Whoever made this did some mighty fine work."
msgstr "Мастер тут постарался на славу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Kind of cutesy, but it's growing on me."
msgstr "Это, конечно, безделушка, но мне нравится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Alright, I gotta know what's inside..."
msgstr "Очень хочу узнать, что внутри..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Alright, I gotta know what's inside..."
msgstr "Очень хочу узнать, что внутри..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A bit delicate lookin' for my taste, but at least it works."
msgstr "На мой вкус уж больно изящно, но работает неплохо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Shouldn't take long to build."
msgstr "Построю за пару минут."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "You can't exactly hang a swing from it, but it's pretty enough."
msgstr "Качели, конечно, на него не повесишь, но и так неплохо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I'll have that set up in a jiffy."
msgstr "Сейчас мигом все поставлю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Err... refreshing...?"
msgstr "Хм... освежает?.."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "They're gonna make my hands all grubby. Ha!"
msgstr "А чем червячков морят, морилкой? Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "I'll have that set up lickety-split."
msgstr "И глазом никто моргнуть не успеет, как я все поставлю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "Looks like a tripping hazard to me."
msgstr "Сюда бы табличку, чтоб люди под ноги смотрели."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Yeesh, that mama bird sure has a lot of mouths to feed."
msgstr "Да уж, у этой наседки семеро по лавкам."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "I'm gonna getcha!"
msgstr "Уж я тебя поймаю!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Gotta work before you can play."
msgstr "Первым делом за работу, развлечения потом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Those are some real free-running eggs!"
msgstr "Вот уж действительно цыплята свободного выпаса!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "Looks like a tripping hazard to me."
msgstr "Сюда бы табличку, чтоб люди под ноги смотрели."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "It's gotta be that one!"
msgstr "Это точно она!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "These birds can't build their own carnival?"
msgstr "Эти птички сами свой собственный карнавал устроить не могут?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "Let's get crackin'! Ha!"
msgstr "Пойдут скорлупки по закоулочкам! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "Gotta work before you can play."
msgstr "Первым делом за работу, развлечения потом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "That little ball's got a mind of its own."
msgstr "Этот шарик как будто живет своей жизнью."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "None of the buttons back at the factory were this fancy."
msgstr "На фабрике у нас таких красивых кнопок не было."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "Gotta work before you can play."
msgstr "Первым делом за работу, развлечения потом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "I pride myself on being a straight-shooter! Ha!"
msgstr "Стреляю без подготовки прямо в яблочко, ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "Looks like a tripping hazard to me."
msgstr "Сюда бы табличку, чтоб люди под ноги смотрели."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Time for some pest control."
msgstr "Пора заняться истреблением вредителей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "Gotta work before you can play."
msgstr "Первым делом за работу, развлечения потом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "Looks like I just need a token to play."
msgstr "Теперь мне нужен только жетон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Well would ya look at that, I'm winning!"
msgstr "Ну вы только гляньте: я победила!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_BALL"
msgid "You can't beat a good old rubber ball."
msgstr "Старый добрый резиновый мяч всему голова."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_CROWKID"
msgid "Aww, hey little guy!"
msgstr "Ути! Привет, малыш!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "I haven't been to a fair since I was a kid!"
msgstr "Я на ярмарке с самого детства не была!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_HOST"
msgid "That's one fancy crow."
msgstr "Какой элегантный ворон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Hm... this area could stand to be gussied up a bit."
msgstr "Хм... тут не помешает добавить веселья."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Lookin' pretty good... but I think we can do even better."
msgstr "Выглядит неплохо... но мы способны на большее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "Now that's a fine lookin' tree!"
msgstr "А вот это — отличное дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Gotta set the foundations for the Cawnival."
msgstr "Пора заложить фундамент для Галкарнавала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Heh, I always had to win the toys for Charlie when we were kids..."
msgstr "Ха, в детстве мне вечно приходилось выигрывать для Чарли игрушки..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "A job well done is its own reward, but gettin' a prize is even better!"
msgstr "Хорошо выполненная работа уже повод для гордости, а уж если еще и призы дают..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I wonder if I can get anything for one ticket..."
msgstr "Интересно, что можно купить за один билетик?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Now we're talkin'! Let's take a look at those prizes!"
msgstr "Совсем другое дело! Ну-ка, что там в ларьке выдают?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I've got a decent pile of tickets going!"
msgstr "Билетиков набралась уже внушительная кучка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "Looks like a bag of bird food."
msgstr "Похоже на кулек с птичьим кормом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_A"
msgid "That's a nice little scarf."
msgstr "Отличный шарфик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_B"
msgid "Surprisingly well made, considering it was made by birds."
msgstr "Сделано на удивление добротно, учитывая, что его шили птицы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARNIVAL_VEST_C"
msgid "It's actually pretty practical for keepin' cool on hot summer days."
msgstr "Поможет подостыть в жаркий летний денек."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "That is one sweet saw blade."
msgstr "Вот это я понимаю — пила."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "You didn't deserve this."
msgstr "Ты этого не заслужила."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I... love you."
msgstr "Кажется... я влюбилась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.DEAD"
msgid "That don't look good."
msgstr "Что-то ей совсем нехорошо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.GENERIC"
msgid "Yer an orange nuisance, aintcha?"
msgstr "Ах ты, оранжевая заноза в заднице!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.HELD"
msgid "Aw, I can't stay mad at you."
msgstr "Ну ладно, не могу я на тебя злиться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT.SLEEPING"
msgid "Sleep tight."
msgstr "Спи крепко."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARRAT_GHOSTRACER"
msgid "You always did have a competitive streak, didn't ya sis?"
msgstr "Ты всегда любила посоревноваться, да, сестричка?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT"
msgid "Free food from the ground."
msgstr "Бесплатный подножный корм."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_COOKED"
msgid "Easier on the gums. Not that that matters."
msgstr "Так хоть деснам полегче. Но не так, как обычно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_OVERSIZED"
msgid "A big bunch of carrots."
msgstr "Знатная морковка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_PLANTED"
msgid "Perfectly pluckable."
msgstr "Легковыдергиваемо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARROT_SEEDS"
msgid "A handful of seeds."
msgstr "Горсть семян."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Welp."
msgstr "Ну-с."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "It's okay. I'll assemble another."
msgstr "Все нормально. Я новый соберу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Good place to kick your feet up, if nothin' else."
msgstr "Идеальное место, чтобы воздух попинать, если больше нечего делать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOON"
msgid "She'll keep the rats outta the factory."
msgstr "Она поможет избавиться от крыс на производстве."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONDEN.EMPTY"
msgid "As abandoned as an old warehouse."
msgstr "Заброшено, как старый дом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONDEN.GENERIC"
msgid "We all gotta sleep."
msgstr "Всем нам приходится спать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CATCOONHAT"
msgid "Do I look like a fur trader?"
msgstr "Я похожа на торговку мехами?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CATTOY_MOUSE"
msgid "I think it's got a squeaky wheel."
msgstr "Ей бы колесики смазать не помешало."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Looks movable."
msgstr "Кажется, это можно сдвинуть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I'm just not tall enough."
msgstr "Я не настолько высокая."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA"
msgid "Everything since I got here has been bananas."
msgstr "С тех пор, как я тут появилась, все происходящее становится БАНАльНым."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Big ol' burnt banana tree."
msgstr "Большое старое погорелое банановое дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Caramelized banana's the tops."
msgstr "Обожаю карамелизированные бананы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_BANANA_TREE"
msgid "That's, uh, a banana tree."
msgstr "Ну, это, ну, банановое дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE"
msgid "Into the depths!"
msgstr "В глубины!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "They're at capacity down there."
msgstr "Здесь немного людновато."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Nah, I don't want blacklung."
msgstr "Мне не хочется заработать антракоз."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Another day, another creepy cave."
msgstr "В новом дне, на новом жутком дне."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Is it wise to go deeper?"
msgstr "Разумно ли спускаться глубже?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.FULL"
msgid "Nah, it's packed up there."
msgstr "Не, там людно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I don't need fresh air."
msgstr "Мне не нужен свежий воздух."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_EXIT.OPEN"
msgid "I barely remember what the surface looks like."
msgstr "С трудом припоминаю, как выглядит белый свет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CAVE_FERN"
msgid "Take a gander at this tiny fern!"
msgstr "Вы только гляньте на этот малюсенький папоротничек!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CEVICHE"
msgid "Now that's some tasty grub!"
msgstr "Вот это всем пайкам паек!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARCOAL"
msgid "It gets everywhere."
msgstr "Он тут повсюду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIERESIDUE"
msgid "I must've just missed her... but she left somethin' behind."
msgstr "Похоже, мы с ней разминулись... но она кое-что оставила."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIEROSE"
msgid "Oh, Charlie. What are you gettin' me into now?"
msgstr "Ох, Чарли. Во что ты меня опять втягиваешь?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_HAND"
msgid "You want something, huh?"
msgstr "Нужно что-то?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_HECKLER"
msgid "You can't please everyone."
msgstr "Всем не угодишь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_LECTURN"
msgid "Everyone's got their part to play, huh?"
msgstr "Похоже, каждому отведена своя роль?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_NPC"
msgid "Charlie, wait!!"
msgstr "Чарли, подожди!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Who'd build a stage out here? Oh..."
msgstr "Кто мог построить здесь сцену? А, ну да..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK1"
msgid "A heap of spare parts."
msgstr "Куча различных кусков."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK2"
msgid "A heap of spare parts."
msgstr "Куча различных кусков."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSJUNK3"
msgid "A heap of spare parts."
msgstr "Куча различных кусков."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "I'm fond'a this one."
msgstr "Мне нравится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Looks so real, I can almost feel the earth rumblin'."
msgstr "Прямо как живой. Я почти чувствую, как земля трясется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Y'got a mean mug there, buddy."
msgstr "Ну и злобное у тебя рыло, дружок."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "That was one ornery son of a beast."
msgstr "Ну и вычурная зверюга!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Aw, it looks just like my beefalo."
msgstr "Ой, как похоже на моего бифало!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "I wonder if I could sculpt a hat like that."
msgstr "Интересно, а у меня получится так же слепить?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "I'm not big on headgames."
msgstr "Я не особо сильна в игре головой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "That ain't supposed to move."
msgstr "Для передвижений он не приспособлен."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "I feel like it's lookin' at me."
msgstr "Кажется, будто она смотрит прямо на меня."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Look at it, just lazing around!"
msgstr "Ты посмотри, как она тут развалилась!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CATCOON"
msgid "Aw, whatcha got there? ...Oh."
msgstr "Ой, а чего это у нас тут такое?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A good boy if ever I saw one."
msgstr "Хорошего мальчика я узнаю сразу, если увижу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It's a sculpture of that mean mutt."
msgstr "Это — статуя той злобной шавки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Hey Max, you guys have a lot in common!"
msgstr "Ой, Макс, смотри, он на тебя похож!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "It's so lifelike, I can almost smell the bad breath."
msgstr "Как живой! Я прямо чувствую, как у него изо рта воняет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "This hog don't know how to quit."
msgstr "Этому свинтусу поучиться бы вовремя уходить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "Ha. It looks kinda surprised, don't it?"
msgstr "Ха. Какой у него удивленный вид."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "She's almost a looker."
msgstr "Глаз не оторвать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "Ugh, still makes my skin crawl."
msgstr "Уф, у меня от него до сих пор мурашки ползают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "My pals and I can't be beat."
msgstr "Нам с друзьями никто не страшен."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "An eye (statue) for an eye (monster)!"
msgstr "Это каменная статуя, но за глаза мы ее зовем монстром."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_FORMAL"
msgid "It's BUSTed. Ha!"
msgstr "У тебя какой-то разбитый вид, ха."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "A little too lifelike for my comfort."
msgstr "Слишком уж реалистичный, у меня аж мурашки по коже."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Ugh, don't remind me of food."
msgstr "Ох, не напоминайте мне о еде."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KITCOON"
msgid "I can't tell if this a great feat of engineering or a very stupid one. Either way, it sure is cute."
msgstr "Это либо гениальное инженерное решение, либо идиотское. Но в любом случае мило."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Kinda makes me nostalgic."
msgstr "Даже ностальгию вызывает."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Why the long face?"
msgstr "Что за недовольная морда?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "That ain't supposed to move."
msgstr "Для передвижений он не приспособлен."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "It tried to mess with the wrong gal."
msgstr "Не на ту напал."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "It doesn't look like he has a care in the world."
msgstr "Выглядит так, будто ему вообще на все плевать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "What a stone-faced brute."
msgstr "Стоит тут с каменным лицом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MOON"
msgid "That statue's moonin' me! HA!"
msgstr "О, тут можно увидеть обратную сторону луны!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "It looks like it's hollerin'."
msgstr "Он как будто трубит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_MUSE"
msgid "I've got a bad feeling about this one."
msgstr "Что-то у меня плохое предчувствие."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PAWN"
msgid "Nice hat."
msgstr "Милая шляпа."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_PIPE"
msgid "It's got bubbles coming out the top."
msgstr "Из нее пузыри идут."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Looks heavy."
msgstr "Массивно смотрится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "That ain't supposed to move."
msgstr "Для передвижений он не приспособлен."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "That shark was kind of a jerk."
msgstr "Эта акула была та еще гадина."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_STALKER"
msgid "I like 'em better when he's not stalkin' me."
msgstr "Мне он больше нравится в каменном виде."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "I built a stool once but it didn't look like that."
msgstr "У поганки должна быть одна ножка, а не лягушачьи лапки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "A fresh pair of eyes is just what we needed around here!"
msgstr "Еще одной пары любопытных глаз нам тут не хватало!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Now this is a pooch I could play with."
msgstr "Вот с таким собакеном я бы поиграла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "What a big nasty worm that was. Blegh."
msgstr "Как есть червь: большой и противный. Гадость."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_YOTD"
msgid "We really brought the heat! Ha!"
msgstr "Ух и задали мы жару! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESSPIECE_YOTS"
msgid "Ugh, still makes my skin crawl."
msgstr "Уф, у меня от него до сих пор мурашки ползают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER"
msgid "Who's the cutest lil toolbox?"
msgstr "Кто тут у нас хороший чемоданчик?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Toolbox controls."
msgstr "Управление чемоданом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Something upset it."
msgstr "Что-то его расстраивает."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Looks like something the bossman would've come up with."
msgstr "Такое только большой начальник мог выдумать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Didn't I tell ya?!"
msgstr "А я говорила!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CHUM"
msgid "I'm all for anything that makes fishing go faster."
msgstr "Я всеми конечностями за любую оптимизацию процесса рыбалки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I'll send you runnin', mutt!"
msgstr "Ты у меня побежишь, теряя тапки, тупица!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYHOUND.STATUE"
msgid "How earthy."
msgstr "Как грубо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYWARG.GENERIC"
msgid "You lookin' to scrap, big guy?"
msgstr "Нарываешься на драку, здоровяк?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CLAYWARG.STATUE"
msgid "I'm glad it ain't movin'."
msgstr "Хорошо, что оно больше не движется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.EMBERS"
msgid "On its last legs."
msgstr "На ладан дышит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.GENERIC"
msgid "It's... cold? Somehow?"
msgstr "Оно… холодное? Как так?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.HIGH"
msgid "A good healthy blaze."
msgstr "Хорошее, яркое пламя."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.LOW"
msgid "Gonna go out soon."
msgstr "Скоро совсем потухнет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.NORMAL"
msgid "Seems good for now."
msgstr "Наверное, пока что нормально."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIRE.OUT"
msgid "That's that."
msgstr "Вот и все."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "On its last legs."
msgstr "На ладан дышит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "It makes cold fire? I don't quite get it."
msgstr "От него холодное пламя исходит? Не врубаюсь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Properly roaring."
msgstr "Неистовый рев."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's gonna go out soon."
msgstr "Скоро совсем потухнет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Doin' okay."
msgstr "Все нормально."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLDFIREPIT.OUT"
msgid "Out, for now."
msgstr "Пока что выключен."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COLLAPSEDCHEST"
msgid "Yeesh, what a mess!"
msgstr "Ох, ну и бардак!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.E"
msgid "West."
msgstr "Запад."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.GENERIC"
msgid "I'm pretty good with directions."
msgstr "У меня все нормально с ориентацией."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.N"
msgid "South."
msgstr "Юг."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NE"
msgid "Southwest"
msgstr "Юго-запад"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.NW"
msgid "Southeast"
msgstr "Юго-восток"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.S"
msgid "North."
msgstr "Север."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SE"
msgid "Northwest"
msgstr "Северо-запад"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.SW"
msgid "Northeast"
msgstr "Северо-восток"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPASS.W"
msgid "East."
msgstr "Восток."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOST"
msgid "Why do I feel like I'm a waiter for those plants?"
msgstr "Я как будто девочка на побегушках у своих растений."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "That should do it!"
msgstr "Вполне неплохо!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Guess I'll have to start from scratch."
msgstr "Что ж, придется начинать сначала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Looks a bit dry to me."
msgstr "По-моему, немного суховато."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "It's dirty work, but somebody's got to do it."
msgstr "Работа грязная, но кто-то же должен ее делать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTINGBIN.WET"
msgid "I'd guess there's a bit too much water in there."
msgstr "У меня такое чувство, что там воды многовато."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COMPOSTWRAP"
msgid "Heh. That bean sprout's a gross little guy."
msgstr "Ха, какой невоспитанный росток."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Let's get building."
msgstr "Пора строить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKBOOK"
msgid "Havin' a blueprint sure makes cooking easier!"
msgstr "По чертежам готовить проще!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMANDRAKE"
msgid "Dead as several doornails."
msgstr "Мертвецки мертв."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMEAT"
msgid "Cooked meat, ready to eat."
msgstr "Кушать подано, садитесь, приятного аппетита."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still purple in the middle."
msgstr "Оно все еще фиолетовое в центре."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKEDSMALLMEAT"
msgid "Well, a morsel's a morsel."
msgstr "Ну, это закуска из закуски."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTER"
msgid "What's the matter lil guy?"
msgstr "В чем дело, малыш?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTERHAT"
msgid "Hardhats must be worn beyond this point!"
msgstr "С этого момента ношение касок строго обязательно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKIECUTTERSHELL"
msgid "That thing was well protected."
msgstr "Защита у этой штуки выдающаяся."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "I can't make heads or tails of it."
msgstr "Ни черта разобрать не могу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.BURNT"
msgid "You guys like gristle, right?"
msgstr "Вам, ребятки, хрящики же нравятся, да?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Still got a bit of a wait."
msgstr "Еще надо немного подождать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost!"
msgstr "Почти!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.DONE"
msgid "Soup's on!"
msgstr "Суп готов!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COOKPOT.EMPTY"
msgid "I make a mean stew."
msgstr "Хоть бы мясного потушить чего."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COONTAIL"
msgid "Grab life by the tail."
msgstr "Ухватила жизнь за хвост."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN"
msgid "I talked its ear off. Ha!"
msgstr "Все уши заболтал. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_COOKED"
msgid "Tell me if I get'em stuck in my teeth."
msgstr "Скажи, если она застрянет у меня в зубах."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_OVERSIZED"
msgid "Who wants some corn on the cob? There's plenty to go around!"
msgstr "Кому кукурузу на палочке? Тут на всех хватит!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CORN_SEEDS"
msgid "A handful of seeds."
msgstr "Горсть семян."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Hey, that looks like it'll fit me!"
msgstr "О, кажется, мне в самый раз!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Looks like a doll's costume."
msgstr "Похоже на костюм куклы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Looks like a jester costume."
msgstr "Похоже на костюм шута."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_KING_BODY"
msgid "Looks like a King's costume."
msgstr "Похоже на костюм короля."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Looks like some kind of costume."
msgstr "Похоже на какой-то костюм."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Looks like a Queen's costume."
msgstr "Похоже на костюм королевы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COSTUME_TREE_BODY"
msgid "Looks like a tree costume."
msgstr "Похоже на костюм дерева."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Looks like the fire's outta fuel."
msgstr "Похоже, закончилось топливо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A little elbow grease, and it'll look good as new."
msgstr "Немножечко поработать, и будет как новенькая!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Looks like the fire's outta fuel."
msgstr "Похоже, закончилось топливо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Now that's a well-built statue!"
msgstr "Вот это статуя, так статуя!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Looks like the fire's outta fuel."
msgstr "Похоже, закончилось топливо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Polished and gleaming!"
msgstr "Начищено до блеска!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COTL_TRINKET"
msgid "Awfully high-and-mighty, huh?"
msgstr "Ужасно высокомерная вещица."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.COZY_BUNNYMAN"
msgid "What a bunch of slackers!"
msgstr "Ишь, сколько бездельников!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.GENERIC"
msgid "Looks like he thinks he's the boss around here."
msgstr "Кажется, он думает, что это он тут главный."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.INERT"
msgid "The foundation doesn't look very stable."
msgstr "Фундамент правления у него не особенно прочный."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CANNONTOWER"
msgid "There's no way they've got a permit for that."
msgstr "Разрешения у них, конечно же, нет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CLAW"
msgid "Now that's some claws for alarm. Ha!"
msgstr "Пора бить тревогу, хо-хо! Тревогу, не меня!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_ICEWALL"
msgid "Heh. I think this guy's tryin' to ice me out!"
msgstr "Хе-хе. Что-то он ко мне охладел."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB"
msgid "Just a hired hand. Er, claw."
msgstr "Наемные руки... то есть клешни."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "I've had supervisors crabbier than him."
msgstr "Это еще что, а как бригадиры ко мне цеплялись!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTERLAB"
msgid "Come on out, don't be shy."
msgstr "Давай выползай, не стесняйся."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_DRAGONLING"
msgid "You're pretty swell, for a tiny monstrosity."
msgstr "А ты довольно красивый для маленького чудовища."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "I spy with my little guy..."
msgstr "У меня зоркий глаз..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_GLOMLING"
msgid "You're pretty cute for a giant bug, hey?"
msgstr "Ты чего такой милый огромный жучара, а?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_KITTEN"
msgid "I'm going to spoil you rotten."
msgstr "Я тебя вусмерть избалую."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_LAMB"
msgid "You're just a fluffball on legs!"
msgstr "Ты просто меховой шарик с лапками!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "You sure are fragile, aren'tcha lil fella?"
msgstr "Такой нежный и хрупкий малыш…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_PERDLING"
msgid "Hey there, feathers."
msgstr "Давай сюда, пернатый."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_PUPPY"
msgid "Pups love you no matter who you are."
msgstr "Щенкам неважно, кто ты на самом деле, они тебя любят."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CROW.GENERIC"
msgid "Looks a bit flighty. Ha!"
msgstr "Выглядит немного ветреным. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CROW.HELD"
msgid "Hauling you around is murder on the feet! Ha!"
msgstr "Носить тебя с собой — это же как смерть ходячая! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRUMBS"
msgid "A trail of crumbs to follow!"
msgstr "След из крошек! Последуем же по нему!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Charm bracelets were never really my thing."
msgstr "Никогда не любила всякие браслетики."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTGRASS"
msgid "A fire waiting to happen."
msgstr "Грядет огонь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTLESS"
msgid "Looks more like a toy than a sword."
msgstr "Больше похоже на игрушку, чем на настоящий меч."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTLICHEN"
msgid "Not to my lichen. Ha!"
msgstr "Хорошо хоть не лишай. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTREEDS"
msgid "Doesn't hold a candle to steel pipe."
msgstr "И не свернуть с пути стального."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CUTSTONE"
msgid "Prepped and ready for the assembly line."
msgstr "Наточен и готов к разделочной части."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER.GENERIC"
msgid "Yeesh big guy, I was just tryin' to help you out!"
msgstr "Эй, здоровяк! Я же просто пыталась тебе помочь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "That pig's seen better days."
msgstr "Ну и помотала же жизнь этого хряка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.BURIED"
msgid "He sure is in a sorry state."
msgstr "Да уж, жалкое зрелище."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.GENERIC"
msgid "He seems to be minding his own business."
msgstr "Вроде он никого не трогает."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Take it easy, big boy!"
msgstr "Полегче, здоровяк!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "I stand corrected. That rock ain't goin' nowhere."
msgstr "Беру свои слова обратно. Этот камень так просто не сдвинешь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "That marble doesn't look structurally sound to me."
msgstr "Конструкция этой мраморной колонны не выглядит прочной."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEADLYFEAST"
msgid "Food poisoning and a half."
msgstr "Более чем просто отравление на пиру."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEAD_SEA_BONES"
msgid "They're picked clean dry."
msgstr "Кто-то их хорошенько обглодал."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "That's an impressive blaze."
msgstr "Впечатляющее великолепие."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Completely charred."
msgstr "Полностью обуглился."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Done and done."
msgstr "Было и прошло."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Another tree."
msgstr "Еще дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Why does a tree need a mouth?!"
msgstr "Зачем вообще дереву нужен рот?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECK_OF_CARDS"
msgid "Remember when you'd always knock down my house of cards?"
msgstr "Помню, как кое-кто вечно ломал мои карточные домики."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_CENTERPIECE"
msgid "Looks like some frou-frou clutter to me."
msgstr "К чему этот чрезмерный пафос?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Looks nice enough, but it feels kinda empty."
msgstr "Выглядит красиво, но пустовато."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It ain't a lamp, but it'll work."
msgstr "Ну надо же, не лампа, а светится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Lookin' fresh as a daisy!"
msgstr "Очень освежает обстановку!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "That's not gonna last much longer."
msgstr "Он больше не продержится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I think it's time to retire this one."
msgstr "Похоже, кому-то пора на пенсию."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_LAMP"
msgid "A good lamp will keep ya workin' through the night!"
msgstr "При хорошем освещении можно и всю ночь проработать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "One of them highbrow \"still life\" pieces, huh?"
msgstr "Это что-то для истинных ценителей, да?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "That frame looks kinda plain with nothin' in it."
msgstr "Эта рамка выглядит довольно скучно, когда пустая."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "It's a pretty good likeness."
msgstr "А что, вполне похоже."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.ANTLER"
msgid "Looks like she has a new addition."
msgstr "Похоже, у нее появилось новое дополнение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.GENERIC"
msgid "A bouncy fluffster."
msgstr "Прыгучий пуховой мешок."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS"
msgid "Don't even think about it, you dumb lug!"
msgstr "Даже не думай об этом, болванище!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "There's no comin' back from that."
msgstr "Пути назад нет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "She's the deerly departed."
msgstr "Ему не стоило лезть на рожон."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "That just ain't right."
msgstr "Она совсем неправильная."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "That is one creepy refrigeration unit."
msgstr "До чего же страшная холодильная установка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It needs that spooky ol' eye to work."
msgstr "Чтобы все заработало, нужен тот жуткий глаз."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Time to roll up the ol' sleeves!"
msgstr "Пора закатать рукава!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "You lookin' at me? Are YOU lookin' at ME?"
msgstr "Ты на меня уставился? Эй! ТЫ на МЕНЯ уставился?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_ANTLER"
msgid "What am I supposed to do with this?"
msgstr "И что мне с этим делать?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_GEMMED"
msgid "Looks dangerous!"
msgstr "Выглядит опасно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's closed for business."
msgstr "Закрыто на спец-обслуживание."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DESERTHAT"
msgid "Helps you see, see?"
msgstr "Она помогает видеть. Видишь?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL"
msgid "What an incredible tool!"
msgstr "Какой невероятный инструмент!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL_NODEV"
msgid "Lazy builders."
msgstr "Ленивые строители."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIRTPILE"
msgid "Time to get my hands dirty."
msgstr "Пришло время запачкать ручки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.COLD"
msgid "S'not picking anything up."
msgstr "Он ничего не ловит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.GENERIC"
msgid "I'm probably one of the few left that knows how to use these."
msgstr "Не так уж и много осталось тех, кто знает как им пользоваться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.HOT"
msgid "I'm sitting right on top of... something."
msgstr "Я сейчас нахожусь ровно над… чем-то."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARM"
msgid "It's getting something."
msgstr "Он что-то поймал."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARMER"
msgid "Gonna hit paydirt any second now."
msgstr "Я срублю куш в любую минуту."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Just like in the bossman's workshop."
msgstr "Прямо как в мастерской босса."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.READY"
msgid "I guess it wants the Voxola?"
msgstr "Наверное, это антенна от дедушкиного радио?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "At least I assembled it right."
msgstr "Ну, я хотя бы его собрала правильно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODSTART"
msgid "That's a Voxola! What's it doing here?"
msgstr "Это же дедушкино радио! Что оно тут делает?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_KIT"
msgid "Leave the dock buildin' to me."
msgstr "Я вам сейчас мигом док состряпаю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "I don't like seeing \"spare\" parts lyin' around..."
msgstr "Не нравится мне, когда остаются «лишние» запчасти..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOLL_BLUEPRINT"
msgid "That's a lot of ruffles to sew on..."
msgstr "Сколько же рюшечек пришивать..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_KIT"
msgid "It's not gonna build itself."
msgstr "Сама себя она не построит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_PACK"
msgid "This baby's got everything you need!"
msgstr "В этой штуке все, что нужно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBODYHAT"
msgid "It's the beast's tummy!"
msgstr "Это же пузо чудища!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONCHILISALAD"
msgid "Can't believe Warly's got me eatin' salads."
msgstr "Поверить не могу, что добровольно ем салаты. Это все Варли!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLY"
msgid "Get a load of this flying welding torch!"
msgstr "Да тут этих сварочных диодов под завязку!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "For the snootiest of snoots."
msgstr "Помогает от всех страшных рож."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Snooty, but durable."
msgstr "Больно помпезно, зато надежно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Pretty fancy for a heater."
msgstr "Слишком вычурно для печки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "We oughta fix that."
msgstr "Нам бы его починить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "That's a proper furnace."
msgstr "Вот это я понимаю — печь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Could use a bit more kick."
msgstr "Ее можно использовать еще немного."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT"
msgid "Snooty fruit."
msgstr "Вот так фрукт."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Cooked the snoot right out of it."
msgstr "Все сопли из него выжарила."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "We'll be eating this stuff for days!"
msgstr "Целый месяц теперь его есть будем!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "A handful of seeds."
msgstr "Горсть семян."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONHEADHAT"
msgid "Front and center!"
msgstr "Перед определяем по заднему шву!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONPIE"
msgid "Where's the beef?"
msgstr "А где мясо?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONTAILHAT"
msgid "That's the business end."
msgstr "Так вот бизнес и рушится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGON_SCALES"
msgid "Showy."
msgstr "Показуха."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE"
msgid "It's evil-lookin', but tough as nails."
msgstr "Выглядит зловеще, зато прочнее стали."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONEHAT"
msgid "Lookin' sharp! Literally."
msgstr "Сделает мои черты более заостренными. В прямом смысле."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK"
msgid "Must be a lot of the stuff growing down there."
msgstr "Внизу, наверное, таких целая куча."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oof. Kitschy."
msgstr "Ох, какой китч."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "Оно горит! Жуть!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Looks like there was an accident here."
msgstr "Кажется, тут произошел несчастный случай."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Wonder if driftwood's a good buildin' material?"
msgstr "Интересно, можно ли что-нибудь построить из такой коряги?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree's seen better days."
msgstr "Это дерево многое повидало."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK"
msgid "Can't say a raw drumstick sounds too appealing."
msgstr "Не уверена, что сырая куриная ножка выглядит аппетитно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK_COOKED"
msgid "Can't be beat."
msgstr "Побить ей я все равно никого не смогу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BANANABUSH"
msgid "Sure beats goin' down to the caves."
msgstr "Наверняка корнями он уходит в пещеру."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH"
msgid "I love getting my hands dirty."
msgstr "Мне нравится, когда руки в грязи."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I'll replant that if no one else wants to."
msgstr "Я его пересажу, если никто другой не собирается этого делать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_GRASS"
msgid "Looks like some gardening's in order."
msgstr "Кажется, тут какие-то садовые работы намечаются."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MARSH_BUSH"
msgid "Well it's not gonna replant itself."
msgstr "Ну, сам себя он не пересадит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MONKEYTAIL"
msgid "Those are some tall tails, I tell ya!"
msgstr "Ну и длиннющие же у них хвосты!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_SAPLING"
msgid "Needs replanting."
msgstr "Его нужно пересадить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Can't fool me, ha!"
msgstr "Меня не обманешь! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL"
msgid "Why not do some real work instead of just liftin' these things?"
msgstr "Может, делом займешься вместо того, чтобы болванки тягать?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Better get some ice on that!"
msgstr "Кому тут приложить холодненькое?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GEM"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Больно уж дорого-богато. Ты же эту штуку просто поднимаешь и бросаешь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Больно уж дорого-богато. Ты же эту штуку просто поднимаешь и бросаешь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_HEAT"
msgid "Is that what he uses for a warm-up?"
msgstr "Он эту штуку использует, чтобы разогреться?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_MARBLE"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Больно уж дорого-богато. Ты же эту штуку просто поднимаешь и бросаешь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_REDGEM"
msgid "You'll really be feelin' the burn! Ha!"
msgstr "С ней точно можно почувствовать жар в теле! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN"
msgid "Powerful stench! I respect that."
msgstr "Какая лютая вонь! Я такое уважаю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_COOKED"
msgid "Whew! That'll put some hair on your hair."
msgstr "Фу! У тебя волос в волосах."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_OVERSIZED"
msgid "It sure is making a big stink."
msgstr "Запашок соответствует размерам."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_SEEDS"
msgid "A handful of seeds."
msgstr "Горсть семян."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMERINGUE"
msgid "Ugh. Maybe one of those little moth guys will clean this mess up."
msgstr "Фу. Может, мотыльки это приберут к лапкам?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTH"
msgid "Quite the tenacious little worker."
msgstr "Маленький, но очень выносливый работник."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTHDEN"
msgid "Sorry little fellas, but you've got some material I need."
msgstr "Простите, малыши, но мне нужно то, что вы производите."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EARMUFFSHAT"
msgid "I hate cold weather."
msgstr "Ненавижу холодную погоду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL"
msgid "You're looking a little eel. Ha!"
msgstr "Что же ты как шланг? Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL_COOKED"
msgid "I'll eat anything once."
msgstr "Впервые ем что-то подобное."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT"
msgid "Look how weird it is! Ha!"
msgstr "Ты глянь на что похож! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_COOKED"
msgid "Did that make it better? I don't know."
msgstr "И он что, стал заметно лучше? Ох не знаю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "It sure makes a big impression. Ha!"
msgstr "Ха, это вам не какая-нибудь лажа!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_SEEDS"
msgid "A handful of seeds."
msgstr "Горсть семян."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ELIXIR_CONTAINER"
msgid "Ain't no picnic for the livin' round here."
msgstr "Это что за пикник во время чумы?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EMBERLIGHT"
msgid "Nice and toasty."
msgstr "Мило и тепленько."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.BURNT"
msgid "That's a shame."
msgstr "Какая жалость."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.EMPTY"
msgid "Sturdily built."
msgstr "Прочно стоит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "I miss lamps."
msgstr "Скучаю по лампочкам."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.GENERIC"
msgid "Pretty sure this one won't move."
msgstr "Я стопроцентно уверена, что он не двинется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "That's not gonna last much longer."
msgstr "Он больше не продержится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.WILTED"
msgid "That bouquet's seen better days."
msgstr "Видал этот букет и лучшие времена."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNING"
msgid "That's an impressive blaze."
msgstr "Впечатляющее великолепие."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNT"
msgid "Completely charred."
msgstr "Полностью обуглился."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.CHOPPED"
msgid "As long as the job's done."
msgstr "Пока работа есть — мы работаем."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.GENERIC"
msgid "Just a tree."
msgstr "Просто дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Impressive blaze."
msgstr "Впечатляющее великолепие."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Completely charred."
msgstr "Полностью обуглился."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Glad that's over with."
msgstr "Рада, что с ним покончено."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Yep. Definitely a tree."
msgstr "Ну да. Это определенно дерево."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEBRELLAHAT"
msgid "Nice and dry underneath."
msgstr "В ней хорошо и сухо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEMASKHAT"
msgid "Guess I'll really be seein' the world through different eyes."
msgstr "Теперь-то я точно посмотрю на мир с другой точки зрения."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR"
msgid "Yeesh, what an eyesore."
msgstr "Вот ведь бревно в глазу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI"
msgid "Can't fault them for doing their job with the big overseer right there."
msgstr "Они просто делают свою работу. С таким бригадиром и я бы не филонила."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "You'd think I'd be used to this kind of thing by now."
msgstr "Казалось бы, давно уже можно было к такому привыкнуть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEPLANT"
msgid "Y'know? I'm not even gonna ask."
msgstr "Чего? Я даже спрашивать не буду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET"
msgid "That's a fine piece of work."
msgstr "А вот это — хорошая работа."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET_ITEM"
msgid "Lemme assemble it."
msgstr "Дай-ка мне это собрать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.BURNT"
msgid "I hate seeing hard work wasted."
msgstr "Не люблю видеть, как трудятся впустую."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GENERIC"
msgid "You reap whatcha sow."
msgstr "Что посеешь — то пожнешь."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GROWING"
msgid "Our hard work is paying off."
msgstr "Наш труд окупится с лихвой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs a bit of a kick."
msgstr "Немножко бы его подбодрить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_HOE"
msgid "Let's get to planting, then!"
msgstr "Ну, пора размечать землю!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.BURNING"
msgid "Not the crops!"
msgstr "Только не посевы!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL"
msgid "Time to harvest!"
msgstr "Собираем урожай!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Woo-wee, that's a big one!"
msgstr "Охо-хо, вот это экземплярчик!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Looks like I'd better get to weeding."
msgstr "Видать, грядки пора прополоть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Растение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GROWING"
msgid "Seems to be coming along."
msgstr "Кажется, у него все хорошо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Should've picked it sooner."
msgstr "Надо было раньше сорвать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Such a waste."
msgstr "Какая потеря."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.SEED"
msgid "It has a lot of work ahead of it."
msgstr "У него впереди еще много работы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW"
msgid "Now that's handy!"
msgstr "Как удобно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW_ITEM"
msgid "This gizmo will get us gardening in no time flat!"
msgstr "С такой вещицей у нас тут через пару минут будет райский сад!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Let's clear out that clutter."
msgstr "Давайте-ка мусор уберем."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERFAN"
msgid "Too fancy."
msgstr "Слишком модно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERHAT"
msgid "Well la-dee-da."
msgstr "О-ля-ля!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERPENCIL"
msgid "I've got ugly handwriting."
msgstr "У меня страшный почерк."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CANARY"
msgid "That's not a good sign."
msgstr "Это не очень хороший знак."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CROW"
msgid "Not a whole lotta use for that."
msgstr "Не слишком много его применений я знаю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN"
msgid "Kinda useless. Looks nice, anyway."
msgstr "Бесполезная вещь. Ну, хотя бы смотрится мило."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "If only I had a cap to put it in."
msgstr "Жаль, что у меня нет подходящей под него шляпы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEM_PUPPET"
msgid "She doesn't look none too happy."
msgstr "А она не выглядит такой уж счастливой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE"
msgid "A clearly handmade fence."
msgstr "Забор, полностью выполненный руками."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_GATE"
msgid "A clearly handmade gate."
msgstr "Ворота, полностью выполненные руками."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_GATE_ITEM"
msgid "Just gotta assemble it now."
msgstr "А теперь мне это надо собрать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_ITEM"
msgid "Just needs to be assembled."
msgstr "Всего-то нужно собрать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_JUNK"
msgid "It does the trick."
msgstr "Годится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FENCE_ROTATOR"
msgid "There's a right tool for every job."
msgstr "Для каждой работы найдется свой инструмент."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FERTILIZER"
msgid "Plants can't get enough."
msgstr "Растениям этого недостаточно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FESTIVEFISH"
msgid "Sure, why not."
msgstr "Ну, почему бы и нет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Sure is a cheery looking design!"
msgstr "Вот это я понимаю — веселенький костюмчик!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIG"
msgid "Never tried one back home, seemed too fancy-shmancy for me."
msgstr "Дома я их никогда не ела. Что за фигли-мигли вообще такие?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIGATONI"
msgid "Gotta say, that's good eatin'!"
msgstr "Должна сказать, на вкус добротно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIGKABAB"
msgid "Just the kind of thing you'd want on your lunch break."
msgstr "Вот чего-то такого обычно и хочется в обед уговорить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIG_COOKED"
msgid "A bit hoity-toity, but I've gotta admit it's pretty tasty."
msgstr "Вычурно, как я не знаю, но вкусно, надо признать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREBALLSTAFF"
msgid "Doesn't look too hard to operate."
msgstr "Похоже, орудовать этой штукой не так и сложно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRECRACKERS"
msgid "Lucky firecrackers!"
msgstr "Ух какие петарды!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREFLIES.GENERIC"
msgid "Natural light, huh? Might be useful."
msgstr "Естественный свет, а? Может пригодиться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREFLIES.HELD"
msgid "I could think of a couple uses for these babies."
msgstr "У меня есть пара идей для применения этих крошек."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREHOUND"
msgid "Get outta here, bucko!"
msgstr "Вали отсюда, болван!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRENETTLES"
msgid "Definitely a workplace hazard."
msgstr "Опасность на рабочем месте."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPEN"
msgid "Yeesh, that pen's piping hot!"
msgstr "Ай, горячо держать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.EMBERS"
msgid "On its last legs."
msgstr "На ладан дышит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.GENERIC"
msgid "It's the pits out here."
msgstr "В ямке ему безопасней."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.HIGH"
msgid "Properly roaring."
msgstr "Неистовый рев."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.LOW"
msgid "It's gonna go out soon."
msgstr "Скоро совсем потухнет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.NORMAL"
msgid "About as cozy as it gets out here."
msgstr "Достаточно уютно, насколько это может сейчас быть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIREPIT.OUT"
msgid "My sister was afraid of the dark."
msgstr "Моя сестра боялась темноты."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESTAFF"
msgid "This \"magic\" stuff's a safety hazard."
msgstr "Эта «магия» огнеопасна."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Needs a top up."
msgstr "Здесь бы немного подтопить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "We should mass produce these things."
msgstr "Надо запустить эти штуковины в массовое производство."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Witness the efficiency of the future!"
msgstr "Узри же эффективность будущего!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH"
msgid "I'd rather eat for a day than not at all."
msgstr "Лучше хотя бы раз в день поесть, чем совсем не есть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHINGNET"
msgid "Seems a bit unfair to the fish."
msgstr "Как-то несправедливо по отношению к рыбе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHINGROD"
msgid "Not a bad way to unwind."
msgstr "Не самый плохой способ размотки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT"
msgid "Is it safe to eat like that?"
msgstr "А это точно безопасно есть прямо так?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_COOKED"
msgid "Nothing fancy, just how I like it."
msgstr "Без всяких выкрутасов, все как я люблю."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_SMALL"
msgid "You sure that's fish? Looks pretty shrimpy to me."
msgstr "Это точно рыба? Больше похоже на креветку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "I won't turn down a bite!"
msgstr "Никогда не откажусь от перекуса!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHSTICKS"
msgid "I've never seen a fish this shape before."
msgstr "Никогда раньше не видела рыбы подобной формы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISHTACOS"
msgid "That's some good eating."
msgstr "А вот это — очень вкусная закуска."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH_BOX"
msgid "Now there's a nice practical way to store fish!"
msgstr "Отличный практичный способ сохранить улов!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FISH_COOKED"
msgid "I hate picking bones outta my teeth."
msgstr "Ненавижу выковыривать из зубов рыбные косточки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLINT"
msgid "So archaic..."
msgstr "Так старо…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOTATIONCUSHION"
msgid "Sure beats drownin'."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER.GENERIC"
msgid "A bit cutesy."
msgstr "Немного вычурно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER.ROSE"
msgid "Not sure how to feel about that..."
msgstr "Даже не знаю, нравится ли мне это…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWERHAT"
msgid "For getting dolled up."
msgstr "Разоденусь такая на свиданку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWERSALAD"
msgid "I guess a bunch of petals count as food."
msgstr "Наверное, этот пучок листьев можно посчитать за еду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_CAVE"
msgid "Woah! It doesn't even need electricity!"
msgstr "Ого! Даже электричество не нужно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_EVIL"
msgid "I think I'll steer clear of that."
msgstr "Надеюсь, он будет меня хорошо слушаться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FLOWER_WITHERED"
msgid "That's how I feel after a long shift."
msgstr "Я себя так же чувствую после долгой смены."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOLIAGE"
msgid "Just a bunch of leaves."
msgstr "Просто горстка листьев."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOOTBALLHAT"
msgid "Gotta protect the assets."
msgstr "Надо беречь ресурсы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FORGETMELOTS"
msgid "I'm not one for flowers, especially when they crowd out my hard working crops!"
msgstr "Я не любительница цветочков, особенно когда они мои честные рабочие посевы вытесняют!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FORMAL_BLUEPRINT"
msgid "That's a pretty fancy thing to put on a big shaggy beast."
msgstr "Такую модную штуку — и на эту образину лохматую напяливать?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_PIECE"
msgid "No bones about it, that's a fossil. Ha!"
msgstr "Простое ископаемое, и тут не подкопаешься. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "What is this a skeleton of?!"
msgstr "Из чего этот скелет?!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That was not assembled correctly."
msgstr "Его не совсем верно собрали."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Some more assembly required."
msgstr "Нужно еще немного подсобрать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRESHFRUITCREPES"
msgid "Fruit wrapped in a blanket of pancake."
msgstr "Фрукты, завернутые в блинчик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Now this one's a good little worker!"
msgstr "Ну какая молодец! Давай, не сбавлять темп!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Она крякнула."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.GENERIC"
msgid "Yep! That's a frog."
msgstr "Ага! Это лягуха."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROG.SLEEPING"
msgid "Shouldn't you be off hopping or something?"
msgstr "А ты не должна скакать там, или что ты делаешь обычно?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGFISHBOWL"
msgid "Mmm! Love Warly's dishes."
msgstr "М-м-м! Обожаю, когда Варли готовит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGGLEBUNWICH"
msgid "It's really not as bad as it looks."
msgstr "Все не так плохо, как кажется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS"
msgid "Not glamorous, but I'll eat it."
msgstr "Не дефлопе, конечно, но я съем это."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGLEGS_COOKED"
msgid "Them's good eats."
msgstr "А вот теперь съедобно смотрится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROGNEWTON"
msgid "Surprisingly tasty."
msgstr "На удивление вкусно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Perfect after a long day of work."
msgstr "Идеальный финал тяжелого рабочего дня."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "You play nice with the other lizards now, hey?"
msgstr "Ты только других ящерок не обижай, ладно?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.RIPE"
msgid "Lookit you, all orange!"
msgstr "Ты только посмотри, какая оранжевая!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "I hope you earned that break."
msgstr "Думаю, ты заслужила перерыв."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITFLY"
msgid "Get outta here! Shoo!"
msgstr "А ну прочь отсюда! Брысь!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITFLYFRUIT"
msgid "Now I'm the boss!"
msgstr "Теперь я тут главная!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRUITMEDLEY"
msgid "Gotta get those vitamins, I guess."
msgstr "Наверное, даже витамины тут есть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FURTUFT"
msgid "Wouldn't mind lining my workboots with this stuff."
msgstr "Я бы даже рабочую обувь себе таким обработала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FUSED_SHADELING"
msgid "I don't like the look of those chompers."
msgstr "Не нравятся мне эти кусалки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "Watch out, it's gonna blow!"
msgstr "Берегись: сейчас рванет!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARGOYLE_HOUND"
msgid "Something scare ya? You look petrified!"
msgstr "Тебя что-то пугает? Будто окаменел!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARGOYLE_WEREPIG"
msgid "At least it's not trying to kill us now."
msgstr "По крайней мере, он больше не хочет нас убить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC"
msgid "Makes everything taste better."
msgstr "С ним все вкуснее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_COOKED"
msgid "Bet that brought out the flavor."
msgstr "Думаю, теперь его запах ушел."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_OVERSIZED"
msgid "I'm not scared of a bit of garlic breath."
msgstr "Ну попахивать будет немного изо рта, делов-то."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GARLIC_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Понятия не имею, что из этого вырастет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GAZPACHO"
msgid "I'd never turn down grub!"
msgstr "Поесть всегда время найдется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GEARS"
msgid "I'm a bit homesick."
msgstr "Немного по дому соскучилась."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.GENERIC"
msgid "That ain't no engine grease I ever seen."
msgstr "Это какая-то новая машинная смазка?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "Someone's in tough spot."
msgstr "Кто-то влип."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Looks like somethin's caught inside."
msgstr "Там вроде что-то внутри."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_BOTTLE"
msgid "We can take it to go!"
msgstr "Удобно с собой носить!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "And just like that, I ain't hungry no more."
msgstr "Как посмотрю — уже и не голодная."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "At least we found some use for that muck."
msgstr "Хоть где-то этот шлак сгодился."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Guess I should put'er together."
msgstr "Тут нужна сборка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GEMSOCKET.GEMS"
msgid "Still gotta tinker with it a bit."
msgstr "Надо бы еще немного подколотить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GEMSOCKET.VALID"
msgid "Ready for a test run!"
msgstr "Готов к тестовому пробегу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT"
msgid "I feel like... they've seen my sister."
msgstr "Кажется… Они знают мою сестру."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "We got a live one!"
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "Ain't nothin' in there."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD"
msgid "Don't think I like the looks of that."
msgstr "Не нравится мне, как эта штука выглядит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "I know, I know. Y'all got a bone to pick."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOST"
msgid "I don't want nothing to do with that."
msgstr "Я не хочу с этим иметь никаких дел."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTFLOWER"
msgid "Don't know if I want that in my garden."
msgstr "Не уверена, что хотела бы видеть это у себя в саду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTFLOWERHAT"
msgid "Ghost flowers? Pretty."
msgstr "Призрачные цветы? Миленько."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "I don't think that's safe to drink..."
msgstr "По-моему, это пить небезопасно…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GIFT"
msgid "My presence is a gift. Ha."
msgstr "Лучший мой подарочек — это я. Ха."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GIFTWRAP"
msgid "I could wrap stuff up real nice."
msgstr "Я могу завернуть что-нибудь действительно красивое."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADHOUSE"
msgid "Better as a dessert than a dwelling."
msgstr "Такой куда приятнее есть, чем в нем жить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADPIG"
msgid "Hey cookie, what's the rush?"
msgstr "Эй, сладкий, куда спешишь?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GINGERBREADWARG"
msgid "This guy's just making me hungry."
msgstr "Так и хочется его куснуть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSBLOCK"
msgid "It's a big hunk of glass."
msgstr "Просто огромный кусок травы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSCUTTER"
msgid "Ha ha! Just try and fight me!"
msgstr "Ха-ха! Давайте, кто первый на меня?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLASSSPIKE"
msgid "That's a hazardous decoration."
msgstr "Очень травмоопасное украшение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMER.GENERIC"
msgid "Check out the peepers on this guy."
msgstr "Надо держать ухо востро с этим парнем."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMER.SLEEPING"
msgid "He deserves the break."
msgstr "Он заслужил отдых."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Did we not water it enough?"
msgstr "Мы его что, мало поливали?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "That's one big flower."
msgstr "Достаточно большой цветок."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERFUEL"
msgid "Doesn't look useful."
msgstr "Не выглядит особо полезным."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOMMERWINGS"
msgid "You can see right through'em."
msgstr "Можно же все насквозь в них видеть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GLOWBERRYMOUSSE"
msgid "You really outdid yourself with this one, buddy."
msgstr "Ты просто превзошел сам себя, дружище."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "Them's the breaks."
msgstr "Все в мире ломается."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "You should really get that horn looked at."
msgstr "Тебе стоит проверить рог у специалиста."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "Glad to see ya pullin' your weight around here!"
msgstr "Приятно видеть, когда кто-то добросовестно выполняет свои обязанности!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL.GENERIC"
msgid "Yeesh, uh... nice whale?"
msgstr "Э-э-э… Хороший кит?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GNARWAIL_HORN"
msgid "I'm sure I can use this for somethin."
msgstr "Ему наверняка можно найти применение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOATMILK"
msgid "I'm a growing gal, you know!"
msgstr "Мне есть еще где расти, ну вы поняли."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOGGLESHAT"
msgid "I hate fashion."
msgstr "Ненавижу моду."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENAXE"
msgid "A shiny way to cut stuff down."
msgstr "Блестящий способ разрушения."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENPICKAXE"
msgid "A shiny way to smash up rocks."
msgstr "Блестящий способ раскола камней."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENPITCHFORK"
msgid "I mean why not, hey?"
msgstr "Нет, ну а почему бы и нет, ну?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDENSHOVEL"
msgid "A little too snazzy for my taste."
msgstr "Как-то уж слишком шикарно, как мне кажется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDEN_FARM_HOE"
msgid "Awfully ritzy for yard work."
msgstr "Уж очень дорого-богато для работы на ферме."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOLDNUGGET"
msgid "Gold! What a prospect."
msgstr "Золото! Вот так свезло."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GOOSE_FEATHER"
msgid "I could think of one or two uses for that, tops."
msgstr "Надо придумать парочку применений."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BARREN"
msgid "Needs a little boost."
msgstr "Его бы маленько ускорить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.BURNING"
msgid "Grass fire!"
msgstr "Трава в огне!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASED"
msgid "You should see a doctor."
msgstr "Тебе стоит показаться врачу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.DISEASING"
msgid "Not lookin' too lush."
msgstr "Не очень сочно выглядит."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.GENERIC"
msgid "That's some tall grass."
msgstr "Немного высокой травы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.PICKED"
msgid "It's on break."
msgstr "Перекур."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS.WITHERED"
msgid "It couldn't stand the heat."
msgstr "Она не переживет жару."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGATOR"
msgid "How can he see anything like that?"
msgstr "Как он вообще что-то видит?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "I didn't know lizards could wilt."
msgstr "Не думала, что ящерицы могут еще и позеленеть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Is that lizard made of grass?"
msgstr "Это что, травяная ящерица из травы?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRASS_UMBRELLA"
msgid "Better than nothing."
msgstr "Лучше, чем ничего."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVEURN.GENERIC"
msgid "Nobody's in there."
msgstr "Внутри никого нет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "It's occupied."
msgstr "Занято."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GRAVY"
msgid "Now we're talking!"
msgstr "Совсем другой разговор!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENAMULET"
msgid "We could be good friends, you and I."
msgstr "Мы можем стать хорошим друзьями, ты и я."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENGEM"
msgid "Now that's a proper gem."
msgstr "Вот это я понимаю — самоцвет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENMOONEYE"
msgid "You coulda been a useful necklace."
msgstr "Из тебя получится неплохая подвеска."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREENSTAFF"
msgid "It's a hard work destroyer."
msgstr "Это неплохой инструмент для разрушения."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP"
msgid "Yep. Green mushroom."
msgstr "Ну да, это зеленый гриб."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_CAP_COOKED"
msgid "Doesn't look TOO deadly."
msgstr "Не ТАК уж и смертельно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It's some sorta green mushroom."
msgstr "Ну это что-то типа зеленого гриба."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "Ленивый гриб."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "It's a mushroom hole."
msgstr "Это грибная яма."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_BIG"
msgid "Fancy a swim? Ha! Didn't think so."
msgstr "Освежиться никто не желает? Ха! Так и думала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GROTTO_POOL_SMALL"
msgid "Fancy a swim? Ha! Didn't think so."
msgstr "Освежиться никто не желает? Ха! Так и думала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUACAMOLE"
msgid "This green mush ain't bad!"
msgstr "А эта зеленая каша не так уж и плоха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUANO"
msgid "What? We all do it."
msgstr "Что? Все это делают."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.GUNPOWDER"
msgid "For when you need a big KABOOM!"
msgstr "Когда тебе понадобится большой БАРАБУМ!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_1"
msgid "A nice change from baked apples."
msgstr "Неплохая замена печеным яблокам."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_10"
msgid "Curious flavor."
msgstr "Интересный вкус."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_11"
msgid "Best eaten by the handful."
msgstr "Лучше сразу горстями есть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_12"
msgid "Ha, yuck! Everyone watch me eat'em!"
msgstr "Ну фу же! Все смотрят, как я это ем!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_13"
msgid "I ain't patient enough to eat these."
msgstr "Не терпится уже это попробовать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_14"
msgid "Whew! That's the kick y'need!"
msgstr "Фух! Вот это встряска!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_2"
msgid "Is this even food?"
msgstr "А это точно еда?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_3"
msgid "That's no treat."
msgstr "Это не сладость."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_4"
msgid "That gummy has too many legs for my taste."
msgstr "Как по мне — слишком много ног у этой тянучки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_5"
msgid "Not made of catcoons, thankfully."
msgstr "Спасибо, что не из енотокотов."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_6"
msgid "Not sure anyone should eat those."
msgstr "Не уверена, что кто-либо вообще должен это есть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_7"
msgid "That's just regular food."
msgstr "Это обычная еда."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_8"
msgid "How spooky."
msgstr "Как жутко."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENCANDY_9"
msgid "Real gelatinous."
msgstr "Прям желатинчик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Makes ya plucky."
msgstr "Придает смелости."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "I got lucky and got the big bottle."
msgstr "Мне повезло: досталась большая бутылка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "Aw, I was hoping for a little more."
msgstr "Ну вот, хотелось чего-то большего."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Ohh. This'll make a spark."
msgstr "О… Искра будет что надо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "I'm more of a coffee drinker, myself."
msgstr "Я предпочитаю кофе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Ha! Ya almost fooled me."
msgstr "Ха! Почти поверила!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "I should hang this somewhere."
msgstr "Надо это куда-нибудь повесить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "Time to decorate."
msgstr "Пора вешать украшения."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "Time for decoratin'!"
msgstr "Время украшений!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Hey, it's them hanging guys."
msgstr "Эй, смотрите, висит!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "It needs to be in a tree."
msgstr "Это должно быть на дереве."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMBAT"
msgid "Good fer a smackin'."
msgstr "Подходит для того, чтоб размазать пару голов."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER"
msgid "And I know how to use it!"
msgstr "И я знаю, как этим пользоваться!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAMMER_MJOLNIR"
msgid "I'm most effective with a tool in hand."
msgstr "Больше всего пользы я приношу, когда у меня в руках мой инструмент."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "It's cushy enough for me."
msgstr "Сгодится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_KELP"
msgid "It wouldn't be my first choice of pillow stuffing."
msgstr "Будь у меня выбор, я бы не стала делать из этого подушку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_PETALS"
msgid "Way too flimsy, there's no support at all!"
msgstr "Какой от нее толк, если она слишком хлипкая?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "Aww, it kinda makes me nostalgic for the old steel mill."
msgstr "Она мне напоминает про старые добрые рабочие деньки на металлургическом заводе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAREBALL"
msgid "Yuck!"
msgstr "Тьфу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HAWAIIANSHIRT"
msgid "That's one loud shirt."
msgstr "Какая броская рубаха."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE"
msgid "Soothes minor cuts and scrapes."
msgstr "Залечивает мелкие царапины и порезы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSALVE_ACID"
msgid "I guess you'd call it an antacid."
msgstr "По-моему, это называется «антацид»."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEALINGSTAFF"
msgid "I'm a bit of a Jane-of-all-trades."
msgstr "Я вроде как мастерица на все руки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.COLD"
msgid "It's a little chilly."
msgstr "Немножко прохладно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.FROZEN"
msgid "Brr! Like a chunk of ice."
msgstr "Бр-р! Будто простой кусок льда."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.GENERIC"
msgid "This is a good rock. A special rock."
msgstr "Какой хороший камень. Особый камень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.HOT"
msgid "Almost TOO hot."
msgstr "Почти что СЛИШКОМ горячо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEATROCK.WARM"
msgid "Tepid."
msgstr "Тепловатый."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEDGEHOUND"
msgid "You're gettin' to be a real thorn in my side!"
msgstr "А ты, оказывается, та еще заноза в боку!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HEDGEHOUND_BUSH"
msgid "Why am I gettin' a bad feeling..."
msgstr "И почему у меня плохое предчувствие?.."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITCRAB"
msgid "Nothin' wrong with being independent."
msgstr "В независимости нет ничего плохого."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "A whole movin' truck in a pitcher."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "Just needed a bit of elbow grease."
msgstr "Всего-то и нужно было, что немного поработать руками."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "That can't be up to code."
msgstr "Строительные нормы явно не соблюдены."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE"
msgid "Aw, she didn't have to give me anything..."
msgstr "Ой, ну не стоило..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "Not sure what came over me to buy these knicknacks."
msgstr "Не знаю, что на меня нашло, когда я это покупала."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "I'm so sorry, Pearl."
msgstr "Прости меня, Жемчужинка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_PEARL"
msgid "I know a bit about not givin' up on someone."
msgstr "Уж я-то точно не умею забывать близких."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT"
msgid "Snoot city."
msgstr "Мордо-город."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME"
msgid "They say you can't go home again."
msgstr "Говорят, домой больше не вернуться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT"
msgid "Burnt to cinders."
msgstr "Сожжено до пепла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC"
msgid "I'll take this as a sign."
msgstr "Приму это за знак свыше."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "Все еще жду каких-нибудь каракулин."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEY"
msgid "The sweet results of honest work."
msgstr "Приятный финал честного труда."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYCOMB"
msgid "Let's build a bee house."
msgstr "Давай строить дом для пчел."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYHAM"
msgid "Think I could fit that whole thing in my mouth?"
msgstr "Думаешь, у меня во рту сможет поместиться все целиком?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HONEYNUGGETS"
msgid "Not bad!"
msgstr "Неплохо!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HORN"
msgid "Watch out for the business end!"
msgstr "Берегись краха бизнеса!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HORRORFUEL"
msgid "Makes the usual nightmare goop look almost pleasant by comparison."
msgstr "В сравнении с этим обычное топливо кошмара выглядит даже приятно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTCHILI"
msgid "I'm tough enough to handle a little spice."
msgstr "Я довольно крепкая, чтобы справиться с остротой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.BOMBED"
msgid "I'm not really a bubble bath kinda gal."
msgstr "Не люблю я эти все пузырьки."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.EMPTY"
msgid "Dry as a bone."
msgstr "Ни капли воды нет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.GENERIC"
msgid "It's a nice, warm spring."
msgstr "Хороший источник, вода теплая."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOTSPRING.GLASS"
msgid "Woah, the top glassed over solid."
msgstr "Ого! Он покрыт твердой корочкой."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUND"
msgid "Anyone got some rolled up newspaper?"
msgstr "У кого-нибудь есть скрученная газета?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDBONE"
msgid "It's covered in tooth marks."
msgstr "Она вся в следах от зубов."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Better safe than sorry."
msgstr "Береженого бог бережет."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "Kinda feel bad for the little fella."
msgstr "Немного даже жаль зверюшку."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "Yikes! Someone burn that thing, quick!"
msgstr "Жуть! Сожгите кто-нибудь эту тварь срочно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDMOUND"
msgid "So that's where they're comin' from."
msgstr "Так вот откуда они все."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH"
msgid "Sure hope no one comes back for it."
msgstr "Надеюсь, за ними никто не вернется."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "Shoots dog teeth? What will they think of next?"
msgstr "Стрелять собачьими зубами? До чего еще они додумаются?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOUNDWHISTLE"
msgid "This oughta give them paws pause."
msgstr "Пусть отдохнут чуток. У них же лапки!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT"
msgid "This was a terrible idea."
msgstr "Это было ужасной идеей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_COOKED"
msgid "Who thought this was a good idea?"
msgstr "Кто сказал, что это была прекрасная мысль?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUMANMEAT_DRIED"
msgid "Nope."
msgstr "Не-а."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH"
msgid "You wanna be my toolbox, lil guy?"
msgstr "Ты хочешь быть моим сундучком с инструментами, малыш?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "Who left you out here all alone, hey?"
msgstr "Эй, кто тебя тут бросил одного?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Yeesh. Fishfry."
msgstr "Фуэ. Жареная рыба."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE"
msgid "Chilly."
msgstr "Холодный."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG.GENERIC"
msgid "Better steer clear'a that."
msgstr "Лучше держаться от него подальше."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG.MELTED"
msgid "It's just a lil ice cube now."
msgstr "От него остался только маленький кубик льда."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBERG_MELTED"
msgid "It's just a lil ice cube now."
msgstr "От него остался только маленький кубик льда."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEBOX"
msgid "It's not factory standard."
msgstr "Это не заводской стандарт."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICECREAM"
msgid "Y'gotta eat it before it melts."
msgstr "Нужно съесть, пока он не растаял."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHAT"
msgid "There must be a more practical solution."
msgstr "Здесь должно быть более практичное решение."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEHOUND"
msgid "Keep those fangs to yourself."
msgstr "Оставь свои клыки при себе."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICEPACK"
msgid "Keeps drinks cool until breaktime."
msgstr "Сохраняет напитки прохладными до перерыва."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICESTAFF"
msgid "This doesn't seem safe."
msgstr "Не слишком безопасно смотрится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ICE_BLUEPRINT"
msgid "Winter gear, huh? Seems practical."
msgstr "Зимнее обмундирование, да? На вид практично."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "I can't begin to imagine how it works."
msgstr "Даже представить не могу, как он работает."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "What on earth is that thing?"
msgstr "Да что же это, в конце концов, такое?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESBOX"
msgid "Sure hope the bossman doesn't mind me borrowing a few things."
msgstr "Надеюсь, начальник не будет против, если я кое-что одолжу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESBOX2"
msgid "Jackpot!"
msgstr "Вот так куш!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "Now I can track down the bossman's loot!"
msgstr "Сейчас посмотрим, что там припас начальник!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "I'd love to know the specs for those specs! Ha!"
msgstr "Ха! Хоть одним глазком посмотрю!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.INSPECTSELF"
msgid "Who's that good-looking gal!"
msgstr "Что же это за миловидная девица!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.IPECACSYRUP"
msgid "That stuff can't be good for your health."
msgstr "Не похоже, что эта штука полезна для здоровья."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.IVY_SNARE"
msgid "Now I've got to clean all this up!"
msgstr "Теперь придется все это убирать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JAMMYPRESERVES"
msgid "The sweet taste of good planning."
msgstr "Сладкий вкус планирования."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JELLYBEAN"
msgid "I would eat them all in one sitting."
msgstr "Я могу их слопать в один присест."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JUNK_PILE"
msgid "Folks underestimate how much good stuff you can find in a scrap pile."
msgstr "Люди знать не знают, сколько добра можно вытащить из кучи металлолома."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JUNK_PILE_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JUNK_PILE_BIG"
msgid "Who's in charge here? Someone could get hurt!"
msgstr "Кто тут главный? Это же травмоопасно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.JUSTEGGS"
msgid "Nice and simple."
msgstr "Просто и вкусно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KABOBS"
msgid "Now that's my kind of cooking."
msgstr "А вот это мне по вкусу."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP"
msgid "I'll try anything once."
msgstr "В жизни нужно попробовать все. Пусть даже и один раз."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KELPHAT"
msgid "I'll stick with my bandana, thanks."
msgstr "Мне и банданы хватит, спасибо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP_COOKED"
msgid "Well, that's not how I would have prepared it."
msgstr "Ну, лично я не стала бы их готовить именно так."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KELP_DRIED"
msgid "I kinda like the stuff!"
msgstr "А мне даже нравится!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.GENERIC"
msgid "Stay back, bug!"
msgstr "Не подползай, жучара!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KILLERBEE.HELD"
msgid "You can just calm right down."
msgstr "Просто успокойся прямо сейчас."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "They won't be playing with that anytime soon."
msgstr "В ближайшее время им тут явно не поиграть."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "Not the most productive use of their time... but it sure is cute."
msgstr "Не самая продуктивная трата времени... Но это очень мило."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR1_KIT"
msgid "I've always been a do-it-yourself kinda gal."
msgstr "Я всегда старалась все делать своими руками."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "They really shouldn't make these things so flammable."
msgstr "Им бы получше поработать над пожарной безопасностью."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "The kits sure seem to like it."
msgstr "Похоже, котятам нравится."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDECOR2_KIT"
msgid "All it needs now is a bit of elbow grease."
msgstr "Немного работы — и оп!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.BURNT"
msgid "Well, hope they can stay with a friend or something."
msgstr "Что ж, надеюсь, им есть где остановиться."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.GENERIC"
msgid "Lofty housing for tiny kits."
msgstr "Большой дом для маленьких котят."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "They're out and about."
msgstr "Разбежались во все стороны."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid ""
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN_KIT"
msgid "We'll make a nice home for the kitcoons."
msgstr "Построим для енотокотят уютный дом."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_DECIDUOUS"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_DESERT"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_FOREST"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_GRASS"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_MARSH"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_MOON"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_NAMETAG"
msgid "Name tags can be pretty handy in the workplace."
msgstr "В большом коллективе без карточек с именами не обойтись."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_ROCKY"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_SAVANNA"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_YOT"
msgid "A clever little thing."
msgstr "Какой умненький малыш."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS"
msgid "Get out of here ya big creep."
msgstr "Вали отсюда, громадина громадная."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUSSACKKEY"
msgid "This must be the actual key."
msgstr "Должно быть, это тот самый ключ."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KLAUS_SACK"
msgid "There's gotta be something good in there."
msgstr "Там должно быть что-то очень хорошее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT"
msgid "Incredible! Let me look at those gears!"
msgstr "Невероятно! Дай мне взглянуть на эти инструменты!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "You're in rough shape, hey?"
msgstr "Эй, ты чего такой шероховатый?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_CARCASS"
msgid "Poor thing's dead as a doornail."
msgstr "Бедолага, откинул лапы."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_SUMMER"
msgid "Hey! You look tasty!"
msgstr "Эй! Выглядишь аппетитно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFANT_WINTER"
msgid "Hey! You look tasty!"
msgstr "Эй! Выглядишь аппетитно!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KOALEFIG_TRUNK"
msgid "Looks like some really snooty food. Ha!"
msgstr "Такое блюдо и языку, и носу приятно. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KRAMPUS"
msgid "Some sort of... festive devil?"
msgstr "Что-то типа… праздничного демона?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KRAMPUS_SACK"
msgid "I could carry a whole warehouse in that thing!"
msgstr "Я смогу тут целый склад таскать!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LANTERN"
msgid "Who'd want a non-electric lamp?"
msgstr "Кому тут надо неэлектрическую лампу?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LATKES"
msgid "I love me some potatoes!"
msgstr "Картошка — дело хорошее!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I could really take a hit in that thing!"
msgstr "В этой штуке я смогу выдержать любой удар!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "This is more my style!"
msgstr "Это вполне в моем стиле!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "It's paper thin!"
msgstr "Тонюсенький, как бумага!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "I'd rather something a bit heftier."
msgstr "Мне бы что-нибудь помассивнее…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "It'll do in a pinch."
msgstr "В трудную минуту пригодится!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "That should do the trick."
msgstr "Это должно сработать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "That armor puts ya at peak efficiency!"
msgstr "В такой броне любой сможет биться на пределе возможностей!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Can't go wrong with armor."
msgstr "Что может пойти не так в доспехах?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Hey! We gotta destroy that Battle Standard!"
msgstr "Эй! Мы должны уничтожить это боевое знамя!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BERNIE"
msgid "You here to help, lil fella?"
msgstr "Ты хочешь помочь нам, дружок?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Why don't you fight us yourself!"
msgstr "Почему бы тебе не сразиться с нами самому?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "You'd be a real heavy hitter with that."
msgstr "С этой штукой ты сможешь бить, как большой!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Hey lil fella."
msgstr "Эй, малой!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Just some high class trinket."
msgstr "Всего-навсего безделушка высочайшего класса."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Faster than tiny hands on an assembly line."
msgstr "Быстрее, чем крошечные ручки работников конвейера!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Here's fire in yer eye!"
msgstr "Огоньком — да прямо в глаз!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "That hat'll help you feel right as rain."
msgstr "Это тебе поможет. Будешь, как огурчик!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "That's fer a bit of self maintenance."
msgstr "Вот — помоги себе сам!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "That'll do the trick."
msgstr "Должно сработать."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "Can't go home without the key."
msgstr "Идти домой без ключа нам смысла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "Perfect assembly!"
msgstr "Идеальная сборка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Gives ya a lil extra punch!"
msgstr "С этим ты сможешь ударить лишний разок-другой!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_LUCY"
msgid "I could take a swing at it. Ha!"
msgstr "Я не прочь помахать этой штукой! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Just like the one I came through..."
msgstr "Совсем как тот путь, которым мы пришли…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Welp, time to go!"
msgstr "Эх, пора идти."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "I'd be so efficient with that!"
msgstr "С этой штукой я буду жечь напалмом!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Wonder how it works?"
msgstr "Интересно, как это работает?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "I'm gonna be a real slugger with that thing!"
msgstr "Ух, какое мочилово я устрою!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "That'd be fer healin' my pals."
msgstr "Это поможет мне исцелять друзей."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE"
msgid "I'm gonna squish that!"
msgstr "Я ее размажу!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_COCOON"
msgid "We could probably wake it back up."
msgstr "Надо бы разбудить ее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "Maybe we shouldn't hatch this."
msgstr "Может, не надо его высиживать?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "Looks chilly."
msgstr "Кажется, ему холодно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It's feeling right as rain."
msgstr "Чувствует себя, как дома."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.CONTENT"
msgid "You're a happy little fellow."
msgstr "Бодренько выглядишь, дружок."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.GENERIC"
msgid "Seems friendly enough."
msgstr "Вроде выглядит дружелюбно."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Let's fatten you up."
msgstr "Сейчас тебе дадим набить брюхо."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_PET.STARVING"
msgid "You need some meat on those bones. Do you have bones?"
msgstr "Тебе бы мяса на кости нарастить. У тебя же есть кости?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVAE_TOOTH"
msgid "Aw. That's a baby tooth."
msgstr "О-о-о, детский зубик."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.COOL"
msgid "Just a rock, now."
msgstr "Теперь это просто камень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVASPIT.HOT"
msgid "Woah! Hot potato!"
msgstr "Ого! Горячая картошка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND"
msgid "Lava!"
msgstr "Лава!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LAVA_POND_ROCK"
msgid "That... is a rock."
msgstr "Это… это камень."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFLOAF"
msgid "It's hard to pin down the flavor..."
msgstr "Никак не могу уловить запах..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATBURGER"
msgid "It's not like any burger I've ever tried."
msgstr "Не похоже на обычный бургер."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "Well... I guess it's creative."
msgstr "Ну... плюсик за творческий подход."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF"
msgid "The trees have eyes!!"
msgstr "Тут глаза на деревьях!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_IDOL"
msgid "That's some quality carving, there."
msgstr "Качественная работа по дереву."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LEIF_SPARSE"
msgid "Back off, you lumbering lumber!"
msgstr "Ну-ка проваливай, ты, деревянная деревяха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LICHEN"
msgid "Not to my lichen. Ha!"
msgstr "Хорошо хоть не лишай. Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIFEINJECTOR"
msgid "I've never taken a sick day in my life."
msgstr "Никогда в жизни не брала больничный."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTBULB"
msgid "Not at all like the lightbulbs I'm used to."
msgstr "Не совсем как те лампочки, к которым я привыкла."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTCRAB"
msgid "I guess crabs can glow now, huh?"
msgstr "Теперь у нас и крабы светятся, да?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTER"
msgid "Neat little gizmo there."
msgstr "Изящная маленькая штучка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTFLIER"
msgid "Doesn't even need a battery!"
msgstr "И даже батарейка не нужна!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "Electrifying! Ha!"
msgstr "Элетризуется! Ха!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "You and I are gonna get along."
msgstr "Мы с тобой скоро подружимся."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's even more interesting up close."
msgstr "Вблизи смотрится еще интереснее."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "All charged up and nowhere to go."
msgstr "Заряжен и ждет своего часа."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "That's one way to get electricity."
msgstr "Вот как можно получить электричество."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LITTLE_WALRUS"
msgid "Nice kilt."
msgstr "Милый килт."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGLOG"
msgid "Stop looking at me like that."
msgstr "Не пялься так на меня."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE"
msgid "Did that tree just move?"
msgstr "Это дерево только что шевельнулось?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_ROOT"
msgid "Oh hey! There's a little stick in there."
msgstr "Эй! Да тут какая-то палочка!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Keep growin' little guy! I'm gonna decorate you."
msgstr "Расти, малыш! Я украшу тебя."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERBISQUE"
msgid "Hey Warly? Can you just keep makin' this forever?"
msgstr "Слушай, Варли, а ты можешь больше ничего другого никогда не готовить?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOBSTERDINNER"
msgid "That's some pretty fancy lookin' grub!"
msgstr "Однако, вот это знатные харчи!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.BURNING"
msgid "I coulda built something with that."
msgstr "А я ведь могла бы с ним что-нибудь построить."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOG.GENERIC"
msgid "It's a hunk of wood."
msgstr "Обычная чурка."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LORDFRUITFLY"
msgid "You think you can just come in here and lord over my garden?"
msgstr "Ты кем себя возомнил? Летает тут по моему саду, повелевает..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.LOST_TOY_1"
msgid "Nope. Not touchin' that."
msgstr "Нет, не мое — вот и трогать не буду."

