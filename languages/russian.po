msgstr "Вольфганг целиком бы съел!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOM_SKIN"
msgid "Is squishy yucky frogman skin!"
msgstr "Болотистая противная жабья кожа!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.BURNT"
msgid "Napping place is gone."
msgstr "Места для сиесты нету."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Napping place."
msgstr "Место для сиесты."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SILK"
msgid "Is too fancy."
msgstr "Какая модная штука."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "Is mighty singing shell!"
msgstr "Большая поющая ракушка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
