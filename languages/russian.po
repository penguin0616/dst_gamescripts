msgid "2.5"
msgstr "2.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.4.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.4.line"
msgid "who gave the order to clear-cut an entire forest"
msgstr "Он приказал вырубить целый лес..."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.5.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.5.duration"
msgid "2.5"
msgstr "2.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.5.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.5.line"
msgid "against the wishes of the people who lived there."
msgstr "...не считаясь с мнением местных жителей."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.6.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.WEREBEAVER_STORY.lines.6.duration"
msgid "2.5"
msgstr "2.5"

