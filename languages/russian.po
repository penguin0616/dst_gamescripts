msgstr "Хлурп"

#. STRINGS.MERMNAMES.5
msgctxt "STRINGS.MERMNAMES.5"
msgid "Flupt"
msgstr "Пуфф"

#. STRINGS.MERMNAMES.6
msgctxt "STRINGS.MERMNAMES.6"
msgid "Flurgle"
msgstr "Фьють"

#. STRINGS.MERMNAMES.7
msgctxt "STRINGS.MERMNAMES.7"
msgid "Fopt"
msgstr "Плямк"

#. STRINGS.MERMNAMES.8
msgctxt "STRINGS.MERMNAMES.8"
msgid "Furp"
msgstr "Хляп"

#. STRINGS.MERMNAMES.9
msgctxt "STRINGS.MERMNAMES.9"
msgid "Furt"
msgstr "Бац"

#. STRINGS.MERM_BATTLECRY.1.1
msgctxt "STRINGS.MERM_BATTLECRY.1.1"
msgid "Glorp! Go away!"
msgstr "Бульк! Вон!"

#. STRINGS.MERM_BATTLECRY.1.2
msgctxt "STRINGS.MERM_BATTLECRY.1.2"
msgid "Glorp! Glorpy glup!"
msgstr "Бульк! Буль-бульк!"

#. STRINGS.MERM_BATTLECRY.2.1
msgctxt "STRINGS.MERM_BATTLECRY.2.1"
msgid "Destroy you!"
msgstr "Уничтожу тебя!"

#. STRINGS.MERM_BATTLECRY.2.2
msgctxt "STRINGS.MERM_BATTLECRY.2.2"
msgid "Wult glut!"
msgstr "Вьють-бульк!"

#. STRINGS.MERM_GUARD_BATTLECRY.1.1
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.1.1"
msgid "To battle!"
msgstr "В бой!"

#. STRINGS.MERM_GUARD_BATTLECRY.1.2
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.1.2"
msgid "Wult flrot!"
msgstr "Вьють-блым!"

#. STRINGS.MERM_GUARD_BATTLECRY.2.1
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.2.1"
msgid "For Mermfolk!"
msgstr "Слава тритонам!"

#. STRINGS.MERM_GUARD_BATTLECRY.2.2
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.2.2"
msgid "Flort Glurtsu flut!"
msgstr "Буль-бульк-блымк!"

#. STRINGS.MERM_GUARD_BATTLECRY.3.1
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.3.1"
msgid "ATTAAAACK!!"
msgstr "В АТАКУ!"

#. STRINGS.MERM_GUARD_BATTLECRY.3.2
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.3.2"
msgid "GLOT FLOOOORPH!!"
msgstr "БУЛЬ-ПЛЕ-Е-ЕСЬ!"

#. STRINGS.MERM_GUARD_BATTLECRY.4.1
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.4.1"
msgid "Defend King!"
msgstr "Защитить короля!"

#. STRINGS.MERM_GUARD_BATTLECRY.4.2
msgctxt "STRINGS.MERM_GUARD_BATTLECRY.4.2"
msgid "Glurph Glurtsen!"
msgstr "Буль-бу-у-у-ульк!"

#. STRINGS.MERM_KING_TALK_HUNGER_CLOSE_STARVING
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_CLOSE_STARVING"
msgid "Treachery... villainy! To let King waste away like this..."
msgstr "Предательство… Какое злодейство! Оставить короля умирать от голода…"

#. STRINGS.MERM_KING_TALK_HUNGER_FULL
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_FULL"
msgid "Have done well. Now go."
msgstr "Отличная работа. А теперь уходи."

#. STRINGS.MERM_KING_TALK_HUNGER_HUNGRISH
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_HUNGRISH"
msgid "King feeling a bit peckish..."
msgstr "Король немного проголодался…"

#. STRINGS.MERM_KING_TALK_HUNGER_HUNGRY
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_HUNGRY"
msgid "King desires food!"
msgstr "Король изволит еды!"

#. STRINGS.MERM_KING_TALK_HUNGER_STARVING
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_STARVING"
msgid "Hungry... HUNGRY! HUNGRYYYY!!!"
msgstr "Еды… ЕДЫ! ЕДЫ-Ы-Ы-Ы-Ы!"

#. STRINGS.MERM_KING_TALK_HUNGER_VERY_HUNGRY
msgctxt "STRINGS.MERM_KING_TALK_HUNGER_VERY_HUNGRY"
msgid "What take so long? Make offerings to your King!"
msgstr "Что ты возишься? Сделай же подношение своему королю!"

#. STRINGS.MERM_TALK_CLOSED.1
msgctxt "STRINGS.MERM_TALK_CLOSED.1"
msgid "Ya talk to ol'Mumsy yet?"
msgstr "А с Мамушкой уже говорили?"

#. STRINGS.MERM_TALK_CLOSED.2
msgctxt "STRINGS.MERM_TALK_CLOSED.2"
msgid "I ain't taking business right now."
msgstr "Сейчас не время говорить о делах."

#. STRINGS.MERM_TALK_CLOSED.3
msgctxt "STRINGS.MERM_TALK_CLOSED.3"
msgid "Don't keep the lady waiting."
msgstr "Не заставляй даму ждать."

#. STRINGS.MERM_TALK_CLOSED.4
msgctxt "STRINGS.MERM_TALK_CLOSED.4"
msgid "Speak with Mumsy. Hurry on, then."
msgstr "Поговори с Мамушкой. Ну же, поспеши."

#. STRINGS.MERM_TALK_CONTEST_OOOH.1
msgctxt "STRINGS.MERM_TALK_CONTEST_OOOH.1"
msgid "Such taste."
msgstr "Со вкусом."

#. STRINGS.MERM_TALK_CONTEST_OOOH.2
msgctxt "STRINGS.MERM_TALK_CONTEST_OOOH.2"
msgid "Nicely done."
msgstr "Красота какая."

#. STRINGS.MERM_TALK_CONTEST_OOOH.3
msgctxt "STRINGS.MERM_TALK_CONTEST_OOOH.3"
msgid "Such beauty."
msgstr "Какая красота."

#. STRINGS.MERM_TALK_CONTEST_PANIC.1
msgctxt "STRINGS.MERM_TALK_CONTEST_PANIC.1"
msgid "Must choose!"
msgstr "Нужно сделать выбор!"

#. STRINGS.MERM_TALK_CONTEST_PANIC.2
msgctxt "STRINGS.MERM_TALK_CONTEST_PANIC.2"
msgid "How decide?!"
msgstr "Никак не могу решить!"

#. STRINGS.MERM_TALK_FIND_FOOD.1.1
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.1.1"
msgid "Will come with you."
msgstr "Пойду с тобой."

#. STRINGS.MERM_TALK_FIND_FOOD.1.2
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.1.2"
msgid "Flort glut."
msgstr "Фьють-бульк."

#. STRINGS.MERM_TALK_FIND_FOOD.2.1
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.2.1"
msgid "Make Mermfolk strong!"
msgstr "Сделаем народ тритонов великим!"

#. STRINGS.MERM_TALK_FIND_FOOD.2.2
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.2.2"
msgid "Blut gloppy Glurtsu!"
msgstr "Блым-плесь-бульк!"

#. STRINGS.MERM_TALK_FIND_FOOD.3.1
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.3.1"
msgid "This do fine."
msgstr "Это пойдет."

#. STRINGS.MERM_TALK_FIND_FOOD.3.2
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.3.2"
msgid "Glort grolt flut."
msgstr "Бульк-бульк-фьюить."

#. STRINGS.MERM_TALK_FIND_FOOD.4.1
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.4.1"
msgid "Find something tasty!"
msgstr "Найти что-то вкусное!"

#. STRINGS.MERM_TALK_FIND_FOOD.4.2
msgctxt "STRINGS.MERM_TALK_FIND_FOOD.4.2"
msgid "Glurt florpy flut!"
msgstr "Бульк-плым-блымк!"

#. STRINGS.MERM_TALK_FOLLOWWILSON.1.1
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.1.1"
msgid "Will come with you."
msgstr "Пойду с тобой."

#. STRINGS.MERM_TALK_FOLLOWWILSON.1.2
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.1.2"
msgid "Flort glut."
msgstr "Фьють-бульк."

#. STRINGS.MERM_TALK_FOLLOWWILSON.2.1
msgctxt "STRINGS.MERM_TALK_FOLLOWWILSON.2.1"
msgid "Make Mermfolk strong!"
