msgstr "Мой разум затуманен голодом!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.2"
msgid "Oof. I got the brainfog."
msgstr "Уф, голова не думает совсем."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.3"
msgid "Maybe I could take a snack break?"
msgstr "Может, сделать перерыв на перекус?"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNGRY_SLOWBUILD.4"
msgid "I could sure go for some grub."
msgstr "Определенно надо что-нибудь перехватить."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail looks like a cake walk."
msgstr "Я справлюсь там на раз-два."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I didn't order lunch to go. Get'em!"
msgstr "Я не заказывала обед. Взять его!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Gah! I lost it."
msgstr "Блин! Потеряла."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Err, are those my footprints? Shoot!"
msgstr "Эм-м, это что, мои следы, что ли? Вот блин!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_START_FORK"
msgid "This trail looks like a doozy."
msgstr "Выглядит зашибенно."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "I think we got the jump on this critter."
msgstr "Похоже, у меня есть преимущество."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I'm gettin' the heebie-jeebies. Somethin's watchin' me."
msgstr "У меня мурашки по коже. За мной явно кто-то следит."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It demands poop!"
msgstr "Здесь бы поднавалить!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_INV_FULL"
msgid "I only got two hands."
msgstr "У меня только две руки."

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_IS_FEASTING"
msgid "What a spread!"
msgstr "Сколько тут всего!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Well look what we've got here!"
msgstr "Посмотрите-ка, кто у нас тут!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Gotcha!"
msgstr "Попался!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "Нашел!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
