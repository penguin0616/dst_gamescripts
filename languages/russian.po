msgstr "Ты мухлюешь, маленький рогач!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORTOX.FIRESTARTER"
