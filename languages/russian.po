#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DRSTYLE"
msgid "She's a doozy."
msgstr "Что-то с чем-то."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RECORD_DUSK"
