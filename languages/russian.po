msgstr "Лучше приступить к приготовлению подношений."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
