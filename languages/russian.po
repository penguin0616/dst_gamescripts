msgid "We can't see! I want my nightlight."
msgstr "Мы не видим! Я хочу свой ночник."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ENTER_LIGHT"
msgid "Phew, light!"
msgstr "Фух, свет!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EXIT_GELBLOB"
msgid "We're all sticky!"
msgstr "Мы все в липкой жиже!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Why do we feel like we're being watched?"
msgstr "Мне кажется, или за нами кто-то наблюдает?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It doesn't want to play anymore."
msgstr "Он больше играть не хочет."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Coming back to play some more?"
msgstr "Ты вернулся? Хочешь еще поиграть?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FAN_OUT"
msgid "Aaw, the twirly is gone."
msgstr "Оу, крутилка кончилась."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "We never knew there was so much to learn about this stuff!"
msgstr "Мы и не думали, что об этом столько всего можно узнать!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Owie, that was not a nice plant!"
msgstr "Ой-ой, какое плохое растение!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Eek, we feel all burny inside!"
msgstr "Ай, у нас внутри жжется!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew, we'll be more careful not to touch strange weeds."
msgstr "Ух, мы больше не будем трогать незнакомые сорняки."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLARE_SEEN"
msgid "Oh, someone's calling us to come over."
msgstr "О, кто-то зазывает нас на огонек."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_HELD"
msgid "We float!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FLOATER_LETGO"
msgid "We sink!"
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_FREEDOM"
msgid "We made it!"
msgstr "Мы справились!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOSTDRAIN"
msgid "We're becoming... even more monstrous!"
msgstr "Мы становимся… еще более чудовищными!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "We'd better not go out in the acid rain until we put on more repellent."
msgstr "Нам лучше не гулять под кислотным дождем без мази."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HIGHRESEARCH"
msgid "I'm learning so much!"
msgstr "Я многому учусь!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOT"
msgid "Hot as heck!"
msgstr "Ох, какой острый, не порезаться бы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HOUNDS"
msgid "Doggies are coming!"
msgstr "Сюда бегут собачки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNGRY"
msgid "It's time for a snack!"
msgstr "Время перекусить!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_AVOID_FORK"
msgid "We feel better sticking to the safer trail."
msgstr "Нам нравится идти туда, где безопаснее."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Fresh tracks!"
msgstr "Свежие следы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Animal went bye-bye."
msgstr "Животное помахало нам лапкой."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "It's too muddy to track."
msgstr "Слишком грязно, чтобы идти по следу."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_START_FORK"
msgid "Whatever left those prints must be big... and scary..."
msgstr "Тот, кто оставил эти следы, наверное, очень большой... и страшный..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "They'll never see us coming!"
msgstr "Он не увидит, что мы рядом!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Why do we feel like something's watching us..."
msgstr "Почему нас не покидает чувство, что на нас смотрят?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "Not good enough for you, plant?"
msgstr "Недостаточно для тебя хорошо, растение?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL"
msgid "Our pockets are full!"
msgstr "Наши карманы полны!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_IS_FEASTING"
msgid "We want to try everything!"
msgstr "Мы хотим попробовать все!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Hello! Are you lost?"
msgstr "Привет! Ты потерялся?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Found you!"
msgstr "Нашел!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are!"
msgstr "А вот и ты!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "We found you!"
msgstr "Мы тебя нашли!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Heehee, gotcha!"
msgstr "Хи-хи! Попался!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "That was the last one, we won!"
msgstr "Это последний! Мы победили!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "We did it, we found them all!"
msgstr "Мы справились! Мы всех нашли!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "We found one more!"
msgstr "Мы нашли еще одного!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Aw... olly olly oxenfree!"
msgstr "Шишки-шишки, мы на передышке!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "We're almost out of time!"
msgstr "Времени почти не осталось!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "We don't think the kitcoons would go this far out..."
msgstr "Мы не уверены, что котята могли так далеко забраться..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "We're back in the kitcoon's playground."
msgstr "Мы вернулись на игровую площадку для котят."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Let's work together to find those kitcoons!"
msgstr "Давайте поищем енотокотят вместе!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Ready or not, here we come!"
msgstr "Кто не спрятался — мы не виноваты!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Uh-oh, its got friends coming!"
msgstr "Ой-ой, его друзья сейчас прибегут!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_ENRAGE"
msgid "Ah! I'm sorry we killed your deer!!"
msgstr "Ай! Прости, что мы убили твоего оленя!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its belly looks hungry!"
msgstr "Похоже, его животик голоден!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_KNOCKEDOUT"
msgid "Ow, our head!"
msgstr "Ой, наша голова!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "We're invincible!"
msgstr "Мы неуязвимы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LOWRESEARCH"
msgid "That might've taught a toddler something."
msgstr "Это может научить мелкого чему-нибудь."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "The giant ball is back."
msgstr ""

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "We can see something glowing waaay over there!"
msgstr "Там вдалеке что-то светится!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Uh-oh, that bright light's attracting a lot of attention..."
msgstr "Ой-ой, такой яркий свет привлечет о-о-очень много внимания..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1"
msgid "We feel weird... weirder than usual..."
msgstr "Мы чувствуем себя странно... еще страннее, чем обычно..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What? How...? Now we're really confused..."
msgstr "Что? Как?.. Теперь мы совсем ничего не понимаем..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "We're us again!"
msgstr "Мы — это снова мы!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost!"
msgstr "Почти!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "We'll get you out."
msgstr "Мы тебя выпустим."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "You're free!"
msgstr "Свобода!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost!"
msgstr "Почти!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "We'll get you out."
msgstr "Мы тебя выпустим."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "You're free!"
msgstr "Свобода!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost!"
msgstr "Почти!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "We'll get you out."
msgstr "Мы тебя выпустим."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "You're free!"
msgstr "Свобода!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Whoops!"
msgstr "У-у-упс!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Сосите кровь у кого-нибудь другого!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Наш волосатый друг ранен!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "Мы откроем его позже, как бы празднуя наше спасение!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "Мы не можем дремать, пока монстры поблизости!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "Мы не можем спать, пока монстры поблизости!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Мне днем не спится."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "Мы еще не готовы идти в кровать."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "Мы не можем спать с урчащим животиком."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "Наш животик урчит, и мы не можем спать!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "Обещаю, я еще покатаюсь на тебе после того, как открою подарок!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "Мы не можем просто вздремнуть, тут ночь на дворе!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "Кто же дремлет до рассвета?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Haha! Again!"
msgstr "Ха-ха! Еще раз!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "We can't sleep with such a bright nightlight..."
msgstr "Мы с таким ярким ночником уснуть не сможем..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Мама всегда говорила: «Не спи в горящем здании»."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "Я не могу! Тут все горит!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Легкотня."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Whoops! Let's try that again."
msgstr "Ой! Попробуем-ка еще разок."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Aww, it got away..."
msgstr "Ну вот, сорвалась рыбешка."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Was that a nibble? Nope."
msgstr "Клюет? Нет? Не клюет."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Come on out, fishies!"
msgstr "Ну где же вы, рыбки?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "This is getting kinda boring..."
msgstr "Как же скучно…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I thought fishing would be a bit more exciting."
msgstr "Мы думали, что рыбалка — дело интересное…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah! Aww, our line snapped..."
msgstr "Ой! Леска порвалась… Как же так?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Should we reel it in a bit?"
msgstr "Не подтянуть ли нам леску?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Don't eat us!"
msgstr "Не ешь нас!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT"
msgid "Is that how the play is supposed to go?"
msgstr "А разве это по сценарию?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "We really shouldn't have broken that den!"
msgstr "Не надо было ломать домик!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Uh-oh... maybe we shouldn't have rowed out so far."
msgstr "Ой-ой... Зря мы отплыли так далеко."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "Плохая птичка!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "Деревья на нас кричат!!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "Буэ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh oh... we're not sure we like the sound of that."
msgstr "Ой-ой... мы не уверены, что нам нравится этот звук."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED"
msgid "We can't wait to see what it is!"
msgstr "Скорей бы узнать, что это такое!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "We're learning so much about this plant!"
msgstr "Мы столько всего узнаем об этом растении!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Wheeeeee--OOF!"
msgstr "Уи-и-и-и... УФ!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID"
msgid "Let's get out of here!"
msgstr "Давай отсюда выбираться!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "Не думаю, что это урчал наш животик."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Aw, wrong spot!"
msgstr "Ой, неправильное место!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "We hear something coming! And it sounds grouchy!"
msgstr "Мы слышим, как что-то приближается! И оно сердитое!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY"
msgid "We see a weird rabbit!"
msgstr "Там странный кролик!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "We caught it!"
msgstr "Поймали!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's burrowing around us!"
msgstr "Вокруг нас кто-то копается!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "Мы не можем это ударить."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "Все равно, что вернуться обратно в школу."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "Уже лучше!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "Так-то!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "Держись, мы поможем!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1"
msgid "Our Liege!"
msgstr "Преклоняемся!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2"
msgid "Nice crown!"
msgstr "Красивая корона!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3"
msgid "Your wish is our command!"
msgstr "Исполним любой каприз!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Our \"Liege\"!"
msgstr "«Преклоняемся»!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Nice \"crown\"!"
msgstr "Красивая «корона»!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Tell us a joke!"
msgstr "А расскажете шутку?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "Все возвращается!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "Но ведь там были подарки!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "Мы ему нравимся!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "We already filled up our scrapbook."
msgstr "Мы уже заполнили свой альбом."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! No fair! We can't see you!"
msgstr "Ай! Так нечестно! Мы тебя не видим!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that creepy light?"
msgstr "Что это за жуткий свет?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "Дерево, защити нас!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "Эй! Придира!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY"
msgid "Hey! Let go!"
msgstr "Эй! Отпусти!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Where's more snow?"
msgstr "Куда дели снег?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "We can't roll it any bigger!"
msgstr "Больше не накатаем!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "Мы насквозь промокли!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Are we seeing things?!"
msgstr "Нам что, мерещится?!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "Привет, растения! Как дела?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Aww, are you lonely? We'll keep you company!"
msgstr "Ой, вам что, одиноко? Мы с вами посидим!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "One day you're going to grow up big and strong... and then we'll eat you!"
msgstr "Однажды ты вырастешь большим и сильным... А потом мы тебя слопаем!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You are a very good plant."
msgstr "Ты очень славное растение."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "We're always here when you need somebody to talk to!"
msgstr "Мы всегда рядом, если тебе захочется с кем-то поговорить!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "Ай!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ох, он нас так манит."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED"
msgid "We felt like using him was a bit like cheating anyway."
msgstr "Мы подумали, что с ним игра какая-то нечестная."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD"
msgid "Oh no... where are we supposed to go now?"
msgstr "О нет... Куда же нам теперь идти?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "They want to get back to finding the kitcoons."
msgstr "Он хочет вернуться к поискам енотокотят."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Either someone else found them, or this one is a lot tinier."
msgstr "Либо этого котенка уже нашли, либо он такой малюсенький, что его и не видать."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We must be getting close!"
msgstr "Мы уже близко к цели!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Doesn't look like he found any clues here."
msgstr "По-моему, он тут ничего не нашел."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING"
msgid "Wow! He's leading us right to the kitcoons! ...Is that cheating?"
msgstr "Ух ты! Он ведет нас прямо к енотокотятам! ...А это не жульничество?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "We should stay close to him."
msgstr "Надо держаться к нему поближе."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "Ну-у, лягушка убежала!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "Она ищет, куда бы спрятаться."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "Эй! Мы же ей пользуемся!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK"
msgid "We don't think this tool's strong enough!"
msgstr "Нам кажется, этот инструмент слабоват!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "Уа-а-а, свет погас!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "Мы тут!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "Ой!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "Ауч! Требуется больше времени."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE"
msgid "Our fur is soaking wet!"
msgstr "Шерстка у нас мокрая насквозь!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT"
msgid "We don't think it can race anymore..."
msgstr "Кажется, бегать она уже не сможет…"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Вес: {weight}"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nWoah, that's heavy!"
msgstr "Вес: {weight}\nОго, тяжеловато!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WET"
msgid "We're unpleasantly moist."
msgstr "Нам мокро и неприятно."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WETTER"
msgid "Wet as a bathtub we can't crawl out of."
msgstr "Тут мокро, как в ванной, мы не можем выбраться."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Oops! We missed it."
msgstr "Ой! Мы промахнулись."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Aww... nothing."
msgstr "Эх, тут пусто."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Hey! Everything's all sparkly!"
msgstr "Ого! Все такое блестящее!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Aww, we were having fun!"
msgstr "У-у-у, весело же было!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

