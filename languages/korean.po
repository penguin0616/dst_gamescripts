msgstr "파티가 너무 지나쳤나 보다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "Is place for all of Wolfgang's friends!"
msgstr "볼프강 친구들 모두 모일 수 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "Come, friends, and eat the mighty food!"
msgstr "이리 와, 친구들아. 힘센 음식 먹자!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "Oops. Is not going here."
msgstr "이런. 여기가 아니다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLECONTAINER"
msgid "Is good place for fish things!"
msgstr "물고기 잡는 물건 넣기 좋다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLESKETCH"
msgid "Picture will help Wolfgang catch fish!"
msgstr "그림 보면 볼프강 물고기 잡는 데 도움 되겠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TACKLESTATION"
msgid "Make better rod for fish!"
msgstr "더 좋은 낚싯대 만든다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TAFFY"
msgid "Is taffy for crushing!"
msgstr "부스러뜨리기 좋은 태피다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRD"
msgid "Is tallest bird!"
msgstr "가장 키 큰 새다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG"
msgid "There is bird inside."
msgstr "안에 새가 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Cooked bird. Good for breakfast!"
msgstr "요리한 새다. 아침 식사로 좋다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "Bird is like ice cube!"
msgstr "얼음 조각 덩어리 같은 새다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Little bird is trying to get out."
msgstr "작은 새가 나가려고 한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Is too hot for little bird!"
msgstr "작은 새에게는 너무 뜨겁다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "I wait for bird."
msgstr "새를 기다린다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Bird comes soon."
msgstr "새가 곧 온다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "Is big egg!"
msgstr "큰 알이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Is nest of emptiness."
msgstr "비어있는 둥지다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TALLEGGS"
msgid "Will make good workout for Wolfgang's jaw!"
msgstr "볼프강이 턱 운동하기에 좋다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TAMALES"
msgid "Was Wolfgang not supposed to eat husk of corn?"
msgstr "볼프강, 옥수수 껍질 먹으면 안 되는 거였냐?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.GENERIC"
msgid "Hah! Not so tall."
msgstr "흐하! 별루 안 크구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Is hungry, and noisy."
msgstr "배고프고 시끄럽다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.SLEEPING"
msgid "Bird is sleeping."
msgstr "새가 자고 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TEENBIRD.STARVING"
msgid "Is hungry, noisy, and angry!"
msgstr "배고프고 시끄럽고 화났다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEBASE.GEMS"
msgid "Do not think it working."
msgstr "작동이 안 되는 것 같다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEBASE.VALID"
msgid "Glow is good sign."
msgstr "빛이 나는 건 좋은 징조다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "I do not fear what lies beyond!"
msgstr "저 너머에 있는 것이 무엇이든, 두렵지 않다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "Strange rock. Do I sit on?"
msgstr "이상한 돌이다. 그 위에 앉으면 되나?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Something missing still."
msgstr "여전히 뭔가가 부족하다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "Is coming together now."
msgstr "슬슬 일이 진행되고 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_BOX"
msgid "Has little lever."
msgstr "작은 레버가 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_CRANK"
msgid "Bendy thing is made of metal!"
msgstr "금속으로 만든 회전용 거시기다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_POTATO"
msgid "Ha ha! Ha ha! What ugly potato!"
msgstr "하하! 하하! 못생긴 감자구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELEPORTATO_RING"
msgid "I can bend into perfect circle!"
msgstr "완벽한 원을 그리겠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TELESTAFF"
msgid "Fancy headache stick."
msgstr "머리 아프게 만드는 고급 막대기구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.BURNT"
msgid "Nothing left to nap in."
msgstr "낮잠 잘 장소가 못 쓰게 되었다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENT.GENERIC"
msgid "It is time for a mighty nap."
msgstr "센 낮잠을 잘 시간이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE"
msgid "Skinny monster!"
msgstr "날씬한 몬스터다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLESPIKE"
msgid "Perfect for sticking!"
msgstr "찌르기에 완벽하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLESPOTS"
msgid "Yuck! Slimy!"
msgstr "우엑! 미끈덩하구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_GARDEN"
msgid "Hmmmm, suspicious!"
msgstr "흐음, 수상쩍다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR"
msgid "Lots of little friends!"
msgstr "작은 친구가 많다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Tiny tentacle baby thing! Ha!"
msgstr "작은 촉수 아기 물건이구나! 하!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "You run away from mighty Wolfgang?"
msgstr "힘센 볼프강으로부터 도망가는 거냐?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "Tiny tree is now gone! Strange..."
msgstr "이제 작은 나무가 사라졌다! 이상하다..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.CRIMSON"
msgid "Should maybe not have fed scary stuff to weird triangle."
msgstr "이상한 삼각형에게 무서운 것을 먹이지 말았어야 했다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.ENABLED"
msgid "Tiny tree is shooting rainbow!"
msgstr "작은 나무가 무지개를 쏘고 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.GENERIC"
msgid "How did tiny tree get inside?"
msgstr "작은 나무는 어떻게 안으로 들어갔을까?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "Wolfgang not want to see giant eye again."
msgstr "볼프강은 거대한 눈을 다시 보고 싶지 않다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "Wolfgang likes the sparkles."
msgstr "볼프강은 반짝거리는 걸 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Is burned away to dust."
msgstr "타서 먼지가 되었다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "Is looking like normal chest without sparkles."
msgstr "반짝거리는 게 없는 일반 상자처럼 보인다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "Wolfgang wants to peek inside!"
msgstr "볼프강은 안을 들여다보고 싶다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE"
msgid "Is pretty rock."
msgstr "예쁜 돌이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITEBUGNET"
msgid "Wolfgang wouldn't hurt fly."
msgstr "볼프강 파리도 못 해친다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THULECITE_PIECES"
msgid "Can smash together to make bigger piece!"
msgstr "다 으깨고 난 다음에 더 큰 조각을 만들 수 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.THURIBLE"
msgid "Is for monster control."
msgstr "몬스터를 조종하는 것이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.ABANDONED"
msgid "Wolfgang is sorry."
msgstr "볼프강은 미안하다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.GENERIC"
msgid "Is Wolfgang's furry friend."
msgstr "볼프강의 털복숭이 친구다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.LOST_TRACK"
msgid "What you looking for, furry friend?"
msgstr "무엇을 찾고 있나, 털복숭이 친구?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.NEARBY"
msgid "Wolfgang thinks furry friend found something!"
msgstr "볼프강은 털복숭이 친구가 뭔가를 발견했다고 생각한다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "Furry friend didn't find anything for Wolfgang."
msgstr "털복숭이 친구가 볼프강에게는 아무것도 찾아주지 않았다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.SUCCESS"
msgid "Furry friend is doing great job!"
msgstr "털복숭이 친구는 잘하고 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "Tiny kitties too far from us!"
msgstr "쪼꼬미 애옹이들이 우리에게서 너무 멀리 떨어져 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TRACKING"
msgid "Go, furry friend, help Wolfgang!"
msgstr "어서, 털복숭이 친구, 볼프강을 도와줘!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "Oh, is wrong kitty!"
msgstr "아, 이 애옹이가 아니야!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TILLWEED"
msgid "Took Wolfgang ages to get out of garden!"
msgstr "볼프강이 정원까지 나오는데 시간이 오래 걸렸다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TILLWEEDSALVE"
msgid "Feels nice on the boo-boos."
msgstr "아픈 데에 좋을 것 같아."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Bah! Frogman was hiding like coward!"
msgstr "핫! 개구리남자가 겁쟁이처럼 숨어 있었다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL.RAGE"
msgid "Frogman is very strong now!"
msgstr "개구리남자가 이제 매우 힘세다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Is little dirt hole."
msgstr "작은 흙 구멍이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Tiny mushy-room is no threat to Wolfgang!"
msgstr "조그만 버어서엇은 볼프강에게 위협이 아니다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Squishy thing in ground."
msgstr "바닥에 질퍽한 것이 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO"
msgid "Is good for sauce makings."
msgstr "소스 만드는 데 좋다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_COOKED"
msgid "Roasty and toasty."
msgstr "잘 구워졌다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_OVERSIZED"
msgid "Is almost big enough to fill Wolfgang's mighty belly!"
msgstr "볼프강이 속을 든든히 채울 만큼 크다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOMATO_SEEDS"
msgid "Is little tiny seeds for burying."
msgstr "땅에 묻는 작은 씨앗이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOPHAT"
msgid "Is good hat!"
msgstr "좋은 모자다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOPHAT_MAGICIAN"
msgid "Wolfgang would rather wear something else."
msgstr "볼프강은 다른 거 쓰고 싶다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TORCH"
msgid "Attack night with fire stick!"
msgstr "불 막대기로 밤을 공격한다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOURTIERE"
msgid "Is pie filled with much protein!"
msgstr "파이에 단백질 많이 들었다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TOWNPORTAL.ACTIVE"
