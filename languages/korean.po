msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.GENERIC"
msgid "Fine, as long as it don't start no forest fires."
msgstr "숲에 불만 안 지르면 난 괜찮아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.OFF"
msgid "Does it look like it's working, Lucy?"
msgstr "작동하는 것 같니, 루시?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "Fine, as long as it don't start no forest fires."
msgstr "숲에 불만 안 지르면 난 괜찮아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "Catchin' some zeds, eh?"
msgstr "잠에 취했나 보네, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "Catchin' some zeds, eh?"
msgstr "잠에 취했나 보네, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "Just follow me, I'll give ya plenty of logs to pick up."
msgstr "날 따라와. 주울 통나무를 잔뜩 줄 테니까."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
msgid "Catchin' some zeds, eh?"
msgstr "잠에 취했나 보네, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_STORAGE_ROBOT.SLEEP"
msgid "Just follow me, I'll give ya plenty of logs to pick up."
msgstr "날 따라와. 주울 통나무를 잔뜩 줄 테니까."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "Let me guess, it doesn't ship to Canada."
msgstr "캐나다까지 옮겨 주지는 않겠지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.CHARGING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.CHARGING"
msgid "Let me guess, it doesn't ship to Canada."
msgstr "캐나다까지 옮겨 주지는 않겠지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.GENERIC"
msgid "Let me guess, it doesn't ship to Canada."
msgstr "캐나다까지 옮겨 주지는 않겠지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEBRELLA.OFF"
msgid "Does it look like it's working, Lucy?"
msgstr "작동하는 것 같니, 루시?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "헉! 조심해, 루시!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "That's a right shame."
msgstr "정말 안타깝잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "It's like havin' our own shipping depot."
msgstr "우리만의 운송 창고가 생긴 것 같네."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "Plum tuckered."
msgstr "완전히 뻗었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERHAT"
msgid "It's a nice toque, eh?"
msgstr "좋은 모자네, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.BURNT"
msgid "The ones from home don't burn."
msgstr "고향에 있는 건 안 탔는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTEROMETER.GENERIC"
msgid "We can build these half as tall back home."
msgstr "고향에선 얘들 크기가 절반 정도였는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTFUEL"
msgid "Making me think of that blue spruce we cut down years ago..."
msgstr "몇 년 전에 베었던 종비나무가 떠오르잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "Almost done."
msgstr "거의 다 됐잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Smells good, eh?"
msgstr "냄새가 좋네, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "Dinner's ready."
msgstr "저녁 준비됐어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "What kind of oven doesn't take wood?"
msgstr "도대체 어떤 오븐에 장작이 안 들어가지?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD1"
msgid "It's a gingerbread lumberjack."
msgstr "진저브레드 나무꾼이네."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD2"
msgid "Always had a soft spot for a good holiday cookie."
msgstr "명절에 먹는 쿠키는 언제나 맛있지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD3"
msgid "Satisfies the sweet tooth."
msgstr "단 게 땡길 때 좋아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD4"
msgid "That thing just ain't right."
msgstr "이건 너무 이상하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD5"
msgid "All the taste and none of the splinters!"
msgstr "맛은 좋고, 가시는 걱정할 필요 없지!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD6"
msgid "Hard to complain aboot this whole \"Feast\" business."
msgstr "이런 별미에 대고 불평할 순 없지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD7"
msgid "Doesn't fall far from the cider tree."
msgstr "주변에 사과 나무도 없는데 어떻게 만들었을까."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD8"
msgid "Perfect for drinking next to a good fire, eh?"
msgstr "따끈한 모닥불 옆에서 마시기 딱 좋잖아?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_FOOD9"
msgid "Psst, Lucy. Do I have a 'nog moustache?"
msgstr "어이, 루시. 혹시 나 입술 위에 에그노그 묻었어?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENT"
msgid "For hanging on the unchopped tree with care."
msgstr "베지 않은 나무에 장식으로 조심스럽게 다는 거야."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Y'know, I do believe that was worth it."
msgstr "나는 보람이 있었다고 생각해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Kinda familiar eh, Lucy?"
msgstr "눈에 익지 않아, 루시?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "That's nice."
msgstr "좋은데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "What do you think, Lucy? Decorate, or chop?"
msgstr "어떻게 생각해, 루시? 장식할까, 아니면 자를까?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNING"
msgid "Such senseless violence."
msgstr "끔찍한 일이야."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "안타깝네. 분위기 정말 좋았는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "Must... not chop..."
msgstr "베면... 안 돼..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREE.YOUNG"
msgid "All holidays should revolve around trees."
msgstr "모든 명절에는 나무가 필요해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Too bad. Made the place feel real cozy."
msgstr "안타깝네. 분위기 정말 좋았는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "I'm sure I have an extra pine cone somewhere."
msgstr "어딘가에 솔방울이 있을 텐데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_DEN"
msgid "Looks cozy."
msgstr "포근해 보이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_MOONGLASS"
msgid "Huh. Don't recall them looking like that."
msgstr "흠. 저런 모양이 아니었는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER"
msgid "Wouldn't mind some fresh seafood right aboot now."
msgstr "지금 당장 신선한 해산물을 좀 먹으면 좋겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "He's thorougly hooped."
msgstr "아주 죽었잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Good eats!"
msgstr "잘 먹겠습니다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYBIG.1"
msgid "You're almost as shaggy as me, buddy!"
msgstr "나만큼 덥수룩한 친구잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYBIG.2"
msgid "You're almost as shaggy as me, buddy!"
msgstr "나만큼 덥수룩한 친구잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYSMALL.1"
msgid "It's nice havin' a dog around."
msgstr "강아지가 있으니 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBYSMALL.2"
msgid "It's nice havin' a dog around."
msgstr "강아지가 있으니 좋잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOBY_TREAT"
msgid "I guess if I were starving…"
msgstr "배고파 죽을 지경이라면, 뭐..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s could be a bit more considerate..."
msgstr "%s이(가) 조금만 배려심이 있었으면..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "Don't singe your moustache, %s."
msgstr "콧수염 태우지 마라, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GENERIC"
msgid "That's my buddy, %s! Hey!"
msgstr "힘센 친구, %s! 안녕!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.GHOST"
msgid "C'mon, bud, let's get you on your feet."
msgstr "걱정하지 마, 친구. 되돌아올 수 있게 도와줄게."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.MURDERER"
msgid "You'll not strong arm me, %s!"
msgstr "네가 아무리 힘세도 난 굽히지 않아, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s has a big, squishy heart under those muscles."
msgstr "%s의 다부진 근육 뒤에는 말랑말랑한 심장이 있지."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOLFGANG_WHISTLE"
msgid "He'd better not ask me to start doing jumping jacks..."
msgstr "팔 벌려 뛰기를 시키지는 않아야 할 텐데..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.ATTACKER"
msgid "Someone oughta teach that monkey some manners."
msgstr "누가 저 원숭이의 버릇을 고쳐줘야겠군."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.FIRESTARTER"
msgid "That ape's playin' with fire!"
msgstr "저 원숭이가 불장난한다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.GENERIC"
msgid "Hey Luce, does that monkey seem kinda familiar to you?"
msgstr "이봐, 루시. 저 원숭이 좀 낯익지 않아?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.GHOST"
msgid "Bad day, eh?"
msgstr "오늘 일진이 안 좋은가 봐."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.MURDERER"
msgid "That chimp's on the choppin' block!"
msgstr "저 원숭이가 사람을 죽인다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WONKEY.REVIVER"
msgid "There's a good heart hiding under all that fur, I can tell."
msgstr "그 털가죽 아래에는 착한 마음씨가 숨겨져 있구나."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODCARVEDHAT"
msgid "What a beaut! Lucy outdid herself!"
msgstr "정말 훌륭해! 루시가 아주 잘 만들었는걸!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.ATTACKER"
msgid "%s isn't a true Canadian..."
msgstr "%s은(는) 진짜 캐나다인이 아니잖아..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVER"
msgid "Been there, bud."
msgstr "나도 겪어봤어, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You're gonna have one monster headache after this, buddy."
msgstr "그게 끝나고 나면 엄청나게 머리가 아플 거잖아, 친구."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Those fires are kind of counterproductive now, eh?"
msgstr "별로 생산적이지 않은 불인데, 안 그래?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GENERIC"
msgid "%s! Fancy seeing another Canadian here."
msgstr "%s! 캐나다 사람을 여기서 만났잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GHOST"
msgid "Canadians gotta stick together, %s. Let's get a heart."
msgstr "캐나다 사람들끼리 단결해야지, %s. 심장을 구해보자."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSE"
msgid "Truly Canada's most ferocious beast."
msgstr "캐나다에서 가장 흉포한 짐승으로 꼽히잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Whew... I mean, let's find you a heart, eh?"
msgstr "휴... 아니, 심장을 찾아줄게."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSE"
msgid "Yeesh, is that really what I look like?"
msgstr "으윽, 내가 정말 이렇게 생겼어?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Hang on bud, we'll get you sorted out."
msgstr "기다려, 친구. 우리가 널 정리해줄게."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.MURDERER"
msgid "Hey, c'mere %s! I've gotta AXE you question!"
msgstr "이리 와, %s! 도끼 맛 좀 보여줄게!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOODIE.REVIVER"
msgid "%s is a Canadian patriot, eh."
msgstr "%s은(는) 캐나다 애국자라니까."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "It's just so sad..."
msgstr "정말 슬퍼..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Just look at that quality woodworking!"
msgstr "저 목공 솜씨 좀 봐!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "They're takin' a load off, eh?"
msgstr "좀 쉬고 있네, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.BURNT"
msgid "Too bad, eh?"
msgstr "안타깝다, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "That's a nice wood grain, eh?"
msgstr "멋진 나뭇결이야, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Hey, yer covering up that quality wood!"
msgstr "이봐, 저 품질 좋은 나무를 가리고 있잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.DIRT"
msgid "Be wary of the moving ground."
msgstr "땅이 움직이니 조심해."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.PLANT"
msgid "I know a plant when I see one. This's an impostor!"
msgstr "식물이 어떻게 생겼는지는 알아. 이건 가짜잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM.WORM"
msgid "WOOORM!"
msgstr "벌레다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.GENERIC"
msgid "That looks like a bum!"
msgstr "생긴 거 진짜 별로다!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE.OPEN"
msgid "I'm not sure I want to look at that, eh?"
msgstr "들여다보고 싶지 않은데, 엉?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMHOLE_LIMITED"
msgid "It smells a bit off, eh?"
msgstr "좀 이상한 냄새 나잖아, 그치?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT"
msgid "This thing will be useful."
msgstr "이거 유용하겠잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_LESSER"
msgid "Wrinklier than the underside of a beaver."
msgstr "비버의 배보다 더 쭈글쭈글하잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMLIGHT_PLANT"
msgid "Just a regular old plant."
msgstr "그냥 식물이잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Why don't you leaf the fighting to the professionals?"
msgstr "싸움은 꾼들한테 맡기지 그래?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "I thought you of all people would prevent forest fires."
msgstr "적어도 너는 산불을 막을 줄 알았는데."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GENERIC"
msgid "%s, hey there budding bud!"
msgstr "%s, 안녕, 싹 난 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.GHOST"
msgid "C'mon, let's getcha replanted."
msgstr "가자, 다시 심어줄게."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.MURDERER"
msgid "I'll wear that gem like a brooch, y'hear!"
msgstr "잘 들어, 그 보석, 내가 브로치로 삼겠어!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD.REVIVER"
msgid "You're a good sapling, %s."
msgstr "넌 정말 착한 나무야, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "It's dead."
msgstr "죽었는걸."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "That carrot's a rat!"
msgstr "저 당근, 사실 쥐잖아!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "I gotcha now."
msgstr "잡았다."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "Huh. It's sleeping."
msgstr "흠. 자고 있잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Just a sweet little critter."
msgstr "귀여운 꼬마 생물체잖아."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "Were you always that colourful?"
msgstr "너 원래 그렇게 다채로웠니?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "I'll let it rest."
msgstr "쉬게 두자."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "Keep lighting my way and we'll get along just fine, bud!"
msgstr "계속 내 길을 밝혀주면 우린 잘 지낼 수 있을 거야, 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORM_BOSS"
msgid "We can take her, Luce!"
msgstr "우리가 이길 수 있어, 루시!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.ATTACKER"
msgid "Trust me, you ain't got the chops, %s."
msgstr "네 실력으로는 어림없어, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.FIRESTARTER"
msgid "You better not burn any of my precious trees!"
msgstr "내 소중한 나무를 태우지 마!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GENERIC"
msgid "%s, buddy, hey!"
msgstr "%s, 친구, 이봐!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.GHOST"
msgid "That soul sapper's lookin' like a real sap now."
msgstr "임프도 영혼을 잃어버릴 수 있구나."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.MURDERER"
msgid "I'll hang those horns on the wall of my cabin!"
msgstr "그 뿔을 내 오두막 벽에 걸어 놓겠어!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX.REVIVER"
msgid "That was mighty kind of you, %s."
msgstr "정말 착한 일 했네, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_NABBAG"
msgid "Looks pretty handy."
msgstr "편리해 보이네."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_REVIVER"
msgid "That might be useful in a pinch."
msgstr "위기 상황에서 쓸모가 있겠어."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WORTOX_SOULJAR"
msgid "To each their own."
msgstr "각자 자신에게."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.ATTACKER"
msgid "Woah! Slow down there, bud!"
msgstr "우어어! 진정해, 친구!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.FIRESTARTER"
msgid "Hey! What do you think you're doin?"
msgstr "이봐! 뭐 하는 거야?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WURT.GENERIC"
