msgstr "조심해! 수염을 태우지 말고!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WOODIE.GENERIC"
