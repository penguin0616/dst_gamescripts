msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Ugh, go away!"
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "More wired junk."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WAGDRONE_PARTS"
