#. STRINGS.SKIN_QUOTES.walter_ancient
msgctxt "STRINGS.SKIN_QUOTES.walter_ancient"
msgid "\"Where should we go on our next adventure, Woby?\""
msgstr "\"다음 모험은 어디로 갈까, 워비?\""

#. STRINGS.SKIN_QUOTES.walter_bee
msgctxt "STRINGS.SKIN_QUOTES.walter_bee"
msgid "\"Maybe if I dress like them, they won't sting me!\""
msgstr "아마 내가 그들처럼 옷을 입는다면 그들은 나를 쏘지 않을 텐데요!"

#. STRINGS.SKIN_QUOTES.walter_bee_d
msgctxt "STRINGS.SKIN_QUOTES.walter_bee_d"
msgid "\"Maybe if I dress like them, they won't sting me!\""
msgstr "아마 내가 그들처럼 옷을 입는다면 그들은 나를 쏘지 않을 텐데요!"

#. STRINGS.SKIN_QUOTES.walter_bee_p
msgctxt "STRINGS.SKIN_QUOTES.walter_bee_p"
msgid "\"Maybe if I dress like them, they won't sting me!\""
msgstr "아마 내가 그들처럼 옷을 입는다면 그들은 나를 쏘지 않을 텐데요!"

#. STRINGS.SKIN_QUOTES.walter_detective
msgctxt "STRINGS.SKIN_QUOTES.walter_detective"
msgid "\"Don't worry Sirs and Madams, Woby and I are on the case!\""
msgstr "\"여러분, 걱정하지 마세요. 워비와 제가 수사에 착수합니다!\""

#. STRINGS.SKIN_QUOTES.walter_formal
msgctxt "STRINGS.SKIN_QUOTES.walter_formal"
msgid "\"I'd wear it more often, but it's so heavy with all these badges...\""
msgstr "\"더 자주 입고 싶은데 배지가 너무 많이 달려서 무거워...\""

#. STRINGS.SKIN_QUOTES.walter_ice
msgctxt "STRINGS.SKIN_QUOTES.walter_ice"
msgid "\"Brrr... it's a good thing you already have your own winter coat, Woby!\""
msgstr "\"브르르... 이미 겨울 코트가 있어서 다행이야, 워비!\""

#. STRINGS.SKIN_QUOTES.walter_lunar
msgctxt "STRINGS.SKIN_QUOTES.walter_lunar"
msgid "\"Look out evildoers, I've got the moon on my side!\""
msgstr "\"조심하거라, 악인들이여. 달이 내 편에 있으니!\""

#. STRINGS.SKIN_QUOTES.walter_nature
msgctxt "STRINGS.SKIN_QUOTES.walter_nature"
msgid "\"Every story needs a fearless adventurer and their trusty steed!\""
msgstr "\"모든 이야기에는 두려움 없는 모험가와 그들의 믿음직한 말이 필요하죠!\""

#. STRINGS.SKIN_QUOTES.walter_rose
msgctxt "STRINGS.SKIN_QUOTES.walter_rose"
msgid "\"I think I really rose to the occasion! Eh, Woby?\""
msgstr "\"자리에 맞게 잘 차려입은 것 같아! 안 그래, 워비?\""

#. STRINGS.SKIN_QUOTES.walter_shadow
msgctxt "STRINGS.SKIN_QUOTES.walter_shadow"
msgid "\"I don't need a handbook telling me what to do - I make the rules now!\""
msgstr "\"이래라저래라 하는 핸드북은 필요없어. 이제 규칙은 내가 정한다!\""

#. STRINGS.SKIN_QUOTES.walter_survivor
msgctxt "STRINGS.SKIN_QUOTES.walter_survivor"
msgid "\"I hope I don't lose any points for the state of my uniform.\""
msgstr "\"유니폼이 낡아서 점수가 깎이지 않았으면.\""

#. STRINGS.SKIN_QUOTES.walter_ventriloquist
msgctxt "STRINGS.SKIN_QUOTES.walter_ventriloquist"
msgid "\"Want to hear a really scary story?\""
msgstr "\"정말 무서운 이야기를 듣고 싶으세요?\""

#. STRINGS.SKIN_QUOTES.walter_victorian
msgctxt "STRINGS.SKIN_QUOTES.walter_victorian"
msgid "\"Extra, extra! Read all about it!\""
msgstr "\"엑스트라, 엑스트라! 그걸 전부 읽어봐요!\""

#. STRINGS.SKIN_QUOTES.walter_yule
msgctxt "STRINGS.SKIN_QUOTES.walter_yule"
msgid "\"Come on Woby, that Winter's Feast tree won't decorate itself!\""
msgstr "\"어서, 워비. 겨울 축제 트리를 장식해야지!\""

#. STRINGS.SKIN_QUOTES.wanda_bishop
msgctxt "STRINGS.SKIN_QUOTES.wanda_bishop"
msgid "\"This match will require a few more adjournments.\""
msgstr "이 경기는 몇 번 더 연기해야 하겠네요."

#. STRINGS.SKIN_QUOTES.wanda_bishop_d
msgctxt "STRINGS.SKIN_QUOTES.wanda_bishop_d"
msgid "\"This match will require a few more adjournments.\""
msgstr "이 경기는 몇 번 더 연기해야 하겠네요."

#. STRINGS.SKIN_QUOTES.wanda_bishop_p
msgctxt "STRINGS.SKIN_QUOTES.wanda_bishop_p"
msgid "\"This match will require a few more adjournments.\""
msgstr "이 경기는 몇 번 더 연기해야 하겠네요."

#. STRINGS.SKIN_QUOTES.wanda_formal
msgctxt "STRINGS.SKIN_QUOTES.wanda_formal"
msgid "\"Nothing is more fashionable than punctuality.\""
msgstr "\"시간 엄수보다 더 세련된 것은 없습니다.\""

#. STRINGS.SKIN_QUOTES.wanda_ice
msgctxt "STRINGS.SKIN_QUOTES.wanda_ice"
msgid "\"Oh botheration, where have I gotten myself this time?\""
msgstr "\"아, 성가셔라. 내가 이번엔 또 어디로 온 거지?\""

#. STRINGS.SKIN_QUOTES.wanda_lunar
msgctxt "STRINGS.SKIN_QUOTES.wanda_lunar"
msgid "\"My future will reveal itself in the phases of the moon.\""
msgstr "\"달이 차고 기울며 내 미래가 드러날 거야.\""

#. STRINGS.SKIN_QUOTES.wanda_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wanda_masquerade"
msgid "\"Starlight is a blast from the past.\""
msgstr "\"별빛은 과거의 향수를 불러일으키지.\""

#. STRINGS.SKIN_QUOTES.wanda_nature
msgctxt "STRINGS.SKIN_QUOTES.wanda_nature"
msgid "\"Time seems to move slower in the depths of the forest.\""
msgstr "\"숲 깊숙한 곳에서는 시간이 더 천천히 흐르는 것 같군.\""

#. STRINGS.SKIN_QUOTES.wanda_rose
msgctxt "STRINGS.SKIN_QUOTES.wanda_rose"
msgid "\"I suppose I should make time to stop and smell the roses every so often.\""
msgstr "\"가끔씩 시간 내서 장미 향을 맡아야겠어.\""

#. STRINGS.SKIN_QUOTES.wanda_shadow
msgctxt "STRINGS.SKIN_QUOTES.wanda_shadow"
msgid "\"There is nothing but dark times ahead.\""
msgstr "\"앞으로 어두운 시간만 있을 뿐입니다.\""

#. STRINGS.SKIN_QUOTES.wanda_steampunk
msgctxt "STRINGS.SKIN_QUOTES.wanda_steampunk"
msgid "\"Not enough people appreciate the minutiae of temporal tinkering.\""
msgstr "\"시간 땜질의 세세한 부분까지 이해하는 사람이 충분하지 않아요.\""

#. STRINGS.SKIN_QUOTES.wanda_western
msgctxt "STRINGS.SKIN_QUOTES.wanda_western"
msgid "\"There's always more to do than there is time to do it.\""
msgstr ""

#. STRINGS.SKIN_QUOTES.wanda_yule
msgctxt "STRINGS.SKIN_QUOTES.wanda_yule"
msgid "\"So many toys to build, and so little time!\""
msgstr "\"조립할 장난감은 너무 많은데 시간은 너무 적어!\""

#. STRINGS.SKIN_QUOTES.warly_candyman
msgctxt "STRINGS.SKIN_QUOTES.warly_candyman"
msgid "\"I'm thinking of opening a chocolate factory.\""
msgstr "\"초콜릿 공장을 열 생각이야.\""

#. STRINGS.SKIN_QUOTES.warly_carrat
msgctxt "STRINGS.SKIN_QUOTES.warly_carrat"
msgid "\"I must train for the races!\""
msgstr "경주에 나가려면 훈련해야 해!"

#. STRINGS.SKIN_QUOTES.warly_carrat_d
msgctxt "STRINGS.SKIN_QUOTES.warly_carrat_d"
msgid "\"I must train for the races!\""
msgstr "경주에 나가려면 훈련해야 해!"

#. STRINGS.SKIN_QUOTES.warly_carrat_p
msgctxt "STRINGS.SKIN_QUOTES.warly_carrat_p"
msgid "\"I must train for the races!\""
msgstr "경주에 나가려면 훈련해야 해!"

#. STRINGS.SKIN_QUOTES.warly_chef
msgctxt "STRINGS.SKIN_QUOTES.warly_chef"
msgid "\"It's a fine day for some fine dining, non?\""
msgstr "\"고급 요리를 먹기 좋은 날이지?\""

#. STRINGS.SKIN_QUOTES.warly_fisherman
msgctxt "STRINGS.SKIN_QUOTES.warly_fisherman"
msgid "\"I'm on a see-food diet.\""
msgstr "\"해산물 구경 다이어트 중이야.\""

#. STRINGS.SKIN_QUOTES.warly_formal
msgctxt "STRINGS.SKIN_QUOTES.warly_formal"
msgid "\"What a treat it is to rub shoulders with the creme de la creme!\""
msgstr "\"이렇게 훌륭한 이들과 어울릴 수 있어 기쁘군!\""

#. STRINGS.SKIN_QUOTES.warly_ice
msgctxt "STRINGS.SKIN_QUOTES.warly_ice"
msgid "\"I'd say this look is best served cold.\""
msgstr "\"이 룩은 차갑게 준비하는 게 가장 좋아요.\""

#. STRINGS.SKIN_QUOTES.warly_lunar
msgctxt "STRINGS.SKIN_QUOTES.warly_lunar"
msgid "\"Nothing beats a golden croissant... I mean crescent.\""
msgstr "\"황금빛 크루아상... 아니, 초승달이 최고지.\""

#. STRINGS.SKIN_QUOTES.warly_masquerade
msgctxt "STRINGS.SKIN_QUOTES.warly_masquerade"
msgid "\"An air of mystery is the secret ingredient for any good soiree.\""
msgstr "\"훌륭한 파티의 비밀 재료는 수수께끼 같은 분위기지.\""

#. STRINGS.SKIN_QUOTES.warly_nature
msgctxt "STRINGS.SKIN_QUOTES.warly_nature"
msgid "\"I only cook with natural ingredients.\""
msgstr "\"천연 재료로만 요리합니다.\""

#. STRINGS.SKIN_QUOTES.warly_pirate
msgctxt "STRINGS.SKIN_QUOTES.warly_pirate"
msgid "\"I seem to have developed quite a taste for treasure.\""
msgstr "\"보물에 맛들인 것 같아.\""

#. STRINGS.SKIN_QUOTES.warly_rose
msgctxt "STRINGS.SKIN_QUOTES.warly_rose"
msgid "\"And just a dash of sweet rosewater.\""
msgstr "\"향긋한 장미수를 조금 더해 볼까.\""

#. STRINGS.SKIN_QUOTES.warly_shadow
msgctxt "STRINGS.SKIN_QUOTES.warly_shadow"
msgid "\"I've cooked up something frightful, just for you!\""
msgstr "\"너만을 위해 무시무시한 걸 만들었지!\""

#. STRINGS.SKIN_QUOTES.warly_victorian
msgctxt "STRINGS.SKIN_QUOTES.warly_victorian"
msgid "\"I actually just work in the galley.\""
msgstr "\"나는 실제로 조리실에서 일해.\""

#. STRINGS.SKIN_QUOTES.warly_yule
msgctxt "STRINGS.SKIN_QUOTES.warly_yule"
msgid "\"I wonder if Maman missed my holiday baking.\""
msgstr "\"어머니가 내 명절 요리를 그리워하셨으려나?\""

#. STRINGS.SKIN_QUOTES.wathgrithr_ancient
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_ancient"
msgid "\"Let us remember the days öf öld!\""
msgstr "\"과거를 기억하리!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_combatant
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_combatant"
msgid "\"I yearn för my chance ön the pröving gröunds!\""
msgstr "\"나는 심판의 경기장에서 내 이름을 떨칠 기회만 기다리고 있다!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_cook
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_cook"
msgid "\"MEEEEEAT.\""
msgstr "\"고오오오오기.\""

#. STRINGS.SKIN_QUOTES.wathgrithr_deerclops
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_deerclops"
msgid "\"I cöuld take yöu curs with öne eye behind my mask!\""
msgstr "\"마스크로 눈 하나 가리고도 충분히 상대할 수 있다고!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_deerclops_d
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_deerclops_d"
msgid "\"I cöuld take yöu curs with öne eye behind my mask!\""
msgstr "\"마스크로 눈 하나 가리고도 충분히 상대할 수 있다고!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_deerclops_p
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_deerclops_p"
msgid "\"I cöuld take yöu curs with öne eye behind my mask!\""
msgstr "\"마스크로 눈 하나 가리고도 충분히 상대할 수 있다고!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_formal
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_formal"
msgid "\"We will celebrate as if we were in Valhalla!\""
msgstr "\"발할라에 있다고 생각하며 잔치를 즐길 거야!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_formalp
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_formalp"
msgid "\"We will celebrate as if we were in Valhalla!\""
msgstr "\"발할라에 있다고 생각하며 잔치를 즐길 거야!\""

#. STRINGS.SKIN_QUOTES.wathgrithr_gladiator
msgctxt "STRINGS.SKIN_QUOTES.wathgrithr_gladiator"
