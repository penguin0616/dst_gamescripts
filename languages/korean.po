msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "Ah yes. Very science-y."
msgstr "아, 그래. 아주 과학적인걸."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "Ah yes. Very science-y."
msgstr "아, 그래. 아주 과학적인걸."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "Ah yes. Very science-y."
msgstr "아, 그래. 아주 과학적인걸."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "Ah yes. Very science-y."
