msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nGood thing Wolfgang have big muscles for carrying!"
msgstr "무게: {weight}\n볼프강 이거 옮길 근육 있어서 다행이다!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WET"
msgid "Wolfgang does not like bath time."
msgstr "볼프강은 목욕 시간이 싫다."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WETTER"
