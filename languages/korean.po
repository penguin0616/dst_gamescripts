#. STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_1_DESC
msgctxt "STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_1_DESC"
msgid "Learn how to utilize Enlightened Shards as a fuel source for G.E.M.erators."
msgstr "계몽된 파편을 보석 발전기의 연료로 사용하는 법을 배운다."

#. STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_1_TITLE
msgctxt "STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_1_TITLE"
msgid "Enlightened G.E.M.erator"
msgstr "계몽된 보석 발전기"

#. STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_2_DESC
msgctxt "STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_2_DESC"
