msgstr "싱싱한 채소!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLANT_NORMAL.WITHERED"
