msgstr "볼프강 가까이에 있어 줘."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORM_BOSS"
msgid "It is the mama worm."
msgstr "엄마 벌레다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORTOX.ATTACKER"
