#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_WINCH_CLAW_NO_ITEM"
