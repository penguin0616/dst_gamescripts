msgstr "나쁜 음식 같다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEAD_SEA_BONES"
