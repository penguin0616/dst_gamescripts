#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNARED"
msgid "Wolfgang does not like bones!"
msgstr "볼프강 뼈 싫다!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNARED_IVY"
msgid "Wolfgang will pull you out of the ground!"
msgstr "볼프강이 널 땅에서 끌어낼 거야!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Not enough snow here."
msgstr "여기 눈 부족하다."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "Snowball will not grow bigger."
msgstr "눈덩이 더 안 커진다."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_SOAKED"
