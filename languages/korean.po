msgstr "여기 호수 있어야 한다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.GENERIC"
