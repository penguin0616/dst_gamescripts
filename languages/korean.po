msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPER"
msgid "No! No! Stay off head!"
msgstr "안돼! 안돼! 머리에서 떨어지자구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPERPELT"
msgid "Strange fur clump."
msgstr "이상한 털뭉치다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURPER_PELT"
msgid "It's still moving!"
msgstr "아직도 움직인다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLE"
msgid "Ha! You are slow!"
msgstr "훗! 너 느리구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLEHAT"
msgid "Keeps head safe."
msgstr "머리를 안전하게 지켜준다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLEHOLE"
msgid "Hole full of slugs."
msgstr "민달팽이가 가득한 구멍이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLESLIME"
msgid "Boom snot!"
msgstr "쿵쾅이 콧물이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Is broken."
msgstr "부서졌다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Is very small bird."
msgstr "아주 작은 새다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Small bird is hungry."
msgstr "작은 새가 배고프다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Small bird sleeps now."
msgstr "작은 새 지금 잔다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLBIRD.STARVING"
msgid "Small bird will die from starving."
msgstr "작은 새가 굶어 죽게 생겼다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLGHOST"
msgid "Aaaaah! Er, ahem, meant AAAAAAAAAAAAAAH!!"
msgstr "아아아! 이게 아니다. 음, 에헴, 아아아아아아아아악!!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLMEAT"
msgid "Too small! Need bigger meat!"
msgstr "너무 작다! 더 큰 고기가 필요하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SMALLMEAT_DRIED"
msgid "Look like leather, taste like meat."
msgstr "가죽처럼 보이지만, 고기 맛이 난다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNAPPER"
msgid "I will smush lizard man!"
msgstr "도마뱀 남자를 부수겠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWBALL_ITEM"
msgid "Wolfgang is snowball fight champion."
msgstr "볼프강 눈싸움 챔피언이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWMAN.GENERIC"
msgid "Pretty!"
msgstr "예쁘다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "What a cute snowball."
msgstr "눈덩이 아주 귀엽다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNURTLE"
msgid "Spirally!"
msgstr "빙글빙글 무늬다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Will be good drink for plants, make them strong!"
msgstr "식물에게 좋은 음료가 될거야. 식물을 튼튼하게 해줄 거야!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "Is powerful plant drink with powerful smell!"
msgstr "강력한 냄새가 나는 강력한 식물 음료다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.STALE"
msgid "Stink getting stronger... will make plants stronger too!"
msgstr "악취가 강해지면... 식물도 강해진다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "Is ready to make plants mighty!"
msgstr "식물을 강력하게 만들 준비가 되었다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPAT"
msgid "Look so friendly and cuddly."
msgstr "착하고 꼭 껴안고 싶게 생겼다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR"
msgid "It gave me a sliver."
msgstr "가느다란 조각을 주었다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_GUNGNIR"
msgid "Wolfgang will stab many foes!"
msgstr "볼프강이 많은 적을 찌를 것이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_LANCE"
msgid "Wolfgang likes swirly stab-stick."
msgstr "볼프강이 돌돌 찌르는 막대를 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Is a good weapon."
msgstr "좋은 무기다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "Wolfgang prefer fight with bare hands but this will do."
msgstr "볼프강 맨손으로 싸우는 게 더 좋지만, 이것도 괜찮다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICEPACK"
msgid "Wolfgang will carry all the food!"
msgstr "볼프강이 음식 모두 나른다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_CHILI"
msgid "Is mighty spicy, but Wolfgang can take it."
msgstr "힘세고 맵지만, 볼프강이 먹을 수 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_GARLIC"
msgid "Smells like mama used to make."
msgstr "엄마가 만들던 음식 냄새가 난다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_SALT"
msgid "Smashed big salt rock into many tiny tasty rocks!"
msgstr "커다란 소금 바위가 부서져서 조그마한 맛있는 돌멩이 많이 생겼다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPICE_SUGAR"
msgid "Fruit smashing made sweet sauce."
msgstr "과일 으깨서 달콤한 소스 만들었다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.DEAD"
msgid "Is made of sticky goo!"
msgstr "끈적한 점액으로 만들어졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.GENERIC"
msgid "He has scary face!"
msgstr "얼굴이 무섭게 생겼다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDER.SLEEPING"
msgid "Walk quiet, he might not see me."
msgstr "조용하게 걸으면 들키지 않을지도 모른다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERDEN"
msgid "The bugs are hiding in there."
msgstr "벌레가 저 안에 숨어 있다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "Monsterchild will draw Wolfgang next, yes?"
msgstr "괴물아기는 다음으로 볼프강을을 그릴 거야, 그렇지?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDEREGGSACK"
msgid "Nasty spider eggs."
msgstr "징그러운 거미 알이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPIDERGLAND"
