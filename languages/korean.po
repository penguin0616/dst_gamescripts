msgid "Hotshot! Is he not?"
msgstr "그 아이는 참 뛰어난 명사수지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH"
msgid "Hotshot! Is he not?"
msgstr "그 아이는 참 뛰어난 명사수지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPER"
msgid "Please keep that mouth to yourself!"
msgstr "그 입을 치우지 못할까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPERPELT"
msgid "My fur is much nicer!"
msgstr "내 털이 훨씬 낫다니까!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURPER_PELT"
msgid "My fur is much nicer!"
msgstr "내 털이 훨씬 낫다니까!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLE"
msgid "Slinky, slurp and slime."
msgstr "살금살금, 꿀꺽, 미끄덩."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHAT"
msgid "Oh how safe I do feel!"
msgstr "오, 아주 안전하게 느껴져!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLEHOLE"
msgid "The hole where all the slurtles go!"
msgstr "모든 슬러틀이 들어가는 구멍이다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLESLIME"
msgid "A useful slime, I think, I say."
msgstr "아주 쓸모있는 슬라임 같은데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Shards of shell I do see here."
msgstr "등딱지 조각이 보이네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.GENERIC"
msgid "The apple of my eye."
msgstr "참으로 보기 좋다니까."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Would you like a nice soul to nibble on?"
msgstr "근사한 영혼이라도 쪼고 싶니?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Night night, sleep tight."
msgstr "잘 자렴."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLBIRD.STARVING"
msgid "Goodness gracious, you're really hungry."
msgstr "오, 맙소사, 무척 배가 고픈 게로구나."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLGHOST"
msgid "I prefer souls with more meat on their bones... metaphorically speaking."
msgstr "난 뼈에 살이 더 붙은 영혼이 좋은데... 비유적인 표현이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLMEAT"
msgid "Poor little creature."
msgstr "가엾은 동물이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SMALLMEAT_DRIED"
msgid "Not to my taste."
msgstr "내 입맛에 안 맞아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNAPPER"
msgid "I'll have a fit if I touch that spit!"
msgstr "저 침을 만지면 싫어서 난동을 부리고 말 거야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWBALL_ITEM"
msgid "No greater delight than a snowball fight!"
msgstr "눈싸움은 내가 제일 좋아하는 싸움이지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWMAN.GENERIC"
msgid "Whoa, man. Snowman!"
msgstr "우와, 눈사람이잖아!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "Of all the snowballs..."
msgstr "아주 특별한 눈덩이야..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SNURTLE"
msgid "Slink and slither, little snurtle."
msgstr "미끌미끌, 작은 스너틀이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "This kelp should help our garden grow, hyuyu!"
msgstr "이 다시마는 우리 정원이 자라는 데 도움이 될 거야, 흐유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "This bubbling brew will make the plants good as new."
msgstr "거품나는 맥주는 식물을 막 자라나는 것처럼 싱싱하게 하지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER.STALE"
msgid "This planty drink is starting to stink."
msgstr "이 식물성 음료에서 냄새가 나기 시작해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "A most potent plant potion indeed!"
msgstr "정말 가장 강력한 식물 물약이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPAT"
msgid "Ptoo to you too!"
msgstr "너도 퉷이다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR"
msgid "For defense only, I promise."
msgstr "방어에만 쓸 거야, 약속해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_GUNGNIR"
msgid "Live in fear of the spear!"
msgstr "창을 두려워 하라!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_LANCE"
msgid "Live in fear of the spear!"
msgstr "창을 두려워 하라!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_WATHGRITHR"
msgid "The Viking woman wields it well."
msgstr "바이킹 여자가 잘 쓰지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "That is a shockingly good point."
msgstr "짜릿할 정도로 예리한데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICEPACK"
msgid "What a cute little pack. Hyuyu!"
msgstr "정말 작고 귀여운 꾸러미야. 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_CHILI"
msgid "I'll spike some mortal's food. Hyuyu!"
msgstr "필멸자 음식에 섞어야지. 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_GARLIC"
msgid "Hissss!"
msgstr "카악!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_SALT"
msgid "Careful with that stuff!"
msgstr "저거 조심해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPICE_SUGAR"
msgid "A saccharine collection of liquefied confection."
msgstr "단 액체로 만든 사카린 가루야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.DEAD"
msgid "Sorry! I'm sorry."
msgstr "미안! 미안해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.GENERIC"
msgid "Gracious, you have many legs!"
msgstr "우와, 다리가 많네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER.SLEEPING"
msgid "Sweetest dreams now."
msgstr "이제 좋은 꿈만 꾸렴."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN"
msgid "A leggy surprise awaits inside!"
msgstr "안에 많은 다리들이 기다리고 있지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "I should paint mustaches on the mortals while they're sleeping..."
msgstr "필멸자들이 자는 동안 콧수염을 그려야 하는데..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDEREGGSACK"
msgid "They wiggle, wriggle, 'round inside."
msgstr "안에서 꿈틀꿈틀거리지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERGLAND"
msgid "It's squishy, yes oh yes it is!"
msgstr "정말 물컹물컹하다니까!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHAT"
msgid "Hyuyu, this is grotesque!"
msgstr "휴우, 끔찍해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHOLE"
msgid "All webbed up!"
msgstr "거미줄이 잔뜩이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERHOLE_ROCK"
msgid "All webbed up!"
msgstr "거미줄이 잔뜩이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDERQUEEN"
msgid "Your majesty, please don't hurt me!"
msgstr "폐하, 해치지 말아 주세요!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_DROPPER"
msgid "You look like you want to play!"
msgstr "같이 놀자는 것 같은데!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HEALER"
msgid "I'm not sure I trust that strange orange dust."
msgstr "그 이상한 주황색 먼지를 믿을 수 있을지 확신이 서지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "I think I'll make do without eating that goo."
msgstr "저 찐득한 걸 안먹어도 될 것 같아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_HIDER"
msgid "Spindly spider, begone, begone!"
msgstr "호리호리한 거미야, 저리 가라!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Dead as dead as dead could be!"
msgstr "어느 모로 봐도 죽었어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "Sharpest spider, soon to strike."
msgstr "날카로운 거미가 공격하려고 해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "Get some rest, little pest."
msgstr "좀 쉬렴, 벌레야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_REPELLENT"
msgid "The easiest way to get rid of a spider is with a big shoo, hyuyu!"
msgstr "거미를 제거하는 가장 쉬운 방법은 큰소리 치는 거야, 흐유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_SPITTER"
msgid "Do you spit your goop at me sir?"
msgstr "지금 나한테 침을 뱉었냐?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Sorry! I'm sorry."
msgstr "미안! 미안해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "I'd be okay eating his soul, I think."
msgstr "저녀석이라면 영혼을 먹어도 괜찮을 것 같아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "Sweetest dreams now."
msgstr "이제 좋은 꿈만 꾸렴."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WATER"
msgid "They're just getting their feet wet."
msgstr "그냥 발을 적시고 있어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPIDER_WHISTLE"
msgid "Hyuyu! Who knew spiders liked to whistle?"
msgstr "흐유! 거미가 휘파람을 좋아한다는 걸 누가 알았겠어?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPOILED_FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPOILED_FISH"
msgid "It's spoiled rotten!"
msgstr "썩어서 부패했어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPOILED_FOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPOILED_FOOD"
msgid "Oh jeez, oh yuck, a pile of muck."
msgstr "이런, 우웩, 아주 역겹네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Dazzling!"
msgstr "눈부셔!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "My beautiful spores."
msgstr "나의 아름다운 포자."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_MOON"
msgid "Don't get too close or you'll be feeling awfully spore."
msgstr "너무 가까이 가지 마. 그렇지 않으면 정말 포자처럼 느껴질 거야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "Dazzling!"
msgstr "눈부셔!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_SMALL.HELD"
msgid "My beautiful spores."
msgstr "나의 아름다운 포자."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_TALL.GENERIC"
msgid "Dazzling!"
msgstr "눈부셔!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SPORE_TALL.HELD"
msgid "My beautiful spores."
msgstr "나의 아름다운 포자."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SQUID"
msgid "An eerie eye to see the sea."
msgstr "바다를 보는 오싹한 눈이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFFCOLDLIGHT"
msgid "Hyuyu, how cold and unwelcoming!"
msgstr "휴우, 차갑고 쌩쌩하네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFFLIGHT"
msgid "So bright it hurts my beady imp eyes!"
msgstr "너무 밝아서 구슬 같은 내 임프 눈이 아파!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFF_LUNARPLANT"
msgid "With a flick of the wrist, someone's getting hit."
msgstr "저 손목을 휙 움직이기만 하면 누가 맞겠는걸."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAFF_TORNADO"
msgid "Swirl and twirl, let cruel winds unfurl!"
msgstr "잔인한 바람이 소용돌이친다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEHAND.AWAKE"
msgid "Well hello there little friend."
msgstr "안녕, 작은 친구."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEHAND.HIDING"
msgid "I see you!"
msgstr "너 보여!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEUSHER.SITTING"
msgid "I see you!"
msgstr "너 보여!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STAGEUSHER.STANDING"
msgid "Well hello there little friend."
msgstr "안녕, 작은 친구."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALAGMITE"
msgid "It's just a rock."
msgstr "평범한 돌이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALAGMITE_TALL"
msgid "It's just a rock."
msgstr "평범한 돌이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER"
msgid "Your mind's not quite right, but neither is mine!"
msgstr "너 정신이 이상하다. 나도 그래!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER_ATRIUM"
msgid "Shall we dance, dearest demon?"
msgstr "춤을 출까, 사랑스러운 악마야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STALKER_MINION"
msgid "Silly thing!"
msgstr "실없는 것!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STASH_MAP"
msgid "This map has the clues I need, now where does it lead?"
msgstr "지도에 내게 필요한 단서가 나와 있군. 따라가면 뭐가 나오려나?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "Whoopsie doopsie!"
msgstr "이런!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "The moon will bring a friend my way."
msgstr "달이 나에게 친구를 데려올 거야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEHARP"
msgid "Little cherub, little harp."
msgstr "작은 천사가 작은 하프를 들었네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "The poor cherub and harp, lost in vines thorny sharp."
msgstr "불쌍한 작은 천사와 하프가 가시 덩굴에 휘감겨 있군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUEMAXWELL"
msgid "My old imp friends would like this, I think."
msgstr "내 예전 임프 친구가 이걸 보면 좋아할 텐데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "A statue made of cold, cold stone."
msgstr "차가운 돌로 만든 조각상이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Hyuyu, she's gone and lost her head!"
msgstr "휴우, 우와, 머리를 잃었네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "Hyuyu, she's gone and lost her head!"
msgstr "휴우, 우와, 머리를 잃었네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "I feel compelled to knock it over."
msgstr "쓰러뜨리고 싶은 충동이 드는걸."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEELWOOL"
msgid "Oh my, that's scratchy!"
msgstr "이런, 아주 거친데!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEERINGWHEEL"
msgid "A big wheel to guide a keel."
msgstr "배를 이끄는 큰 핸들이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "I can see the appeal of a steering wheel."
msgstr "조타 핸들은 너무 좋다니까."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STINGER"
msgid "Careful where you point that thing."
msgstr "조심해서 다루는 게 좋아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "I'll take a seat and rest my feet."
msgstr "자리에 앉아 발을 좀 쉬어야겠군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "Move your rear, I want to sit here!"
msgstr "엉덩이 치워, 내가 앉고 싶다고!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_TABLE.GENERIC"
msgid "Now, will the tables turn?"
msgstr "그냥 테이블이야. 따분해라, 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "The centerpiece has been set."
msgstr "테이블에 장식이 있군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "It either starts, or we harvest for parts!"
msgstr "작동하지 않으면 분해해서 부품을 챙겨야겠어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "Ol' Kramps would love this."
msgstr "크람푸스가 이걸 보면 좋아했을 텐데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STRAWHAT"
msgid "It'll be uncomfortable to wear on my horns."
msgstr "뿔 위에 쓰기는 불편할 텐데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STUFFEDEGGPLANT"
msgid "This is my first time encountering such a texture."
msgstr "이런 질감은 처음이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.STUFFING"
msgid "Why fill yourself with dread when you could fill yourself with bread?"
msgstr "빵으로 배를 채울 수 있는데 왜 겁을 집어먹어?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_PICKED"
msgid "Leaves of a plant we picked."
msgstr "식물에게서 딴 잎이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_PLANT"
msgid "A strong willed plant, desert born."
msgstr "사막에서 태어난 강한 의지의 식물이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUCCULENT_POTTED"
msgid "A plant, imprisoned for eternity."
msgstr "영원히 갇힌 식물이네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "I fear it's only a shell of its former self."
msgstr "안타깝지만 이전 모습은 사라지고 껍데기만 남았어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "We need a key for this gift from the sea!"
msgstr "바다의 선물을 열려면 열쇠가 있어야 해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPERTACKLECONTAINER"
msgid "That's quite a lot to tackle, hyuyu!"
msgstr "도구가 엄청 많이 들어가겠네, 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR"
msgid "Alas and alack, the stone has a crack!"
msgstr "아아, 돌에 금이 갔구나!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "All that trouble for a pile of rubble."
msgstr "그렇게 애를 썼는데 돌무더기가 되다니."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "Thank you for your support, hyuyu!"
msgstr "천장을 지탱해 줘서 고맙다, 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "Alas and alack, the stone has a crack!"
msgstr "아아, 돌에 금이 갔구나!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "The Pillar of Dread looks rather dead, hyuyu!"
msgstr "공포의 기둥이 죽어버렸군, 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "What a marvel! Shame it's not marble."
msgstr "참으로 경이롭군! 대리석이 아니라 안타까워."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "A pile of pillar-in-progress."
msgstr "미완성 기둥이군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "A pile of pillar-in-progress."
msgstr "미완성 기둥이군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SURFNTURF"
msgid "My my, what an odd pair!"
msgstr "세상에, 정말 이상한 조합이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEATERVEST"
msgid "I'm not against trying new looks."
msgstr "나는 새로운 패션을 시도하는 것에 반대하지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEETPOTATO"
msgid "Should I tell them it's a prank? Hyuyu!"
msgstr "장난이라고 말해 줘야 하나? 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWEETTEA"
msgid "A little sip will do the trick."
msgstr "몇 모금 마시면 효과가 있을 거야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SWORD_LUNARPLANT"
msgid "A swish to and fro will cut down my foe."
msgstr "앞뒤로 휘두르면 적이 쓰러지겠군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Double the pranks!"
msgstr "장난에 또 장난을 쳤네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "A special place to stuff your face!"
msgstr "입안을 채우는 특별한 곳이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "The stage is set!"
msgstr "무대가 준비됐어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "Best not to break the illusion."
msgstr "환상을 깨지 않는 게 좋겠어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLECONTAINER"
msgid "Hoohoo! What mysteries of fisheries does it hold?"
msgstr "후후! 어떤 낚시의 비밀이 들어 있을까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLESKETCH"
msgid "Some cunning plans to put fish in our hands!"
msgstr "물고기를 손에 넣는 교활한 계획이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TACKLESTATION"
msgid "Let's build a better fish trap, hyuyu!"
msgstr "더 좋은 물고기 덫을 만들자, 휴우!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TAFFY"
msgid "It's very chewy and sweet."
msgstr "매우 끈적하고 달아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRD"
msgid "Legs that go from here to there!"
msgstr "긴 다리로 아주 성큼성큼 다니네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG"
msgid "To mortals it's a tasty treat."
msgstr "필멸자에게는 맛있어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "So sorry, Ms. Bird."
msgstr "미안해, 새야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "You seem chilly, silly billy."
msgstr "추워 보여, 후후."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "They grow up so fast, or so I hear."
msgstr "너무 빨리 자란다고 들었어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Ooo, ouch, much too hot!"
msgstr "오오, 앗, 너무 뜨거워!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "It isn't ready to come out and play."
msgstr "나와서 놀 준비가 아직 안 됐어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Oh dear, oh dear, it's almost here!"
msgstr "오 맙소사, 오 맙소사, 곧 나오겠다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "A pretty egg in mother's nest."
msgstr "엄마의 둥지 안에 있는 예쁜 알이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Her baby is gone. That's just wrong."
msgstr "아기가 사라졌어. 그러면 안 되는데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TALLEGGS"
msgid "I thought I heard bagpipes!"
msgstr "어디서 백파이프 소리가 들린다 했지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TAMALES"
msgid "Very convincing."
msgstr "꽤 그럴싸한걸."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.GENERIC"
msgid "It will turn traitor sometime later."
msgstr "언젠가는 배신자가 되겠지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.HUNGRY"
msgid "Would you like a snack from my backpack?"
msgstr "내 가방에서 간식이라도 꺼내줄까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.SLEEPING"
msgid "They grow so fast, wouldn't you say?"
msgstr "정말 너무 빨리 자라는 것 같아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TEENBIRD.STARVING"
msgid "Awkward even in starvation."
msgstr "굶주린 상태에서도 어색해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEBASE.GEMS"
msgid "I don't think my magic would power it."
msgstr "내 마법도 별 도움이 안 될 것 같은데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEBASE.VALID"
msgid "Ready for some fun!"
msgstr "재미 볼 준비가 되었어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "Let's hop!"
msgstr "뛰자!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "Automatic hopper."
msgstr "자동 도약 장치네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "Why won't you work for this nice imp?"
msgstr "왜 이 착한 임프를 위해 작동하지 않는 거야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "It's almost done I'd say, I'd say!"
msgstr "거의 다 됐어, 됐어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_BOX"
msgid "It's a thing. For the thing!"
msgstr "물건을 위한 물건이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_CRANK"
msgid "It's a thing. For the thing!"
msgstr "물건을 위한 물건이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_POTATO"
msgid "It's a thing. For the thing!"
msgstr "물건을 위한 물건이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELEPORTATO_RING"
msgid "It's a thing. For the thing!"
msgstr "물건을 위한 물건이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TELESTAFF"
msgid "Hassle-free hopping."
msgstr "아주 편리한 도약을 하게 해주지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENT.BURNT"
msgid "Burnt down, down to the ground."
msgstr "불에 타서 무너졌네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENT.GENERIC"
msgid "I could catch a wink, I think."
msgstr "잠깐이라면 자도 될 것 같은데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE"
msgid "Just try and catch me!"
msgstr "날 잡아 봐라!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLESPIKE"
msgid "Ooo, looks dangerous!"
msgstr "오오, 위험해 보여!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLESPOTS"
msgid "Hoohoo, how naughty!"
msgstr "후훗, 못 됐네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_GARDEN"
msgid "Also slippery!"
msgstr "그리고 미끄러워!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR"
msgid "Slippery!"
msgstr "미끄러워!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "It doesn't have anything to prove."
msgstr "아직 인생의 쓴맛을 보지 않았지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Hyuyu."
msgstr "휴우."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "Its power's gone, but not for long."
msgstr "그 힘은 사라졌지만 오래 가지 않았어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.CRIMSON"
msgid "Oh dear, perhaps I've taken this prank too far..."
msgstr "저런, 장난이 너무 지나쳤나봐..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.ENABLED"
msgid "Hyuyu... whoopsie..."
msgstr "휴유... 헉..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.GENERIC"
msgid "A souvenir of sorts, hyuyu!"
msgstr "일종의 기념품이야, 휴유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "It seems nobody here likes pranks."
msgstr "여기서는 아무도 장난을 좋아하지 않는 것 같아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "I can't tell if that bodes well."
msgstr "그것이 좋은 징조인지는 말할 수 없어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Hyuyu, someone's been playing pranks."
msgstr "휴유, 누가 장난을 쳤어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "Extraordinarily ordinary!"
msgstr "지극히 평범해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "Oh, pay it no mind!"
msgstr "오, 신경 쓰지 마!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITE"
msgid "I'll use the nearest shrine to produce a design."
msgstr "가장 가까운 사원을 사용해 디자인해봐야지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITEBUGNET"
msgid "Fly away? Not today!"
msgstr "날아가려고? 그렇겐 안 되지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.THULECITE_PIECES"
msgid "Such strength and such shine."
msgstr "단단한 데다 예쁘게 광도 나지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.THURIBLE"
msgid "Ooo! Smells like fire and brimstone!"
msgstr "오오! 불과 유황 냄새가 난다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.ABANDONED"
msgid "All alone, no mortal to play with."
msgstr "난 외톨이야, 함께 놀 필멸자가 없어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.GENERIC"
msgid "I've set my worries to the side, they'll be my guide!"
msgstr "걱정은 제껴 뒀고 그들이 내 길잡이가 될 거야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.LOST_TRACK"
msgid "Fee-fi-fo-fum, where have they gone?"
msgstr "크킁 크킁, 어디로 갔지?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.NEARBY"
msgid "They too can feel a trickster's around, hyuyu!"
msgstr "그들도 주위에 사기꾼이 있는 걸 느낄 수 있어, 휴유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "No one to find, oh my, oh my."
msgstr "아무것도 찾을 수 없어, 저런, 저런."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.SUCCESS"
msgid "It found all the little pranksters!"
msgstr "꼬맹이 장난꾸러기들을 모두 찾았어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "They're far far away, yet here I stay."
msgstr "그들은 멀리 있지만 나는 여기에 있지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TRACKING"
msgid "Oh where, where could they be, hyuyu."
msgstr "오 어디에, 녀석들이 어디에 있을까, 휴유."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "They're not looking for who I'm looking for."
msgstr "내가 찾고 있는 녀석을 찾고 있지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TILLWEED"
msgid "Till what, weed?"
msgstr "어디까지, 잡초야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TILLWEEDSALVE"
msgid "A welcome break from pains and aches."
msgstr "고통과 통증으로부터 받는 반가운 휴가네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Ooo, you look like FUN!"
msgstr "오오, 너 재미있어 보인다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL.RAGE"
msgid "Now we're REALLY having fun!"
msgstr "재미는 이제부터 시작이지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Just a hole."
msgstr "단순한 구멍이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Nothing to do but chop it in two."
msgstr "둘로 자르는 것 말고는 할 게 없어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Have we summoned something fun?"
msgstr "재미있는 것을 불러온 건가?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO"
msgid "Who shall I throw this at?"
msgstr "누구한테 던지면 좋을까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_COOKED"
msgid "Squishy, squishy."
msgstr "물컹물컹해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_OVERSIZED"
msgid "Hyuyu, I'll have to find something very big to throw it at!"
msgstr "흐유, 던지려면 엄청 큰 걸 찾아야겠어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOMATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "이상하디 이상한 작은 씨앗이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOPHAT"
msgid "A stylish imp I'm fit to be!"
msgstr "난 스타일 근사한 임프다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOPHAT_MAGICIAN"
msgid "Hyuyuyu, he's up to his old tricks!"
msgstr "휴우우, 예전에 쓰던 마술을 또 부리고 있군!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TORCH"
msgid "I won't go astray if this lights my way."
msgstr "이게 내 길을 비춰주면 길을 잃는 일은 없겠지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOURTIERE"
msgid "A pie, not sweet, but filled with meat."
msgstr "달진 않지만 고기로 채운 파이야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "My order's almost here."
msgstr "내가 주문한 게 도착할 때가 됐는데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Soul delivery machine."
msgstr "영혼 배달 기계다."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "Cheers, my dears, I must be off."
msgstr "안녕, 아가들아, 난 간다."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "A rock containing a touch of fun."
msgstr "재미의 손길이 담긴 바위다."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAILMIX"
msgid "Looks chewy. I hate chewing."
msgstr "질겨 보이는데. 난 질긴 건 싫어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAILS"
msgid "You wouldn't pummel a tiny imp, would you?!"
msgstr "설마 작은 임프를 때릴 셈이야?!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRANSISTOR"
msgid "I do not know what this does."
msgstr "이게 뭔지 전혀 모르겠어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP"
msgid "I'm a very patient imp."
msgstr "나는 아주 참을성이 있는 임프라고."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_BRAMBLE"
msgid "Spiky, pointy, green and thorny!"
msgstr "뾰족한 초록색 가시투성이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "Jaws that snap! It was a trap."
msgstr "아가리가 콱 닫혔어! 덫이었구나."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "Careful where you tread, lest you end up dead!"
msgstr "조심해서 딛지 않으면 저승길을 딛게 돼!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_TEETH"
msgid "I hope this isn't too cruel."
msgstr "이게 너무 잔인한 건 아니겠지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "What a rude thing to leave lying around."
msgstr "이런 걸 함부로 놔두다니, 정말 버릇 없군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.BURNT"
msgid "Oh no, our treasure!"
msgstr "이런, 우리 보물이!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A storage place for bits and bobs."
msgstr "잡동사니를 저장하는 장소다."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "There's room to spare for things in there."
msgstr "안에 물건을 넣을 공간이 있군."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREASURECHEST_TRAP"
msgid "What have we here?"
msgstr "이건 뭐지?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREECLUMP"
msgid "Hey! Don't bar the way!"
msgstr "야! 막지 마!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TREEGROWTHSOLUTION"
msgid "It'll really rib to your sticks."
msgstr "그걸로 오랫동안 포만감을 얻게 될 거야."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRIDENT"
msgid "Holding a pitchfork feels disturbingly natural."
msgstr "갈퀴를 들고 있는 게 이상할 정도로 자연스러워."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_1"
msgid "Somebody finally lost them."
msgstr "누군가 잃어버린 모양이네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_10"
msgid "Humans are so funny."
msgstr "인간은 너무 웃겨."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_11"
msgid "Do you have a riddle for me?"
msgstr "혹시 수수께끼라도 내려고?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_12"
msgid "I kind of like it, yes I do."
msgstr "제법 마음에 들어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_13"
msgid "I see no soul within, no no."
msgstr "안에 영혼이 안 보이는데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_14"
msgid "Tea's always spilling through the cracks!"
msgstr "찻잔의 금으로 차가 새고 있어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_15"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_16"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_17"
msgid "I haven't got the tine for that!"
msgstr "어차피 난 쓸 일도 없어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_18"
msgid "Tiny little pranksters surely wait inside. Surprise!"
msgstr "안에 작은 말썽꾼들이 숨어서 기다리고 있을 테지! 짜잔!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_19"
msgid "I feel unbalanced too!"
msgstr "나도 균형이 안 맞는 것 같아!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_2"
msgid "What might I do with a fake kazoo?"
msgstr "가짜 카주로 뭘 하지?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_20"
msgid "Much less satisfying than big sharp claws!"
msgstr "커다랗고 날카로운 발톱이 더 시원해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_21"
msgid "I have no idea what it does."
msgstr "이게 무슨 물건인지 전혀 모르겠어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_22"
msgid "Fried and frayed, just like my brain!"
msgstr "내 뇌처럼 닳고 달았지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_23"
msgid "Not to toot my own shoehorn, but I'm great at collecting soles!"
msgstr "딱히 자랑하는 건 아니지만, 난 밑창 수집을 좋아해!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_24"
msgid "Perhaps a cat genie awaits inside?"
msgstr "어쩌면 고양이 요정이 안에서 기다리고 있을까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_25"
msgid "A lovely scent upon the breeze!"
msgstr "산들바람에 아름다운 향기가 날리지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_26"
msgid "I don't think I get this joke."
msgstr "이건 전혀 이해하지 못하겠어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_27"
msgid "I don't wear clothes."
msgstr "나는 옷을 입지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_28"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_29"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_3"
msgid "Tied like my tongue!"
msgstr "복잡한 매듭이네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_30"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_31"
msgid "A little piece from off the board."
msgstr "보드에서 가져온 말이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_32"
msgid "If I look inside what will I see?"
msgstr "안을 들여다 보면 무엇이 보일까?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_33"
msgid "No fun! It won't fit over my claw."
msgstr "재미없어! 내 발굽에 맞지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_34"
msgid "I like my claws much better."
msgstr "내 발굽이 더 좋아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_35"
msgid "The drink's been drunk, so now it's junk!"
msgstr "음료는 마셨으니 이제는 쓰레기만 남았지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_36"
msgid "Mine are much more impressive."
msgstr "내 송곳니가 훨씬 더 멋져."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_37"
msgid "Heehee, you couldn't kill me!"
msgstr "히히, 날 죽이지 못 했지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_38"
msgid "The size of the world is a matter of perspective."
msgstr "세계의 크기는 시각에 따라 달라 보이지."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_39"
msgid "I don't usually wear gloves."
msgstr "난 장갑은 잘 안 낀다고."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_4"
msgid "I see no soul within, no no."
msgstr "안에 영혼이 안 보이는데."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_40"
msgid "Snips and snails and puppydog scales."
msgstr "달팽이 저울이네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_41"
msgid "Without a doubt, the goop's spilled out."
msgstr "점액이 흘러나온 게 분명해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_42"
msgid "Thank goodness this snake is just a fake."
msgstr "이 뱀이 가짜라서 다행이다."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_43"
msgid "Oh joy, oh boy! A wheely toy!"
msgstr "아, 신나라! 바퀴 달린 장난감이다!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_44"
msgid "There's cracks in it for pests to get into."
msgstr "갈라진 틈으로 해충이 들어갈 수 있겠네."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_45"
msgid "Though you may think me quite a loon, I swear I hear a little tune."
msgstr "내가 미쳤다고 생각할지 모르지만, 분명히 무슨 노랫소리가 들려."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_46"
msgid "We don't have these on my plane."
msgstr "내가 원래 있던 차원엔 이런 게 없어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_5"
msgid "Nyooooom!"
msgstr "뉴우우움!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_6"
msgid "Frizzle-frazzled like my mind!"
msgstr "내 정신 상태처럼 아주 엉망이네!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_7"
msgid "Oh, humans play such funny games!"
msgstr "오, 인간들은 정말 재미있는 놀이를 다 한다니까!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_8"
msgid "I have no idea what it is, but it sure is funny!"
msgstr "이게 뭔지는 전혀 모르겠지만, 웃기긴 웃긴데!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRINKET_9"
msgid "No \"if\"s, \"and\"s or \"but\"-tons."
msgstr "이것도, 저것도, 그것도 안 맞아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "Double, double toil and trouble, fire burn and fishbowl bubble!"
msgstr "고난과 재앙이 두 배가 되면 불길은 타고 어항은 끓지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "How fun!"
msgstr "재미있는걸!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "For a fish it must be quite ideal, to be a prize and not a meal!"
msgstr "물고기에겐 먹히느니 차라리 전리품이 되는 게 낫겠지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "무게: {weight}\n잡은 사람: {owner}"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nJust look at the size of this fishy prize!"
msgstr "무게: {weight}\n잡은 사람: {owner}\n전리품 물고기 크기 좀 봐!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nMy fish is best, as this scale can attest!"
msgstr "무게: {weight}\n잡은 사람: {owner}\n내 물고기가 최고야. 이 저울이 증인이지!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nYour impressive weight saved you from landing on a plate!"
msgstr "무게: {weight}\n잡은 사람: {owner}\n엄청난 무게 덕분에 접시에 오르는 신세는 면했구나!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "What fun!"
msgstr "정말 재미있어!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "Let's do it again, hyuyu!"
msgstr "다시하자, 흐유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "Hoohoo, a game!"
msgstr "후후, 게임이야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nBut is it worth the weight? Hyuyu!"
msgstr "무게: {weight}\n심은 후 {day}째 날에 수확\n하지만 무게를 달아볼 가치가 있을까? 흐유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nI say, what a nice display!"
msgstr "무게: {weight}\n심은 후 {day}째 날에 수확\n있잖아, 진열이 정말 멋져!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "It's not enough to tip the scale, hyuyu!"
msgstr "저울을 기울이는 것만으로는 충분하지 않아, 흐유!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It's my very best vest!"
msgstr "내가 가진 중에서 최고로 좋은 조끼야!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNKVEST_WINTER"
msgid "A puffy, poofy vest, oh yes."
msgstr "푹신한 조끼는 정말 좋아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_COOKED"
msgid "Goodness, no thank you."
msgstr "윽, 사양하겠어."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_SUMMER"
msgid "I'll pass, I say!"
msgstr "안 먹는다고!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TRUNK_WINTER"
msgid "No, no, no, not my taste at all."
msgstr "아니, 전혀 먹고 싶지 않아."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TUMBLEWEED"
msgid "Does it know where it wants to go?"
msgstr "어디로 가고 싶은지나 알까 몰라?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURFCRAFTINGSTATION"
msgid "Mortals just love to change the world to suit them."
msgstr "필멸자는 세상을 자신에게 맞게 바꾸는 것을 좋아해."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_ARCHIVE"
msgid "Floor or ceiling, depending on your perspective."
msgstr "관점에 따라 바닥도 되고 천장도 되지."

