msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_fantasy"
msgid "A whimsical fence dotted with flowers."
msgstr "꽃이 여기저기 흩어져 피어 있는 기발한 울타리입니다."

#. STRINGS.SKIN_DESCRIPTIONS.fence_fantasy_item
