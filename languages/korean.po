msgstr "책은 새들이나 읽는 것이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOOK_BRIMSTONE"
