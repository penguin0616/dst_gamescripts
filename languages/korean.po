#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
