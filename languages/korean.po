msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COLD"
msgid "Brrr! Where are my furs!"
msgstr "덜덜덜이군요! 모피가 어디 있지요!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COMPASS_OUT"
msgid "I fear I'm going to lose my way!"
msgstr "길을 잃을까 두려워!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COZY_SLEEP"
msgid "A well-rested warrior am I!"
msgstr "이 전사는 편안한 휴식을 취했도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_CRAFTING_FAIL"
msgid "I lack the provisions."
msgstr "준비물이 모자란다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DAMP"
msgid "Slick for battle."
msgstr "전투하기엔 너무 미끄럽다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DEERCLOPS"
msgid "A worthy foe approaches."
msgstr "강한 적수가 온다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DESPAWN"
msgid "'Tis the lights of Valhalla?"
msgstr "이게 발할라의 빛인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Back to merely my usual level of fearsomeness."
msgstr "무시무시한 힘이 평소대로 돌아왔어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I... suppose I was unworthy."
msgstr "난... 자격이 없었나 보군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "The tides have turned for the wetter."
msgstr "더 습한 흐름으로 바뀌었군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "I've lost my defensive advantage!"
msgstr "방어 효과가 사라졌다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I fear my defense against sleep hath weakened."
msgstr "잠에 굴복하게 될까봐 두려워."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "I think I've done my share."
msgstr "내 역할은 다한 것 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Be banished, beastly blight!"
msgstr "사라져라, 짐승의 역병아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_DUSK"
msgid "The sun is setting, darkness waits nearby."
msgstr "태양이 지고 있고, 어둠이 근처에서 기다리고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.GENERIC"
msgid "Meat makes my heart sing!"
msgstr "고기는 내 마음을 들뜨게 하지!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.INVALID"
msgid "This is not food befitting a warrior."
msgstr "이건 전사에게 어울리는 음식이 아니야."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.PAINFUL"
msgid "Ohh, I don't feel well."
msgstr "윽, 속이 안 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.SPOILED"
msgid "Ugh, fresh is better."
msgstr "우욱. 신선했으면 좋았을 텐데."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.STALE"
msgid "That was stale beast."
msgstr "신선하지 않은 고기였어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EAT.YUCKY"
msgid "This food is not befitting a warrior."
msgstr "이 음식은 전사에게 어울리지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EATING_NOT_FEASTING"
msgid "Tis more than enough to share!"
msgstr "다 나누고도 남겠는걸!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_BOOSTED"
msgid "It doth soothe for but a fleeting moment."
msgstr "한순간이나마 위안을 주는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Visions from Helheim!"
msgstr "헬하임의 환영이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I am the battalion."
msgstr "일기당천이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "'Tis excess!"
msgstr "지나치구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.1"
msgid "Hff... Nothing can weigh a warrior down!"
msgstr "훗... 전사에게 이런 건 아무것도 아니야!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.2"
msgid "Huff... Huff..."
msgstr "헉... 헉..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.3"
msgid "Tis... nothing..."
msgstr "이건... 아무것도 아니야..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.4"
msgid "Heave... ho...!"
msgstr "여엉... 차...!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.5"
msgid "Gnnngh..."
msgstr "끙..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.6"
msgid "Swift... as Sleipnir..."
msgstr "슬레이프니르처럼... 빠르게..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.7"
msgid "Strong... like Thor..."
msgstr "토르처럼... 강하게..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.8"
msgid "Enduring... like Freya..."
msgstr "프레이야처럼... 끈질기게..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENCUMBERED.9"
msgid "I will be... victorious!"
msgstr "난... 승리할 것이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENTER_DARK"
msgid "And the curtain falls."
msgstr "드디어 막이 내렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ENTER_LIGHT"
msgid "I step into the light!"
msgstr "빛의 영역에 입장!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EXIT_GELBLOB"
msgid "Thank Odin, I am free!"
msgstr "난 자유다! 감사합니다, 오딘이시여!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Away, spying demon. To arms!"
msgstr "저리 가, 훔쳐보는 악마야. 전투 준비!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "You would flee this fight? Asgard does not honor cowards!"
msgstr "이 전투에서 도망갈 거야? 아스가르드는 겁쟁이를 예우해주지 않아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Thou hast returned, now let us finish this battle!"
msgstr "그대가 돌아왔군, 이제 이 전투를 끝내자!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FAN_OUT"
msgid "I've lost another fan!"
msgstr "바람개비가 또 고장 났어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "What need hath a warrior of this knowledge?"
msgstr "이 지식의 전사에게 무슨 필요가 있겠어?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "I feel as though my body's aflame!"
msgstr "몸이 불타는 것 같아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Accursed plant with your fiery barbs! Fight me properly!"
msgstr "불타는 가시를 가진 저주받은 식물 녀석아! 제대로 싸우라고!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "The fiery curse has passed."
msgstr "불의 저주가 지나갔네."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLARE_SEEN"
msgid "My allies beckon me!"
msgstr "동료가 날 부른다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLOATER_HELD"
msgid "Aye, I deny thee, Njord!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FLOATER_LETGO"
msgid "None shall lift me - I rise by will alone!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_FREEDOM"
msgid "Freedom! The saga continues!"
msgstr "자유이지요! 사가는 계속 흐르지요!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GHOSTDRAIN"
msgid "They're driving me mad...!"
msgstr "나를 미치게 만들어...!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "My defense against the burning rain hath dwindled away!"
msgstr "불타는 비에 대한 방어책이 사라졌다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HIGHRESEARCH"
msgid "I am an excellent craftswoman."
msgstr "나는 장인으로서의 솜씨도 대단하지."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HOT"
msgid "The hot sun tires me."
msgstr "뜨거운 태양 때문에 지치고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HOUNDS"
msgid "The beasts are approaching..."
msgstr "짐승이 다가오고 있어..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNGRY"
msgid "How I long for a feast!"
msgstr "진수성찬을 먹고 싶다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_AVOID_FORK"
msgid "Perhaps I shall start with an easier prey."
msgstr "더 쉬운 사냥감부터 노려야겠구나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Hush... The creature is near."
msgstr "쉿... 동물이 근처에 있어요."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I've lost the tracks."
msgstr "흔적을 놓쳤어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "It's too muddy for trailing."
msgstr "추적하기엔 너무 질척거려."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_START_FORK"
msgid "A battle lies at the end of this trail. Onward!"
msgstr "이 흔적의 끝에서 전투가 기다린다. 전진!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "My quarry will not suspect my presence..."
msgstr "사냥감이 날 눈치채지 못하리라..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_HUNT_WRONG_FORK"
msgid "My warrior instincts are telling me something is not right..."
msgstr "전사로서의 직감이 뭔가 수상하다고 말하는구나..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "More droppings for you?"
msgstr "똥이 더 필요해?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_INV_FULL"
msgid "I'm carrying all I can!"
msgstr "더는 못 들어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_IS_FEASTING"
msgid "My friends, let us celebrate this great bounty!"
msgstr "친구들, 이 풍요를 마음껏 즐기자!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Hail, tiny beastie!"
msgstr "안녕, 꼬맹이 짐승!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "You've been found, little beast!"
msgstr "넌 들켰어, 귀여운 짐승아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "You would make a fine stagehand, I hardly saw ye!"
msgstr "넌 훌륭한 무대 담당자가 될 거야, 아주 보기 드물지!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were good, but not good enough!"
msgstr "훌륭해, 하지만 좀 부족하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "You cannot escape my keen eye!"
msgstr "내 예리한 시선에서 벗어나진 못할 걸!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Glorious victory!!"
msgstr "영광의 승리다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "{name} has lead us to glorious victory!"
msgstr "{name} 덕분에 영광스럽게 승리했어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Only one remains! Victory is imminent!"
msgstr "하나밖에 안 남았네! 승리가 임박했어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Arrgh! The little beasties were too clever."
msgstr "아르르! 꼬맹이 짐승이 너무 영리했어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Alas! We need to find the last of them soon!"
msgstr "이런! 곧 마지막 녀석을 찾아야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "Perhaps we're too far to find the little beasties."
msgstr "아마 꼬맹이 짐승을 찾기에 너무 멀리 왔어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "We have returned to the hunting grounds."
msgstr "사냥터로 돌아왔다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "A hunt is always better with more warriors!"
msgstr "사냥에는 언제나 전사가 많을 수록 좋지!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Let our glorious hunt commence!"
msgstr "영광스러운 사냥을 시작하자!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Call thy hordes, they shan't protect thee!"
msgstr "어디, 패거리를 불러봐! 그런다고 도움은 못 될 테니!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_ENRAGE"
msgid "RUN AWAY!"
msgstr "도망가!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Now the true battle begins!"
msgstr "이제야 진정한 전투가 시작되는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh, my head."
msgstr "윽, 머리야."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "I rode in on a bolt lightning."
msgstr "내가 번갯불을 타고 왔거든."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very exciting."
msgstr "좀 시시했는걸."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Thou return'st!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Something doth shine like a beacon in the distance."
msgstr "멀찍이 무언가가 등대처럼 빛나는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That light in the sky... 'tis a challenge to all who see it!"
msgstr "저 하늘의 빛은... 저걸 보는 모든 이들에게 도전하는 듯하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_1"
msgid "What foul magic is this?"
msgstr "이 사악한 마법은 뭐지?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "I've been bewitched!!"
msgstr "마법에 걸렸다!!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Thank Odin, the curse hath been lifted."
msgstr "저주가 풀렸도다. 오딘이시여, 감사드리나이다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Thy form takes shape!"
msgstr "점점 형태가 보이는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "It calls from within!"
msgstr "안에서 부르고 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Taste thy freedom!"
msgstr "자유를 맛보길!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Thy form takes shape!"
msgstr "점점 형태가 보이는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "It calls from within!"
msgstr "안에서 부르고 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Taste thy freedom!"
msgstr "자유를 맛보길!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Thy form takes shape!"
msgstr "점점 형태가 보이는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "It calls from within!"
msgstr "안에서 부르고 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Taste thy freedom!"
msgstr "자유를 맛보길!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOONPOTION_FAILED"
msgid "'Twas all in vain!"
msgstr "다 헛짓이었어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOSQUITOS"
msgid "Away, tiny demons!"
msgstr "작은 악마야, 저리 가라!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Don't give up, beast! Fight!"
msgstr "포기하지 말아라, 짐승아! 계속 싸워!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERGIFT"
msgid "Not with the gift of battle before me!"
msgstr "지금 전투의 위협이 있단 말이야!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERSIESTA"
msgid "Battle is upon us, there'll be no rest!"
msgstr "지금은 싸워야 하니까 쉴 수 없어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODANGERSLEEP"
msgid "It's not safe to sleep. Use the spear!"
msgstr "지금 자는 건 안전하지 않아. 창을 들어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODAYSLEEP"
msgid "The sun is high, journey on!"
msgstr "태양이 높이 떴으니 계속 가야지!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'll not rest yet."
msgstr "아직은 쉴 때가 아니야."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'd like a meat snack first."
msgstr "우선 고기 간식부터 먹는 게 좋겠어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'll starve overnight! Feast first."
msgstr "밤새 굶겠군요! 식사부터 하지요."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOINSPIRATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOINSPIRATION"
msgid "I must warm up my voice... in the heat of battle!"
msgstr "목소리를 덥혀야 해... 전투의 열기로!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I must dismount my mighty steed!"
msgstr "먼저 내 강대한 군마에게서 내려야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NONIGHTSIESTA"
msgid "No napping in the moonlight."
msgstr "달빛 아래에서는 낮잠 잘 수 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "This doesn't feel like the time for a nap."
msgstr "낮잠 잘 시간 같지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Curses! I was not done with that!"
msgstr "빌어먹을! 아직 완성하지 못했거늘!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "'Tis too bright for sleep!"
msgstr "너무 환해서 잘 수가 없어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOSLEEPONFIRE"
msgid "I'll not sleep in the flames."
msgstr "불길 속에선 잘 수 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOTSKILLEDENOUGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOTSKILLEDENOUGH"
msgid "I... I fear I lack the skill to perform this piece..."
msgstr "그건... 내게 역부족이다..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I fear I cannot. It is being razed."
msgstr "할 수 없어. 불타고 있는걸."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_NO_TRAP"
msgid "Thankfully, I am light of foot."
msgstr "다행히, 난 발이 빠른 편이지."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "I'm more suited to fighting than fishing."
msgstr "난 낚시보단 전투에 더 맞아."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "It lives to fight another day."
msgstr "훗날을 기약해야겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I tire of waiting!"
msgstr "기다리기도 지치는구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I'm tempted to simply wade in with my spear..."
msgstr "차라리 그냥 창을 들고 뛰어드는 게..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Come to me, delicious sea meats!"
msgstr "나에게로 와라, 맛있는 바다 고기들아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "It's not befitting of a warrior to just stand around waiting!"
msgstr "가만히 서서 기다리는 건 전사에게 어울리지 않아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "By Freya, the little fiend snapped my line!"
msgstr "프레이야이시여, 작은 악마가 내 줄을 끊었잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line has gone slack, tis time to reel!"
msgstr "줄이 느슨해졌으니 이제 감아야겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "A gargantuan foe approaches!"
msgstr "거대한 적이 다가온다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OFF_SCRIPT"
msgid "How unprofessional!"
msgstr "이러고도 행위예술가라 할 수 있겠는가!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "I suppose 'tis retribution for destroying the home of the slippery beast."
msgstr "그 미끈거리는 짐승의 집을 부순 것에 대한 응보로군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "This meager vessel will not withstand such rugged waters!"
msgstr "이 보잘것없는 배는 그렇게 험한 바다를 견딜 수 없다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PECKED"
msgid "Away, feisty beaker!"
msgstr "사나운 부리 저리 치워!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PETRIFED_TREES"
msgid "I sense Loki's mischievous hand in the shadows."
msgstr "그림자 속에 로키의 장난스러운 손길이 느껴져."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Foul!"
msgstr "불결해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PIRATES_ARRIVE"
msgid "A ship approaches! Prepare for battle!"
msgstr "배가 접근한다! 전투 준비!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PLANT_RANDOMSEED"
msgid "I care not what shall emerge."
msgstr "무엇이 나타날지는 관심이 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "My head hath been filled with useless knowledge about non-meat!"
msgstr "내 머리는 고기에 관한 것이 아닌 지식만 쓸데없이 가득 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "'Twas not one of my more graceful exits..."
msgstr "더 품위를 지키며 나올 수 있는 곳은 아니었어..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_PREFALLINVOID"
msgid "'Tis not my time to fall!"
msgstr "아직 떨어지긴 싫다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_QUAKE"
msgid "The world shudders!"
msgstr "세계가 떨고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Are you not satisfied with the place?!"
msgstr "여기가 마음에 안 드는 것이냐?!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Which denizen of the underworld draws near?"
msgstr "지하의 생물이 다가오고 있군. 과연 무엇일까?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_LUCKY"
msgid "Odd rabbit! A sign from the gods?"
msgstr "이상한 토끼구나! 신들의 계시인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "I have you, fateful rabbit!"
msgstr "잡았다, 운명의 토끼여!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RABBITKING_PASSIVE"
msgid "A creature approaches from beneath."
msgstr "밑에서 어떤 생물이 다가온다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REPELLED"
msgid "Foul magics block mine blows!"
msgstr "불결한 마법이 내 공격을 차단하고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RESEARCH"
msgid "The power of knowledge is great."
msgstr "지식이 힘은 대단해요!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "I am restored!"
msgstr "되살아났다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "To battle!"
msgstr "전투하자!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_REVIVING_CORPSE"
msgid "Rise, my ally!"
msgstr "동료여, 일어나라!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.1"
msgid "Heavy is the head that weareth the crown."
msgstr "왕관을 쓴 머리는 무겁기 마련."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.2"
msgid "Fate hath set the crown upon thy head."
msgstr "운명이 그대의 머리 위에 왕관을 씌웠도다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY.3"
msgid "Mine Liege!"
msgstr "주군!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Empty is the head that weareth the \"crown\"."
msgstr "'왕관'을 쓴 머리가 비어 있구나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Fate hath set the \"crown\" upon thy head."
msgstr "운명이 그대의 머리 위에 '왕관'을 씌웠도다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Mine \"Liege\"!"
msgstr "'주군'!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_RUINS_RESET"
msgid "I will fight my way out!"
msgstr "내 힘으로 싸워서 나갈 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SACREDCHEST_NO"
msgid "Alas! I am unworthy!"
msgstr "이런! 난 자격이 안 되는구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SACREDCHEST_YES"
msgid "I have gained the gods' favor!"
msgstr "신의 은총을 입었다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I hath already completed my tome."
msgstr "내 고서는 이미 완성했다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Revealeth thyself, fiend!"
msgstr "정체를 밝혀라, 악마여!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Hark! 'Tis a most unnatural light!"
msgstr "오, 참으로 부자연스러운 빛이구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SHELTER"
msgid "Aha! Shelter!"
msgstr "아하! 쉴 곳이군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNARED"
msgid "No cage can hold me!"
msgstr "그 어떤 우리도 나를 잡아둘 순 없어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNARED_IVY"
msgid "You would defend your vegetable kin against me? Have at thee!"
msgstr "너의 채소 친척을 변호하고 싶어? 각오해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "A fruitless endeavor."
msgstr "쓸데없는 짓이다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "'Tis futile to roll it further."
msgstr "더 굴려봤자 무의미하다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SOAKED"
msgid "I'm nearly drowned!"
msgstr "익사하는 줄 알았네!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_SPOOKED"
msgid "Doth mine eyes deceive me?"
msgstr "내 눈에 헛것이 보이나?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "I care naught for these plants or the veggies they produce."
msgstr "이 식물이나 여기서 나오는 채소에는 전혀 관심이 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Grow, or do not."
msgstr "자라라, 아니면 말거나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "Perhaps someone more weak and feeble might talk to the plants, while I hunt."
msgstr "사냥하는 동안 더 허약하고 연약한 누군가가 식물에게 말을 걸 수도 있겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "No fearsome warrior should be caught talking to plants."
msgstr "무시무시한 전사가 식물과 대화하는 것을 들키면 안 돼."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "I should be hunting, not gardening!"
msgstr "정원 가꾸기가 아니라 사냥을 해야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_THORNS"
msgid "Arg, I've been poked!"
msgstr "앗, 찔렸다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_THURIBLE_OUT"
msgid "Alas, it is no more."
msgstr "이런, 이제 없네."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_ABANDONED"
msgid "I will finish this hunt solo!"
msgstr "난 이 사냥을 혼자서 끝낼 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_DEAD"
msgid "My guide hath fallen, and I am left directionless!"
msgstr "길잡이는 쓰러졌고 난 길 잃은 채 남겨졌지!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "It is vying for my attention."
msgstr "관심을 얻으려고 다투네."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Someone was swifter than I!"
msgstr "나보다 날쌘 녀석이 있네!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "I sense there's a little beastie afoot..."
msgstr "꼬맹이 짐승이 아장대고 있는 게 느껴져..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "No little beasties in this area."
msgstr "이 구역에는 꼬맹이 짐승이 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_START_TRACKING"
msgid "Onward, great beast!!"
msgstr "앞으로, 멋쟁이 짐승!!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Let us proceed!"
msgstr "앞으로 가자!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOADESCAPED"
msgid "The beast returned from whence it came."
msgstr "짐승이 원래 있던 곳으로 돌아갔어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOADESCAPING"
msgid "Don't let the beast entertain thoughts of escape."
msgstr "짐승이 탈출은 꿈꾸지도 못하게 해."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOOL_SLIP"
msgid "Slippery devil!"
msgstr "이런, 미끄러워라!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOOL_TOOWEAK"
msgid "This meager tool hath not the strength to break it."
msgstr "이 하찮은 도구는 이걸 부수기에 너무 약하구나."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TORCH_OUT"
msgid "My light is quenched!"
msgstr "불빛이 소멸했다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Fear not! I have arrived!"
msgstr "다들 걱정 마! 내가 왔어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_TRAP_WENT_OFF"
msgid "That wasn't part of the plan."
msgstr "이건 계획에 없던 일인데."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_UNIMPLEMENTED"
msgid "It is not of this world."
msgstr "이 세계의 것이 아니야."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WASHED_ASHORE"
msgid "The sea did not claim me this day."
msgstr "오늘은 바다가 날 데려가지 않았군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEAK_RAT"
msgid "The wee beast is on death's door."
msgstr "작은 짐승이 죽음의 문턱 앞에 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "무게: {weight}"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nBy the gods, I've netted a monster!"
msgstr "무게: {weight}\n신이시여, 괴물이 걸렸잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WET"
msgid "I am a wet warrior."
msgstr "젖은 전사가 되었네."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WETTER"
msgid "Does this count as a bath?"
msgstr "이것도 목욕으로 칠 수 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINCH_CLAW_MISS"
msgid "My aim wasn't true..."
msgstr "조준을 잘못했군..."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "My efforts were for naught."
msgstr "노력한 게 헛수고였어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "I feel Odin's blessing upon me!"
msgstr "오딘의 축복이 느껴진다!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "The blessing hath faded."
msgstr "축복이 사라졌군."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMHOLE"
msgid "That was a sloppy adventure."
msgstr "꽤 질퍽한 경험이었어."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMS"
msgid "The earth quakes with the approach of a foe!"
msgstr "다가오는 적 때문에 땅이 흔들리고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORMS_BOSS"
msgid "A behemoth approaches."
msgstr "거대한 괴물이 다가온다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Blasted imp magic!"
msgstr "빌어먹을 임프의 마법 같으니!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Aha! A new plan has revealed itself before mine eyes!"
msgstr "알겠다! 새로운 계획이 눈 앞에 나타났어!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOBOATS"
msgid "I have strayed too far from the starting place!"
msgstr "시작 지점으로부터 너무 멀어졌구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Alas, there is nary a waypoint to guide me in this race!"
msgstr "아아, 이 경주에는 날 이끌 중간 지점이 없도다."

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "Space for a challenger must be made, lest I be forced to race alone."
msgstr "혼자 경주하지 않으려면 도전자를 위한 공간을 마련해야 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.DEER"
msgid "I shall send you to the unicorn!"
msgstr "일각수에게 보내주마!"

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.GENERIC"
msgid "Valhalla awaits!"
msgstr "발할라가 기다리고 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.PIG"
msgid "I'm having pig tonight!"
msgstr "오늘밤에는 돼지고기를 먹겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.PREY"
msgid "Die bravely, little foe!"
msgstr "용감하게 죽어라, 꼬마 적아!"

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.SPIDER"
msgid "Spider, meet my spear!"
msgstr "거미야, 내 창을 받아라!"

#. STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.BATTLECRY.SPIDER_WARRIOR"
msgid "Prepare to be slain!"
msgstr "죽음을 맞이해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.GENERIC"
msgid "Odin will have you yet!"
msgstr "언젠가는 오딘이 널 데려갈 것이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.PIG"
msgid "I'll be back, pigskin!"
msgstr "돼지껍질 씨, 돌아오겠요!"

#. STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.PREY"
msgid "I let you go this time!"
msgstr "이번에는 봐 주겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.SPIDER"
msgid "Leggy coward."
msgstr "다리 많은 겁쟁이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Flee, monster! I will return."
msgstr "도망가세요, 괴물 씨! 돌아올 거예요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "What do you desire, apparition?"
msgstr "무엇을 원하지, 유령?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "For me?"
msgstr "나 주는 거야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "What is it waiting for?!"
msgstr "무엇을 기다리고 있는 거지?!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Perhaps it's best we part ways..."
msgstr "어쩌면 헤어지는 게 좋을지도..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "My warrior's sense tells me it's not to be trifled with."
msgstr "하찮게 보면 안 될 것 같은 느낌이 드는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "It's gathering its strength."
msgstr "힘을 모으고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "What strange magic!"
msgstr "참 이상한 마법이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "For me?"
msgstr "나 주는 거야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "What is it doing?"
msgstr "무엇을 하고 있는 거지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something wicked this way comes."
msgstr "못된 게 오고 있어요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "My victories shall be remembered!"
msgstr "기억에 남을 승리다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN"
msgid "There's a tree hiding within."
msgstr "안에 나무가 숨어 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN_COOKED"
msgid "The young tree has been cooked."
msgstr "아기 나무가 요리가 되었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ACORN_SAPLING"
msgid "Grow strong, young twigs!"
msgstr "어린 나무야, 튼튼하게 자라라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ADVENTURE_PORTAL"
msgid "Adventure is calling."
msgstr "모험이 부르고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIANHAT"
msgid "A boon from Mani's defeated Champion."
msgstr "마니께서 패배한 챔피언에게 주는 혜택이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Even a single shard holds a measure of Mani's power."
msgstr "파편 하나에도 마니의 힘이 상당히 느껴져."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's ferrying this warrior's soul to the next realm."
msgstr "이 전사의 영혼을 다음 영역으로 옮기고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Surely the battle is not over already?"
msgstr "전투가 벌써 끝난 건 아니겠지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Mani hath sent forth his greatest warrior to challenge me!"
msgstr "마니께서 나에게 도전하기 위해 가장 위대한 전사를 보내셨네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "Be thy strength fit for the vengeance thou seek'st?"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "It striketh mine eyes with unparalleled radiance."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Is that all you've got, Champion?"
msgstr "그게 다야, 챔피언?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It seems you are a worthy foe indeed..."
msgstr "넌 참으로 대적할 가치가 있는 것 같아..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "You think I'm trapped here with you? Ha! It is you who are trapped with me!"
msgstr "내가 너랑 여기 갇힌 것 같아? 하! 네가 나랑 갇힌 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "Come, let us finish this!"
msgstr "자, 끝내자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "It seems I've bested it after all."
msgstr "결국 물리친 것 같아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Beware, stranger! The beast may yet rise again!"
msgstr "조심해, 이방인! 아직은 또 일어날 수 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Only a coward would strike a foe down while they sleep!"
msgstr "잠자는 동안 적을 쓰러뜨리는 건 겁쟁이 뿐일 걸!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Unhallowed giant! Odin would pierce his lone eye at the sight of thee!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.AMULET"
msgid "It's red, and a fighter. Just like me!"
msgstr "빨간 전사네. 딱 나처럼!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCHOR"
msgid "Tis light as a feather thanks to my Viking's strength!"
msgstr "바이킹의 힘 덕분에 깃털처럼 가볍군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCHOR_ITEM"
msgid "I will craft the finest ship in the land!"
msgstr "육지에서 가장 좋은 배를 만들겠어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I care not for any fruit, much less one as hard as stone!"
msgstr "나는 과일을 좋아하지 않는다. 하물며 돌 같은 과일이야 말할 것도 없지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "It writhes upon the ground! Be it berry or beast?!"
msgstr "땅 위에서 꿈틀대는군! 저건 열매인가? 아니면 짐승인가?!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "The loathesome berry hath ceased its wriggling."
msgstr "저 추악한 열매가 꿈틀거리는 걸 멈췄군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "A fire burns within, yet the tree lives?"
msgstr "안에서 불이 타오르는데, 나무가 살아있다니?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "It hath been felled."
msgstr "쓰러졌도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "The sight of it doth send a terrible chill down my spine."
msgstr "저 광경을 보니 등골이 오싹해지는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Perhaps 'tis for the best."
msgstr "이게 최선일지도."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "These lands seem to suit it well."
msgstr "이 땅이 잘 맞는 모양이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "It may yet grow with the passing of another season."
msgstr "계절이 한 번 더 지나면 자랄지도."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Why do you despair? Does this land not suit you?"
msgstr "왜 절망하느냐? 이 땅이 맞지 않는 것이냐?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Fear not, I shall find you a place to lay down your roots."
msgstr "안심하거라. 네 뿌리를 뻗을 곳을 찾아 줄 터이니."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENTTREE_SEED"
msgid "It must be returned to the earth."
msgstr "흙으로 돌려보내야만 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_ALTAR"
msgid "These crafts had better be good."
msgstr "공작의 결과가 좋길 바래요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This one is not in working order."
msgstr "작동하지 않는 상태야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANCIENT_STATUE"
msgid "Treasure with a mysterious aura."
msgstr "신비로운 기운이 있는 보물이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANIMAL_TRACK"
msgid "Oh! I love a good hunt."
msgstr "아! 저는 훌륭한 사냥을 좋아하지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTCHOVIES"
msgid "I wrested them from the sea."
msgstr "바다에서 건져 냈지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.GENERIC"
msgid "Tis the mighty lion!"
msgstr "위대한 개미사자로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.UNHAPPY"
msgid "We've incurred its wrath!"
msgstr "분노를 사버렸다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLION.VERYHAPPY"
msgid "The lion smiles upon us."
msgstr "개미사자가 우리에게 미소를 보내네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLIONHAT"
msgid "A helm to change the very ground I walk upon!"
msgstr "내가 거니는 땅 그 자체를 바꾸는 투구로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ANTLIONTRINKET"
msgid "A fitting tribute!"
msgstr "제대로 된 제물!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I fear no beast, mortal or metal!"
msgstr "나는 짐승, 필멸자 또는 금속을 두려워하지 않는다고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "This sentry seems to be asleep at its post."
msgstr "이 보초는 초소에서 잠들어 있는 것 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "The fire reigned supreme."
msgstr "불이 압승했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Might as well do something whilst I wait."
msgstr "기다리는 동안 뭐라도 하는 게 좋겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Shouldn't be long now!"
msgstr "이제 금방 다 될 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "What have we here?"
msgstr "여기 있는 이건 뭐지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "There is no meat inside, so I care not."
msgstr "안에 고기가 없으니 신경 쓰고 싶지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Will you whisper truths to me, as Mímir did to Odin?"
msgstr "미미르가 오딘에게 했던 것처럼 나에게도 진실을 속삭여줄래?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Reveal thine secrets to me, O strange machine!"
msgstr "너의 비밀을 밝혀줘, 오 이상한 기계여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "This place has been long forgotten."
msgstr "오래 전에 잊혀진 장소야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "These people once praised Mani."
msgstr "이 사람들은 한때 마니를 찬양했지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "What if I just stab it?"
msgstr "그냥 찌르면 어떻게 될까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "If it is a gate, it hath been firmly shut."
msgstr "이게 문이라면 굳게 닫아버렸네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Another gate betwixt worlds?"
msgstr "세계와 세계 사이에 또 다른 문이 있네?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It calls down a sign from Mani himself!"
msgstr "마니 자신으로부터 상징을 부른다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Its quest is complete."
msgstr "이 퀘스트는 완료되었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "'Tis the machine from my vision."
msgstr "환영으로 본 기계다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "These runes are foreign to me."
msgstr "이 룬은 나에게 낯설어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "Perhaps they speak of ancient battles."
msgstr "아마도 그들은 고대 전투에 대해 이야기하겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "These runes are foreign to me."
msgstr "이 룬은 나에게 낯설어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Perhaps they speak of ancient battles."
msgstr "아마도 그들은 고대 전투에 대해 이야기하겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "These runes are foreign to me."
msgstr "이 룬은 나에게 낯설어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "It guards these halls."
msgstr "이 구멍을 지키고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It is at rest."
msgstr "휴식 중이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Where are you going, O will-o'-wisp?"
msgstr "어디 가니, 도깨비불?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It requires an offering."
msgstr "제물을 요구하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "This one has been given an offering."
msgstr "누가 이 녀석에게 제물을 바쳤군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORDRAGONFLY"
msgid "Excellent armor for the heat of battle."
msgstr "전투 열기를 견딜 수 있는 훌륭한 갑옷이군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORDREADSTONE"
msgid "It will serve me well, despite its origins."
msgstr "이게 어디서 왔든 유용하게 쓰리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORGRASS"
msgid "Grass protection. That's not going to last long."
msgstr "풀의 보호구라. 얼마 못 가겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORMARBLE"
msgid "Near impenetrable!"
msgstr "이거라면 대부분의 공격은 뚫지 못할 테지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORRUINS"
msgid "Armor fit for Odin himself!"
msgstr "오딘이 입어도 좋을 갑옷이군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSKELETON"
msgid "What devilish armor!"
msgstr "악마의 갑옷이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSLURPER"
msgid "She ebbs the ache of hunger. Good fur."
msgstr "식욕을 감퇴하게 만드는군요. 좋은 털이군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORSNURTLESHELL"
msgid "A shield of sorts."
msgstr "일종의 방패다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORWAGPUNK"
msgid "It grants the wearer a fleetness of foot to rival Hermod himself."
msgstr "저걸 걸치면 헤르모드에 필적할 만큼 발이 빨라지지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMORWOOD"
msgid "A borrowed tree vest."
msgstr "빌린 나무 조끼다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_BRAMBLE"
msgid "My ally is surely a strong warrior."
msgstr "내 동료는 정말 강한 전사야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_CARROTLURE"
msgid "'Tis better to wear than eat them, I suppose."
msgstr "먹기보다는 입는 게 나을 것 같구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Armor crafted from a fallen foe."
msgstr "쓰러진 적으로 만든 갑옷이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "This will make my plant ally more deadly in battle."
msgstr "이게 있으면 내 식물 아군이 전투에서 더 강력해지겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_SANITY"
msgid "Strong, but such a headache it gives..."
msgstr "강하지만 두통을 주는군..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "This garb invites madness..."
msgstr "이 의복은 광기를 불러오는구나..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Signs of a battle past."
msgstr "전투가 있었던 흔적이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A most well placed sign."
msgstr "위치가 완벽한 표지판이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "I shall point the way to triumph!"
msgstr "승리로 향하는 길을 표시할 테다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Signs of a battle past."
msgstr "전투가 있었던 흔적이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A most well placed sign."
msgstr "위치가 완벽한 표지판이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "I shall point the way to triumph!"
msgstr "승리로 향하는 길을 표시할 테다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.GENERIC"
msgid "The flames' remains."
msgstr "불길에서 남은 것."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone could not pass to this world."
msgstr "눈알 뼈는 이 세계로 올 수 없었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower must remain in its home world."
msgstr "꽃은 원래 세계에 남아있어야 하니까."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "It's burnt. Gone."
msgstr "탔군요. 떠났군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS"
msgid "Vegetable! I will not consume you!"
msgstr "채소잖아! 먹지 않겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUSSOUP"
msgid "I shall not consume it!"
msgstr "먹지 않겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_COOKED"
msgid "Fire does not make it more palatable."
msgstr "익힌다고 더 맛있어지진 않지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "This spear will never match up to mine."
msgstr "이 창은 절대로 내 것에 필적할 수 없을 걸."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ASPARAGUS_SEEDS"
msgid "These serve me no purpose!"
msgstr "아무짝에도 쓸모가 없군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Soon it will open the path!"
msgstr "곧 길이 열릴 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It shan't work again for some time."
msgstr "당분간은 작동하지 않을 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Trickery! The Bifrost was of Loki!"
msgstr "속임수다! 비프로스트는 로키의 것인데!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Tis the Bifrost!"
msgstr "비프로스트다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_GATE.ON"
msgid "A light to guide the way!"
msgstr "길을 안내하는 빛!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_KEY"
msgid "Heimdallr's key to the Bifrost."
msgstr "비프로스트로 가는 헤임달의 열쇠."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "An ancient basin to house flames."
msgstr "불꽃을 담는 고대의 대야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "An unholy flame."
msgstr "불경한 불꽃."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "The writings of the gods t'were not meant for us."
msgstr "신들의 글은 우리가 읽을 것이 아니지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "Tis a portrait of an ancient people. They live in wretchedness."
msgstr "고대인들의 초상화다. 불행 속에 살고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "There is no painting here. Only stone."
msgstr "여기에는 그림이 없어. 돌만 있고."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "A great evil sweeps across the land."
msgstr "거대한 악이 땅을 뒤덮는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Many of the people are cleaved in two!"
msgstr "많은 사람들이 두 동강 났어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "A glittering city, blessed by the gods."
msgstr "신들의 축복을 받은 빛나는 도시."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ATRIUM_STATUE"
msgid "I doth smell their fear!"
msgstr "저들의 두려움의 냄새가 나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.AXE"
msgid "To chop and destroy!"
msgstr "자르고 파괴하는 도구!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Mini beastie."
msgstr "작은 짐승이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "The mini beast slumbers."
msgstr "작은 짐승이 자는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BACKPACK"
msgid "A portable armory."
msgstr "휴대용 무기고다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BACONEGGS"
msgid "Pig and eggs!"
msgstr "돼지와 알이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALATRO_MACHINE"
msgid "So be it! Yet one more round, thou knavish deceiver!"
msgstr "좋다! 하지만 한 판만 더 할 것이다, 이 교활한 기만자여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOON"
msgid "Fie! Foul beast!"
msgstr "에잇! 불쾌한 짐승!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONHAT"
msgid "A rubbery mockery of life."
msgstr "미약한 삶의 조롱."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONPARTY"
msgid "It hath swallowed the wee ones whole!"
msgstr "작은 것들을 통째로 삼켜 버렸어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its strange power hath faded."
msgstr "그 이상한 힘이 사라졌버렸다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Grant me the speed of Hermod!"
msgstr "바이킹 헤르모드 같은 속도를 허락하소서!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONS_EMPTY"
msgid "Such colors! I could sing!"
msgstr "아름다운 색이군! 노래가 절로 나오네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BALLOONVEST"
msgid "Tis only good for floating, not fighting."
msgstr "이건 싸우기보다는 떠다니는 데나 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANABUSH"
msgid "I hath no use for a plant burgeoning with foul non-meats."
msgstr "고기가 아닌 게 열리는 식물 따위는 필요 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANAJUICE"
msgid "Monkey slop."
msgstr "원숭이나 먹는 오물이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANANAPOP"
msgid "I've somehow found a way to make it even LESS appealing!"
msgstr "어쩌다 보니 더 끔찍해졌어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANDAGE"
msgid "To heal even the deepest of battle wounds."
msgstr "아무리 깊은 상처라도 치료해주지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "If I had a bandage for every mere flesh wound…"
msgstr "긁힌 상처마다 반창고를 붙인다면..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLE"
msgid "'Tis a paltry bit of sea meat."
msgstr "쥐꼬리만 한 바다 고기다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLEPITA"
msgid "Why hide the meat within this bready pocket?"
msgstr "맛 좋은 고기를 왜 텁텁한 빵으로 감싸는 거야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "For those who are strong of will, and strong of stomach."
msgstr "의지가 강한 자는 위장도 튼튼하기 마련이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLESUSHI"
msgid "I hunger for more!"
msgstr "더 먹고 싶군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLE_COOKED"
msgid "You will find a new home in my belly."
msgstr "이제 내 배 속에서 살렴."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BARNACLINGUINE"
msgid "It slays my hunger soundly!"
msgstr "허기를 철저히 물리친다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BASALT"
msgid "A thousand mortals couldn't break through this stone."
msgstr "수천 명의 필멸자가 애를 써도 이 돌을 부술 수는 없을 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BAT"
msgid "Dark winged meat."
msgstr "어둠의 날개가 달린 고기로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATBAT"
msgid "Winged spear!"
msgstr "날개 창이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATCAVE"
msgid "They're hiding under the stage."
msgstr "무대 아래에 숨어있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATHBOMB"
msgid "I shall toss thee in the earth's cauldron!"
msgstr "땅의 가마솥에 던져 넣겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSE"
msgid "A trophy from the hunt."
msgstr "사냥의 전리품이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSEHAT"
msgid "A warrior would never deign to wear such a thing!"
msgstr "전사라면 그런 옷을 입을 생각은 결코 하지 않을 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATNOSE_COOKED"
msgid "If it's meat, I shall eat it!"
msgstr "고기라면 먹겠지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_CONTAINER"
msgid "It holds my music like arrows in a quiver."
msgstr "화살통 안의 화살처럼 내 음악을 보관하는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_DURABILITY"
msgid "The notes doth imbue my weapons with their sharpness!"
msgstr "음률 덕분에 무기가 더 날카로워졌어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "A fiery performance shalt shield me from the foul burn of my enemy's gaze."
msgstr "적이 불결한 시선으로 불타는 듯이 바라보는 것을 맹렬한 성능으로 보호해 줄거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "I will serenade my enemies on their journey to Valhalla!"
msgstr "적들이 발할라로 가는 길에 난 세레나데를 부를거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "My very words art enough to make my foes tremble!"
msgstr "난 적들을 떨게 할 만큼 예술적으로 말하지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "A melody lively enough to rouse the dead!"
msgstr "망자도 일어날 만큼 활기 찬 선율이로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "A well aimed insult can turn the tide in battle."
msgstr "콕 찝어 모욕을 주면 전투의 흐름을 뒤집을 수 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Do not fear, my song shall show us the light."
msgstr "두려워 마라. 내 노래가 빛을 보여줄 테니."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "A rousing anthem to inspire bravery in battle!"
msgstr "전투에서 용기를 북돋워 주는 신나는 찬가네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "A stirring battle song to clear the head."
msgstr "머리를 맑게 해주는 감동적인 배틀송이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "I shall sing of sweet darkness."
msgstr "달콤한 어둠을 노래하리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATWING"
msgid "Like the wings of my helm, only meatier."
msgstr "내 투구의 날개랑 비슷하지만 살코기가 더 붙었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BATWING_COOKED"
msgid "Cooked dark wing."
msgstr "익힌 어둠의 날개다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARDHAIR"
msgid "Fur of the crazies."
msgstr "광인의 털이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGER"
msgid "Beast or berserker?"
msgstr "짐승인가, 아니면 버서커인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "May we meet again in Valhalla."
msgstr "발할라에서 다시 만나기를."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Thou were a worthy foe."
msgstr "그대는 강한 적수였다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "There's still fight left in the creature!"
msgstr "저 괴물에게 아직 싸울 힘이 남아 있구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERFUR_SACK"
msgid "It will preserve the freshness of my kills."
msgstr "내가 죽인 것들을 신선하게 보존할 수 있겠구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGERVEST"
msgid "BEAR-SERKER!"
msgstr "베어서커!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEARGER_FUR"
msgid "It fought bravely, but its hide is now forfeit."
msgstr "용감하게 싸웠지만, 결국엔 가죽을 잃고 말았지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEAST_BLUEPRINT"
msgid "No luck is needed for one who's skilled in battle."
msgstr "전투에 능한 사람에게는 운이 필요하지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEDROLL_FURRY"
msgid "A luxury fur bed!"
msgstr "고급스러운 털 침대로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEDROLL_STRAW"
msgid "A tool for valiant naps."
msgstr "용맹한 낮잠에 쓰이는 도구다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEE.GENERIC"
msgid "Wee warriors! I don't know if I like them."
msgstr "조막만한 전사군요! 그들이 마음에 드는지는 모르겠군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEE.HELD"
msgid "Easy now!"
msgstr "진정해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.BURNT"
msgid "The hive is silent."
msgstr "벌통이 조용하네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.FULLHONEY"
msgid "It's a honey treasure trove!"
msgstr "꿀이 든 보물상자다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.GENERIC"
msgid "A sweet box of wee warriors."
msgstr "작은 전사들이 들어있는 달콤한 상자다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.NOHONEY"
msgid "Where's the honey?"
msgstr "꿀은 어디에 있지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.READY"
msgid "It's a honey treasure trove!"
msgstr "꿀이 든 보물상자다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Pithy honey. More patience is needed."
msgstr "미량의 꿀이군. 인내심이 필요하다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "The hive is silent."
msgstr "벌통이 조용하네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "It's a honey treasure trove!"
msgstr "꿀이 든 보물상자다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "The old crone would take my head if I dared steal a drop of honey."
msgstr "꿀을 한 방울이라도 훔쳤다간 쪼그랑할멈이 가만두지 않을 테지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Where's the honey?"
msgstr "꿀은 어디에 있지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "It's a honey treasure trove!"
msgstr "꿀이 든 보물상자다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Pithy honey. More patience is needed."
msgstr "미량의 꿀이군. 인내심이 필요하다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DEAD"
msgid "A fallen steed."
msgstr "군마가 죽었구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "It seems Valhalla will not take my steed just yet."
msgstr "아직은 내 애마가 발할라에 갈 때가 아닌 모양이구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "The critter has finally learned its role."
msgstr "짐승이 이제야 자기 역할을 받아들였군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Come along beastie."
msgstr "따라오렴, 짐승아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.GENERIC"
msgid "Ancient woolen beasts!"
msgstr "고대의 털북숭이 짐승이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.MYPARTNER"
msgid "A proud an noble beast, bonded to a proud and noble warrior."
msgstr "자랑스럽고 고귀한 전사와 결속한 자랑스러운 고귀한 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.NAKED"
msgid "Are you cold without your wools?"
msgstr "모피가 없으면 춥니?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.ORNERY"
msgid "The noble steed of a mighty warrior!"
msgstr "위대한 전사의 고귀한 군마!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.PUDGY"
msgid "My mouth's watering just looking at it..."
msgstr "보기만 해도 입에 군침이 도는군..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.RIDER"
msgid "With the stalwart beast at my side, we ride tonight!"
msgstr "충실한 짐승과 함께 오늘밤 달리자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO.SLEEPING"
msgid "Sounds like Aunt Hilda."
msgstr "힐다 고모랑 똑같은 소리를 내며 자네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOFEED"
msgid "I must keep my beast fed and battle-ready."
msgstr "내 짐승을 잘 먹이고 전투 채비를 해두어야 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOHAT"
msgid "That would suit me."
msgstr "나에게 어울릴 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOTREAT"
msgid "My noble steed deserves a reward."
msgstr "내 애마에게 상을 내려야겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALOWOOL"
msgid "I do love woolly things."
msgstr "난 털이 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "The show must go on!"
msgstr "쇼는 계속 되어야 한다고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Preparing for the stage is nearly as exhilarating as preparing for battle!"
msgstr "무대를 준비하는 것은 전투를 준비하는 것만큼이나 짜릿해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "This beastie is ready for its dress rehearsal."
msgstr "이 짐승은 드레스 리허설을 할 준비가 되었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "I must prepare!"
msgstr "내가 준비해야지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEF_BELL"
msgid "This bell commands loyalty from the woolen beasts."
msgstr "이 종을 울리면 양털 짐승들에게 충성심이 생겨."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEGUARD"
msgid "En guarde!"
msgstr "앙 가르드!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEHAT"
msgid "A bee helm, of course."
msgstr "벌 투구지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEHIVE"
msgid "Always buzzing, always plotting."
msgstr "언제나 윙윙거리며 뭔가를 꾸미지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEMINE"
msgid "It sounds suspicious."
msgstr "수상쩍은 소리가 나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEMINE_MAXWELL"
msgid "Watch your step!"
msgstr "발걸음 조심해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEEN"
msgid "Your monarchy shall topple this day!"
msgstr "너의 왕좌도 오늘로 끝이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "A land not of milk, but of honey."
msgstr "젖은 아니고 꿀이 흐르는 땅이네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "The bees are expanding their domain."
msgstr "벌들이 영역을 확장하고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "A hive of winged warriors."
msgstr "날개 달린 전사들의 근거지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEESWAX"
msgid "The stuff of candlemakers."
msgstr "양초제작자의 재료다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEESWAX_SPRAY"
msgid "It holds a fearsome enchantment."
msgstr "무시무시한 마법이 걸려 있도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BEETLETAUR"
msgid "You shall be chained again, foe!"
msgstr "다시 사슬에 묶이게 해주마, 적아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BELL"
msgid "I prefer the ringing resonance of clashing blades."
msgstr "저는 칼날이 부딪히는 소리를 선호하지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_ACTIVE"
msgid "What a brave beast!"
msgstr "용감한 짐승이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_BIG"
msgid "The beast hath been imbued with a fighting spirit!"
msgstr "투지가 가득한 짐승이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It has gone to Valhalla."
msgstr "발할라로 떠났다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's a stuffed beast."
msgstr "짐승 인형이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES"
msgid "Fruits. I don't like 'em."
msgstr "과일이군. 난 싫어해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_COOKED"
msgid "Warm red mush."
msgstr "따뜻한 빨간 죽."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_JUICY"
msgid "I'd prefer a juicy steak."
msgstr "육즙이 좔좔 흐르는 스테이크가 더 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "You're not meat."
msgstr "고기가 아냐."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.BARREN"
msgid "Should we put some turds on it?"
msgstr "여기에 똥을 좀 놓을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.BURNING"
msgid "Consumed by passionate flame!"
msgstr "열정의 화염에 휩싸였어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Disease festers within its soul."
msgstr "혼까지 병들었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "내 눈 앞에서 약해지고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.GENERIC"
msgid "A fruit bush."
msgstr "과일 덤불이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.PICKED"
msgid "The fruits have been snatched."
msgstr "과일은 다 거둔 상태다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It's too hot to grow."
msgstr "너무 더워서 자랄 수 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Good."
msgstr "좋다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Consumed by passionate flame!"
msgstr "열정의 화염에 휩싸였어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Disease festers within its soul."
msgstr "혼까지 병들었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "내 눈 앞에서 약해지고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "It's covered in rabbit food."
msgstr "토끼밥으로 덮여 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "The rabbit food is all gone."
msgstr "토끼밥이 다 사라졌다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It looks atrocious."
msgstr "잔혹해 보인다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BERRYSAUCE"
msgid "It looks like vile berries but... that smell... could it be meat?"
msgstr "보기엔 불쾌한 열매인데... 냄새가... 설마 고기인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIBINGKA"
msgid "Surely this loaf must be made of meat!"
msgstr "고기로 만든 빵이 틀림없다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIGFOOT"
msgid "That's something completely different!"
msgstr "이건 예상치 못했는데!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRCHNUTDRAKE"
msgid "A young tree warrior!"
msgstr "젊은 나무 전사다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.DEAD"
msgid "You can feast in Valhalla now, friend."
msgstr "이제 발할라에서 마음껏 먹기를."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.GENERIC"
msgid "A home for my ravens!"
msgstr "내 까마귀가 살 수 있는 집이네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What do you want, little friend?"
msgstr "무엇을 원하니, 작은 친구야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Are you having a nice time?"
msgstr "심심하지는 않니?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.SKELETON"
msgid "The cage is soiled."
msgstr "새집이 더럽군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Sweet dreams, raven friend."
msgstr "좋은 꿈 꾸렴, 까마귀 친구야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDCAGE.STARVING"
msgid "The raven wishes to feast!"
msgstr "까마귀가 음식을 원하네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRDTRAP"
msgid "I'm a cunning raven catcher!"
msgstr "난 똑똑한 까마귀 사냥꾼이라니까!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_EGG"
msgid "Eggy."
msgstr "알 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_EGG_COOKED"
msgid "Hot egg."
msgstr "뜨거운 알이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_MUTANT"
msgid "The beasts are changed by the storm!"
msgstr "폭풍이 오면 짐승들이 변신한다고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "You think you can challenge me, winged fiend?"
msgstr "날개 달린 악마야, 나에게 도전할 수 있을 것 같니?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP"
msgid "This one needs a good smack."
msgstr "크게 한 방 때려줘야겠네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Rrraugh!"
msgstr "이얏!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Be wary of his blasts!"
msgstr "그의 충격파를 조심해야지요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLACKFLAG"
msgid "A banner of ill omen."
msgstr "불길한 깃발이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_FIRE"
msgid "Like the breath of a dragon."
msgstr "용의 숨결 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_LAVA"
msgid "Njord guide my blows!"
msgstr "뇨르드여, 내 공격을 인도하소서!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_LAVA2"
msgid "Njord, lend me thy strength!"
msgstr "뇨르드여, 힘을 빌려주소서!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_PIPE"
msgid "Projectile weaponry!"
msgstr "발사하는 무기류군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_SLEEP"
msgid "Goodnight to our foes."
msgstr "적들에게 수면을."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLOWDART_YELLOW"
msgid "A face-to-face fight would be more honorable."
msgstr "서로 마주 보고 싸우는 것이 더 명예로울 텐데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEAMULET"
msgid "Cold jewelery."
msgstr "차가운 보석이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEGEM"
msgid "An icy blue sapphire."
msgstr "얼음 같은 파란 사파이어군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEMOONEYE"
msgid "Odin's eye!"
msgstr "오딘의 눈이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEPRINT.COMMON"
msgid "Oh, a map! No, wait. That's wrong."
msgstr "오, 지도군! 아니, 잘못 봤군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUEPRINT.RARE"
msgid "Tis a blessed scroll."
msgstr "축복받은 두루마리군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_CAP"
msgid "Hmm, a blue one."
msgstr "음, 파란 버섯이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_CAP_COOKED"
msgid "I have no desire to eat it."
msgstr "먹고 싶은 욕구가 없어요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's mold, really."
msgstr "따지자면 일종의 곰팡이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Good, it's hiding."
msgstr "좋아, 숨어 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "I hope it doesn't grow again."
msgstr "다시 자라지 않았으면 좋겠네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARDS"
msgid "Grandfather logs."
msgstr "통나무 할아버지군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARON"
msgid "Tis barely a fight."
msgstr "별로 싸움거리도 안 돼."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOARRIOR"
msgid "You shall be a worthy opponent!"
msgstr "좋은 상대가 되겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT03"
msgid "The ship hath met a valiant end."
msgstr "배가 용맹한 최후를 맞았군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT04"
msgid "The ship hath met a valiant end."
msgstr "배가 용맹한 최후를 맞았군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATFRAGMENT05"
msgid "The ship hath met a valiant end."
msgstr "배가 용맹한 최후를 맞았군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATPATCH"
msgid "If a Viking cares for her vessel, t'will do the same in return."
msgstr "바이킹이 배를 보살피면 배도 보답하기 마련이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATPATCH_KELP"
msgid "It shall hold for now."
msgstr "일단은 버티겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Onward!"
msgstr "전진!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Chart a course for victory!"
msgstr "승리를 향한 항로를 계획해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "You just don't know it yet, but I have won already."
msgstr "넌 아직 모르겠지만, 승리는 이미 내 것이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK"
msgid "Ha! A Viking can maneuver her ship as easily as breathing!"
msgstr "하! 바이킹에게 배를 모는 건 숨 쉬는 것만큼이나 쉽지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Ha! A Viking can maneuver her ship as easily as breathing!"
msgstr "하! 바이킹에게 배를 모는 건 숨 쉬는 것만큼이나 쉽지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "I must cast it into the sea!"
msgstr "이걸 바다로 던져야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "I must cast it into the sea!"
msgstr "이걸 바다로 던져야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "A witness to my impending triumph!"
msgstr "내 다가오는 승리의 증인이로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_START"
msgid "I shall triumph, in the name of the Valkyrie!"
msgstr "발키리의 이름으로 승리하리라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "The location is unimportant. Only know that I will arrive first."
msgstr "위치는 중요하지 않다. 가장 먼저 도착하는 건 나라는 사실만 알아 둬라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "My stores are well defended 'neath the deck of my ship."
msgstr "내 물건들이 배의 갑판 밑에서 안전하게 보호받고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "I shall build a vessel like the tales of old."
msgstr "옛 이야기에 나오는 것 같은 함선을 만들리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "It doth look battleworthy."
msgstr "전투에 적합해 보이는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "It shall shield my vessel from harm."
msgstr "이게 내 배를 지켜줄 거다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_KELP"
msgid "My vessel is well defended."
msgstr "내 배가 잘 보호받고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "It shall shield my vessel from harm."
msgstr "이게 내 배를 지켜줄 거다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "My vessel is well defended."
msgstr "내 배가 잘 보호받고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "It shall shield my vessel from harm."
msgstr "이게 내 배를 지켜줄 거다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "A fearsome defense indeed!"
msgstr "참으로 무시무시한 방어 수단이구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "It shall shield my vessel from harm."
msgstr "이게 내 배를 지켜줄 거다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Ready for battle!"
msgstr "전투 준비 완료!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Load the cannons!"
msgstr "대포를 장전하라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Woe! There is nary a cannonball in sight!"
msgstr "오호통재라! 대포알이 하나도 보이지 않는구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_CANNON_KIT"
msgid "We must be prepared for a battle at sea."
msgstr "해전에 대비해야만 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_GRASS_ITEM"
msgid "'Tis a piteous ship, but I shall make do."
msgstr "형편없기 그지없는 배지만, 어쩔 수 없지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ITEM"
msgid "Ship building is in my bones!"
msgstr "배 건조는 식은 죽 먹기지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_LEAK"
msgid "My vessel hath been wounded!"
msgstr "배가 다쳐 버렸군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "While it navigates, I shall prepare the ship's defenses."
msgstr "이게 항해하는 동안 나는 배의 방어를 준비하리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "It shall be my navigator."
msgstr "널 나의 항해사로 임명하마."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "It shines like the north star, guiding my vessel."
msgstr "북극성처럼 빛나며 내 배를 인도하는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "A beacon to guide my ship."
msgstr "내 배를 인도하는 등대로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I am a warrior, not a tinkerer of machines!"
msgstr "나는 전사지 기계공이 아니야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ROTATOR"
msgid "The most nimble vessel is often the victor in battle."
msgstr "전투에서는 주로 가장 날렵한 함선이 승리하곤 하지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "It shall be done, with haste!"
msgstr "즉시 만들겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It is filled with the hair of the woolen beasties."
msgstr "북실북실한 짐승의 털로 채워져 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_KELP"
msgid "'Tis a pillow from Njoror's domain."
msgstr "뇨르드의 영역에서 난 베개군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_PETALS"
msgid "As good a use as any for flimsy petals."
msgstr "연약한 꽃잎의 좋은 사용처로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Only the strong-willed could sleep on such a thing."
msgstr "오직 강한 의지를 가진 이만이 저걸 베고 잘 수 있으리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOMB_LUNARPLANT"
msgid "I have made the plant's power my own."
msgstr "식물의 힘을 내 것으로 만들었도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Ha! Look how my plant ally's power grows!"
msgstr "하! 내 식물 아군이 강해지는 것을 보아라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESHARD"
msgid "Bits of our enemies."
msgstr "적들의 파편이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESOUP"
msgid "A feast fit for the gods!"
msgstr "신에게 어울리는 성찬이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BONESTEW"
msgid "Delicious!"
msgstr "맛있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOKSTATION.BURNT"
msgid "Villainy! Do not let the elder see!"
msgstr "누가 이런 악독한 짓을! 그 노인이 이 광경을 봐서는 안 된다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOKSTATION.GENERIC"
msgid "A trove of wisdom."
msgstr "지식의 보고로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BEES"
msgid "Our elder has been watching the wee speared creatures closely."
msgstr "그 나이 많은 여자가 침 달린 벌레를 유심히 관찰했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BIRDS"
msgid "To rule the skies!"
msgstr "공중을 지배하기 위하여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_BRIMSTONE"
msgid "This tome is brimming with Hel's fire!"
msgstr "이 책은 헬의 불로 타오르고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_ELEMENTAL"
msgid "'Twas not meant for mortal eyes."
msgstr "산 자가 읽을 수 있는 것이 아니다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FIRE"
msgid "A tome to combat the most fiery tempest!"
msgstr "맹렬한 불길과 맞서 싸울 때 유용하겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FISH"
msgid "Secret tactics for capturing the sea meats!"
msgstr "바다의 고기를 잡는 비결이 담긴 병법서로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_FOSSIL"
msgid "The curse of Alviss dwells within."
msgstr "알비스의 저주가 깃들어 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_GARDENING"
msgid "But can it tend the garden of mine soul?"
msgstr "과연 내 영혼의 정원도 가꿔줄 수 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_HORTICULTURE"
msgid "But can it tend the garden of mine soul?"
msgstr "과연 내 영혼의 정원도 가꿔줄 수 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "The knowledge within shall grant us bountiful harvests."
msgstr "이 책에 담긴 지식이 풍족한 수확을 불러다 주리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_LIGHT"
msgid "A beacon of knowledge."
msgstr "지식의 등대군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "A blinding beacon of knowledge!"
msgstr "눈부신 지식의 등대로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_MOON"
msgid "We call upon the power of Mani!"
msgstr "마니의 힘을 불러낸다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_RAIN"
msgid "It speaks of ways to appease Freyr."
msgstr "프레이를 기쁘게 할 방법이 적혀있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "A tome filled with great wisdom."
msgstr "지혜로 가득한 책이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_SILVICULTURE"
msgid "A tome of the ways of the forest!"
msgstr "숲의 길에 대한 서적이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_SLEEP"
msgid "Where's the drama? The suspense?"
msgstr "뭐가 극적이지? 서스펜스가 어디에 있다는 거야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_TEMPERATURE"
msgid "I need only the heat of battle!"
msgstr "내게 필요한 건 전투의 열기 뿐이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_TENTACLES"
msgid "Knowledge grants great power!"
msgstr "지식은 곧 큰 힘이지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOK_WEB"
msgid "Sometimes we may learn from the enemy."
msgstr "가끔은 적으로부터 배울 수 있는 법이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOMERANG"
msgid "For flinging at foes!"
msgstr "적에게 던지는 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BOOTLEG"
msgid "Retreat is the way of cowards!"
msgstr "후퇴는 겁쟁이를 위한 것!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BROKEN_FORGEDITEM"
msgid "'Tis battered, but not lost!"
msgstr "많이 낡았지만, 아직 가망이 있도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BRUSH"
msgid "Time for hair and makeup!"
msgstr "머리 정리하고 단장할 시간!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUGNET"
msgid "To snatch insects from the air."
msgstr "날아다니는 곤충을 잡는 도구."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Ah! The sea hath sent its foul veggies!"
msgstr "아! 바다가 역겨운 채소를 보냈군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "It is defeated."
msgstr "쓰러졌다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BULLKELP_ROOT"
msgid "I'll turn the sea's dark forces against it!"
msgstr "바다의 사악한 힘으로 쓰러지게 해 주마!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNDLE"
msgid "Ready to take on an epic saga."
msgstr "전설이 될 여정을 시작할 준비가 되었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNDLEWRAP"
msgid "That's a wrap."
msgstr "잘 싸였네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNNYMAN"
msgid "I want to eat you."
msgstr "먹고 싶다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUNNYSTEW"
msgid "A hearty meal worthy of praise!"
msgstr "든든한 한 끼는 칭찬할 만 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Razed to the ground."
msgstr "완전히 타버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUSHHAT"
msgid "For the hunt."
msgstr "사냥을 위한 것."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTER"
msgid "Butter. Might it be good on steak?"
msgstr "버터군. 스테이크에 바르면 좋을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It is sort of nice."
msgstr "보기 좋은 듯."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLY.HELD"
msgid "Caught!"
msgstr "잡았다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Muffin, smuffin."
msgstr "머핀, 머핀이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUTTERFLYWINGS"
msgid "A pretty souvenir."
msgstr "예쁜 기념품이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.BUZZARD"
msgid "You and I, we meat feast together."
msgstr "나랑 같이 고기 잔치를 벌이자."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CABBAGEROLLS"
msgid "Begone foul cabbage, I shall feast on the meat within."
msgstr "안에 있는 고기만 먹을 테니 꺼져라, 사악한 양배추야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS.GENERIC"
msgid "It does have admirable armor."
msgstr "매우 훌륭한 갑옷을 둘렀군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS.PICKED"
msgid "It will return."
msgstr "다시 자랄 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_FLOWER"
msgid "Beauty from brawn."
msgstr "강자의 아름다움이군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_MEAT"
msgid "Sword plant meat."
msgstr "검 식물 고기로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Toasted sword plant meat."
msgstr "구운 검 식물 고기로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CALIFORNIAROLL"
msgid "That's just a morsel of fish food."
msgstr "한입거리의 물고기밥."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.EMBERS"
msgid "That fire's nearly dead."
msgstr "불이 거의 죽었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Warm fire, warm Wigfrid."
msgstr "불이 따뜻하니 위그프리드도 따뜻해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.HIGH"
msgid "The fire roars!"
msgstr "불이 타오르고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.LOW"
msgid "Fire's slowly dying."
msgstr "불이 서서히 죽어가는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Warm fire, warm Wigfrid."
msgstr "불이 따뜻하니 위그프리드도 따뜻해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAMPFIRE.OUT"
msgid "And the light flickers out."
msgstr "빛이 깜박이더니 꺼져버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY.GENERIC"
msgid "Oh sweet songbird, sing me thy tune!"
msgstr "사랑스러운 새야, 내게 노래를 들려주렴!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY.HELD"
msgid "Freedom has been wrenched from thy grasp by mine own."
msgstr "네 자유를 내 손이 앗아갔구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANARY_POISONED"
msgid "What plague has besieged this innocent woodland creature?"
msgstr "어떤 역병이 이 순수한 숲의 동물을 해친 거지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANDYBAG"
msgid "That we might carry our sweetest plunders!"
msgstr "달콤한 전리품을 휴대할 수 있게 해주지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANE"
msgid "Turns \"walk\" to \"trot\"."
msgstr "좀 더 빨리 걷게 해주지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Woe to any fool who doth attack my ship!"
msgstr "내 배를 공격하는 멍청이들에게 절망을!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "'Tis sadly not a weapon, but I enjoy it nonetheless."
msgstr "슬프게도 무기는 아니지만 그래도 즐겨."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Be this a weapon of sorts?"
msgstr "이것은 일종의 무기인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALCANNON_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Alas, 'tis naught but fool's gold."
msgstr "아, 헛된 금덩어리에 불과하도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "It shall be done at once."
msgstr "한 번에 해내야 해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "How cruel to be tormented by the sight of eggs I cannot eat!"
msgstr "내가 먹을 수 없는 달걀을 보고 괴로워하는 건 너무 잔인하잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "It shall be done at once."
msgstr "한 번에 해내야 해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "A wooden idol to remind me of this day!"
msgstr "오늘을 떠올리게 할 나무돌!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "I shall treasure it always."
msgstr "항상 소중히 간직할거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "A good luck charm from the ravens!"
msgstr "까마귀의 행운을 부르는 부적이야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "A box of mystery."
msgstr "수수께끼의 상자다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "A box of mystery."
msgstr "수수께끼의 상자다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It hath a feeling of magic about it."
msgstr "마력을 느끼고 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "It shall be done at once."
msgstr "한 번에 해내야 해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "What use is a tree of such small stature?"
msgstr "키 작은 나무가 무슨 소용이 있겠어?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "It shall be done at once."
msgstr "한 번에 해내야 해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Nay."
msgstr "아니야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "A meal fit for wooden birds."
msgstr "나무새에게 어울리는 식사네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "The home of the wood-hewn birds."
msgstr "나무를 깎아 만든 새들의 집이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "A test of reflexes!"
msgstr "반사신경 테스트다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Try to flee all you want, you will not escape me!"
msgstr "하고 싶은 대로 얼마든지 탈출을 시도해 보렴, 넌 나를 피할 수 없을 걸!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "A test of speed and stamina!"
msgstr "속도와 체력을 테스트하네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "The home of the wood-hewn eggs."
msgstr "나무로 만든 알의 고향."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Aha! It must be this one!"
msgstr "알겠다! 확실하게 이거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "A test of one's mental prowess!"
msgstr "지적 능력 테스트야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "The little ball must be possessed by some mischievous spirit."
msgstr "이 작은 공이 짓궂은 영혼에 씐 게 분명해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Fire at will!"
msgstr "사격 개시!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "A test of marksmanship!"
msgstr "사격술 시험이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "'Tis not a door for a warrior of my size."
msgstr "나 같은 전사에게 이런 건 식은 죽 먹기지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Prepare to be slain!"
msgstr "죽음을 맞이해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "It will be built with utmost speed."
msgstr "가장 빠른 속도로 지어지겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It requires a token to prove my worthiness."
msgstr "내 가치를 증명하려면 토큰이 필요해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "All of the spoils without the challenge."
msgstr "땀 한 방울 안 흘리고 전리품을 얻을 수 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_BALL"
msgid "This may be useful for testing my companions' reflexes."
msgstr "동료의 반사 신경을 테스트하는 데 유용할 수 있겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_CROWKID"
msgid "Noble ravens! How fare thee?"
msgstr "고귀한 까마귀여! 안녕한지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "A gleaming token of friendship."
msgstr "빛나는 우정의 토큰이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_HOST"
msgid "He must be the leader of the ravens."
msgstr "까마귀의 지도자가 틀림없어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Methinks these grounds are in need of adornment."
msgstr "이러한 땅에는 장식이 필요하다고 생각한다오."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Make haste! The great Tree demands offerings of decorations!"
msgstr "서둘러! 위대한 나무가 제물을 장식으로 요구했다고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "A glorious sight to behold."
msgstr "영예로운 광경이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Perhaps it will grow as tall as Yggdrasil."
msgstr "아마도 위그드라실만큼 키가 크겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "To the victor go the spoils!"
msgstr "승자는 전리품을 가지겠지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I must construct it before my efforts can be rewarded."
msgstr "이걸 지어야 내 노력을 보상 받을 수 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I am rewarded for completing the test of skill."
msgstr "기술 시험을 마치면 보상을 받겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "A great pile indeed!"
msgstr "더미가 정말 크다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "The ravens recognize my unrivaled skill."
msgstr "까마귀가 나의 비할 데 없는 기술을 알아보는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "'Tis food for birds, not Vikings."
msgstr "바이킹이 아니라 새에게 주는 음식이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_A"
msgid "Blood red, to strike fear into the hearts of our enemies!"
msgstr "피처럼 붉다, 적의 마음에 공포를 심어주자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_B"
msgid "'Tis not unlike the garb of a forest nymph."
msgstr "숲의 요정의 복장과 별반 다르지 않네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARNIVAL_VEST_C"
msgid "'Tis a tree pelt."
msgstr "나무 껍질이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "A shame it is not a weapon."
msgstr "무기가 아닌 게 안타깝구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "It seems my training hath come to an abrupt end."
msgstr "내 훈련이 갑작스러운 끝을 맞이했구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "A carpenter's saw is merely another blade for me to master!"
msgstr "내게 목공의 톱은 익혀야 할 또 하나의 칼날에 불과하다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.DEAD"
msgid "It has breathed its last."
msgstr "마지막 숨을 거두었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.GENERIC"
msgid "Vegetables are not to be trusted!"
msgstr "채소는 믿을 수 없다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.HELD"
msgid "I have you now, wicked vegetable."
msgstr "잡았다, 사악한 채소 같으니."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT.SLEEPING"
msgid "A deceptive vegetable with no honor."
msgstr "염치라곤 없는 기만적인 채소군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARRAT_GHOSTRACER"
msgid "This shadowy creature seeks to challenge me."
msgstr "이 그림자 같은 존재가 내게 도전하려고 하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT"
msgid "Where's the protein?"
msgstr "단백질은 어디에?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_COOKED"
msgid "Sad cooked carrots."
msgstr "초라한 익힌 당근."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_OVERSIZED"
msgid "If only you were meat..."
msgstr "이게 고기였다면..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_PLANTED"
msgid "A wee root vegetable."
msgstr "작은 뿌리 채소로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARROT_SEEDS"
msgid "Tiny nature bits."
msgstr "자연의 작은 조각이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Alas! My hunting excursions will go unregaled!"
msgstr "아아! 내 파란만장한 사냥을 기록할 수 없게 되었다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "I've no choice but to act out my directions now."
msgstr "이젠 그냥 마음 가는 대로 방향을 정해 다닐 수밖에."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "What legends might I find within these maps?"
msgstr "과연 이 지도에선 어떤 전설을 발견할 수 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOON"
msgid "Oh! Cute meat with fur."
msgstr "아! 털 달린 귀여운 고기군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONDEN.EMPTY"
msgid "She fought bravely. Alas, she is gone."
msgstr "용맹하게 싸우고는 가버렸노라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Cute meat lives there."
msgstr "귀여운 고기가 사는 곳."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATCOONHAT"
msgid "A furry cap! Blessings to you, cute meat."
msgstr "털난 모자군요! 고마워요, 귀여운 고기."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CATTOY_MOUSE"
msgid "T'would make for excellent target practice!"
msgstr "이건 사냥 연습용으로 아주 좋을 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "A feat of strength in the making."
msgstr "내 힘을 보여줄 때가 되었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I will clear the way!"
msgstr "내가 길을 뚫겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA"
msgid "Monkey food."
msgstr "원숭이 음식이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Thoroughly vanquished."
msgstr "완전히 사라졌군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Warmed monkey food."
msgstr "따뜻하게 만든 원숭이 음식이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_BANANA_TREE"
msgid "A flimsy monkey tree."
msgstr "부실한 원숭이 나무군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE"
msgid "What treasures lie beneath?"
msgstr "이 안에는 어떤 보물이 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "It's more packed than the Thingvellir!"
msgstr "팅크베틀리르보다 더 소란스럽네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I've no desire to visit Hel today."
msgstr "아직 헬을 뵙고 싶진 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "To the underworld!"
msgstr "지하 세계로 가자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "What treasures lie beneath?"
msgstr "이 안에는 어떤 보물이 있을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.FULL"
msgid "There are too many people up there."
msgstr "밖에 사람이 너무 많군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I've had enough of Sol's shining face for one day."
msgstr "오늘은 솔의 빛나는 얼굴을 충분히 본 것 같아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Back to open skies!"
msgstr "푸른 하늘을 다시 보게 되겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CAVE_FERN"
msgid "Foliage from the dark ages."
msgstr "암흑시대의 식물이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CEVICHE"
msgid "Fancy for my taste, but it'll do."
msgstr "내 입맛에는 안 어울리게 고급이지만, 어쩔 수 없지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARCOAL"
msgid "Loot from Loge, the demigod."
msgstr "반신반인 로게의 전리품이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_HAND"
msgid "It seeks an offering."
msgstr "제물을 원하는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_HECKLER"
msgid "Begone, critics!"
msgstr "꺼져라, 비평가 놈들아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_LECTURN"
msgid "This play is in need of actors."
msgstr "이 연극에 배우가 필요하군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_NPC"
msgid "At last, you reveal yourself!"
msgstr "드디어 모습을 드러냈구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The stage beckons!"
msgstr "무대가 부른다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK1"
msgid "It's only a pile of fallen warriors."
msgstr "쓰러진 전사들의 더미일 뿐."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK2"
msgid "More fallen mechanical warriors."
msgstr "쓰러진 기계 전사들의 더미가 더 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSJUNK3"
msgid "Someone should really clean this place up."
msgstr "이곳 청소가 좀 필요한걸."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "'Twas made in honor of our stalwart vessel!"
msgstr "우리 듬직한 배를 기념하여 만든 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ANTLION"
msgid "The artist hath captured her noble mane perfectly."
msgstr "웅장한 갈기를 완벽히 표현했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEARGER"
msgid "'Twas a battle to sing of."
msgstr "노래로 남길 만한 전투였지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "May the beast now be at peace."
msgstr "저 짐승이 이제 안식에 들기를."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "A stone tribute to my faithful steed."
msgstr "충성심있는 말에게 바치는 돌로 된 찬사네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "I honor this warrior queen!"
msgstr "나는 전사 여왕에게 경의를 표한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "This warrior does battle in the mind."
msgstr "이 전사는 정신의 전투를 하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Battle is nigh!"
msgstr "결전이 다가왔다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "To celebrate the moon's messenger!"
msgstr "달의 전령을 기리기 위한 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CARRAT"
msgid "I'm not keen on honoring a vegetable so."
msgstr "채소에는 딱히 경의를 표하고 싶지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CATCOON"
msgid "You have my respect, fellow hunter."
msgstr "존경을 표해요, 동료 사냥꾼님."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A hound of the hunt!"
msgstr "사냥을 위한 개로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "A testament to a worthy foe."
msgstr "상대할 만한 적수로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_CRABKING"
msgid "'Twas a hard-fought battle, but we prevailed!"
msgstr "힘든 싸움이었지만 결국 우리가 승리했지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "The beast proved himself to be a worthy adversary!"
msgstr "그 야수가 자신이 걸맞은 적수임을 증명했구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "I have fond memories of dueling this beast."
msgstr "이 짐승과의 결투는 좋은 추억으로 남았지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "Our fight shall be made ballad."
msgstr "우리의 싸움은 발라드로 전해질 것이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "'Twas an unnatural thing. Slaying it was a kindness."
msgstr "자연의 섭리를 거스르는 존재이니, 죽음이 곧 자비였도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "I do relish thy slaying, worm."
msgstr "널 죽이는 것은 참으로 즐겁다, 벌레여."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Tis the trophy of glorious battle!"
msgstr "영광스러운 전투의 트로피로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "I shall feast my eyes upon this trophy!"
msgstr "난 이 트로피만 바라볼 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Not a man fit for battle."
msgstr "전투를 할 수 있는 자가 아니군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "You fought well, Champion of Mani."
msgstr "잘 싸웠어, 마니의 챔피언."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "Feasts, feasts, everywhere, and not a ham to eat."
msgstr "사방에 화려한 조각이 많은데 먹을 건 햄 한 조각도 없군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KITCOON"
msgid "A mighty pillar for a mighty family!"
msgstr "훌륭한 가족을 위한 훌륭한 버팀목이지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A tribute to the festive warrior spirit."
msgstr "축제를 즐기는 전사의 정신에 대한 헌정이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "The figure of a fellow warrior!"
msgstr "전사의 모습을 조각한 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Battle is nigh!"
msgstr "결전이 다가왔다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "To honor our victory at sea!"
msgstr "바다에서 거둔 승리를 기념하는 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Their weapons were strange, but they possessed a warrior's spirit."
msgstr "저들이 가진 무기는 기묘하나, 저들에게는 전사의 영혼이 깃들어 있도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "The beast guarded its treasure well, but not well enough."
msgstr "보물을 지키던 짐승이다. 그다지 잘 지키지는 못했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MOON"
msgid "Offered in honor of our beauteous moon!"
msgstr "아름다운 달에 경의를 표하며 바친 것이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "'Twas an honor to fight thee."
msgstr "당신과의 전투는 영광이었어요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_MUSE"
msgid "A Valkyrie's spirit dwells within."
msgstr "발키리의 혼이 안에 살고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_PAWN"
msgid "Tis a noble foot soldier."
msgstr "귀중한 보병이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_PIPE"
msgid "Tis but a jest."
msgstr "장난인가."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "A castle fit for a queen."
msgstr "여왕에게 어울리는 성이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Battle is nigh!"
msgstr "결전이 다가왔다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Until we meet again, bait-breathed warrior."
msgstr "다음에 또 만나자, 입에서 미끼 냄새가 나는 전사여."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_STALKER"
msgid "A hard stone monument to a hard fought battle."
msgstr "치열한 전투에 바치는 단단한 기념비다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "An honorable yet odious creature!"
msgstr "명예롭고도 역겨운 생물체다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "A battle I shan't soon forget."
msgstr "금방 잊지는 못할 전투야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "'Twas no match for my spear."
msgstr "내 창에 비하면 아무것도 아니었다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "I shall never forget this hungry cave serpent."
msgstr "이 굶주린 동굴 뱀을 죽인 걸 평생 기억하리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_YOTD"
msgid "A monument to my triumph."
msgstr "내 승리에 대한 기념비로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESSPIECE_YOTS"
msgid "I do relish thy slaying, worm."
msgstr "널 죽이는 것은 참으로 즐겁다, 벌레여."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER"
msgid "Don't worry, I won't eat him."
msgstr "걱정할 것 없어. 먹진 않을 테니."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Who are you?"
msgstr "누구냐?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "The eyeball is tired."
msgstr "눈알이 피곤해하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Be this science or witchcraft?"
msgstr "이건 과학인가? 아니면 마술인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "It contained not a mystery, but a curse!"
msgstr "수수께끼가 아니라 저주가 들어있었구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CHUM"
msgid "A banquet for the sea beasties!"
msgstr "바다짐승의 만찬이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I shall fell you swiftly!"
msgstr "재빨리 처단해주마!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYHOUND.STATUE"
msgid "Tis a terrible wolf, turned to stone."
msgstr "끔찍한 늑대가 돌이 되었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYWARG.GENERIC"
msgid "Lo! What terrible beast!"
msgstr "오호라! 끔찍한 짐승이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CLAYWARG.STATUE"
msgid "T'would be a glorious battle, were it alive."
msgstr "살아있었으면 굉장한 전투를 치렀을 텐데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.EMBERS"
msgid "That fire's nearly dead."
msgstr "불이 거의 죽었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.GENERIC"
msgid "A cold comfort."
msgstr "시원한 안락함을 주는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.HIGH"
msgid "The fire roars!"
msgstr "불이 타오르고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.LOW"
msgid "Fire's slowly dying."
msgstr "불이 서서히 죽어가는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.NORMAL"
msgid "A cold comfort."
msgstr "시원한 안락함을 주는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIRE.OUT"
msgid "And the light flickers out."
msgstr "빛이 깜박이더니 꺼져버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "That fire's nearly dead."
msgstr "불이 거의 죽었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A cold comfort."
msgstr "시원한 안락함을 주는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.HIGH"
msgid "The fire roars!"
msgstr "불이 타오르고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.LOW"
msgid "Fire's slowly dying."
msgstr "불이 서서히 죽어가는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "A cold comfort."
msgstr "시원한 안락함을 주는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLDFIREPIT.OUT"
msgid "And the light flickers out."
msgstr "빛이 깜박이더니 꺼져버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COLLAPSEDCHEST"
msgid "Who hath rendered a shambles of our booty?"
msgstr "누가 우리 보물을 난장판으로 만든 거냐?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "동."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.GENERIC"
msgid "A reading cannot be gleaned."
msgstr "판독할 수 없군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "북."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "북동."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "북서."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "남."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "남동."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "남서."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "서."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOST"
msgid "'Tis naught but food for worms."
msgstr "이건 벌레나 먹는 거지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "That shall do."
msgstr "그럴 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Reduced to ash."
msgstr "재가 되었네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "It's so dry it's nearly dust."
msgstr "너무 건조해서 거의 먼지네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "A barrel of stink."
msgstr "악취나는 오크통이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTINGBIN.WET"
msgid "Soggy muck."
msgstr "눅진거리는 똥이야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COMPOSTWRAP"
msgid "I question my ally's tastes."
msgstr "동료의 미각이 의심스럽군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Portal! Prepare to be built!"
msgstr "포털! 만들어질 각오를 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKBOOK"
msgid "'Tis filled with too many non-meat dishes if you ask me."
msgstr "고기가 안 들어간 요리가 너무 많다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMANDRAKE"
msgid "She's definitely dead."
msgstr "확실히 죽었다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMEAT"
msgid "Meeeat!"
msgstr "고오오오기이이이!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Monster beast steak."
msgstr "괴물 짐승 스테이크."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKEDSMALLMEAT"
msgid "Yum, yum, meat snacks."
msgstr "냠냠, 고기 간식이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTER"
msgid "It seeks to make a meal of my vessel!"
msgstr "내 배를 먹으려고 하잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTERHAT"
msgid "Tis a helm fit for a warrior of the deep."
msgstr "심해의 전사에게 어울리는 투구군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKIECUTTERSHELL"
msgid "'Twas a spiky foe."
msgstr "뾰족한 적이었지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "'Tis but a jumbled mess of words."
msgstr "횡설수설일 뿐이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.BURNT"
msgid "The fire reigned supreme."
msgstr "불이 압승했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Might as well do something whilst I wait."
msgstr "기다리는 동안 뭐라도 하는 게 좋겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Shouldn't be long now!"
msgstr "이제 금방 다 될 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.DONE"
msgid "What have we here?"
msgstr "과연, 어떻게 됐지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COOKPOT.EMPTY"
msgid "Nothing in there."
msgstr "안이 텅 비었다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COONTAIL"
msgid "It is the tail of cute meat."
msgstr "귀여운 고기의 꼬리다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN"
msgid "A vegetable sword!"
msgstr "채소 검이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_COOKED"
msgid "Popped corn smells good."
msgstr "뻥튀기한 옥수수는 냄새가 좋군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_OVERSIZED"
msgid "Sadly, it is not meat."
msgstr "안타깝게도 고기가 아니구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CORN_SEEDS"
msgid "Tiny nature bits."
msgstr "자연의 작은 조각이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_DOLL_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_FOOL_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_KING_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COSTUME_TREE_BODY"
msgid "I have my own costu- that is, warrior's garb!"
msgstr "내게는 이미 의상... 아니, 전사의 옷이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "The flame must be lit!"
msgstr "불을 붙여야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "An altar to a wee fluffy beastie."
msgstr "작고 복슬복슬한 짐승을 기리는 제단이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "The flame must be lit!"
msgstr "불을 붙여야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "The beastie's power grows."
msgstr "짐승이 점점 강해지는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "The flame must be lit!"
msgstr "불을 붙여야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Hail to the golden beast!"
msgstr "황금 짐승을 찬양하라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COTL_TRINKET"
msgid "A crown of ill omen."
msgstr "불길한 징조의 왕관이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.COZY_BUNNYMAN"
msgid "I am not fooled by their cozy exterior."
msgstr "나는 저 포근한 겉모습에 속지 않는다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING.GENERIC"
msgid "Have at thee, cursed crustacean!"
msgstr "각오해라, 저주받은 갑각류야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING.INERT"
msgid "A barren, sandy fortress."
msgstr "황량한 모래투성이 요새군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Now THIS is a battle."
msgstr "이 정도는 되어야 전투라 할 수 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_CLAW"
msgid "Prepare thyself to be de-clawed!"
msgstr "집게발이 뽑힐 준비나 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_ICEWALL"
msgid "Oh good. I worried it would be too easy."
msgstr "잘됐군. 너무 시시할까 봐 걱정했는데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_MOB"
msgid "Appetizer."
msgstr "이 정도는 몸풀기다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Finally. A clawed combatant worthy to die by my spear."
msgstr "드디어 내 창으로 죽일 만한 집게 전사군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTERLAB"
msgid "Tis a peculiar boulder."
msgstr "이상한 돌이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_DRAGONLING"
msgid "By the unicorn! A dragon!"
msgstr "일각수 맙소사! 용이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "They shall watch and learn from my battles!"
msgstr "내 전투를 보고 배워야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_GLOMLING"
msgid "A warrior's faithful companion!"
msgstr "전사의 믿음직한 동료!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_KITTEN"
msgid "She is a magnificent hunter!"
msgstr "훌륭한 사냥꾼이지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LAMB"
msgid "I wouldst turn farmer for thee."
msgstr "너를 위해서라면 난 농부가 되어도 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Mine lunar friend!"
msgstr "달 친구다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PERDLING"
msgid "Not a raven, but wise nonetheless."
msgstr "까마귀만큼은 아니지만, 영리한 새지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRITTER_PUPPY"
msgid "I shall defend this hound to the death."
msgstr "이 사냥개는 내 목숨을 바쳐서라도 지켜야지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.GENERIC"
msgid "Raven friend!"
msgstr "까마귀 친구!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CROW.HELD"
msgid "Together again."
msgstr "다시 함께하게 되었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CRUMBS"
msgid "Telltale spoor left by a festive foe."
msgstr "축제를 즐긴 적이 숨기지 못하고 남긴 자취군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Plunder!"
msgstr "약탈이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTGRASS"
msgid "A craftwoman's most elemental resource."
msgstr "수공업자의 가장 기본적인 재료지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLESS"
msgid "'Tis hardly a sword at all."
msgstr "검이라고 부르기도 민망하군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTLICHEN"
msgid "Even if I ate plants, I wouldn't eat THAT plant."
msgstr "내가 다른 식물은 먹어도 이건 절대 안 먹는다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTREEDS"
msgid "I cleaned all the bugs out! Then I ate them."
msgstr "벌레를 다 치웠지요! 그리고 제가 먹었지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.CUTSTONE"
msgid "Solid stone!"
msgstr "단단한 돌이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER.GENERIC"
msgid "You leave me no choice, beast! To arms!"
msgstr "내게 선택의 여지를 주지 않는구나, 짐승이여! 전투 준비!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "The beast hath been consumed by foul magic."
msgstr "저 짐승은 추악한 마법에 삼켜졌구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.BURIED"
msgid "It pains me to see a worthy adversary in such a state."
msgstr "강한 적수가 이런 꼴이 된 걸 보니 가슴이 아프군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.GENERIC"
msgid "The calm before the storm."
msgstr "폭풍전야로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Finally. Let us fight."
msgstr "드디어. 그럼 어디 싸워 보자."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Only something of great might could crack that foul stone."
msgstr "저 추악한 돌을 깨뜨리려면 막강한 힘이 깃든 도구가 필요하노라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "The pillar is weakened... mayhaps it could be broken."
msgstr "기둥이 약해졌구나... 부술 수 있을지도 모르겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEADLYFEAST"
msgid "A most potent dish."
msgstr "가장 강력한 요리다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEAD_SEA_BONES"
msgid "Njord's depths hold many secrets."
msgstr "뇨르드의 심해에는 많은 비밀이 잠들어 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "The wood's ablaze!"
msgstr "나무가 불타고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Loge took that one."
msgstr "로게께서 데려가셨군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "숲의 전사가 베었군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Future firewood!"
msgstr "미래의 땔나무로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "This firewood will take a bit of extra work."
msgstr "좀 더 성가시게 구는 땔나무로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECK_OF_CARDS"
msgid "Dost these cards bear a fell curse?"
msgstr "이 카드에 사악한 저주가 걸린 건가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_CENTERPIECE"
msgid "Pretty... useless."
msgstr "아주... 쓸데없구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Empty. Shall we use it for target practice?"
msgstr "비어 있구나. 사격 연습에 쓰면 어떨까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It burns bright."
msgstr "밝게 타오르는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Saveth them for my funeral."
msgstr "내 장례식을 위해 남겨두어라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "The light wanes."
msgstr "빛이 어두워지는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Beauty fades. Glory is forever."
msgstr "아름다움은 사라지지만, 영광은 영원하다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_LAMP"
msgid "A warrior hath no need for light!"
msgstr "전사에게 빛은 필요 없다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "The work of a child, no doubt."
msgstr "어린 아이의 작품이 틀림없군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "I shall paint it with the blood of mine enemies."
msgstr "적들의 피로 그림을 그리리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "A fallen comrade?"
msgstr "쓰러진 전우인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.ANTLER"
msgid "Skadi has bestowed a gift on Freya's creature."
msgstr "스카디께서 프레이야의 짐승에게 선물을 주셨군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER.GENERIC"
msgid "The beauty of Freya dwells in all creatures!"
msgstr "프레이야의 아름다움은 모든 생물 안에 깃들어있지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS"
msgid "Rays will shine through my spear and poke out your eyeball!"
msgstr "내 창에서 나온 광채가 네 눈알을 뽑아낼 것이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "May thine spirit be released to Valhalla."
msgstr "그대의 영혼이 발할라로 풀려나기를."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "It fought bravely."
msgstr "저 짐승은 용감하게 싸웠노라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "What's this? The fight is not over!"
msgstr "어떻게 된 거지? 싸움이 아직 끝나지 않았군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "The cold doth sooth me."
msgstr "추위는 내 마음을 편하게 해주지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Where art thou, cursed eye?"
msgstr "어디 있는 거냐, 저주받은 눈이여?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Fear not the heat, I shall build this posthaste."
msgstr "어서 만들 테니, 열기를 두려워하지 마라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Delicious! I should like to share it with my new allies."
msgstr "맛있군요! 새 아군과 함께 먹어야겠어요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_ANTLER"
msgid "The unicorn's horn, in the flesh!"
msgstr "일각수의 뿔을 실제로 보게 되다니!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEER_GEMMED"
msgid "Tis a magical woodland creature!"
msgstr "마법스러운 숲의 동물이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's probably a tuft of grass."
msgstr "풀 덤불인 것 같잖아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DESERTHAT"
msgid "Tis no helm."
msgstr "이건 투구라고 부를 수 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL"
msgid "It smells of bacon!"
msgstr "베이컨 냄새가 난다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DEVTOOL_NODEV"
msgid "I'm not strong enough to wield it."
msgstr "이것을 사용할 정도로 강하지 않다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIRTPILE"
msgid "A small hill of earth."
msgstr "흙으로 된 작은 고개로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.COLD"
msgid "All is quiet."
msgstr "아주 잠잠하다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.GENERIC"
msgid "A mechanical hunting hound. For the hunt."
msgstr "기계 사냥개로군. 사냥에 쓰이는."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.HOT"
msgid "Sound the horns! We've arrived!"
msgstr "뿔나팔을 부세요! 저희가 도착했습니다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARM"
msgid "We've got the scent!"
msgstr "냄새를 맡았다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGROD.WARMER"
msgid "The hound is excited. We're getting close."
msgstr "개가 흥분했군. 가까워지고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "What cryptic ruins."
msgstr "참으로 의아한 폐허로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.READY"
msgid "Seems it's missing a piece..."
msgstr "뭔가 빠진 것 같은데..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ready! The saga continues!"
msgstr "준비하지요! 사가는 계속 흐르지요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DIVININGRODSTART"
msgid "This mysterious sword feels important."
msgstr "뭔가 중요하게 느껴지는 신비로운 검이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOCK_KIT"
msgid "I shall make a harbor worthy of my vessel."
msgstr "내 배에 걸맞은 항구를 만들리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "'Tis little more than set-dressing."
msgstr "무대 소품이나 다를 바 없군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DOLL_BLUEPRINT"
msgid "Who would wear this into battle?"
msgstr "누가 이런 걸 입고 전투에 참가하겠어?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBOAT_KIT"
msgid "Let us construct the most formidable vessel these cursed waters have ever touched."
msgstr "지금껏 이 저주받은 물에 닿은 가장 막강한 배를 만들자."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBOAT_PACK"
msgid "It posesses all that a mighty vessel might require."
msgstr "막강한 배에 필요한 점을 모두 갖추고 있구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONBODYHAT"
msgid "It's the beast's back."
msgstr "짐승의 등이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONCHILISALAD"
msgid "Yeuch! I was promised a feast!"
msgstr "윽! 분명히 성찬이라고 했는데!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLY"
msgid "Ah, dragon! At last we meet!"
msgstr "아, 용이군요! 결국 만났군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "This chest is worthy of my weapons."
msgstr "이 궤짝이라면 내 무기를 보관해도 되겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "This chest is worthy of my weapons, and then some."
msgstr "이 궤짝이라면 내 무기와 다른 물건들을 보관해도 되겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "It retains the heat of the fallen beast."
msgstr "쓰러진 짐승의 열기를 간직하고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It has seen much battle."
msgstr "많은 전투를 겪었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Its belly is alight with fearsome dragonfire."
msgstr "뱃속에 무시무시한 용의 화염이 들어있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "A small inferno burns within."
msgstr "작은 지옥불이 안에서 타고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT"
msgid "It's very fancy."
msgstr "아주 고급스럽군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Grilled fancy fruit."
msgstr "구운 고급 과일이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Alas, you are fruit, not meat."
msgstr "아아, 너는 고기가 아니라 과일이구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Tiny nature bits."
msgstr "자연의 작은 조각이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONHEADHAT"
msgid "The head of a great and merciful beast!"
msgstr "위대하고 자비로운 짐승의 머리로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONPIE"
msgid "Why isn't this a meat pie? Meat, meeeat!"
msgstr "왜 이것이 고기 파이가 아니지요? 고기, 고기군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGONTAILHAT"
msgid "A beast is no beast without a tail."
msgstr "꼬리가 없다면 짐승이 아니겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRAGON_SCALES"
msgid "Mystical scales."
msgstr "신비한 비늘이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE"
msgid "A stone of ill omen."
msgstr "불길한 돌이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONEHAT"
msgid "Ready to bear the brunt of battle!"
msgstr "선봉을 맡을 준비 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DREADSTONE_STACK"
msgid "It hails from a place deeper and darker than even here."
msgstr "이곳보다도 더 깊고 어두운 곳에서 온 물건이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_LOG"
msgid "'Tis wood, forged in the sea's depths!"
msgstr "심해에서 만들어진 나무군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Tis consumed by flame!"
msgstr "화염이 집어삼켰다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Consumed by Hel's flames."
msgstr "헬의 화염이 삼켜 버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Thank you for your bounty, tree."
msgstr "선물 고맙다, 나무야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "A rare beauty to be sure, but tis no Yggdrasil."
msgstr "위그드라실보다는 못하지만, 그래도 보기 드물게 아름다운 나무군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK"
msgid "Leg of beastie."
msgstr "짐승의 다리로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DRUMSTICK_COOKED"
msgid "Hooooot meat!"
msgstr "만세, 고기다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BANANABUSH"
msgid "I hath no use for a plant burgeoning with foul non-meats."
msgstr "고기가 아닌 게 열리는 식물 따위는 필요 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH"
msgid "I should like to see that returned to the earth goddess."
msgstr "대지의 여신께 돌려드려야겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I should like to see that returned to the earth goddess."
msgstr "대지의 여신께 돌려드려야겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_GRASS"
msgid "I should like to see that returned to the earth goddess."
msgstr "대지의 여신께 돌려드려야겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MARSH_BUSH"
msgid "I should like to see that returned to the earth goddess."
msgstr "대지의 여신께 돌려드려야겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_MONKEYTAIL"
msgid "Art thou plants or monkey parts? Make up thine mind!"
msgstr "너는 식물이냐? 아니면 원숭이의 일부냐? 둘 중 하나만 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_SAPLING"
msgid "I should like to see that returned to the earth goddess."
msgstr "대지의 여신께 돌려드려야겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUG_TRAP_STARFISH"
msgid "A most wicked trap I could set for my foes."
msgstr "적에 대비해 설치할 수 있는 가장 악랄한 덫이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL"
msgid "'Tis not just strength, but cunning that makes a warrior!"
msgstr "전사를 만드는 건 비단 힘뿐이 아니라 기교라고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "My ally wields a strange weapon, indeed."
msgstr "내 아군이 참으로 이상한 무기를 휘두르는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_GEM"
msgid "My friend, if you want to be fighting fit you must join me in combat!"
msgstr "친구, 제대로 붙고 싶다면 나와 함께 전투에 참여해야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_GOLDEN"
msgid "He hath strength, next we must work on his bravery!"
msgstr "힘은 있으니까 다음으로 용기를 키워야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_HEAT"
msgid "Training in comfort."
msgstr "안락하게 훈련할 수 있겠구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_MARBLE"
msgid "Train well my friend, and join me in glorious battle!"
msgstr "열심히 훈련해서 영광스러운 전투에 함께 하자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUMBBELL_REDGEM"
msgid "My ally wields a strange weapon, indeed."
msgstr "내 아군이 참으로 이상한 무기를 휘두르는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN"
msgid "Smells like my battle boots."
msgstr "내 전투화랑 비슷한 냄새가 나는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_COOKED"
msgid "What was the purpose of cooking this?"
msgstr "이걸 익힌 이유가 대체 뭐지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_OVERSIZED"
msgid "It gives off a powerful stink."
msgstr "지독한 냄새가 난다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DURIAN_SEEDS"
msgid "Tiny nature bits."
msgstr "자연의 작은 조각이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMERINGUE"
msgid "This food is not fit for a warrior, it's fit for the floor!"
msgstr "이 음식은 전사에게 줄 게 아니라 바닥에 버려야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMOTH"
msgid "This creature has no fight in it."
msgstr "이 생물은 호전적이지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.DUSTMOTHDEN"
msgid "Sorry beasties, but your home is ripe for the pillaging!"
msgstr "짐승들아 미안, 너희 집은 곧 약탈당할 거란다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EARMUFFSHAT"
msgid "Yes, most practical!"
msgstr "그래, 아주 실용적이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL"
msgid "Delicious slimy snake fish."
msgstr "미끈거리고 맛있는 뱀 물고기로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EEL_COOKED"
msgid "Hot eel!"
msgstr "뜨거운 장어다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT"
msgid "Purple and bulbous."
msgstr "보라색이고 불룩한 모양이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_COOKED"
msgid "Food for the weak."
msgstr "약자의 음식이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "I've no use for vegetables, big or small."
msgstr "크든 작든, 난 채소가 싫어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EGGPLANT_SEEDS"
msgid "Tiny nature bits."
msgstr "자연의 작은 조각이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ELIXIR_CONTAINER"
msgid "The elixirs dost soothe her spirit."
msgstr "이 영약은 그녀의 영혼을 진정시켜 주지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EMBERLIGHT"
msgid "My ally's flame burns bright as her fighting spirit."
msgstr "내 아군의 불길이 그녀의 투지만큼 밝게 불타는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.BURNT"
msgid "It was no challenge at all."
msgstr "별것 아니었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.EMPTY"
msgid "There is no beast beneath."
msgstr "아래에 짐승이 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "The light burns bright."
msgstr "빛이 밝게 타고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.GENERIC"
msgid "Tis a tribute to Freya's beauty."
msgstr "프레이야의 아름다움을 기리는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "The light wanes."
msgstr "빛이 어두워지는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ENDTABLE.WILTED"
msgid "Their beauty fades."
msgstr "아름다움이 사라지는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNING"
msgid "The wood's ablaze!"
msgstr "나무가 불타고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.BURNT"
msgid "Loge took that one."
msgstr "로게께서 데려가셨군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "숲의 전사가 베었군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN.GENERIC"
msgid "I feel at home in the woods."
msgstr "숲에 오면 집에 온 느낌이 들지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "The wood's ablaze!"
msgstr "나무가 불타고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Loge took that one."
msgstr "로게께서 데려가셨군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "숲의 전사가 베었군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A good sturdy tree."
msgstr "좋은 튼튼한 나무군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEBRELLAHAT"
msgid "Don't get rain in your eye!"
msgstr "눈에 비가 들어가지 않게 해주지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEMASKHAT"
msgid "Follower of Heimdall, watch over my path!"
msgstr "헤임달의 추종자, 내가 하는 걸 지켜봐!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR"
msgid "Be it the plucked eye of Odin, returned for revenge?"
msgstr "오딘에게서 뽑은 눈이 복수하려고 돌아왔을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR_MINI"
msgid "I hath no fear of having all eyes upon me!"
msgstr "눈을 떼지 않고 나를 경계해도 두렵지 않아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I will prepare myself for the coming challenge!"
msgstr "다가오는 도전을 준비하겠어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYEPLANT"
msgid "Don't point your eyeball at me, foliage!"
msgstr "그 눈알 돌려라, 식물아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET"
msgid "The eye of the laser god stares into my soul."
msgstr "레이저 신의 눈이 저를 보고 있군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.EYETURRET_ITEM"
msgid "An ancient eyeball of protection!"
msgstr "고대의 보호용 눈알이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.BURNT"
msgid "Serves you right for not growing meats!"
msgstr "고기를 재배하지 못하는 벌이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GENERIC"
msgid "I can't grow meat, what's the point?"
msgstr "고기를 재배할 수 없는데 무슨 소용이야?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.GROWING"
msgid "They're growing stronger."
msgstr "강해지고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It wants a turd feast."
msgstr "똥 잔치를 원하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_HOE"
msgid "To bury those useless seeds deep in the ground."
msgstr "그 쓸모없는 씨앗을 땅속 깊이 묻을 만큼은."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.BURNING"
msgid "Good riddance."
msgstr "걸맞는 최후로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL"
msgid "Begone, non-meat!"
msgstr "꺼져, 안고기!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "It's about time I cut you back down to size."
msgstr "이제 널 베어내 크기를 도로 줄일 시간이 왔어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Weed, vegetable or fruit, all are the same to me."
msgstr "잡초든 채소든 과일이든 나에게는 다 똑같아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "식물이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.GROWING"
msgid "I care not."
msgstr "관심없거든."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "It is even more foul than usual."
msgstr "평소보다 훨씬 더 더럽잖아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Good! Let it rot!"
msgstr "좋아! 썩으렴!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLANT.SEED"
msgid "I've no use for you."
msgstr "난 네가 싫어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLOW"
msgid "I claim this soil for the garden!"
msgstr "이 흙은 내 정원의 소유라고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_PLOW_ITEM"
msgid "A ferocious weapon against untamed soil."
msgstr "길들여지지 않은 땅에 대적하는 사나운 무기야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "You dare tresspass upon my garden?"
msgstr "감히 내 정원에 침입해?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERFAN"
msgid "The luxuries of camp, on the go."
msgstr "야영지의 안락함을 휴대할 수 있게 만들었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERHAT"
msgid "Seems a bit flashy for battle."
msgstr "전투에 쓰기에는 좀 화려하군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHERPENCIL"
msgid "Perhaps I'll pen a saga of my journeys!"
msgstr "내 모험 수기를 써도 좋겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CANARY"
msgid "In remembrance of a songbird."
msgstr "노래하는 새를 기리는 것."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_CROW"
msgid "A token from the ravens!"
msgstr "까마귀가 남긴 것!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN"
msgid "Red as my hair."
msgstr "제 머리카락처럼 붉은 색이군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Winter's feather."
msgstr "겨울의 깃털이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FEM_PUPPET"
msgid "She looks unhappy upon her throne."
msgstr "옥좌에 앉았지만 불행해 보인다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE"
msgid "Tis not my kind of fencing."
msgstr "이런 건 칼잡이에겐 필요 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE"
msgid "A tiny replica of Valhalla's gates."
msgstr "발할라 게이트의 모형이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_GATE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "요새에는 걸맞지 않은, 그저 농장을 지키는 문."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ITEM"
msgid "Not for fortification. Merely the farm."
msgstr "요새에는 걸맞지 않은, 그저 농장을 지키는 문."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_JUNK"
msgid "A sturdy barrier."
msgstr "튼튼한 방벽이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FENCE_ROTATOR"
msgid "I'd take a proper blade at my side over this overgrown sewing needle."
msgstr "이 커다란 바늘보다는 제대로 된 검을 차고 싶군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FERTILIZER"
msgid "Its stench could raise the fallen."
msgstr "망자도 다시 깨울 수 있을 것 같은 악취다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVEFISH"
msgid "Let us celebrate the season by feasting on fish flesh!"
msgstr "물고기 살을 마음껏 먹으며 축제를 즐기자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "The bright colors could be useful for distracting enemies."
msgstr "밝은 색상이 적의 주의를 분산시키는 데 유용할거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIG"
msgid "Bah! Foul non-meat!"
msgstr "쳇! 불결한 안고기!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIGATONI"
msgid "I will not sully my warrior tastebuds with such filth."
msgstr "그런 오물로 내 전사의 미각을 더럽히지는 않을 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIGKABAB"
msgid "Food with a wooden spear lanced through it!"
msgstr "나무창에 꽂힌 음식이야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIG_COOKED"
msgid "Roasted fig flesh."
msgstr "구운 무화과 살이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREBALLSTAFF"
msgid "The gods did not mean thy magic for me."
msgstr "내가 이 마법을 부리는 것을 신들께서 허락하지 않으셨다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRECRACKERS"
msgid "To strike fear into the hearts of mine enemies!"
msgstr "내 적의 심장에 두려움을 심어주는 것이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.GENERIC"
msgid "Tiny fairy lights aglow!"
msgstr "작은 요정 불이 빛나고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREFLIES.HELD"
msgid "I hold the light!"
msgstr "내 손안에 빛이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREHOUND"
msgid "The flamed one has no mercy."
msgstr "자비심 없는 불개로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRENETTLES"
msgid "They fight like cowards."
msgstr "겁쟁이처럼 싸우네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPEN"
msgid "I sense a burning power within."
msgstr "안에서 불타는 힘이 느껴지는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.EMBERS"
msgid "That fire's nearly dead."
msgstr "불이 거의 죽었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.GENERIC"
msgid "Warm fire, warm Wigfrid."
msgstr "불이 따뜻하니 위그프리드도 따뜻해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.HIGH"
msgid "The fire roars!"
msgstr "불이 타오르고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.LOW"
msgid "Fire's slowly dying."
msgstr "불이 서서히 죽어가는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.NORMAL"
msgid "Warm fire, warm Wigfrid."
msgstr "불이 따뜻하니 위그프리드도 따뜻해."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIREPIT.OUT"
msgid "And the light flickers out."
msgstr "빛이 깜박이더니 꺼져버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESTAFF"
msgid "That we might become Masters of Fire!"
msgstr "불의 지배자가 될 수 있겠군요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "The catapult grows weak and tired."
msgstr "투석기의 힘이 빠지고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Time to rest, flinging warrior."
msgstr "쉴 시간이에요, 날개 치는 전사씨."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Catapult engaged for battle!"
msgstr "투석기가 전투에 돌입했다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH"
msgid "Meat of the sea!"
msgstr "바다의 고기로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGNET"
msgid "I shall feed all my allies for a day!"
msgstr "하루 동안 동료들을 전부 먹여 살리겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHINGROD"
msgid "I'm a ruthless fisherwoman."
msgstr "나는 무자비한 고기잡이 여인이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT"
msgid "This sea meat will serve me well."
msgstr "이 바다 고기는 앞으로 쓸모 있겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_COOKED"
msgid "Joy!"
msgstr "기뻐라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL"
msgid "This sea meat will serve me well."
msgstr "이 바다 고기는 앞으로 쓸모 있겠지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "This meat will swim in my belly!"
msgstr "이제는 내 뱃속에서 헤엄쳐라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHSTICKS"
msgid "Spears of sea meat."
msgstr "바다 고기로 만든 창이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISHTACOS"
msgid "Fish in a blanket!"
msgstr "담요로 싼 물고기로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_BOX"
msgid "Meat is best when it's fresh!"
msgstr "고기는 신선한 게 최고지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FISH_COOKED"
msgid "Joy!"
msgstr "기뻐라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLINT"
msgid "Vital for spear construction."
msgstr "창 만드는 데 꼭 필요하지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOTATIONCUSHION"
msgid "Not this day, Njord!"
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.GENERIC"
msgid "A flower from Freya."
msgstr "프레이야께서 보내신 꽃이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER.ROSE"
msgid "Were that I smelled half as sweet."
msgstr "내게서 이것의 반만큼이라도 좋은 향기가 났으면."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERHAT"
msgid "Flimsy for the fight, enchanting on one's head."
msgstr "전투에는 별로지만 머리에 쓰면 예쁘다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWERSALAD"
msgid "Leaves are for animals. Animals are for eating."
msgstr "잎은 동물을 위한 것이지요. 동물은 먹기 위한 것이지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_CAVE"
msgid "And it lit up the night, upon the darkest hour."
msgstr "가장 어두운 시간에 밤을 밝히는도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_EVIL"
msgid "A terrible evil plagues this flora."
msgstr "이 식물은 끔찍한 악령에 씌웠군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FLOWER_WITHERED"
msgid "Not enough time in the limelight."
msgstr "조명을 충분히 받지 못했군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOLIAGE"
msgid "A collection of ferns."
msgstr "양치식물 모듬이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOOTBALLHAT"
msgid "A pig's bottom made this helmet."
msgstr "돼지 엉덩이로 만든 투구."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FORGETMELOTS"
msgid "I do not trust them."
msgstr "난 그들을 믿지 않지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FORMAL_BLUEPRINT"
msgid "My fearsome steed has no use for such a thing!"
msgstr "내 무시무시한 말은 그런 걸 싫어한다고!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_PIECE"
msgid "Bones of a dark and ancient foe."
msgstr "고대의 악한 존재의 뼈."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "It looks as though it might roam the earth any moment!"
msgstr "금방이라도 일어나 이 땅을 거닐 것 같군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Tis not as majestic as I once pictured."
msgstr "상상했던 것만큼 위엄 있지는 않군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "All that remains of a terrible beast."
msgstr "끔찍한 짐승의 잔해다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRESHFRUITCREPES"
msgid "So light and airy!"
msgstr "산뜻하고 폭신하네!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRIENDLYFRUITFLY"
msgid "It seems this one is not an enemy."
msgstr "이것은 적이 아닌 것 같네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.DEAD"
msgid "You're a bit slimy for Valhalla."
msgstr "발할라에 들어가기엔 너무 끈적거리는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.GENERIC"
msgid "I'd like some frog boots someday."
msgstr "언젠가는 개구리 장화를 신어보고 싶군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROG.SLEEPING"
msgid "It sleeps."
msgstr "자고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGFISHBOWL"
msgid "My ally is a god among men."
msgstr "내 동료는 인간들 틈에 섞여 든 신인가 보군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGGLEBUNWICH"
msgid "What a treat!"
msgstr "훌륭한 특식이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS"
msgid "Filled with rubbery protein!"
msgstr "고무 같은 단백질이 차 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGLEGS_COOKED"
msgid "I like when I can see the bones sticking out."
msgstr "뼈가 튀어나온 모습이 특히 좋아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROGNEWTON"
msgid "Into my belly with ye!"
msgstr "그대들과 함께 내 뱃속으로!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Monkey drink."
msgstr "원숭이 음료네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Meat impostor!"
msgstr "고기인 척하는 사기꾼이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I have no need for your fake meat."
msgstr "가짜 고기는 필요 없어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "푹 자거라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITFLY"
msgid "Intruder! Taste my blade!"
msgstr "불청객 녀석아! 내 칼 맛 좀 봐라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITFLYFRUIT"
msgid "Now I am chieftain of the wee winged garden beasts!"
msgstr "이제 나는 날개 달린 작은 정원 짐승들의 족장님이셔!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FRUITMEDLEY"
msgid "Ugh! Putting it into a cup doesn't fool me."
msgstr "윽! 잔에 넣는다고 저를 속일 수는 없지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FURTUFT"
msgid "Fur from a large beastie."
msgstr "큰 짐승의 모피."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUSED_SHADELING"
msgid "'Tis naught but a pest to be crushed beneath my boot!"
msgstr "내 발에 짓밟힐 해충에 불과하도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "'Tis small, but lively!"
msgstr "작지만 활기차구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_HOUND"
msgid "Shed your stone form and fight, beast!"
msgstr "돌의 형태를 벗고 싸워라, 짐승아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Do not cower behind your carapace of rock! Fight!"
msgstr "돌껍질 속에 숨지 말아라! 싸우자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC"
msgid "Foul ingredient!"
msgstr "역겨운 재료군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_COOKED"
msgid "The stench!"
msgstr "윽, 냄새!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_OVERSIZED"
msgid "Its enlarged form offends my eyes."
msgstr "확대해보니 형태가 내 눈을 거슬리네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GARLIC_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "고기가 아닌 것의 씨앗 한 줌."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GAZPACHO"
msgid "My mind doth question Warly's allegiances."
msgstr "왈리의 의도에 의심이 드는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEARS"
msgid "Those might look nice glued to my helm."
msgstr "투구에 붙이면 근사할 것 같은데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.GENERIC"
msgid "Cursed nectar of Helheim!"
msgstr "저주스러운 헬하임의 넥타르여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "Bestow succor upon that poor soul, lest they perish in that cursed tar."
msgstr "저 가련한 자가 저주받은 타르 속에서 죽기 전에 도와야 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "What is that flotant herfang?"
msgstr "저 떠다니는 보물은 뭐지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_BOTTLE"
msgid "The goo hath been contained."
msgstr "끈적이는 물체를 가두었도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Thy morsels, it doth preserveth."
msgstr "그대의 식사를 보존해 주리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "Once a mighty deathtrap, now a pantry."
msgstr "한때는 강력한 함정이었으나, 이제는 식료품 창고로구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Peasant's work."
msgstr "천한 농민이나 하는 일이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.GEMS"
msgid "It lacks its gem."
msgstr "보석이 없군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GEMSOCKET.VALID"
msgid "Showtime!"
msgstr "이제 됐다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT"
msgid "God of the moon, shine thy smile upon me!"
msgstr "달의 신이시여, 당신의 미소를 저에게 비추소서!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_CAGE.FILLED"
msgid "'Tis spirited."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_CAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_CAGE.GENERIC"
msgid "An empty vessel."
msgstr "빈 용기야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_GUARD"
msgid "Aha, there are warriors among you!"
msgstr "아아, 너희 중에 전사가 있구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_GUARD_EVOLVED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GESTALT_GUARD_EVOLVED"
msgid "Revenge is thine inheritance."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOST"
msgid "A spirit trapped between worlds."
msgstr "세계의 틈새에 갇힌 영혼이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWER"
msgid "'Tis all that remains."
msgstr "남은 것은 이게 다군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTFLOWERHAT"
msgid "Cursed blossoms of the dead."
msgstr "망자의 저주받은 꽃이로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "'Tis a powerful elixir!"
msgstr "강력한 영약이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFT"
msgid "A gift! From... the gods?"
msgstr "선물이다! ...신들께서 주신 걸까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GIFTWRAP"
msgid "I must show my allies how much they are valued!"
msgstr "내가 얼마나 동료들을 생각하는지 알 수 있도록 정성을 보여야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADHOUSE"
msgid "Neither a house nor a meal I will enjoy."
msgstr "집도 식사도 즐기지 못하겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADPIG"
msgid "You shall not escape me!!"
msgstr "내게서 도망치진 못할 거다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GINGERBREADWARG"
msgid "I will fight thee for defying thy meaty origins."
msgstr "고기의 태생을 부정한 죄로 널 단죄하겠다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSBLOCK"
msgid "Such beauty!"
msgstr "참으로 아름답다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSCUTTER"
msgid "T'will win any battle, surely!"
msgstr "어떤 전투에서도 승리하겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLASSSPIKE"
msgid "'Twas forged in flame."
msgstr "화염 속에서 만들어졌다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.GENERIC"
msgid "A majestic goober."
msgstr "위엄 있는 벌레로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMER.SLEEPING"
msgid "It slumbers."
msgstr "자는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "It was once a wonder of the woods."
msgstr "한때는 숲의 경이라 불렸지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "A wonder of the woods."
msgstr "숲의 경이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERFUEL"
msgid "This slop could be useful."
msgstr "쓸 데가 있을 것 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOMMERWINGS"
msgid "Ohh, look what the goober left for me."
msgstr "오, 구버가 남긴 것을 볼까요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GLOWBERRYMOUSSE"
msgid "A repulsive vegetable concoction."
msgstr "역겨운 채소 혼합물이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "The beast's been disarmed!"
msgstr "짐승의 무장이 해제됐다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "You are still a great warrior!"
msgstr "넌 지금도 훌륭한 전사야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "Tis a fair and noble beast!"
msgstr "고귀하니 좋은 짐승이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL.GENERIC"
msgid "Draw your weapon and fight me, beastie!"
msgstr "싸우게 무기를 꺼내라, 짐승아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GNARWAIL_HORN"
msgid "A fine horn, indeed!"
msgstr "정말 훌륭한 뿔이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOATMILK"
msgid "This is powerful milk."
msgstr "강한 젖이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOGGLESHAT"
msgid "T'would be no help in battle."
msgstr "전투에는 전혀 도움이 안 되겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENAXE"
msgid "A tool of gold!"
msgstr "금으로 만든 도구로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPICKAXE"
msgid "Gold for gold."
msgstr "금으로 금을 캐겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENPITCHFORK"
msgid "A weapon of very wealthy farmers."
msgstr "매우 부유한 농부의 무기죠."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDENSHOVEL"
msgid "Digging like a king!"
msgstr "왕처럼 땅을 파는 거다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDEN_FARM_HOE"
msgid "A tool far too magnificent for those worthless seeds."
msgstr "그 가치 없는 씨앗에게는 과분하게 멋진 도구야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOLDNUGGET"
msgid "Such a pleasing gold piece."
msgstr "기분 좋게 만들어주는 황금 조각이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GOOSE_FEATHER"
msgid "A shieldmaiden deserves a soft bed of dunn."
msgstr "방패 여전사라면 부드러운 침대에서 자는 게 마땅하지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BARREN"
msgid "The life has gone from it."
msgstr "생명이 사라졌다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.BURNING"
msgid "Loge looks upon you!"
msgstr "로게가 굽어보시는구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASED"
msgid "Disease festers within its soul."
msgstr "혼까지 병들었어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "내 눈 앞에서 약해지고 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.GENERIC"
msgid "That could be useful."
msgstr "쓸모가 많을 것 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.PICKED"
msgid "I eagerly await the next harvest."
msgstr "다음 수확이 기대되는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS.WITHERED"
msgid "The heat has defeated this plant."
msgstr "더위에 쓰러지고 말았군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGATOR"
msgid "What fine flaxen hair."
msgstr "가느다란 금발머리다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "Alas! It is stricken."
msgstr "아아! 병들어버렸군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "What flaxen scales."
msgstr "풀빛 비늘로 덮여있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRASS_UMBRELLA"
msgid "Flowers are not befitting a warrior, but wet armor is even worse."
msgstr "꽃은 전사에게 어울리지 않지만, 젖은 갑옷은 그보다도 더 나쁘니까."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVEURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVEURN.GENERIC"
msgid "'Tis empty."
msgstr "비었도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVEURN.HAS_SPIRIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVEURN.HAS_SPIRIT"
msgid "A spirit doth abide within."
msgstr "안에 영혼이 깃들어 있도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GRAVY"
msgid "A sauce worthy of the gods themselves!"
msgstr "신에게 어울리는 소스구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENAMULET"
msgid "Enhanced emerald crafting skills!"
msgstr "첨단 에메랄드 제조 기술이 보이는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENGEM"
msgid "An emerald stone."
msgstr "에메랄드 돌이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENMOONEYE"
msgid "Odin gave his eye that we might see."
msgstr "우리가 볼 수 있도록 오딘께서 눈을 주셨도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREENSTAFF"
msgid "Twirly green power."
msgstr "녹색 힘이 감돌고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP"
msgid "Terrible!"
msgstr "끔찍해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_CAP_COOKED"
msgid "Charred by flame or not, that will not touch my lips!"
msgstr "불에 그을렸든 아니든, 내 입에는 절대 안 넣어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "It has risen!"
msgstr "나왔다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "Hide, coward."
msgstr "어디 숨어봐라, 겁쟁아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "I see fungal spores."
msgstr "버섯 포자가 보이는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GROTTO_POOL_BIG"
msgid "The pools hath been enchanted."
msgstr "수영장이 마법에 걸렸나봐."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GROTTO_POOL_SMALL"
msgid "The pools hath been enchanted."
msgstr "수영장이 마법에 걸렸나봐."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUACAMOLE"
msgid "Yum, creamy!"
msgstr "냠냠, 부드럽군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUANO"
msgid "Hmm, dark wing turds."
msgstr "흠, 어둠 날개의 똥이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.GUNPOWDER"
msgid "Such energy!"
msgstr "힘이 넘친다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_1"
msgid "How sinister! I nearly mistook it for a true apple!"
msgstr "이렇게 사악할 수가! 진짜 사과인 줄 알았잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_10"
msgid "I shall uncover its secret center!"
msgstr "안에 어떤 비밀이 숨어있는지 파헤쳐주마!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_11"
msgid "Tis not meat, but tis close enough!"
msgstr "고기는 아니지만 비슷하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_12"
msgid "They look like that which writhe and crawl."
msgstr "꿈틀거리고 땅을 기는 무언가랑 비슷하군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_13"
msgid "You shalt not break me, confection!"
msgstr "너 따위는 내 이빨을 깰 수 없어, 사탕아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_14"
msgid "Wretched Hel's fire!"
msgstr "지독한 헬의 불 같으니!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_2"
msgid "A clever ruse. It is not corn at all."
msgstr "영악한 속임수로군. 옥수수가 아니잖아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_3"
msgid "A confection to strike terror into any warrior's heart!"
msgstr "전사의 마음에 공포를 불어 넣는 사탕이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_4"
msgid "Monsters, prepare to do battle with a Viking's teeth!"
msgstr "몬스터들이여, 바이킹의 이빨과 대적할 각오를 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_5"
msgid "The perfect treat!"
msgstr "완벽한 별미!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_6"
msgid "What have I done to anger the gods so?"
msgstr "신들께서 이런 벌을 내리실 정도로 내가 큰 잘못을 저질렀나?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_7"
msgid "That monarch swine insults me."
msgstr "돼지 왕이 나를 모독하는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_8"
msgid "I shall uncover its secret center!"
msgstr "안에 어떤 비밀이 숨어있는지 파헤쳐주마!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENCANDY_9"
msgid "The battle was mighty, yet in the end the worm was consumed!"
msgstr "치열한 전투 끝에 벌레가 먹혔도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Tis Berserker magic."
msgstr "버서커의 마법이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Fortune hath smiled upon me today!"
msgstr "오늘은 내게 행운이 따르는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "A meager reward for my troubles."
msgstr "그간의 고생에 대한 미약한 보상이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Hel's fuel."
msgstr "헬의 연료다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "Changeling elixir."
msgstr "변신의 영약이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "Meant to hang from Yggdrasil's kin!"
msgstr "위그드라실의 친척에게 매다는 것!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Decoration! Prepare to be hung from something!"
msgstr "장식이여! 무언가에 걸릴 준비를 해라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "It shall strike fear unto the hearts of mine foes!"
msgstr "적의 심장에 두려움을 심어주리라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "'tis but a decoration!"
msgstr "장식일 뿐이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "It shalt be hung from the highest branch!"
msgstr "가장 높은 가지에 걸릴 것이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "Huginn? Or Muninn?"
msgstr "후긴? 아니면 무닌?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMBAT"
msgid "A weapon fit for the great dining halls!"
msgstr "웅장한 만찬장에 어울리는 무기로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER"
msgid "More fit for labor than battle."
msgstr "전투보다는 노동에 어울리는군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAMMER_MJOLNIR"
msgid "I am worthy!"
msgstr "나에겐 자격이 있다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "It is filled with the hair of the woolen beasties."
msgstr "북실북실한 짐승의 털로 채워져 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_KELP"
msgid "'Tis a pillow from Njoror's domain."
msgstr "뇨르드의 영역에서 난 베개군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_PETALS"
msgid "As good a use as any for flimsy petals."
msgstr "연약한 꽃잎의 좋은 사용처로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "Only the strong-willed could sleep on such a thing."
msgstr "오직 강한 의지를 가진 이만이 저걸 베고 잘 수 있으리라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAREBALL"
msgid "Ha! I am no coward, pass it this way!"
msgstr "흥! 난 겁쟁이가 아니다. 이리 줘봐라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HAWAIIANSHIRT"
msgid "Flowers cannot stop a spear."
msgstr "꽃은 창을 막을 수 없지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE"
msgid "Be filled with life!"
msgstr "생기를 채우지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSALVE_ACID"
msgid "This slime doth soothe me."
msgstr "이 점액이 고통을 잠재워 주는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEALINGSTAFF"
msgid "Blessings of magicks within."
msgstr "마법의 축복이 깃들었군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.COLD"
msgid "The stone has taken on cold!"
msgstr "돌에 냉기가 도는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.FROZEN"
msgid "Cold teeth bite at me!"
msgstr "차가운 이빨이 나를 문다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.GENERIC"
msgid "A stone of great use!"
msgstr "매우 쓸모가 많은 돌이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.HOT"
msgid "Loge would be proud."
msgstr "로게께서 기뻐하실 만하다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEATROCK.WARM"
msgid "The stone has taken on warmth!"
msgstr "돌에 온기가 도는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGEHOUND"
msgid "Deceiver! Thou art a prickly pox upon my stage!"
msgstr "기만자여! 너는 내 무대의 눈엣가시 같은 존재로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HEDGEHOUND_BUSH"
msgid "A thorny bramble."
msgstr "가시덤불이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB"
msgid "Be ye a sea witch? Or just an old crone?"
msgstr "바다 마녀인가? 그냥 쪼그랑할멈인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "The crab shall dwell where I see fit."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "The old crone resides here?"
msgstr "쪼그랑할멈이 지내는 곳인가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "The sea witch seems to be pleased with it."
msgstr "바다 마녀의 마음에 드나 보군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_BUNDLE"
msgid "Our labor hath been rewarded!"
msgstr "우리의 노동은 보상을 받았지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "A fresh bounty of shells to adorn our battlements."
msgstr "흉벽을 장식할 새로운 조개껍데기다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "The battle is won, but at what cost?"
msgstr "대체 무엇을 위해 승리한 거지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HERMIT_PEARL"
msgid "I shall protect it with my life!"
msgstr "목숨을 걸고 지키겠어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HIVEHAT"
msgid "Vikings do not wear horns."
msgstr "바이킹은 뿔을 쓰지 않는다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOME"
msgid "Home is where the hearth is!"
msgstr "화덕이 있는 곳이 바로 집이지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.BURNT"
msgid "Signs of a battle past."
msgstr "전투가 있었던 흔적이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.GENERIC"
msgid "A most well placed sign."
msgstr "위치가 완벽한 표지판이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "I shall write a tale of triumph!"
msgstr "승리의 이야기를 써야지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEY"
msgid "Sticky and gross."
msgstr "끈적하고 징그럽군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYCOMB"
msgid "Wouldn't make much of a comb."
msgstr "별로 쓸 데가 없어 보이는데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYHAM"
msgid "A feast!"
msgstr "푸짐하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HONEYNUGGETS"
msgid "A feast!"
msgstr "푸짐하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORN"
msgid "How I long for battle."
msgstr "전투가 그립군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HORRORFUEL"
msgid "The sight of it chills even my courageous Viking heart."
msgstr "내 용감한 바이킹의 심장조차 이걸 보니 서늘해지는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTCHILI"
msgid "A true test of willpower."
msgstr "진정한 의지의 시험."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.BOMBED"
msgid "'Tis imbued with the power of the moon!"
msgstr "달의 힘이 가득하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.EMPTY"
msgid "Odd, I do not see the fire giant..."
msgstr "어라, 불의 거인이 안 보이는데..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GENERIC"
msgid "Perhaps a fire giant slumbers beneath!"
msgstr "볼의 거인이 아래에서 자고 있을지도 모르겠군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOTSPRING.GLASS"
msgid "Oh no! The giant is trapped!"
msgstr "이런! 거인이 갇혔잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUND"
msgid "Fenrir's spawn!"
msgstr "펜리르의 새끼!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDBONE"
msgid "A fallen foe."
msgstr "쓰러진 적이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Burial by fire."
msgstr "화장 중이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "Rest well, fallen foe."
msgstr "잘 가라, 쓰러진 적아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "The dead walk again!"
msgstr "시체가 다시 걷잖아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDMOUND"
msgid "These hounds are true warriors."
msgstr "이 개들은 진정한 전사라고 할 수 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH"
msgid "A token of a successful conquest."
msgstr "성공적인 정복의 징표다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "A beautiful ranged weapon. Fit for a coward."
msgstr "아름다운 원거리 무기로다. 겁쟁이에게 어울리는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HOUNDWHISTLE"
msgid "It casts a spell upon the dogged beasts."
msgstr "개들에게 마법을 건다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH"
msgid "A loyal companion, if ever there were one."
msgstr "매우 충성심이 가득한 동료다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "An ensconced water sprite!"
msgstr "물의 요정이 들어있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "An unfortunate casualty of battle."
msgstr "안타까운 전쟁의 피해자로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE"
msgid "Reminds me of home."
msgstr "고향 생각나네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.GENERIC"
msgid "A trap left by the dastardly ice giants, no doubt."
msgstr "비겁한 얼음 거인이 남긴 덫이 틀림없군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG.MELTED"
msgid "'Twas no match for this great heat."
msgstr "이런 더위에는 버틸 수가 없지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBERG_MELTED"
msgid "'Twas no match for this great heat."
msgstr "이런 더위에는 버틸 수가 없지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEBOX"
msgid "Winter dwells inside!"
msgstr "안에 겨울이 살고 있군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICECREAM"
msgid "That stuff hurts my teeth."
msgstr "이빨을 아프게 한다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHAT"
msgid "A chunk of cold."
msgstr "냉기 덩어리다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEHOUND"
msgid "Teeth of frost!"
msgstr "서릿발의 이빨이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICEPACK"
msgid "A backpack of the beast."
msgstr "짐승의 가방이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICESTAFF"
msgid "A gift from Ullr!"
msgstr "울르의 선물이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ICE_BLUEPRINT"
msgid "My beast will not fear the cold."
msgstr "내 짐승은 추위를 두려워하지 않을 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "Woah!"
msgstr "우어어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "I suspect nothing of this rock."
msgstr "전혀 수상한 점이 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "A warrior hath no need for such things."
msgstr "전사에게 이런 건 필요 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.INSPECTSELF"
msgid "Who is that incredible warrior in the mirror?"
msgstr "거울 너머에 보이는 저 멋진 전사는 누구지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IPECACSYRUP"
msgid "'Tis a most sickly-smelling syrup."
msgstr "아주 악취 나는 시럽이구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.IVY_SNARE"
msgid "Ha! At least this plant hath some spirit!"
msgstr "하! 이 식물은 최소한 영혼은 있어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JAMMYPRESERVES"
msgid "Sticky and gross."
msgstr "끈적하고 징그럽군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JELLYBEAN"
msgid "The yield of an industrious candy farmer."
msgstr "열심히 일하는 사탕 농부의 수확물."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUNK_PILE"
msgid "Mayhaps a treasure lies inside?"
msgstr "안에 보물이 있지는 않을까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUNK_PILE_BIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUNK_PILE_BIG"
msgid "T'would be a disgrace to be slain by a falling pile of refuse..."
msgstr "쓰러지는 쓰레기 더미에 죽으면 참으로 수치스럽겠지..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.JUSTEGGS"
msgid "A simple meal, but a good one."
msgstr "간단하지만 훌륭한 식사로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KABOBS"
msgid "A feast!"
msgstr "푸짐하군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP"
msgid "Ridiculous sea vegetable."
msgstr "우스꽝스러운 바다 채소군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELPHAT"
msgid "I'd never trade mine helm for this."
msgstr "절대 내 투구와 바꾸지 않겠어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_COOKED"
msgid "Tis even worse than before."
msgstr "전보다 더 나빠졌군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KELP_DRIED"
msgid "I despise it."
msgstr "혐오스러워."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.GENERIC"
msgid "A challenger!"
msgstr "도전자인가!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KILLERBEE.HELD"
msgid "A conquered foe."
msgstr "생포한 적이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "Alas, it shall wobble no more."
msgstr "이런, 더는 뒤뚱대면 안 돼."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "A sparring partner for the wee beasties."
msgstr "꼬마 짐승의 대련 상대로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR1_KIT"
msgid "Fear not beasties, it will be constructed forthwith!"
msgstr "겁내지 마 짐승아, 당장 만들 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "It seems the hunt is over."
msgstr "사냥이 끝난 것 같아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "The beasties must learn to hunt!"
msgstr "짐승은 사냥하는 법을 배워야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDECOR2_KIT"
msgid "I will construct it with the speed of Hermod!"
msgstr "헤르모드의 속도로 만들 거야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.BURNT"
msgid "Not great as a hideaway now."
msgstr "지금 은신처로는 좋지 않아."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.GENERIC"
msgid "A penthouse for wee beasties."
msgstr "꼬마 짐승용 펜트하우스네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "The wee beasties are out, let us find them!"
msgstr "꼬마 짐승이 나갔어, 찾아보자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "We must bring them home quickly!"
msgstr "얼른 집으로 데려와야 해!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOONDEN_KIT"
msgid "Everything one needs to build a hideaway for tiny beasts."
msgstr "쪼꼬미 짐승용 은신처를 만드는 데 필요한 게 다 있어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_DECIDUOUS"
msgid "A wee beastie with a talent for mischief."
msgstr "장난치는 데 재능이 있는 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_DESERT"
msgid "A wee beastie with not-so-wee ears."
msgstr "귀는 그닥 꼬마가 아닌 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_FOREST"
msgid "A wee beastie that's particularly excellent at hiding."
msgstr "특별히 숨는 데 탁월한 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_GRASS"
msgid "A fairly flammable looking wee beastie."
msgstr "정말 불이 잘 붙을 것 같은 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_MARSH"
msgid "A wee beastie with a weapon equipped to its tail. Ferocious!"
msgstr "꼬리에 무기를 장착한 꼬마 짐승. 포악하구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_MOON"
msgid "A wee beastie imbued with a third eye for finding more hiding spots."
msgstr "제삼의 눈으로 숨을 장소를 더 많이 찾아내는 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_NAMETAG"
msgid "To me, tiny beastie! I shall gift thee with a warrior's name!"
msgstr "이리 온, 꼬맹이 짐승아! 전사의 이름을 선물로 줄게."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_ROCKY"
msgid "A very serious wee beastie."
msgstr "아주 진지한 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_SAVANNA"
msgid "A wee beastie with the heart of a mighty beastie."
msgstr "전능한 짐승의 심장을 가진 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KITCOON_YOT"
msgid "A wee beastie with an excellent costume."
msgstr "성대하게 차려입은 꼬마 짐승."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS"
msgid "I shall free thy deer this day!"
msgstr "네 사슴들도 오늘로 해방이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUSSACKKEY"
msgid "What wonders will you reveal?"
msgstr "무엇을 얻을까 기대되는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KLAUS_SACK"
msgid "A secret, kept under lock and key!"
msgstr "자물쇠와 열쇠로 꽁꽁 숨겨놨군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT"
msgid "I taste a battle on the breeze!"
msgstr "전투의 향기가 바람을 타고 흘러오는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "I don't think I'd ride that horse."
msgstr "저 말을 타서는 안 될 것 같군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_CARCASS"
msgid "This creature is no more."
msgstr "이 생물은 이제 죽었다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_SUMMER"
msgid "Dearest creature... I am going to eat you."
msgstr "동물아... 내가 널 먹어주마."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFANT_WINTER"
msgid "Poor unsuspecting meat beast."
msgstr "제 운명을 짐작도 못하고 있는 가엾은 고기 짐승이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KOALEFIG_TRUNK"
msgid "The trunk hath been fattened up."
msgstr "코에 살이 쪘네."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS"
msgid "You don't scare me, goat!"
msgstr "넌 하나도 무섭지 않아, 이 염소야!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.KRAMPUS_SACK"
msgid "The sack itself is the present."
msgstr "이 자루 자체가 선물이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LANTERN"
msgid "A lantern to hold back the night."
msgstr "밤의 엄습을 막아내는 등불이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LATKES"
msgid "My eyes see foul potatoes, but the taste of meat is unmistakable!"
msgstr "역겨운 감자에서 고기 맛이 나다니!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I shall not bend to whims of my foes."
msgstr "적에게 굽히는 일은 없을 거야."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Tis a worthy suit of armor."
msgstr "훌륭한 갑옷이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "That is not fit for a warrior!"
msgstr "전사에게는 어울리지 않는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "The wearer shalt be fleet of foot."
msgstr "발걸음이 빨라지겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Tis not as sturdy as a warrior would hope."
msgstr "전사에게 쓸모가 있을 만큼 튼튼하지는 않군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Makes the wearer sharp of tooth."
msgstr "착용자를 이빨처럼 뾰족하게 만들어준다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Makes the wearer keen of mind."
msgstr "착용자의 정신을 날카롭게 만들어준다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "I shall armor myself for battle!"
msgstr "전투를 위해 갑옷을 입어야지!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Let us down the enemy's standard!"
msgstr "적의 깃발을 내려뜨리자!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BERNIE"
msgid "The call of battle has arisen in thee!"
msgstr "결전의 함성이 들려온다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_BOARLORD"
msgid "Tis a coward who watches the fight."
msgstr "싸움 구경만 하는 겁쟁이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Be still my heart! Tis the king of battle helms!"
msgstr "투구의 왕을 직접 보게 되다니, 내 심장이 마구 떨리는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Thy fire giant shall fight by our side."
msgstr "불의 거인이 우리 편에서 싸워줄 것이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "I'd not dabble in thy horrid magic."
msgstr "그 끔찍한 마법은 건드릴 생각 없다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "Sleipnir bestowed it with swiftness."
msgstr "슬레이프니르가 속도를 부여해준 것이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "A barrage of Hel's fire."
msgstr "헬의 불을 내린다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "A blessing from Freya is contained within."
msgstr "프레이야의 축복이 깃들어 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "Tis heavily laden with Freya's blessings."
msgstr "프레이야의 축복이 많이 깃들어 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A mighty blade for a mighty battle!"
msgstr "훌륭한 전투를 위한 훌륭한 칼!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "The Rainbow Bridge conceals itself."
msgstr "무지개 다리가 스스로를 감추는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "The Rainbow Bridge opens!"
msgstr "무지개 다리가 열린다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Horns, sharp as the spear of the Valkyrie."
msgstr "발키리의 창처럼 날카로운 뿔."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_LUCY"
msgid "Thy axe is filled with burning passion this day!"
msgstr "열정으로 불타는 도끼다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "Tis a gate betwixt realms."
msgstr "여러 세계를 이어주는 게이트다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "We dive, back into the ether!"
msgstr "다시 에테르로 돌아간다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "Magic stone, empower my spirit!"
msgstr "마법의 돌이여, 나의 정신에 힘을 다오!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Tis most heinous magic!"
msgstr "가장 사악한 마법이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Empower me with thy Nox strength!"
msgstr "녹스의 힘을 내게 다오!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "'Twas not made for a warrior."
msgstr "전사에게는 어울리지 않는다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE"
msgid "A fiery foe!"
msgstr "불 같은 적!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_COCOON"
msgid "The best allies are made in the heat of battle."
msgstr "최고의 아군은 치열한 전장에서 만나는 법."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "A dragon egg!"
msgstr "드래곤의 알이로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "This egg looks chilly."
msgstr "알이 추워 보이는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "It's warm and toasty."
msgstr "뜨끈뜨끈하군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.CONTENT"
msgid "It glows contentedly."
msgstr "만족스럽게 빛나고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.GENERIC"
msgid "A faithful, fiery friend."
msgstr "믿음직한 불의 친구."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "You must eat to keep your fires burning."
msgstr "먹어야 불을 유지할 수 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_PET.STARVING"
msgid "Its fires are dying out."
msgstr "불이 꺼지고 있다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVAE_TOOTH"
msgid "A fearsome eggy fang!"
msgstr "무시무시한 엄니로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.COOL"
msgid "It's not very scary now, is it?"
msgstr "이제 별로 무섭지 않지?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVASPIT.HOT"
msgid "Your fiery pools are no match for me!"
msgstr "불구덩이 따위는 전혀 무섭지 않아!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND"
msgid "I shall not surrender to the fiery pits!"
msgstr "불구덩이 따위에 항복하는 일은 없어!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LAVA_POND_ROCK"
msgid "Stone belched forth by the earth's fiery heart!"
msgstr "땅의 불 같은 심장이 내뱉은 돌이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFLOAF"
msgid "It has a suspiciously non-meat smell to it."
msgstr "수상하다. 고기가 아닌 냄새가 난다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATBURGER"
msgid "This will suffice until I find real meat."
msgstr "진짜 고기를 찾기 전까지는 이걸로 버틴다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "A nightmarish vision... but food nonetheless."
msgstr "악몽 같은 모양새군... 그래도 음식은 음식이다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF"
msgid "That is an ancient woodland being."
msgstr "고대의 삼림지 생물이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_IDOL"
msgid "Tribute to an ancient woodland being."
msgstr "고대의 숲속 존재에게 바치는 헌사로다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LEIF_SPARSE"
msgid "That is an ancient woodland being."
msgstr "고대의 삼림지 생물이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LICHEN"
msgid "Sky blue nonsense plant."
msgstr "엄청나게 무의미한 식물이로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIFEINJECTOR"
msgid "This will return me to top form."
msgstr "이걸로 몸 상태를 최고로 회복할 수 있겠어."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTBULB"
msgid "Glow!"
msgstr "빛나라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTCRAB"
msgid "Its glow is most welcome."
msgstr "기분 좋은 빛이 나고 있구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTER"
msgid "It lights the fires of mine heart!"
msgstr "내 심장에 불을 지른다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTFLIER"
msgid "Light the way, noble insect."
msgstr "길을 밝혀라, 고귀한 곤충이여."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "The lightning has made you a unicorn warrior!"
msgstr "벼락이 일각수 전사로 만들어주었구나!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "May I call you Unicorn?"
msgstr "일각수라고 불러도 될까?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNINGGOATHORN"
msgid "This could deal a lasting blow."
msgstr "오래 지속되는 타격을 입힐 수 있겠군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "Oh, great lightning!"
msgstr "오, 위대한 번개여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "Bring with you lightning, Donner!"
msgstr "천둥 번개를 부르지요!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LITTLE_WALRUS"
msgid "A spawn of the evil toothed seal."
msgstr "사악한 이빨이 달린 물개의 새끼로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGLOG"
msgid "Burning such magic would seem a waste."
msgstr "이 마법을 태우는 것은 낭비겠지요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE"
msgid "A tree of life, but it is not Yggdrasil."
msgstr "위그드라실은 아닌 살아있는 나무로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_ROOT"
msgid "I hath birthed the root of terror!"
msgstr "공포의 뿌리를 얻었도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LIVINGTREE_SAPLING"
msgid "It bears the promise of horridness!"
msgstr "앞으로 끔찍한 장래가 기대되는도다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERBISQUE"
msgid "That's more like it."
msgstr "이건 마음에 드는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOBSTERDINNER"
msgid "I triumphed over my wobster foe."
msgstr "웝스터를 상대하여 이겼노라."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.BURNING"
msgid "Flaming log!"
msgstr "불타는 통나무로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOG.GENERIC"
msgid "Wood is always of value."
msgstr "나무는 언제나 쓸모가 있지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LORDFRUITFLY"
msgid "Thou art no lord!"
msgstr "그대는 주인이 아니다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_1"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_10"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_11"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_14"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_18"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_19"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_2"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_42"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_43"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LOST_TOY_7"
msgid "It hath the stench of death upon it."
msgstr "죽음의 악취가 서려 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "The unicorn smiles upon me this day!"
msgstr "일각수가 오늘 나에게 행운을 보내는군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUCY"
msgid "It's nice, but it's no spear."
msgstr "나쁘진 않지만, 창이 더 좋은데."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUMPY_SAPLING"
msgid "It brings shame to the might of Yggdrasil."
msgstr "위그드라실의 수치로군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARFROG"
msgid "This frog hath seen too much."
msgstr "이 개구리는 너무 많은 것을 보았도다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANTHAT"
msgid "A formidable helm, burning with an unearthly flame!"
msgstr "기이한 불길로 타오르는 막강한 투구로다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_HUSK"
msgid "It hath a formidible hide, for a non-meat."
msgstr "안고기 치고는 막강한 가죽을 가지고 있구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARPLANT_KIT"
msgid "Even the sturdiest armor will sometimes need repairs."
msgstr "아무리 튼튼한 갑옷도 때로는 수리가 필요하지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "How strange... and beautiful."
msgstr "정말 이상하면서도.... 아름답군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARRIFT_PORTAL"
msgid "An opening, yet I cannot pass through."
msgstr "틈이 있지만 들어갈 수가 없구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT"
msgid "Vicious plant, I shall honor thee with a swift death!"
msgstr "빠른 죽음으로 널 기리겠노라, 사악한 식물이여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "Ha! You shall have to do better than that!"
msgstr "흥! 이 정도로는 어림없다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE"
msgid "I shall forge weapons to rival the gods themselves!"
msgstr "신들에 필적하는 무기를 만들리라!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_FORGE_KIT"
msgid "The forge must be built, forthwith!"
msgstr "서둘러 대장간을 만들어야 한다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_GRAZER"
msgid "I will not fall prey to your tricks, spirit!"
msgstr "네 속임수에 넘어가지는 않겠다, 영혼이여!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUNAR_SEED"
msgid "Sprung from the shining coronal of a mighty deity."
msgstr ""

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANT"
msgid "Finally! A useful vegetable."
msgstr "마침내! 유용한 채소군요."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUREPLANTBULB"
msgid "Perhaps I will be a meat farmer after all!"
msgstr "어쩌면 고기 농부가 될 수도 있겠는걸!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.LUTEFISK"
msgid "A true Viking delicacy!"
msgstr "진정한 바이킹의 별미군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MADSCIENCE_LAB"
msgid "Be there method to this madness?"
msgstr "설마 미친 짓에도 체계가 있다는 건가?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MAGICIAN_CHEST"
msgid "'Tis a wicked looking thing."
msgstr "참으로 사악해 보이는구나."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS"
msgid "I will slay the four-winged beast!"
msgstr "날개 넷 달린 짐승을 베어 버리겠다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_BEAK"
msgid "A trophy from my victory!"
msgstr "승리의 전리품이다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHER"
msgid "The plume of a fallen foe."
msgstr "쓰러진 적의 깃털이군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "A bolt of thine finest bird-cloth!"
msgstr "최고급 새 천이군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MALE_PUPPET"
msgid "He looks unhappy upon his throne."
msgstr "옥좌에 앉아있지만 불행해 보이는군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE"
msgid "The corpse of the rutabaga still retains its magic."
msgstr "순무 시체가 아직도 마법을 간직하고 있군."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKESOUP"
msgid "A stew of magic!"
msgstr "마법의 스튜로군!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_ACTIVE"
msgid "She just wants to go on a rutabaga saga."
msgstr "순무도 모험을 떠나고 싶은 모양이지."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_COOKED"
msgid "Grilled rutabaga."
msgstr "구운 순무다."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANDRAKE_PLANTED"
msgid "A rutabaga!"
msgstr "순무다!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MANRABBIT_TAIL"
