msgid "Little statue needs fire!"
msgstr "작은 조각상에 불이 필요하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Tiny statue has grown mighty!"
msgstr "쪼그만 조각상이 아주 커졌다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TRINKET"
msgid "Is spooky crown for tiny head."
msgstr "작은 머리를 위한 오싹한 왕관이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COZY_BUNNYMAN"
msgid "Rabbits look ready for bedtime."
msgstr "토끼가 잠잘 준비 된 것 같다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.GENERIC"
msgid "This makes Wolfgang very scared AND hungry."
msgstr "볼프강 매우 겁먹었고 배고프다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.INERT"
msgid "Is giant castle of sand!"
msgstr "커다란 모래성이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Cowardly crabs like to toss rock."
msgstr "겁쟁이 게들이 돌 던지는 거 좋아한다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CLAW"
msgid "Keep away from boat, big pinchers!"
msgstr "배 가까이 오지 마라, 꼬집쟁이야!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_ICEWALL"
msgid "Puny ice wall not stop Wolfgang."
msgstr "하찮은 얼음 벽으로 볼프강 못 막는다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB"
msgid "Little crab is very bold for creature that is so delicious."
msgstr "작은 게 맛있는 동물치고 아주 용감하다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Come, tough guy. Wolfgang just warmed up."
msgstr "덤벼라, 덩치. 볼프강 지금까지 몸풀기였다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTERLAB"
msgid "Wolfgang hear little noises inside."
msgstr "볼프강 귀에 안에서 작은 소리가 들린다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_DRAGONLING"
msgid "Mighty pet! Very good!"
msgstr "힘센 펫이다! 아주 좋다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Little eye not so scary!"
msgstr "작은 눈은 그렇게 무섭지 않다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_GLOMLING"
msgid "Flying bug friend!"
msgstr "날아다니는 벌레 친구다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_KITTEN"
msgid "Small fur is Wolfgang's friend."
msgstr "작은 털뭉치는 볼프강의 친구다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LAMB"
msgid "Is walking fluff!"
msgstr "털뭉치가 걷는다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Strong Wolfgang will protect soft flutterby."
msgstr "튼튼한 볼프강이 연약한 나비 지켜준다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PERDLING"
msgid "Bird baby is weak, but good."
msgstr "아기새는 약하지만 좋다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PUPPY"
msgid "I am call him Pupgang!"
msgstr "너 이름은 퍼프강으로 하자!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.GENERIC"
msgid "I do not like birds. Too fragile."
msgstr "나는 새를 좋아하지 않는구나. 너무 약하구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.HELD"
msgid "He is squawky."
msgstr "시끄럽다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRUMBS"
msgid "Is clue! Yummy, yummy clue!"
msgstr "단서다! 아주 맛있는 단서다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CURSED_MONKEY_TOKEN"
