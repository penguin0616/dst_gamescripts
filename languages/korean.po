msgstr "벌레를 잡는다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BULLKELP_PLANT.GENERIC"
