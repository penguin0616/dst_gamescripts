#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
