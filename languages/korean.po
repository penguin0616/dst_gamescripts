msgstr "발사 준비 됐다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.GENERIC"
