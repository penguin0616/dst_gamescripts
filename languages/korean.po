msgstr "위험해 보인다, 꼬마 물고기야!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WURT.GENERIC"
msgid "Is tiny fish girl, %s! Hello!"
msgstr "꼬마 물고기, %s! 안녕!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WURT.GHOST
