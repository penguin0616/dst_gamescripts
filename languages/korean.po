msgstr "아름다운 꽃이잖아."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
