msgstr "무서운 개구리가 무서워서 도망갔다."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_TOADESCAPING"
msgid "Is looking skittery!"
msgstr "겁 먹은 것 같다!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_TOOL_SLIP"
