msgstr "세상에나! 이 살인자!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PLAYER.REVIVER"
