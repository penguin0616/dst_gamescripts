#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAST_YOTD_ITEM"
msgid "Is for making big sail-stick."
msgstr "이걸로 커다란 돛 막대기 만든다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELL"
msgid "A fancy suit is no match for my muscles!"
msgstr "비싼 슈트는 내 근육의 상대가 되지 못하는구나."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLHEAD"
msgid "Scary head is twelve feet tall!"
msgstr "무서운 머리가 12피트나 하는구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLIGHT"
msgid "Scary light!"
msgstr "무서운 빛이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLLOCK"
msgid "Scary lock!"
msgstr "무서운 자물쇠다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Is box that sings!"
msgstr "노래 부르는 상자다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MAXWELLTHRONE"
msgid "Scary chair!"
msgstr "무서운 의자다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT"
msgid "Meat makes me strong!"
msgstr "고기가 나를 힘세게 만든다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATBALLS"
msgid "Ball of meats make me strong!"
msgstr "고기 공이 날 힘세게 만든다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.BURNT"
msgid "Cannot dry meat now."
msgstr "이제는 고기를 말릴 수 없다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE"
msgid "Yum, meaty leather!"
msgstr "냠, 고기 가죽이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Is very good and dry now!"
msgstr "잘 말랐다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING"
msgid "Dry meaty things! Dry!"
msgstr "말리는 고기 물건이구나! 말라라!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Go away, rain! Meat is drying!"
msgstr "가라, 비야! 고기가 마르고 있구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Sky tears is re-wetting Wolfgang's dry things!"
msgstr "하늘이 흘리는 눈물이 볼프강이 말린 거 다시 적신다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Wolfgang could punch water out, maybe?"
msgstr "볼프강이 주먹으로 물 쫓아낼까?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK.GENERIC"
msgid "For drying many meats!"
msgstr "고기를 많이 말릴 수 있다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "Cannot dry meat now."
msgstr "이제는 고기를 말릴 수 없다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "Will old lady be able to eat such tough meat?"
msgstr "할머니가 이렇게 질긴 고기 먹을 수 있냐?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "Is very good and dry now!"
msgstr "잘 말랐다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "Dry meaty things! Dry!"
msgstr "말리는 고기 물건이구나! 말라라!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "Go away, rain! Meat is drying!"
msgstr "가라, 비야! 고기가 마르고 있구나!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "Sky tears is re-wetting the dry things!"
msgstr "하늘이 흘리는 눈물이 말린 거 다시 적신다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "Wolfgang could punch water out, maybe?"
msgstr "볼프강이 주먹으로 물 쫓아낼까?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Is sad and meat-less."
msgstr "슬프다. 고기 없다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATYSALAD"
msgid "Need more than weird leaves to fill Wolfgang's mighty belly!"
msgstr "이상하게 생긴 이파리로는 볼프강의 힘센 배 채울 수 없다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEAT_DRIED"
msgid "Look like leather, taste like meat."
msgstr "가죽처럼 보이지만, 고기 맛이 난다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEGAFLARE"
msgid "Wolfgang will be careful with that one."
msgstr "볼프강은 저거 조심히 다룰 거다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM"
msgid "Is fishy man!"
msgstr "물고기처럼 생긴 사람이다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORHAT"
msgid "Is helmet special for fish man."
msgstr "물고기 사람만을 위한 투구다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "Is helmet special for fish man."
msgstr "물고기 사람만을 위한 투구다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD"
msgid "Not as mighty as Wolfgang!"
msgstr "볼프강만큼 힘세지 않다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_LUNAR"
msgid "Nice spiky fish man... Wolfgang is friend."
msgstr "착하지, 뾰족뾰족 물고기 사람... 볼프강 친구다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMGUARD_SHADOW"
msgid "Fighting fish man dutiful even in death."
msgstr "물고기 사람 전사, 죽어서도 싸운다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHAT"
msgid "Wolfgang will be biggest and strongest fish man!"
msgstr "볼프강이 물고기 사람 중에서 제일 크고 튼튼하다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.BURNT"
msgid "Not so nice looking now."
msgstr "이젠 상태가 안 좋다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHEAD.GENERIC"
msgid "What a handsome devil!"
msgstr "잘생긴 악마다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.BURNT"
msgid "The house was really not strong enough."
msgstr "집이 정말 너무 약했다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE.GENERIC"
msgid "The house was not strong enough."
msgstr "집이 너무 약했다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
