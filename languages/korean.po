msgstr ""

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_SECRET"
