msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHEALTH2"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER1"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXSANITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXSANITY"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXSANITY1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXSANITY1"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MOVESPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MOVESPEED"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MOVESPEED2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MOVESPEED2"
msgid "Are you the brightest bulb of the bunch?"
msgstr "네가 군계일학이야?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MUSIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MUSIC"
msgid "Are you the brightest bulb of the bunch?"
