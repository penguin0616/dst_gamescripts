msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COLD"
msgid "I'm... getting freezer burn..."
msgstr "나... 얼어붙고 있어..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COMPASS_OUT"
msgid "Oh. I believe it broke."
msgstr "아, 망가진 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_COZY_SLEEP"
msgid "Ah, what lovely dreams I had!"
msgstr "아, 정말 행복한 꿈이었어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_CRAFTING_FAIL"
msgid "I am lacking the required ingredients."
msgstr "필요한 재료가 모자라."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DAMP"
msgid "I've been lightly spritzed."
msgstr "약간 젖었어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DEERCLOPS"
msgid "I do not like that sound one bit!"
msgstr "소리가 전혀 마음에 들지 않아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DESPAWN"
msgid "I'm going to the kitchen in the sky."
msgstr "하늘에 있는 주방으로 갈래."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Erm... I think I'm more of a food lover than a fighter after all."
msgstr "어... 난 싸움보다 요리가 더 좋은 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Oh well, I prefer natural gas over electric anyway."
msgstr "뭐, 어차피 난 전기보다 천연가스가 더 좋아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Is it getting a bit soggy in here?"
msgstr "안이 조금 축축해졌나?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Ah... I've gone from tough to tender."
msgstr "아… 맷집이 사라졌네."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Oh dear, I seem to be getting a bit tired after all..."
msgstr "이것 참, 점점 지쳐가는 것 같아서..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "Ah non, I think I'm losing steam."
msgstr "아 이런, 작업 능률이 떨어진다."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "I hope that helps."
msgstr "도움이 됐으면 좋겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_DUSK"
msgid "The dinner hour approaches."
msgstr "곧 저녁 먹을 시간이야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.COOKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.COOKED"
msgid "Not very palatable."
msgstr "딱히 맛있지는 않아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.DRIED"
msgid "A bit dry."
msgstr "건조하네."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.GENERIC"
msgid "Magnifique!"
msgstr "굉장해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.INVALID"
msgid "Clearly inedible."
msgstr "전혀 먹을 수 없어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PAINFUL"
msgid "Aarg! My stomach..."
msgstr "아이고, 배야..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PREPARED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.PREPARED"
msgid "Delectable!"
msgstr "맛있다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.RAW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.RAW"
msgid "Blech. Completely lacking in every way."
msgstr "우웩. 모든 면에서 형편없어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_1"
msgid "I'd prefer some variety."
msgstr "좀 다른 음식을 먹고 싶어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_2"
msgid "So bland."
msgstr "지겨워."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_3"
msgid "I want to eat something different."
msgstr "뭔가 다른 걸 먹고 싶어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_4"
msgid "I can't stand this food."
msgstr "이건 너무 질렸어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SAME_OLD_5"
msgid "Enough already!"
msgstr "더는 못 먹겠어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.SPOILED"
msgid "Blech! Why did I allow that to cross my lips?"
msgstr "우웩! 내가 왜 이걸 입에 넣었지?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.STALE"
msgid "That was past its best-by date..."
msgstr "유효 기간이 지난 거였어..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.TASTY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.TASTY"
msgid "Tres magnifique!"
msgstr "정말 굉장해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EAT.YUCKY"
msgid "I'm frankly offended by the mere suggestion."
msgstr "이건 나에 대한 모독이야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EATING_NOT_FEASTING"
msgid "The others might enjoy this!"
msgstr "다른 친구들이 좋아할지도 몰라!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_BOOSTED"
msgid "It is no Maman's chicken soup."
msgstr "어머니의 닭고기 수프엔 비할 게 못 되는군."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "How terrible it must be when one no longer recognizes the world around them."
msgstr "더는 주변 세상을 인식할 수 없다니, 얼마나 끔찍할까."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I could lift a cow!"
msgstr "소도 들어 올릴 수 있겠어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "Trop fort!"
msgstr "너무 강해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.1"
msgid "I'm not... built for this..."
msgstr "내 몸은... 이런 데 안 익숙해..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.2"
msgid "I bet... this is burning some calories..."
msgstr "덕분에... 칼로리가 소모되겠군..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.3"
msgid "Oof!"
msgstr "윽!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.4"
msgid "Hrrrr..."
msgstr "흐으으..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.5"
msgid "Mon dieu!"
msgstr "세상에나!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.6"
msgid "I'm working up... an appetite!"
msgstr "식욕이... 마구 오른다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.7"
msgid "So... heavy!"
msgstr "너무... 무거워!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.8"
msgid "I am strong... like flour!"
msgstr "난 강해... 밀가루처럼!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENCUMBERED.9"
msgid "HRR!"
msgstr "흐으!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_DARK"
msgid "Darkness, darkness."
msgstr "어둠, 어둠."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ENTER_LIGHT"
msgid "A new day comes with the dawning light."
msgstr "아침 해와 함께 새로운 날이 시작되지."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EXIT_GELBLOB"
msgid "Evil jelly!"
msgstr "사악한 젤리야!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Why do I suddenly feel such a sinking feeling in my stomach..."
msgstr "왜 갑자기 위장이 가라앉는 느낌이 들지..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Leaving before breakfast?"
msgstr "아침 식사 전에 떠나?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Ah, it's back! Not going out without a fight, it seems."
msgstr "아, 돌아왔구나! 싸우지 않고는 밖으로 나가지 않나 봐."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FAN_OUT"
msgid "It fell apart in my hands!"
msgstr "내 손 안에서 부서졌어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "If it goes into the food we eat, I suppose I should know everything about it."
msgstr "먹는 음식에 들어간다면 다 알고 있어야 할 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Mon dieu, I feel as though my insides are boiling!"
msgstr "몽 듀(맙소사), 속이 끓어오르는 것 같아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "This strange heat... I wonder if this is how crabs feel when they're boiled."
msgstr "이상하게 덥네...게를 삶으면 이런 기분일까."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Whew, I'm very glad that's over."
msgstr "휴, 끝나서 정말 다행이야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLARE_SEEN"
msgid "What's this? Someone's trying to get our attention."
msgstr "뭐지? 누가 우리 주의를 끌려고 하잖아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLOATER_HELD"
msgid "I feel like a dumpling!"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FLOATER_LETGO"
msgid "Was that wise?"
msgstr ""

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FOODMEMORY"
msgid "\nI'd rather not eat the same old thing again."
msgstr "\n매번 먹던 걸 또 먹느니 굶겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_FREEDOM"
msgid "Freeeeeeee!"
msgstr "자유다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOSTDRAIN"
msgid "My, I have a headache."
msgstr "이런, 머리가 아파."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "It's time for a second course of Acid Repellent."
msgstr "산 억제제를 다시 발라야겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HIGHRESEARCH"
msgid "My brain is tingling!"
msgstr "두뇌가 근질근질해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOT"
msgid "I'm baking like a soufflé here..."
msgstr "내가 수플레가 되어 구워지는 것 같은 더위야..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HOUNDS"
msgid "I recognize that sound. Hunger."
msgstr "익숙한 소리야. 바로 배고픔의 소리지."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNGRY"
msgid "I need food..."
msgstr "음식이 필요해..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_AVOID_FORK"
msgid "This trail might be safer, non?"
msgstr "이 흔적이 더 안전하지 않을까?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "Game is close at hand..."
msgstr "사냥감이 근처에 있어..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "I have lost the trail."
msgstr "흔적을 놓쳤어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "The trail has been washed out."
msgstr "흔적이 지워졌어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_START_FORK"
msgid "Oh my... that trail looks a bit dangerous for my taste..."
msgstr "세상에... 저 흔적은 내 입맛에는 조금 위험해 보이는걸..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "It's close, I've nearly got it!"
msgstr "아주 가까워. 거의 다 됐어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Mon dieu, I have the most terrible feeling..."
msgstr "세상에나. 정말 끔찍한 느낌이야..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It requires more manure."
msgstr "비료가 더 필요해."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_INV_FULL"
msgid "I cannot carry another stitch."
msgstr "더는 아무것도 못 들겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_IS_FEASTING"
msgid "Winter's Feast is served!"
msgstr "겨울 축제가 준비됐어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Oh! Bonjour petit chat!"
msgstr "오! 봉주르 쁘띠 샤!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Voilà!"
msgstr "야호!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "There you are mon petit chat!"
msgstr "거기 있구나 몽 쁘띠 샤!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Ah, there you are!"
msgstr "아, 거기 있었어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Bonjour, I see you!"
msgstr "봉주르, 네가 보여!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Et voilà! The last petit chat."
msgstr "에 브알라! 마지막 쁘띠 샤다."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "Ah, {name} found them at last!"
msgstr "아, {name} 녀석이 끝끝내 찾아낸 거야!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "There should only be one left."
msgstr "한 마리 밖에 안 남았겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Well, I suppose I'll just have to do better next time."
msgstr "음, 다음엔 더 잘해야 할 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "The game will be finished soon."
msgstr "게임이 곧 끝나겠네."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I think I might have wandered too far..."
msgstr "너무 멀리서 헤매고 있었던 것 같아..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Hmm, they should be around here somewhere..."
msgstr "흠, 여기 근처 어딘가에 있을 텐데..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Might I join in, s'il vous plait?"
msgstr "함께 해도 될까, 씰 부 쁠레?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Three, two, one... allons-y!"
msgstr "셋, 둘, 하나... 알룽-지!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Something's coming!"
msgstr "뭔가 오고 있다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_ENRAGE"
msgid "Our egg's been beat! Run!"
msgstr "이런, 잘못 건드렸다! 도망쳐!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its shackles fell away!"
msgstr "굴레가 벗겨졌잖아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KNOCKEDOUT"
msgid "My head... spinning..."
msgstr "머리가... 빙글빙글 도네..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "That was much too close!"
msgstr "정말 아슬아슬했어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LOWRESEARCH"
msgid "I did not learn any new tricks from that."
msgstr "아무것도 새로 배우지 못했어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Déjà vu."
msgstr ""

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "What could that glow be?"
msgstr "저 빛은 대체 뭘까?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That flare is sure to entice anything nearby."
msgstr "저 조명탄이 주변에 있는 걸 전부 끌어들일 거야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_1"
msgid "I'm beginning to feel a bit unwell..."
msgstr "몸 상태가 조금 안 좋은 것 같은데..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Mon dieu, I've become a monkey!"
msgstr "세상에나, 원숭이가 되어버렸잖아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "I don't think I'll be cooking with bananas for a while..."
msgstr "한동안 바나나 요리는 안 할 거야..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Nearly there, mon ami!"
msgstr "거의 다 됐어, 친구!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Something looks to be trapped inside."
msgstr "안에 뭔가 있는 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Taste sweet freedom!"
msgstr "달콤한 자유를 맛보렴!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Nearly there, mon ami!"
msgstr "거의 다 됐어, 친구!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Something looks to be trapped inside."
msgstr "안에 뭔가 있는 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Taste sweet freedom!"
msgstr "달콤한 자유를 맛보렴!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Nearly there, mon ami!"
msgstr "거의 다 됐어, 친구!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Something looks to be trapped inside."
msgstr "안에 뭔가 있는 것 같아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Taste sweet freedom!"
msgstr "달콤한 자유를 맛보렴!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOONPOTION_FAILED"
msgid "Perhaps that is for the best."
msgstr "이게 최선일지도."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOSQUITOS"
msgid "Disease with wings!"
msgstr "날개 달린 질병 덩어리!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "My poor sirloin's not looking so good!"
msgstr "가엾은 등심의 상태가 안 좋아 보여!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERGIFT"
msgid "I would like to not die first."
msgstr "먼저 죽고 싶지는 않아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSIESTA"
msgid "This is no time to close my eyes!"
msgstr "지금은 눈을 감을 때가 아니야!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODANGERSLEEP"
msgid "In this particular instance I'd prefer not to die in my sleep!"
msgstr "자다가 죽는 건 사양이야!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP"
msgid "It is too bright to sleep."
msgstr "너무 밝아서 잘 수 없어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not tired."
msgstr "피곤하지 않다."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSIESTA"
msgid "I could use a nice meal first."
msgstr "일단 속을 든든히 채워야겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOHUNGERSLEEP"
msgid "My hunger trumps my exhaustion."
msgstr "지친 것보다 배고픈 게 더 문제야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOMOUNTEDGIFT"
msgid "First I should get down from this big sirloin here."
msgstr "일단 이 커다란 등심에서 내려가야 해."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA"
msgid "Siesta in the dark? I think not."
msgstr "어둠 속에서 낮잠이라고? 말도 안 돼."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "This does not strike me as a relaxing place for siesta."
msgstr "별로 낮잠 자기 적당한 곳은 아닌 듯."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "You were too beautiful for this world."
msgstr "넌 이 추악한 세상에는 어울리지 않았어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "I can still see the light from our metal friend when I close my eyes..."
msgstr "눈을 감아도 쇳덩이 친구에게서 나오는 빛이 보여..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOSLEEPONFIRE"
msgid "I think not! That's a hotbed for danger!"
msgstr "안 돼! 위험하다고!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Fire!"
msgstr "발사!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_NO_TRAP"
msgid "Went off without a hitch."
msgstr "완벽했어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Ah non, that was terrible!"
msgstr "이런, 정말 끔찍했어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "You have escaped my crockpot for now, mon ami."
msgstr "지금은 내 냄비에 들어가는 신세를 면했구나, 친구."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Fishing requires lots of patience."
msgstr "낚시는 엄청난 인내심을 요하지."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Fish! Wouldn't you like to sample my hook?"
msgstr "물고기야! 내 바늘 좀 맛보지 않을래?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Hum dum dee da..."
msgstr "음흠흠..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I wonder if there's a better spot elsewhere."
msgstr "더 좋은 자리가 있으려나 모르겠네."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah, zut! I've lost my tackle."
msgstr "이런! 도구를 잃어버렸어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "I should tighten my line a bit."
msgstr "줄을 조금 더 팽팽하게 해야겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Oh? What could that be?"
msgstr "어? 저게 뭘까?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OFF_SCRIPT"
msgid "Everyone wants to add their own flavor to a role."
msgstr "누구나 역할에 자기만의 '맛'을 입히고 싶어하지."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "It's crumbling without the centerpiece!"
msgstr "대들보가 사라져서 무너지고 있군!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Zut, going this far out to sea was a recipe for disaster."
msgstr "이런! 이렇게 바다 멀리 나오는 건 재앙을 부르는 레시피였군."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PECKED"
msgid "Gah! Enough!"
msgstr "윽! 그만해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PETRIFED_TREES"
msgid "Are the trees making that sound?"
msgstr "나무가 내는 소리인가?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "It has a most un-delicious smell."
msgstr "엄청 맛없을 것 같은 냄새가 나."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PIRATES_ARRIVE"
msgid "Oh, zut alors..."
msgstr "이런..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RANDOMSEED"
msgid "I wonder what it will turn out to be."
msgstr "어떤 결과가 나올지 궁금해."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I've learned a little something about this plant."
msgstr "이 식물에 대해 조금 배웠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Mon dieu, somehow that made me a bit seasick..."
msgstr "몽 듀(맙소사), 어쩐지 배멀미가 났어..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_PREFALLINVOID"
msgid "It is not the fall that kills you..."
msgstr "추락하는 것은 날개가 있다더니..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_QUAKE"
msgid "That is not a comforting sound..."
msgstr "아무래도 불안하게 만드는 소리인데..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Perhaps the accoustics are not ideal here."
msgstr "여긴 음향 환경이 안 좋은 걸지도."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Something unpleasant brewing below."
msgstr "밑에서 뭔가 불쾌한 게 부글대고 있군."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_LUCKY"
msgid "That is a rare rabbit, indeed!"
msgstr "아주 희귀한 토끼군!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Voilà! Got you!"
msgstr "야호! 잡았다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RABBITKING_PASSIVE"
msgid "I hear a gentle rustling beneath our feet."
msgstr "우리 발밑에서 바스락거리는 소리가 들려."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REPELLED"
msgid "I can't get through!"
msgstr "통과할 수 없어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RESEARCH"
msgid "Education is a lifelong process."
msgstr "교육이란 평생에 걸쳐서 이뤄지는 과정이지."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Do I smell pie?"
msgstr "파이 냄새가 나는 것 같은데?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Et voilà!"
msgstr "됐다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, mon amie."
msgstr "기다려, 친구."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.1"
msgid "Mon Empereur!"
msgstr "황제이시여!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.2"
msgid "Your Grace."
msgstr "각하."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY.3"
msgid "Your Excellency."
msgstr "합하."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Mon \"Empereur\"!"
msgstr "'황제'이시여!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Your \"Grace\"."
msgstr "'각하'."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Your \"Excellency\"."
msgstr "'전하'."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_RUINS_RESET"
msgid "The terrible monsters are back!"
msgstr "끔찍한 몬스터들이 돌아왔다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_NO"
msgid "Apologies for my shortcomings."
msgstr "내가 부족해서 미안해."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SACREDCHEST_YES"
msgid "Merci beacoup!"
msgstr "메르시 보꾸!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SCRAPBOOK_FULL"
msgid "My scrapbook is already filled to the brim."
msgstr "내 스크랩북이 이미 가득 찼어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Non non, I refuse to be a delicious morsel!"
msgstr "안 돼, 먹히고 싶지 않아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that eerie glow?"
msgstr "저 오싹한 빛은 뭐지?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SHELTER"
msgid "I am thankful for this tree's protective buffer."
msgstr "이 나무집의 보호가 참 고맙네."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED"
msgid "Ouch! How rude!"
msgstr "아얏! 정말 너무하네!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNARED_IVY"
msgid "You think you can come between me and my fresh ingredients, mon ami?"
msgstr "나와 내 신선한 재료 사이를 이간질할 수 있다고 생각해, 몽 아미(친구)?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's not enough snow here!"
msgstr "여긴 눈이 부족해!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "I'm afraid it won't get any bigger."
msgstr "아쉽지만 더 크게는 못 만들어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SOAKED"
msgid "I'm wetter than a dish rag!"
msgstr "행주보다 더 흠뻑 젖어버렸어!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_SPOOKED"
msgid "Eee!"
msgstr "으아악!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Bonjour! Parlez-vous francais?"
msgstr "봉쥬르(좋은 아침)! 팔레 부 프랑셰(불어 할 줄 알아)?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "May you grow big, ripe and delicious."
msgstr "크게 잘 익어서 맛있어 지기를."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "My, you look fresh as a daisy today mon ami!"
msgstr "어머, 오늘 데이지처럼 상큼해 몽 아미!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "What a good little plant you are."
msgstr "넌 정말 훌륭한 식물이구나."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "How are you today, mon ami? Everything growing well?"
msgstr "오늘 어때, 몽 아미(친구)? 모두 잘 자라고 있니?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_THORNS"
msgid "Gah!"
msgstr "앗!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_THURIBLE_OUT"
msgid "Out of fuel."
msgstr "연료가 바닥났어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_ABANDONED"
msgid "I think perhaps it's time for a break. Au revoir!"
msgstr "지금 쉬어야 할 것 같아. 오 흐브아!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_DEAD"
msgid "Oh my, that must have been his ninth life..."
msgstr "세상에, 아홉 번째 생이 틀림 없어..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Oh! Do you smell something, monsieur?"
msgstr "오! 무슨 냄새 안나, 무슈?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Ah, he seems to have lost the trail."
msgstr "아, 흔적을 놓쳤나 봐."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "I have a feeling we're very close."
msgstr "아주 가까이 있다는 느낌인데."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Perhaps there are no petits chats around to track."
msgstr "흔적 근처에는 아마 쁘띠 샤가 없을 거야."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_START_TRACKING"
msgid "Allons-y, monsieur! I'll be close behind."
msgstr "알룽-지, 무슈! 바로 뒤에 가까이 있을게."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Just a moment, I'm coming!"
msgstr "잠깐, 내가 왔다."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPED"
msgid "It's going to leave soon."
msgstr "곧 떠나겠어."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOADESCAPING"
msgid "Was it something I said?"
msgstr "내가 말실수라도 했나?"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_SLIP"
msgid "Everything is slick..."
msgstr "모든 게 다 너무 미끈거려..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOOL_TOOWEAK"
msgid "No, this won't do..."
msgstr "아니, 이걸로 안 돼."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TORCH_OUT"
msgid "Come back, light!"
msgstr "불빛아, 돌아와!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Bonjour! I've arrived!"
msgstr "봉주르! 도착했다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TRAP_WENT_OFF"
msgid "Darn!"
msgstr "쳇!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_UNIMPLEMENTED"
msgid "It is not operational yet."
msgstr "아직 작동하지 않아."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WASHED_ASHORE"
msgid "Land! I'm saved!"
msgstr "육지야! 살았다!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEAK_RAT"
msgid "Quel dommage, I think it's gone off."
msgstr "이런, 없어진 것 같아."

