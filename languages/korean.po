msgid "Isabella"
msgstr "이사벨라"

#. STRINGS.MERMNAMES.33
msgctxt "STRINGS.MERMNAMES.33"
msgid "Madeline"
msgstr "메들린"

#. STRINGS.MERMNAMES.34
msgctxt "STRINGS.MERMNAMES.34"
msgid "Michael"
