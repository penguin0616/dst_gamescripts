msgstr "볼프강 소름 돋는다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTGRASS"
msgid "Is pile of grass."
msgstr "풀 무더기다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLESS"
