msgid "All that work, up in smoke..."
msgstr "기껏 열심히 했는데, 연기와 함께 사라졌다..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "Hm, I should teach that kid how to use a level."
msgstr "수평기 쓰는 법을 가르쳐줘야겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMKING"
msgid "Are you the boss around here?"
msgstr "네가 대장이냐?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE.BURNT"
msgid "Yeesh, what a mess."
msgstr "윽, 엉망진창이다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Not bad handiwork."
msgstr "솜씨가 나쁘지 않다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Guess it's back to the drawing board."
msgstr "계획을 다시 짜야겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "Whatcha makin' there, kid?"
msgstr "뭐 만드니, 꼬마야?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "It looks kinda gloomy."
msgstr "우울해 보인다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Now that's a proper tree fort!"
msgstr "이거야말로 훌륭한 나무 요새지!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_ARMORY"
msgid "Get your merm hats here!"
msgstr "여기서 어인 모자를 구할 수 있어!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "Get your merm hats here!"
msgstr "여기서 어인 모자를 구할 수 있어!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_LUNAR"
msgid "You're a rather prickly one, ain't ya?"
msgstr "아주 성질이 못된 녀석이구나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_PRINCE"
msgid "Looks like someone got a promotion!"
msgstr "승진했나 보군!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_SHADOW"
msgid "Can't seem to catch a break, can ya?"
msgstr "지칠 줄 모르는 녀석이구나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOL"
msgid "Should get the job done... I hope."
msgstr "이거면 될 거야... 아마도."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOLSHED"
msgid "I know a toolshed when I see one."
msgstr "딱 봐도 도구 창고네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "I know a toolshed when I see one."
msgstr "딱 봐도 도구 창고네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "It's an improvement."
msgstr "나아졌군."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MESSAGEBOTTLE"
msgid "Wonder where this came from?"
msgstr "어디에서 왔는지 궁금하다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "Might as well reuse this."
msgstr "재사용하는 편이 좋겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "Aw shoot, I hope the big guy isn't too upset."
msgstr "아, 덩치 큰 녀석이 너무 화를 내지는 않았으면 좋겠어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "I might've helped him a little bit on the mechanical side of things."
msgstr "기계적 측면에서는 조금 도와준 걸 수도."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MILKYWHITES"
msgid "That's not appetizing.."
msgstr "맛없어.."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT"
msgid "I put that behind me."
msgstr "저걸 쓰던 시절은 지났다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN"
msgid "Nice to have some more light out here on the water."
msgstr "바다에 나갈 때 조명이 더 있으면 좋다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN"
msgid "Swirly."
msgstr "빙글빙글 돈다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFLARE"
msgid "Safety in numbers, hey?"
msgstr "뭉치면 안전하겠지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC"
msgid "Cutesy little drawing."
msgstr "귀여운 낙서가 그려져 있다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN"
msgid "What good's a blank sign?"
msgstr "표지판에 아무것도 안 쓰여 있으면 무슨 소용이지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM"
msgid "I hate handmade stuff."
msgstr "손으로 만든 물건은 싫다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR"
msgid "I've had about enough of terrible beasts!"
msgstr "끔찍한 짐승은 이제 지긋지긋하다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST"
msgid "Maybe there's loot inside."
msgstr "안에 쓸 만한 게 있을지도 모른다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN"
msgid "That's a doozy!"
msgstr "근사하다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Taking a break from the mines?"
msgstr "땅 파다 말고 쉬고 있니?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD"
msgid "I love it."
msgstr "마음에 든다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND"
msgid "Dutiful little miner."
msgstr "열심히 일하는 작은 광부다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBAT"
msgid "I think it nose a thing or two. Ha!"
msgstr "한 두 가지 코를 박고 찾는 거 같아. 하!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBATHILL"
msgid "Might be some good materials stuck in that gunk."
msgstr "그 덩어리에 좋은 재료가 박혀있을 지도 몰라."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT"
msgid "A real strange contraption."
msgstr "정말 기묘한 장치다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL"
msgid "The excavation crew's down there."
msgstr "아래에 채굴팀이 있군."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY"
msgid "No monkeying around on the job."
msgstr "작업하는 데 방해만 하지 마라."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL"
msgid "Ha! Smells like me after a full shift!"
msgstr "크윽! 온종일 일하고 나면 나는 냄새가 난다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.BURNT"
msgid "I don't think it was up to code."
msgstr "화재 안전 규정을 안 지킨 모양이야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Looks pretty rickety to me."
msgstr "금방이라도 무너질 것 같은데."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "Something ain't right about it."
msgstr "뭔가 이상해."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "This looks like the bossman's... but what was he doing out here?"
msgstr "저건 사장의... 그런데 사장은 여기서 뭘 하던 거지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYPILLAR"
msgid "Looks shoddy, but it's stable somehow."
msgstr "조잡해 보이는데 어째서인지 안정적이야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYQUEEN"
msgid "She must be one of the higher-ups."
msgstr "지위가 높은 녀석인 게 분명해."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYTAIL"
msgid "Those are some tall tails, I tell ya!"
msgstr "꼬리 참 기네!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Dress for the job you want."
msgstr "원하는 직업에 맞게 차려입어야 하는 법이지."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT"
msgid "Keeps the sun off your head and the hair outta your face."
msgstr "햇빛으로부터 머리를 보호해 주고, 머리카락으로부터 얼굴을 보호해 줘."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA"
msgid "Not sure meat's supposed to be that color."
msgstr "고기가 저런 색이라도 괜찮을지 모르겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT"
msgid "Hooboy! Is that even meat?"
msgstr "하앗! 저게 고기인가?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Drying didn't help none."
msgstr "건조해도 별로 달라진 게 없다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE"
msgid "I'm all for getting my daily iron but this goes too far."
msgstr "철분 섭취는 좋지만, 이건 너무 나갔다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN"
msgid "In need of a good fixin'!"
msgstr "제대로 고쳐야겠다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC"
msgid "I don't think it's done yet."
msgstr "아직 안 됐다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Moonlight's good for the complexion, hey?"
msgstr "달빛이 피부에 좋다고 하지 않았나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED"
msgid "Job well done! Now what?"
msgstr "됐다! 이제 어떻게 되는 거지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hm. This wasn't assembled right."
msgstr "흠. 제대로 되지 않았다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Cute little fella, aintcha?"
msgstr "귀여운 친구네?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "So... you like engineerin'?"
msgstr "혹시... 공학 좋아해?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "They ain't flyin' no more."
msgstr "이제 못 날겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It'll be a nice tree someday."
msgstr "언젠가 멋진 나무가 될 거다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE"
msgid "It was impractical to build this here."
msgstr "여기에다 짓는 건 무의미한 것 같은데."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC"
msgid "Must be broke. I can still see the moon."
msgstr "고장난 것 같다. 아직도 달이 보인다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED"
msgid "Why do I get the feeling something's watchin' me..."
msgstr "뭔가가 나를 지켜보고 있다는 느낌이 드는 이유는..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Full as can be."
msgstr "다 찼다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Brand spanking new moon."
msgstr "새로운 달이다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's waning."
msgstr "지고 있다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing."
msgstr "차고 있다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS"
msgid "Can't wait to try this out."
msgstr "얼른 시험해 보고 싶다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE"
msgid "Anything to make gettin' firewood easier."
msgstr "장작을 쉽게 얻을 수만 있다면 뭐든 좋다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED"
msgid "I'd better hustle, the energy's not gonna last long."
msgstr "서두르는 게 좋겠어. 에너지가 오래 가지 않을 거야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK"
msgid "Wonder if it's got any special properties."
msgstr "특별한 성질이 있는지 궁금하다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "Wonder what lives in there?"
msgstr "저 안에 뭐가 사는지 궁금하지 않아?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER"
msgid "A rock with a hole in it."
msgstr "구멍이 있는 바위다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL"
msgid "Do I gotta offer it up to something?"
msgstr "무언가에게 제물로 바쳐야 하나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET"
msgid "Woah! What an odd texture."
msgstr "엇! 이상한 질감이다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED"
msgid "I could learn a thing or two from this."
msgstr "이걸로 무언가 새로운 걸 배울 수 있겠다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES"
msgid "That's... strange."
msgstr "뭔가... 이상하다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN"
msgid "I don't wanna see whatever's in there."
msgstr "저 안에 뭐가 있는지 보고 싶지 않다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "That's some good, workable material there."
msgstr "거기에 작업하기 좋은 재료가 있어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "It's been powered up."
msgstr "전원이 켜졌다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "You work with the materials you've got out here."
msgstr "여기 꺼내온 재료로 작업하는 구나."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK"
msgid "Not quite electricity, but it could still work..."
msgstr "전기가 충분하지는 않지만 아직은 작동 할 수 있어..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC"
msgid "Looks like an electrical fire waiting to happen."
msgstr "전기 화재가 일어나기를 기다리고 있는 것 같네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "The boss really does have a gadget for everything."
msgstr "보스에게는 정말 모든 것을 할 수 있는 도구가 있어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Inventions? What sort of inventions?"
msgstr "발명품인가? 무슨 발명품이지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Don't worry, we're nearly done."
msgstr "걱정하지 마, 거의 끝났어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "All the pieces are finally in their proper place."
msgstr "모든 조각이 마침내 제자리에 있네."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "Can't shake the feeling that this is all building up to somethin'..."
msgstr "뭔가를 꾸미고 있다는 생각을 떨칠 수 없다..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Don't worry, I'll get you where you need to go."
msgstr "걱정하지 마, 있어야 할 곳에 데려다줄게."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Huh? You talkin' to me?"
msgstr "으음? 나한테 말을 거는 거야?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON"
msgid "Now what were you doin' hiding underground?"
msgstr "지금 지하에 숨어서 뭐하고 있었어?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL"
msgid "I'll fix ya up right proper!"
msgstr "제대로 고쳐줄게!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK"
msgid "Looks like it's still under construction."
msgstr "아직 공사 중인 것 같아."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Somethin' inside is itching to get out."
msgstr "안에서 뭔가 나오고 싶어 한다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Somethin' inside is itching to get out."
msgstr "안에서 뭔가 나오고 싶어 한다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Somethin' inside is itching to get out."
msgstr "안에서 뭔가 나오고 싶어 한다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED"
msgid "You're a pretty lil fella."
msgstr "예쁜 친구구나."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD"
msgid "Let's getcha fixed up."
msgstr "고쳐보자."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP"
msgid "Anyone wanna volunteer to try it?"
msgstr "자원해서 해보고 싶은 친구?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED"
msgid "Wouldn't have minded having some of these around when I was pulling overtime."
msgstr "초과 근무를 하고 있을 때는 이런 것들이 주변에 있어도 꺼리지 않았을 거야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "Feels kinda like old times back at the factory."
msgstr "마치 옛날에 공장에서 일하던 때로 돌아간 듯한 느낌이 들어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "Well, it's not shaping up to be a portal. I was hopin' the boss had figured out a way back..."
msgstr "글쎄, 그걸로는 포털이 생기지 않을 걸. 보스가 방법을 찾았길 바라..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Wonder what the boss is gonna use all this energy for?"
msgstr "보스가 이 에너지를 전부 무엇에 쓸지 궁금해?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Hm, wonder if I could use this energy somehow."
msgstr "흠, 이 에너지를 어떻게든 활용할 수 있을까?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Wonder how far down it goes."
msgstr "깊이가 얼마나 될까."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "That old lady's more resourceful than I gave her credit for."
msgstr "그 할머니는 내 생각보다 기지가 뛰어나다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "이런, 불이 붙었다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT"
msgid "Looks like there was an accident here."
msgstr "여기서 사고가 일어난 모양이다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Don't worry, we'll put it to good use."
msgstr "걱정하지 마. 좋은 곳에 쓸게."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC"
msgid "Sure is pretty, ain't it?"
msgstr "너무 예쁘다. 그렇지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "The trees sure are pretty 'round here."
msgstr "이곳의 나무는 아주 예쁘다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE"
msgid "Oh, mama!"
msgstr "으악, 깜짝이야!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG"
msgid "Animals don't build things well."
msgstr "동물은 원래 집 짓는 솜씨가 별로지."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "That's where the mom keeps her babies."
msgstr "어미가 새끼를 두는 장소다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA"
msgid "What's this fancy stuff? I like it!"
msgstr "이 근사한 물건은 뭐지? 마음에 든다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC"
msgid "Once you've dealt with bedbugs, mosquitoes aren't so bad."
msgstr "빈대를 극복하고 나면 모기는 아무것도 아니다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD"
msgid "Stop wriggling, it's gross."
msgstr "꿈틀대지 마, 징그럽다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB"
msgid "Talk about a buzz-kill. Ha!"
msgstr "소리만 들어도 몸이 가려운걸!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Just throw a healthy dollop on the ground."
msgstr "바닥에 조금 던지기만 하면 돼."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE"
msgid "I almost feel sorry for the bloodsucker. Almost."
msgstr "이 피 빨이 녀석이 거의 불쌍할 정도야. \"거의\"."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK"
msgid "Somehow it's still not the creepiest doll I've seen."
msgstr "놀랍지만, 이것보다 소름 끼치는 인형도 봤어."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK"
msgid "Ha. That's real gross."
msgstr "크윽! 정말 징그럽다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING"
msgid "Don'tcha just wanna noogie it?"
msgstr "아주 그냥 꼬옥 껴안아주고 싶지 않나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG"
msgid "Just a hole now."
msgstr "지금은 평범한 구덩이다"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC"
msgid "Anything good in there, ya think?"
msgstr "안에 괜찮은 게 있을까?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK"
msgid "I ain't one to pull my punches... but I'll mull them! Ha!"
msgstr "원래 펀치는 좋아하지 않지만... 이건 설탕에 \"물드\"렀으니 괜찮아! 하하!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "That was a one-way ticket."
msgstr "편도 티켓이었다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Wow. Can't even see the weld joints."
msgstr "우와. 용접 부위가 보이지도 않는다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "That's really not my forte."
msgstr "이건 내 전문이 아니다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME"
msgid "Strange, no matter how you spin it."
msgstr "어떻게 돌려봐도 이상해."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB"
msgid "Fire in the hole!"
msgstr "폭발 주의!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT"
msgid "Really?"
msgstr "정말?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "That seemed like a waste."
msgstr "아깝다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Now that's a big mushroom!"
msgstr "커다란 버섯이다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "All burned up."
msgstr "다 타버렸다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Nothing yet."
msgstr "아직 아무것도 없다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Looks like a pretty good yield."
msgstr "풍작으로 보인다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Not much use with a dead log."
msgstr "죽은 통나무는 이제 쓸모없다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "It's real cold out."
msgstr "정말 춥다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "We've got our first mushrooms!"
msgstr "첫 번째 버섯이다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Lookit all that fungus."
msgstr "버섯이 참 많다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Roasted."
msgstr "불타버렸다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Where's the plug?"
msgstr "플러그가 어딨지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "How's it work without circuitry?"
msgstr "전기 회로 없이 어떻게 작동하지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Roasted."
msgstr "불타버렸다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Is there an \"on\" switch?"
msgstr "스위치로 작동하는 건가?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "It lights up, even without filament."
msgstr "필라멘트도 없이 켜진다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "저 역겨운 악취는 대체 뭐지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "Stink."
msgstr "악취 난다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "That's a big mushroom!"
msgstr "커다란 버섯이다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MOON"
msgid "Now that's a weird looking mushroom."
msgstr "지금 그건 이상하게 생긴 버섯이야."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "저 역겨운 악취는 대체 뭐지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Not a fan of the smell."
msgstr "냄새가 안 좋다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I guess they grow better down here?"
msgstr "여기서 더 잘 자라는 모양인데?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "저 역겨운 악취는 대체 뭐지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Whew. That's an odor."
msgstr "휴. 냄새 독하다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "It's huge!"
msgstr "거대하다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "저 역겨운 악취는 대체 뭐지?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "There's spiders in the crawlspace."
msgstr "잘 보면 틈에 거미가 있다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBEARGER"
msgid "Grumpy hasn't had his mornin' cup of joe yet."
msgstr "아침에 커피를 안 마셔서 기분이 안 좋은가 봐."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDDEERCLOPS"
msgid "Shoulda wore safety goggles. Or is it goggle?"
msgstr "안전 고글을 썼어야지. 평범한 고글이 눈에 맞기는 하려나?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "Sorry, Fido."
msgstr "미안하게 됐다, 멍멍아."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "That pup looks awful!"
msgstr "강아지, 참 끔찍해 보인다!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Well, it looks more peaceful at least."
msgstr "뭐, 최소한 평화로워 보이기는 한다."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDWARG"
