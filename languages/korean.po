msgid "Tell us a joke!"
msgstr "농담 하나 해줘!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "다 돌아왔다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "하지만 선물이었는데!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "우리를 좋아한다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "We already filled up our scrapbook."
msgstr "우린 이미 스크랩북을 다 채웠어."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! No fair! We can't see you!"
msgstr "아야! 불공평해! 우린 너 안 보인다고!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that creepy light?"
msgstr "그 오싹한 빛은 뭐지?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "우리를 보호해 줘, 나무야!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "야! 못됐어!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY"
msgid "Hey! Let go!"
msgstr "이봐! 가게 둬!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Where's more snow?"
msgstr "눈이 더 필요한데, 어디 있지?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "We can't roll it any bigger!"
msgstr "더 굴려도 안 커져!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "몽땅 젖었다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Are we seeing things?!"
msgstr "설마 헛것이 보이는 건가?!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "안녕 식물들! 오늘 어떠니?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Aww, are you lonely? We'll keep you company!"
msgstr "에이, 쓸쓸하니? 친구로 지내자!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "One day you're going to grow up big and strong... and then we'll eat you!"
msgstr "언젠가 넌 크고 강해지겠지... 그러면 널 잡아먹을 거야!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You are a very good plant."
msgstr "넌 아주 훌륭한 식물이야."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "We're always here when you need somebody to talk to!"
msgstr "이야기할 누군가가 필요할 때 항상 여기 있을 게!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "아얏!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "아, 이젠 미끼 노릇 못 하겠다."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED"
msgid "We felt like using him was a bit like cheating anyway."
msgstr "녀석을 이용하는 건 어쨌든 약간의 꼼수를 쓰는 것 같아."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD"
msgid "Oh no... where are we supposed to go now?"
msgstr "오 아니야... 지금 어디로 가고 있는 거야?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "They want to get back to finding the kitcoons."
msgstr "애옹쿤을 찾으러 다시 오고 싶을 거야."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Either someone else found them, or this one is a lot tinier."
msgstr "누군가 다른 사람이 찾아냈거나 아니면 이 녀석이 아주 조그맣거나."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We must be getting close!"
msgstr "가까워지고 있는 것 같은데!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Doesn't look like he found any clues here."
msgstr "여기서 아무런 단서도 찾지 못한 것 같아."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING"
msgid "Wow! He's leading us right to the kitcoons! ...Is that cheating?"
msgstr "와! 우리를 바로 애옹쿤에게 이끌고 있어!... 이런 게 꼼수인가?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "We should stay close to him."
msgstr "가까이 있어야 해."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPED"
msgid "Aww, the frog left!"
msgstr "이런, 개구리가 떠났다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOADESCAPING"
msgid "It's looking around for a way out."
msgstr "나갈 길을 찾고 있다."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_SLIP"
msgid "Hey! We were using that!"
msgstr "야! 우리가 쓰던 것이다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOOL_TOOWEAK"
msgid "We don't think this tool's strong enough!"
msgstr "우린 이 도구가 너무 약한 것 같아!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TORCH_OUT"
msgid "Waah, our light went out!"
msgstr "으악, 불이 꺼졌다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "We're here!"
msgstr "도착했다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TRAP_WENT_OFF"
msgid "Eek!"
msgstr "앗!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_UNIMPLEMENTED"
msgid "Gah! It needs more time."
msgstr "크앗! 시간이 더 필요하다."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WASHED_ASHORE"
msgid "Our fur is soaking wet!"
msgstr "털이 젖는다!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEAK_RAT"
msgid "We don't think it can race anymore..."
msgstr "이제 경주는 못 할 것 같다..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_WEIGHT"
