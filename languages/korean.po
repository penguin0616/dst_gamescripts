msgstr "물고기 꼬마가 바빠 보인다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "Is tree full of fish!"
msgstr "나무에 물고기가 꽉 찼다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "Is tree full of fighting fish!"
msgstr "나무에 싸우는 물고기가 꽉 찼다!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY"
msgid "For fish man only."
msgstr "물고기 사람 전용이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "For fish man only."
msgstr "물고기 사람 전용이다."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERM_LUNAR"
