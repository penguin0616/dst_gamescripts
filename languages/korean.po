msgctxt "STRINGS.SKILLTREE.WINONA.WINONA_LUNAR_3_TITLE"
msgid "Enlightened Strike"
msgstr "계몽된 일격"

#. STRINGS.SKILLTREE.WINONA.WINONA_MIDSHELF_LOCK_DESC
msgctxt "STRINGS.SKILLTREE.WINONA.WINONA_MIDSHELF_LOCK_DESC"
