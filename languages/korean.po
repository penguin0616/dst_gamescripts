msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "It's resting."
msgstr "쉬고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "It looks a bit scary..."
msgstr "좀 무서워..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "It looks a bit scary..."
msgstr "좀 무서워..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "That looks like a long fall."
msgstr "오래 걸릴 거 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "Would we change anything if we could go back in time?"
msgstr "시간을 되돌릴 수 있다면 뭐든 바꿀 수 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "It's resting."
msgstr "쉬고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Would we change anything if we could go back in time?"
msgstr "시간을 되돌릴 수 있다면 뭐든 바꿀 수 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "It's resting."
msgstr "쉬고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Would we change anything if we could go back in time?"
msgstr "시간을 되돌릴 수 있다면 뭐든 바꿀 수 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "It's resting."
msgstr "쉬고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "We never knew clocks could be so dangerous."
msgstr "시계가 그렇게 위험할 수 있다는 것을 결코 알지 못했어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POCKET_SCALE"
msgid "Wonder how heavy our fish is!"
msgstr "우리가 잡은 물고기 무게가 궁금한걸!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLISHCOOKIE"
msgid "Yay! We love cookies!"
msgstr "만세! 쿠키 좋아!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLLY_ROGERS"
msgid "She's our friend!"
msgstr "우리 친구야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POLLY_ROGERSHAT"
msgid "We're the famous pirate Webbeard! Arr!"
msgstr "우리는 악명 높은 해적 거미수염이다! 으하하!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE"
msgid "I didn't expect this to grow."
msgstr "이게 자랄 줄은 몰랐다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_COOKED"
msgid "It's good for us!"
msgstr "몸에 좋은 거다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "We can't even wrap all our arms around it!"
msgstr "팔로 감쌀 수도 없어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POMEGRANATE_SEEDS"
msgid "We could grow something with these."
msgstr "이걸 재배할 수 있을 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POND"
msgid "Water doesn't go well with our fur."
msgstr "물은 우리 털에 안 좋다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PONDEEL"
msgid "Fresh water-snake."
msgstr "민물에 사는 뱀이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PONDFISH"
msgid "It could stand to be fried."
msgstr "튀기면 좋겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POND_ALGAE"
msgid "Just a normal pond plant."
msgstr "평범한 연못의 식물이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POOP"
msgid "Doodoo."
msgstr "응가."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "Shake-a, shake-a, shake-a!"
msgstr "흔들 흔들 흔들!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "This is taking so loooong!"
msgstr "너무 오래 걸린다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "Food'll be ready soon!"
msgstr "음식이 곧 준비된다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Mmmm! Let's eat!"
msgstr "냠냠! 먹자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Aw, there's nothing in there."
msgstr "이런, 안이 텅 비었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Makes yummies!"
msgstr "맛있는 걸 만든다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "We can stay warm and cozy on our adventures!"
msgstr "따뜻하고 포근하게 모험할 수 있겠어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "All done."
msgstr "다 됐어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Oh! Can we grind it, please?"
msgstr "오! 이거 갈아도 될까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLETENT"
msgid "Yay, we're camping!"
msgstr "만세, 캠핑이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PORTABLETENT_ITEM"
msgid "Let us help!"
msgstr "도와줄게!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO"
msgid "Woah! A potato!"
msgstr "우와! 감자다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOSACK"
msgid "We peeked inside, some of them looked more like rocks than potatoes..."
msgstr "안을 엿보니까 어떤 녀석들은 감자보다는 돌맹이 같았어..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOSOUFFLE"
msgid "It looks so fancy."
msgstr "근사해 보인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATOTORNADO"
msgid "Woah! It's cool, AND edible!"
msgstr "우와! 멋진 데다, 먹을 수도 있다니!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_COOKED"
msgid "It's a cooked potato now."
msgstr "이제는 요리한 감자다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_OVERSIZED"
msgid "Mr. Wolfgang will be so happy!"
msgstr "볼프강이 아주 좋아할 거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTATO_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POTTEDFERN"
msgid "Mum would like this nice fern."
msgstr "엄마가 이 양치류 장식을 좋아할 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POWCAKE"
msgid "Mum never let me have these."
msgstr "우리 엄마는 이런 거 못 먹게 했는데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.POWDER_MONKEY"
msgid "Hey, Ms. Wickerbottom says we shouldn't take things that don't belong to us!"
msgstr "위커바텀 씨가 남의 물건을 함부로 가져가면 안 된다고 하셨어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "We'll have to fill it up somewhere."
msgstr "어딘가를 채워야 할 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "Our watering can back home didn't look anything like that."
msgstr "우리 집에 있는 물뿌리개는 이렇게 생기지 않았는데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PRIME_MATE"
msgid "He's a big bully!"
msgstr "덩치 큰 깡패 녀석이야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.GENERIC"
msgid "It looks like a nice bird."
msgstr "친절한 새 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.HELD"
msgid "I got you now."
msgstr "내가 너 잡았어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUFFIN.SLEEPING"
msgid "Nighty night."
msgstr "잘 자."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN"
msgid "That's a huge pumpkin!"
msgstr "거대한 호박이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINCARVER"
msgid "Fun fun fun fun fun."
msgstr "재밌다, 재밌어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINCOOKIE"
msgid "Yum!"
msgstr "냠!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKINPIE"
msgid "We'd like a big slice, please!"
msgstr "크게 잘라 주세요!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_COOKED"
msgid "It's all warm now."
msgstr "이제 따뜻해졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_LANTERN"
msgid "Just like we used to make at home!"
msgstr "전에 집에서 만들던 거랑 똑같다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Let's carve a big scary face into it!"
msgstr "거기에 크고 무시무시한 얼굴을 새겨 보자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUMPKIN_SEEDS"
msgid "We could grow something with these."
msgstr "이걸 재배할 수 있을 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUNCHINGBAG"
msgid "Wigfrid's teaching us how to spar with it!"
msgstr "위그프리드가 이거랑 대련하는 법 가르쳐주고 있어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PUREBRILLIANCE"
msgid "It's blinding our poor spider eyes!"
msgstr "우리 불쌍한 거미 눈이 멀 것 같아!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEAMULET"
msgid "Did you hear something?"
msgstr "방금 무슨 소리 들렸나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEGEM"
msgid "I can see knowledge swimming inside."
msgstr "안에서 지식이 넘실대는 게 보인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PURPLEMOONEYE"
msgid "Now we won't need to leave a trail of breadcrumbs!"
msgstr "이제 흔적을 남기고 다닐 필요 없다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "We hope it's good."
msgstr "괜찮아야 할 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "I think it's hungry."
msgstr "배고픈 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "It's nice enough."
msgstr "제법 괜찮다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Ivy grows everywhere."
msgstr "담쟁이덩굴은 아무 데서나 자란다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Wow. She looks beautiful."
msgstr "우와. 예쁘다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It looks like the friendly goat we met."
msgstr "전에 본 우호적인 염소 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "A lotta goat statues around here."
msgstr "여기는 염소 조각상이 많다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Take it easy, grandpa."
msgstr "진정해, 할아버지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Aww... all the berries are gone now."
msgstr "이런... 베리가 다 없어졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Now we have somewhere to put food."
msgstr "이제 음식을 담을 수 있겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "We can cooks stuff in it."
msgstr "음식을 담아 요리할 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "It's kinda small."
msgstr "좀 작다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN1"
msgid "We could trade it for something small."
msgstr "사소한 물건과 교환할 수 있겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN2"
msgid "I wonder what we can buy with this."
msgstr "이걸로 뭘 살 수 있을까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN3"
msgid "We can buy a whole bunch of stuff with this."
msgstr "이걸로 뭐든 잔뜩 살 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_COIN4"
msgid "The nice lady said we need three of them."
msgstr "친절한 아줌마가 이거 세 개는 필요하다고 했다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Crabs kinda look like spiders."
msgstr "어떻게 보면 게는 거미랑 비슷하게 생겼다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "We don't want to eat it."
msgstr "먹고 싶지 않다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "We can trap little crabs in this."
msgstr "이걸로 작은 게를 잡을 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FERN"
msgid "Maybe we could make a salad."
msgstr "샐러드를 만들 수 있을지도 모르겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FLOUR"
msgid "It's no good by itself."
msgstr "이것만으로는 쓸모없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "This probably doesn't count as a salad, huh."
msgstr "이건 샐러드로 칠 수 없겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "We can put it on the altar now."
msgstr "이제 제단에 놓을 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "The goat lady said this was what the Gnaw wanted."
msgstr "물뜯이가 원하는 게 이거라고 염소 아줌마가 그랬다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "This is what it wants, but it's kinda puny."
msgstr "이게 맞긴 한데, 너무 적은 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "We think the Gnaw wants something different."
msgstr "물뜯이가 원하는 건 이게 아닌 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "It's okay. The next one will be better."
msgstr "괜찮다. 다음 건 나을 테니까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Maxwell says you ward monsters away with it."
msgstr "이걸로 몬스터를 물리칠 수 있다고 맥스웰이 그랬다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "It didn't ward us off!"
msgstr "우리는 물리치지 않았다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATKID"
msgid "Hi! I'm Webber!"
msgstr "안녕! 난 웨버다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Milk is good for our bones. Endo and exo!"
msgstr "염소젖은 뼈에 좋지. 내골과 외골 다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Does your kid want to play?"
msgstr "새끼 염소랑 같이 놀아도 돼?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL"
msgid "We have to be careful when we cook."
msgstr "요리할 때는 조심해야 한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "We could use it to make yummy food."
msgstr "맛좋은 음식을 만드는 데 사용할 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "What should we cook?"
msgstr "무엇을 요리할까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "Let's find a place to put it."
msgstr "놓을 만한 장소를 찾아보자."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_HOE"
msgid "I know how to use this!"
msgstr "이거 어떻게 쓰는 건지 나 안다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_KEY"
msgid "Cool! I wonder what it unlocks?"
msgstr "멋지군! 무엇을 열 수 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "We wanna go to the park."
msgstr "공원에 가고 싶다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "It's the kind of lamp they have in the city."
msgstr "도시에서 볼 수 있는 등불이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "We're almost as tall as this lamp."
msgstr "이 등불은 우리랑 키가 비슷하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "We want to do the grinding!"
msgstr "직접 갈고 싶다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "It doesn't look very cozy."
msgstr "별로 아늑해 보이지 않는다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Do they have any toys?"
msgstr "장난감이 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "That's full of good stuff."
msgstr "좋은 물건이 많이 들어있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "I don't like mushrooms."
msgstr "난 버섯이 싫다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Those mushrooms are tiny."
msgstr "작은 버섯들이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "No more little mushrooms."
msgstr "작은 버섯이 이제는 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION"
msgid "It makes all our eyes water!"
msgstr "눈에서 물이 나오게 한다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Our eyes don't water any more."
msgstr "눈에서 더는 물이 나오지 않는다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_OVEN"
msgid "Mom said I should be careful around the oven."
msgstr "오븐 주변에서는 조심해야 한다고 엄마가 말했다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "We gotta set this up."
msgstr "이걸 설치해야 한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "It looks sharp."
msgstr "뾰족해 보인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "I think it's sort of pretty."
msgstr "꽤 이쁘다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "It almost looks real."
msgstr "거의 진짜 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "No coins in it. I guess no one made wishes."
msgstr "안에 동전이 없다. 아무도 소원을 빌지 않은 모양이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Park. Park. Park!"
msgstr "공원. 공원. 공원이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "It's locked. I think we need a key."
msgstr "잠겼다. 열쇠가 필요한 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's a monument or something."
msgstr "무슨 기념비인 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Aw. Someone died."
msgstr "저런. 누군가 죽었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Don't be afraid!"
msgstr "무서워할 것 없어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It's not moving."
msgstr "안 움직인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I should leave it alone."
msgstr "그냥 내버려 둬야겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's sleeping."
msgstr "자고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Now we don't have to eat off the floor."
msgstr "이제 바닥에서 주워 먹을 필요가 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It's all crusty around the edges."
msgstr "가장자리에 소금이 말라 굳어 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PORTAL"
msgid "At least it took us somewhere different."
msgstr "어딘가 다른 곳으로 이동했다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "I wonder where this takes us."
msgstr "어디로 우리를 데려갈까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT"
msgid "This pot's a bit bigger than the other one."
msgstr "이 솥은 이전 것보다 크다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO"
msgid "Woah! A potato!"
msgstr "우와! 감자다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "It's a cooked potato now."
msgstr "이제는 요리한 감자다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "We can hang a pot off this."
msgstr "여기에 솥을 걸 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "We should put it together."
msgstr "조립해야겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "You cook stuff in it."
msgstr "안에 음식을 넣고 요리할 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Sweet pot!"
msgstr "솥에 단 게 들었다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "That one got a bit squishy."
msgstr "물컹해졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Aww... It's broken."
msgstr "이런... 고장난 상태네."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "I wish we could ride in that."
msgstr "탈 수 있으면 좋을 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "We can't even fix it."
msgstr "고칠 수도 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Bummer."
msgstr "이런."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Aw. That's too bad."
msgstr "이런. 안타깝다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Does it still tell the right time?"
msgstr "아직도 시간이 맞을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "I don't think that clock works anymore."
msgstr "시계는 이제 작동하지 않는 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Where did everyone go?"
msgstr "다들 어디로 갔을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "I wonder what happened here?"
msgstr "여기서 무슨 일이 일어났을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Looks like everyone left."
msgstr "다 떠난 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It doesn't lead anywhere anymore."
msgstr "이제는 문 기능을 하지 않는다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "Too bad."
msgstr "안타깝다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Well, it wouldn't hurt to take a look."
msgstr "뭐, 안을 살펴봐도 되겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Someone's precious things are probably inside."
msgstr "누군가의 소중한 물건이 안에 들어있겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALMON"
msgid "Mom said fish oil is good for our brain."
msgstr "엄마는 생선 기름이 뇌에 좋다고 말했다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Smells good!"
msgstr "맛있는 냄새가 난다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT"
msgid "We don't use a lot of salt on our food."
msgstr "우리는 음식에 소금을 많이 쓰지 않는다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "We're gonna crunch them all up."
msgstr "다 부술 거다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "We have to wait for more salt."
msgstr "좀 더 기다려야 소금을 얻을 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt's ready."
msgstr "소금이 준비되었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "We should set it up at the crusty pond."
msgstr "소금 연못 가에 설치해야겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAP"
msgid "Sticky, gooey sap."
msgstr "끈적한 수액이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's a big ol'bucket."
msgstr "크고 낡은 양동이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAPLING"
msgid "It's gonna take too long to grow back."
msgstr "다시 자라려면 오래 걸리겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Aw... It's no good anymore."
msgstr "이런... 이젠 쓸 수 없게 됐다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "We can plant a whole bunch of food with this."
msgstr "이걸로 식량을 잔뜩 심을 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't wanna use this."
msgstr "이건 쓰기 싫다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "We ground it all up."
msgstr "다 갈았다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "What a cool purple shrub."
msgstr "멋진 보라색 관목이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "All the good stuff's gone."
msgstr "좋은 건 다 사라졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It doesn't taste very good on its own."
msgstr "이것만으로는 맛이 좋지 않다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "I wonder why the people left this nice place."
msgstr "왜 사람들이 이 좋은 곳을 떠났을까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Why would anyone do that?"
msgstr "대체 왜 이랬을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Ew... The bugs got in it."
msgstr "우웩... 벌레가 들어갔다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "There isn't any sap yet."
msgstr "아직 수액이 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sticky, sticky sap!"
msgstr "끈적한 수액!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "Aw, now it's not as pink."
msgstr "저런, 이제는 분홍색이 아니다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "They're not afraid of us!!"
msgstr "우리를 두려워하지 않는다!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Hi, Mr. Pig!"
msgstr "안녕, 돼지 씨!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's sleeping."
msgstr "자고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "I've never seen their houses up close!"
msgstr "저들의 집을 이렇게 가까이서 보는 건 처음이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "No one lives in it anymore."
msgstr "이젠 아무도 살지 않는다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Sweet!"
msgstr "달다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Is it a fruit or a vegetable?"
msgstr "과일일까, 채소일까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It's a cooked fregetable. Vruit?"
msgstr "요리한 채소다. 과일인가?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Hi there! Wanna trade?"
msgstr "안녕! 거래할래?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Hey. You look nice."
msgstr "안녕. 넌 성격 좋아 보이는데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP"
msgid "Wow! It's a turnip!"
msgstr "우와! 순무다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "We cooked the turnip."
msgstr "순무를 요리했다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_WHEAT"
msgid "If only I were back at the mill."
msgstr "방앗간으로 돌아갈 수 있다면."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "심으면 무엇인지 알 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBIT.GENERIC"
msgid "We just want to play!"
msgstr "그냥 같이 놀자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBIT.HELD"
msgid "He's ours now."
msgstr "이제 우리 거다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHAT"
msgid "Haha!"
msgstr "하하!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Come out! We just want to be friends."
msgstr "나와! 친구로 지내고 싶을 뿐이야."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOLE.SPRING"
msgid "I hope they're okay in there."
msgstr "안에서 괜찮을까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOUSE.BURNT"
msgid "A little overdone and overlarge."
msgstr "너무 태웠는 데다 너무 크다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Just like grandpa said, \"You live in what you eat.\""
msgstr "할아버지가 말한 것처럼 \"자기가 먹은 것 안에서 산다\"."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGHORN"
msgid "What kind of music do rabbits like?"
msgstr "토끼는 어떤 음악을 좋아하지?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "We can hide things with the rabbits!"
msgstr "토끼가 우리 물건을 숨겨 줄 거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "Nasty rabbit."
msgstr "못된 토끼."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKINGSPEAR"
msgid "It's a little fuzzy, like us!"
msgstr "우리처럼 복슬복슬해!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "What a grouchy ol' rabbit!"
msgstr "심술쟁이 토끼!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_LUCKY"
msgid "We'll catch it!"
msgstr "우리가 잡을 거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RABBITKING_PASSIVE"
msgid "Hello, Mister Rabbit!"
msgstr "안녕하세요, 토끼 씨!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINCOAT"
msgid "Dry fur is the best fur."
msgstr "마른 털이 좋은 털이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINHAT"
msgid "It'll keep the water out of your fur."
msgstr "털이 물이 젖지 않게 해 줄 거다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINOMETER.BURNT"
msgid "I don't think that's accurate."
msgstr "정확하지 않은 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAINOMETER.GENERIC"
msgid "It must be powered by magic."
msgstr "마법의 힘으로 작동하는 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RATATOUILLE"
msgid "Do we have to eat our veggies?"
msgstr "채소를 먹어야 하나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RAZOR"
msgid "I watched my father use one of these."
msgstr "아빠가 이런 걸 쓰는 걸 본 적이 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD"
msgid "It's a real earworm!"
msgstr "귀에 쏙쏙 박히네!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_BALATRO"
msgid "It makes us happy!"
msgstr "행복한 음악이야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_CREEPYFOREST"
msgid "It's his favorite song!"
msgstr "내 거미 친구가 가장 좋아하는 노래야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DANGER"
msgid "It's his favorite song!"
msgstr "내 거미 친구가 가장 좋아하는 노래야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DAWN"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DRSTYLE"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_DUSK"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_EFS"
msgid "This one's kind of scary."
msgstr "이건 조금 무섭네."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_END"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "We want candy."
msgstr "우리 사탕 먹고 싶어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_MAIN"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "It makes us want to do a little dance!"
msgstr "춤을 추고 싶어져!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDGEM"
msgid "It feels warm, even on the coldest nights."
msgstr "아무리 추운 밤에도 따뜻한 느낌이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDLANTERN"
msgid "Our own personal night light!"
msgstr "우리만의 밤 조명이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDMOONEYE"
msgid "That rock needs a nap. Its eye is all red!"
msgstr "돌에게 낮잠이 필요하다. 눈이 아주 빨개서!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REDPOUCH"
msgid "We're so lucky!"
msgstr "우린 운이 좋다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_CAP"
msgid "It smells funny."
msgstr "냄새가 요상하네."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_CAP_COOKED"
msgid "It smells better now."
msgstr "냄새가 나아졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Ready for the taking!"
msgstr "이제 따도 되겠다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "We can't get at it like that."
msgstr "이 상태로는 딸 수 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "I think some spores remain."
msgstr "포자는 조금 남은 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.BURNING"
msgid "Those burn quickly!"
msgstr "빨리 탄다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.GENERIC"
msgid "I bet those would be useful."
msgstr "쓸 데가 있을 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REEDS.PICKED"
msgid "Only stems remain."
msgstr "줄기만 남았다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REFINED_DUST"
msgid "It's a good thing neither of us are allergic."
msgstr "우리 둘 다 알레르기가 없다는 것은 좋은 일이지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REFLECTIVEVEST"
msgid "Safety first!"
msgstr "안전 제일!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RELIC"
msgid "These haven't been used in a while."
msgstr "오랫동안 안 쓴 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB.BURNT"
msgid "I think it's broken."
msgstr "이젠 사용할 수 없을 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "It's like a science lab in here!"
msgstr "무슨 과학 실험실 같다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "All our work... gone."
msgstr "우리의 수고가... 사라졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Father used to work on something like that."
msgstr "아빠도 저런 것을 가지고 작업했는데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "The fires care not for magic."
msgstr "불은 마법을 무시한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "We should be careful around that."
msgstr "저 주위에서는 조심해야겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "Smells like cooking."
msgstr "요리할 때 나는 냄새다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "Did I just hear a squeak?"
msgstr "방금 무슨 소리가 들렸나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESKIN_TOOL"
msgid "Awww do we have to clean?"
msgstr "힝, 꼭 청소해야 해?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "It will be of no use to us in that state."
msgstr "저 상태로는 아무 쓸모없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "It's a giant doll of our friend!!"
msgstr "우리 친구를 거대한 인형으로 만들었네!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RESURRECTIONSTONE"
msgid "Some sort of religious monument maybe?"
msgstr "무슨 종교적인 형상인가?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.REVIVER"
msgid "I think it loves me."
msgstr "날 좋아하나 보다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RHINODRILL"
msgid "Looks like a big bully!"
msgstr "덩치 큰 깡패 같다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROASTTURKEY"
msgid "Can we have the wishbone?"
msgstr "소원을 비는 뼛조각, 우리가 가져도 돼?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN.GENERIC"
msgid "Red is my favorite color!"
msgstr "나는 빨간색을 좋아한다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN.HELD"
msgid "Held snug in our pockets."
msgstr "주머니 안에 잘 들어간다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "What pretty white feathers."
msgstr "예쁜 하얀 깃털이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Let's name it \"Francis\"."
msgstr "\"프랜시스\"라고 이름 붙이자."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBOT_BLUEPRINT"
msgid "We hope it's not too heavy for the beefalo."
msgstr "비팔로에게 너무 무겁지 않으면 좋겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROBOT_PUPPET"
msgid "I don't think they're having fun."
msgstr "재미있게 지내는 것 같지 않다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK"
msgid "We'll need to mine it before we can use it."
msgstr "사용하려면 일단 캐야 한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCKS"
msgid "None of these look like they would skip well."
msgstr "물수제비에는 적당하지 않을 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCKY"
msgid "Snip snap!"
msgstr "울퉁불퉁!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "We don't think it can make fruit anymore."
msgstr "이제 과일을 만들어내지 못할 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "It's burning!"
msgstr "불에 타고 있다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It's really sick."
msgstr "많이 아프다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "It looks a little pale."
msgstr "창백해 보인다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "There's rocks growing out of that bush!"
msgstr "덤불에서 돌멩이가 자란다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It doesn't have anything good."
msgstr "괜찮은 물건이 없다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "Too hot."
msgstr "너무 뜨겁다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "We have to wait for it to ripen."
msgstr "익으려면 좀 더 기다려야 한다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "We cracked it open."
msgstr "부수고 열었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "No more pit!"
msgstr "이제 씨가 없다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "Oh wow, it's growing!"
msgstr "우와, 자란다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE.GENERIC"
msgid "Ice can be useful."
msgstr "얼음은 쓸모 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE.MELTED"
msgid "Puddle!"
msgstr "웅덩이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_ICE_MELTED"
msgid "Puddle!"
msgstr "웅덩이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "This lava's all dried up."
msgstr "용암이 다 말랐다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.LOW"
msgid "It's a little less cozy."
msgstr "덜 포근해졌다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Cozy!"
msgstr "포근하다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_LIGHT.OUT"
msgid "It looks like it might break."
msgstr "곧 망가질 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_MOON"
msgid "Neat!"
msgstr "멋지다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "It's all stone and no bark."
msgstr "껍질까지 다 돌이 됐다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "It's all stone and no bark."
msgstr "껍질까지 다 돌이 됐다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROOK"
msgid "Who made these things!?"
msgstr "누가 이걸 만들었을까!?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROOK_NIGHTMARE"
msgid "You can't rook us."
msgstr "우린 순순히 당하지 않아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROPE"
msgid "We could tie stuff up with this."
msgstr "이걸로 물건을 묶을 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "We can help!"
msgstr "우리가 도울게!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Winona wouldn't let us play with them. We've never seen her so stern..."
msgstr "위노나가 못 가지고 놀게 해. 그렇게 엄격하게 구는 건 처음 봤어..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROTTENEGG"
msgid "Ew!"
msgstr "우웩!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ROYAL_JELLY"
msgid "It's goopy."
msgstr "물컹거린다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUBBLE"
msgid "Rocks from an old city."
msgstr "오래된 도시의 바위다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINSHAT"
msgid "And now we are king."
msgstr "이제 우리가 왕이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINS_BAT"
msgid "We will, we will, smash you!"
msgstr "박살 내주마!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.RUINS_RUBBLE"
msgid "It looks broken."
msgstr "부서진 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "We feel cold."
msgstr "추워진 느낌이다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It's judging us."
msgstr "우리를 평가하고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLEHORN"
msgid "Leaves the beast nakey."
msgstr "짐승에게서 안장을 벗기는 도구다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_BASIC"
msgid "We ride!"
msgstr "타자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_RACE"
msgid "It's a saddle made out of spidersnacks!"
msgstr "거미밥으로 만든 안장이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_SHADOW"
msgid "We love riding beefalo! Wheee!"
msgstr "우린 비팔로 타는 게 좋아! 야호!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_WAR"
msgid "We'll have lots of fun riding on this."
msgstr "타면 엄청 신나겠다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Wigfrid takes good care of her steed."
msgstr "위그프리드는 애마를 잘 보살피네."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALSA"
msgid "Yummy but... spicy!!"
msgstr "맛있지만... 맵다!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTBOX"
msgid "Makes our food last longer."
msgstr "음식이 더 오래 가게 해준다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTLICK"
msgid "We really regret licking it. Blech."
msgstr "핥은 게 후회된다. 우웩."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTLICK_IMPROVED"
msgid "We know it's gross but we want to lick it anyway."
msgstr "역겨운 건 알지만, 그래도 핥고 싶어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTROCK"
msgid "What a weird rock."
msgstr "이상한 돌이네."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.GENERIC"
msgid "They're kind of spooky."
msgstr "오싹하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.GROWING"
msgid "Hey, it's growing back!"
msgstr "이야, 다시 자란다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Someone already took all the salt."
msgstr "누가 소금을 다 가져가 버렸다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANDBLOCK"
msgid "Not like this!!"
msgstr "이건 아니야!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANDSPIKE"
msgid "Ouchie!"
msgstr "아얏!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANITYROCK.ACTIVE"
msgid "It's in our way."
msgstr "우리를 막고 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Something about this rock feels off."
msgstr "이 돌은 뭔가 이상하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.BURNING"
msgid "So bright!"
msgstr "너무 밝다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.DISEASED"
msgid "Maybe it needs some chicken soup?"
msgstr "밥 많이 먹으면 나을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.DISEASING"
msgid "Are you okay, lil sapling?"
msgstr "괜찮니, 어린 나무야?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.GENERIC"
msgid "These sure grow slowly."
msgstr "너무 느리게 자란다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.PICKED"
msgid "Don't worry lil guy, it'll grow back!"
msgstr "걱정하지 마, 다시 자랄 거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SAPLING.WITHERED"
msgid "I think the heat broke it."
msgstr "너무 더워서 어떻게 된 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCANDATA"
msgid "Wow, it learned all that just by looking really hard?"
msgstr "와아, 그냥 열심히 관찰해서 전부 배운 거야?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.BURNING"
msgid "Someone should address this."
msgstr "누가 뭘 좀 어떻게 해야 할 텐데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.BURNT"
msgid "He got dressed down."
msgstr "옷을 벗었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCARECROW.GENERIC"
msgid "Let's play dress up!"
msgstr "인형놀이 하자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCORCHED_SKELETON"
msgid "They're probably fine."
msgstr "괜찮을 거다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Oooh, we found a page!"
msgstr "우와, 페이지를 찾았어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAPHAT"
msgid "It still smells like pig sweat!"
msgstr "아직 돼지 땀 냄새가 나!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "We can see extra far with that on!"
msgstr "그걸 쓰면 더 멀리 보여!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Oh! There's so many possibilities!"
msgstr "오! 정말 할 수 있는 게 많다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Aww. Can we make another one?"
msgstr "이런. 다시 만드는 게 어때?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "I always wanted pottery lessons!"
msgstr "예전부터 항아리를 만들어보고 싶었다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Wow! It looks great!"
msgstr "와! 근사하다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "That looks really nice!"
msgstr "정말 멋져 보인다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "There! All better!"
msgstr "이야! 이제 좀 나아졌다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "I think it's stuck in there."
msgstr "아무래도 안에 갇혀 있는 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Where's your head, mister?"
msgstr "머리는 어디 갔나요, 아저씨?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "I think it's looking at us!"
msgstr "우리를 보고 있는 것 같다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "I think it really ties the island together."
msgstr "섬에 어울리는 것 같다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "You look great!"
msgstr "좋아 보인다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "I think it's stuck in there."
msgstr "아무래도 안에 갇혀 있는 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "Peekaboo, monster!"
msgstr "까꿍, 몬스터야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Did someone lose this?"
msgstr "누가 머리를 잃어버렸나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "It's a bit scary, but we don't like to judge."
msgstr "무섭지만, 섣불리 판단해선 안 되겠지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Oh! That piece was his nose."
msgstr "아! 아까 그거 코였구나."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "I think it's stuck in there."
msgstr "아무래도 안에 갇혀 있는 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "It was hiding!"
msgstr "숨어있었군!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Looks like a... cactus? No, that's not right."
msgstr "선인장인가...? 아니, 아니군."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Fire is very dangerous."
msgstr "불은 매우 위험하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "There's all kinds of fun things you can do at sea."
msgstr "바다에서는 재미있는 일을 아주 많이 할 수 있다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEAFOODGUMBO"
msgid "We could eat it forever!"
msgstr "이거라면 평생 먹을 수 있다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEASTACK"
msgid "We hope no one crashes their boat on that!"
msgstr "누가 배로 들이받지 않기를!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "We wonder what goes in there."
msgstr "저 안에 뭐가 들어갈까."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "Oooh it glows. Can we touch it?"
msgstr "아, 빛난다. 만져도 되나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDPOUCH"
msgid "We're gonna fill it with seeds!"
msgstr "씨앗으로 채울 거야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDS"
msgid "A small life trapped within. My sympathies."
msgstr "안에 작은 생명이 갇혀 있다. 불쌍하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEEDS_COOKED"
msgid "Their growing days are over."
msgstr "이젠 자랄 수 없게 되었다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SENTRYWARD"
msgid "Woah! I bet it sees so far!"
msgstr "우와! 아주 멀리까지 볼 수 있겠지!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_KIT"
msgid "Mum used to handle all of our sewing."
msgstr "바느질은 엄마가 다 했는데."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Aww, we wanted to play dress-up..."
msgstr "에이, 옷 입히기 놀이 하고 싶었는데..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Let's play dress up!"
msgstr "인형놀이 하자!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SEWING_TAPE"
msgid "It's sticky, like a web."
msgstr "거미줄처럼 끈적하다."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWDANCER"
msgid "We'll dance with you, Mr. Shadow!"
msgstr "우리가 같이 춤출게요, 그림자 씨!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWDIGGER"
msgid "Sometimes scary things are nice."
msgstr "무서운 존재가 사실은 착할 때도 있지."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWHEART"
msgid "Why does it make me feel so bad?"
msgstr "왜 기분이 나빠질까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "W-we don't think we want to look down there..."
msgstr "우, 우린 저 아래 내려다 보고 싶지 않아..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "We wonder if they get dizzy walking like that..."
msgstr "저렇게 걸으면 어지럽지 않으려나..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "We don't want to get gobbled up again!"
msgstr "우린 다시 먹히기 싫어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "It's smiling at us! Maybe it wants to play!"
msgstr "우릴 보고 웃고 있어! 놀고 싶은가 봐!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Maybe it just wants a friend to play with."
msgstr "그냥 같이 놀 친구가 필요한 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Aww, no fair, we wish we had wings!"
msgstr "에이, 불공평해. 우리도 날개 갖고 싶어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_BATTLEAXE"
msgid "We'll be careful. Promise!"
msgstr "조심할게. 정말이야!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_BEEF_BELL"
msgid "We can save our beefalo!"
msgstr "우리 비팔로를 구할 수 있어!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_FORGE"
msgid "We'd rather do crafts with paper and glue..."
msgstr "우린 그냥 종이랑 풀로 만드는 게 좋은데..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Where should we put it?"
msgstr "어디다 둬야 하지?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHALLOW_GRAVE"
msgid "Aww. Did we know them?"
msgstr "저런. 우리랑 아는 사이였나?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHARK"
msgid "Shark attack!"
msgstr "상어 공격이다!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHARKBOI"
msgid "Maybe it just wants to play with us."
msgstr "그냥 우리랑 놀고 싶어 하는 것 같아."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHELL_CLUSTER"
msgid "Any pretty shells in there?"
msgstr "예쁜 껍데기가 있을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHIELDOFTERROR"
msgid "Ms. Wickerbottom says we shouldn't bite."
msgstr "위커바텀 씨가 물면 안 된다고 하셨어."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHOVEL"
msgid "Maybe we can tunnel our way out?"
msgstr "터널을 뚫어서 나갈 수 있지 않을까?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SHOVEL_LUNARPLANT"
